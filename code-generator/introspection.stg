// Introspection artifacts: frame layout, runtime writer, model samples, frame_log.proto.

frame_layout_header(introspection_artifacts) ::= <<
// GENERATED by motion-spec-codegen. Do not edit.
#pragma once

#include \<cstddef\>
#include \<cstdint\>

namespace motion_spec::introspection {

inline constexpr std::uint32_t kSchemaVersion = <introspection_artifacts.frame_layout.schema_version>;
inline constexpr std::uint32_t kFrameLayoutVersion = <introspection_artifacts.frame_layout.frame_layout_version>;
inline constexpr std::uint32_t kRuntimeRdfContractVersion = <introspection_artifacts.frame_layout.runtime_rdf_contract_version>;
inline constexpr std::size_t kNumConstraints = <introspection_artifacts.frame_layout.pools.constraints>;
inline constexpr std::size_t kNumMonitors = <introspection_artifacts.frame_layout.pools.monitors>;
inline constexpr std::size_t kNumQuantities = <introspection_artifacts.frame_layout.pools.quantities>;
inline constexpr std::size_t kNumTriggers = <introspection_artifacts.frame_layout.pools.triggers>;
inline constexpr std::size_t kNumPoses = <introspection_artifacts.frame_layout.pools.poses>;
inline constexpr std::size_t kNumTwists = <introspection_artifacts.frame_layout.pools.twists>;
inline constexpr std::size_t kNumWrenches = <introspection_artifacts.frame_layout.pools.wrenches>;
inline constexpr std::size_t kFrameSizeBytes = <introspection_artifacts.frame_layout.frame_size_bytes>;
inline constexpr const char *kSchemaHash = "<introspection_artifacts.frame_layout.schema_hash>";
inline constexpr const char *kFrameLayoutHash = "<introspection_artifacts.frame_layout.frame_layout_hash>";
inline constexpr const char *kRuntimeActivityId = "<introspection_artifacts.frame_layout.runtime_activity_id>";
inline constexpr const char *kRuntimeProducerAgentId = "<introspection_artifacts.frame_layout.runtime_producer_agent_id>";
inline constexpr const char *kRuntimeAgentId = "<introspection_artifacts.frame_layout.runtime_agent_id>";
inline constexpr std::int64_t kEndState = <introspection_artifacts.frame_layout.end_state>;
inline constexpr std::int64_t kNominalPeriodNs = <introspection_artifacts.frame_layout.nominal_period_ns>;

} // namespace motion_spec::introspection
>>

introspection_runtime_header(introspection_artifacts) ::= <<
// GENERATED by motion-spec-codegen. Do not edit.
#pragma once

#include "frame_layout.h"

#include \<atomic\>
#include \<chrono\>
#include \<cmath\>
#include \<cstddef\>
#include \<cstdint\>
#include \<cstdio\>
#include \<cstring\>
#include \<cstdlib\>
#include \<fcntl.h\>
#include \<string\>
#include \<thread\>
#include \<type_traits\>
#include \<unistd.h\>
#include \<sys/mman.h\>
#include \<vector\>

namespace motion_spec::introspection {

struct ConstraintSlot {
    std::int64_t active;
    double error;
    double output;
    std::int64_t satisfied;
    double sat_t;
    double measured;
    double setpoint;
};

struct MonitorSlot {
    std::int64_t active;
    double value;
    std::int64_t satisfied;
    double sat_t;
};

struct Trigger {
    std::int64_t kind;
    std::int64_t idx;
    std::int64_t fsm_state;
    double t;
    std::int64_t wall_ns;
};

// Spatial slots ride the frame ring; the writer serializes them into the frame record's
// pose/twist/wrench fields.
struct PoseSlot {
    double px, py, pz, qx, qy, qz, qw;
};

struct TwistSlot {
    double lx, ly, lz, ax, ay, az;
};

struct WrenchSlot {
    double fx, fy, fz, tx, ty, tz;
};

struct Frame {
    std::uint64_t seq;
    double t;
    std::uint64_t step;
    std::int64_t fsm_state;
    std::int64_t active_motion;
    std::int64_t last_event;
    double state_since_t;
    std::int64_t state_since_wall_ns;
    double event_t;
    std::int64_t event_wall_ns;
    std::int64_t wall_ns;
    std::int64_t period_ns;
    std::int64_t compute_ns;
    ConstraintSlot constraints[kNumConstraints];
    MonitorSlot monitors[kNumMonitors];
    double quantities[kNumQuantities];
    Trigger triggers[kNumTriggers];
    std::int64_t trigger_count;
    PoseSlot poses[kNumPoses];
    TwistSlot twists[kNumTwists];
    WrenchSlot wrenches[kNumWrenches];
};

static_assert(sizeof(ConstraintSlot) == 7 * 8, "ConstraintSlot must be padding-free");
static_assert(sizeof(MonitorSlot) == 4 * 8, "MonitorSlot must be padding-free");
static_assert(sizeof(Trigger) == 5 * 8, "Trigger must be padding-free");
static_assert(sizeof(PoseSlot) == 7 * 8, "PoseSlot must be padding-free");
static_assert(sizeof(TwistSlot) == 6 * 8, "TwistSlot must be padding-free");
static_assert(sizeof(WrenchSlot) == 6 * 8, "WrenchSlot must be padding-free");
static_assert(sizeof(Frame) == kFrameSizeBytes, "Frame layout must match frame_layout.json");
static_assert(std::is_trivially_copyable_v\<Frame\>, "Frame must stay trivially copyable");

inline std::int64_t wall_time_ns() {
    const auto now = std::chrono::system_clock::now().time_since_epoch();
    return std::chrono::duration_cast\<std::chrono::nanoseconds\>(now).count();
}

inline std::int64_t steady_time_ns() {
    const auto now = std::chrono::steady_clock::now().time_since_epoch();
    return std::chrono::duration_cast\<std::chrono::nanoseconds\>(now).count();
}

class LatestFramePublisher {
public:
    explicit LatestFramePublisher(const std::string &name) {
        int fd = ::shm_open(name.c_str(), O_CREAT | O_RDWR, 0666);
        if (fd \< 0) return;
        if (::ftruncate(fd, sizeof(Frame)) != 0) {
            ::close(fd);
            return;
        \}
        void *p = ::mmap(nullptr, sizeof(Frame), PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
        ::close(fd);
        if (p == MAP_FAILED) return;
        frame_ = static_cast\<Frame *\>(p);
        std::memset(frame_, 0, sizeof(Frame));
    \}

    ~LatestFramePublisher() {
        if (frame_) {
            ::munmap(frame_, sizeof(Frame));
            frame_ = nullptr;
        \}
    \}

    void publish(const Frame &scratch) {
        if (!frame_) return;
        const std::uint64_t odd = __atomic_load_n(&frame_->seq, __ATOMIC_RELAXED) | 1ull;
        __atomic_store_n(&frame_->seq, odd, __ATOMIC_RELAXED);
        std::atomic_thread_fence(std::memory_order_release);
        std::memcpy(
            reinterpret_cast\<char *\>(frame_) + sizeof(std::uint64_t),
            reinterpret_cast\<const char *\>(&scratch) + sizeof(std::uint64_t),
            sizeof(Frame) - sizeof(std::uint64_t));
        std::atomic_thread_fence(std::memory_order_release);
        __atomic_store_n(&frame_->seq, odd + 1, __ATOMIC_RELAXED);
    \}

private:
    Frame *frame_ = nullptr;
};

class FrameLogger {
public:
    FrameLogger(
        const std::string &path,
        const char *producer_agent_id,
        const char *activity_id,
        std::size_t ring_capacity = 8192)
        : ring_(ring_capacity), mask_(ring_capacity - 1), health_path_(path + ".health.json") {
        if (ring_capacity == 0 || (ring_capacity & (ring_capacity - 1)) != 0) return;
        log_ = std::fopen(path.c_str(), "wb");
        if (!log_) return;
        write_header(producer_agent_id, activity_id);
        running_.store(true, std::memory_order_relaxed);
        writer_ = std::thread(&FrameLogger::run, this);
    \}

    ~FrameLogger() { close(); \}

    void close() {
        bool expected = true;
        if (!running_.compare_exchange_strong(expected, false, std::memory_order_relaxed)) {
            return;
        \}
        if (writer_.joinable()) writer_.join();
        if (log_) {
            std::fclose(log_);
            log_ = nullptr;
        \}
        write_health();
    \}

    void push(const Frame &frame) {
        attempted_.fetch_add(1, std::memory_order_relaxed);
        if (!running_.load(std::memory_order_relaxed)) return;
        const std::uint64_t head = head_.load(std::memory_order_relaxed);
        const std::uint64_t tail = tail_.load(std::memory_order_acquire);
        if (head - tail \>= ring_.size()) {
            dropped_.fetch_add(1, std::memory_order_relaxed);
            return;
        \}
        ring_[head & mask_] = frame;
        head_.store(head + 1, std::memory_order_release);
        accepted_.fetch_add(1, std::memory_order_relaxed);
    \}

private:
    void run() {
        while (running_.load(std::memory_order_relaxed)) {
            if (!drain()) std::this_thread::sleep_for(std::chrono::milliseconds(2));
        \}
        drain();
    \}

    bool drain() {
        const std::uint64_t head = head_.load(std::memory_order_acquire);
        std::uint64_t tail = tail_.load(std::memory_order_relaxed);
        if (tail == head) return false;
        while (tail != head) {
            const Frame &frame = ring_[tail & mask_];
            write_frame(frame);
            ++tail;
        \}
        tail_.store(tail, std::memory_order_release);
        return true;
    \}

    static void append_varint(std::string &out, std::uint64_t value) {
        while (value \>= 128) {
            out.push_back(static_cast\<char\>((value % 128) + 128));
            value /= 128;
        \}
        out.push_back(static_cast\<char\>(value));
    \}

    static void append_key(std::string &out, std::uint32_t field, std::uint32_t wire) {
        append_varint(out, (static_cast\<std::uint64_t\>(field) * 8) + wire);
    \}

    static void append_bytes(std::string &out, std::uint32_t field, const void *data, std::size_t size) {
        append_key(out, field, 2);
        append_varint(out, size);
        out.append(static_cast\<const char *\>(data), size);
    \}

    static void append_string(std::string &out, std::uint32_t field, const char *value) {
        const char *s = value ? value : "";
        append_bytes(out, field, s, std::strlen(s));
    \}

    static void append_uint(std::string &out, std::uint32_t field, std::uint64_t value) {
        append_key(out, field, 0);
        append_varint(out, value);
    \}

    static void append_i64(std::string &out, std::uint32_t field, std::int64_t value) {
        append_key(out, field, 1);
        out.append(reinterpret_cast\<const char *\>(&value), sizeof(value));
    \}

    static void append_double(std::string &out, std::uint32_t field, double value) {
        append_key(out, field, 1);
        out.append(reinterpret_cast\<const char *\>(&value), sizeof(value));
    \}

    bool write_delimited(const std::string &message) {
        if (!log_) return false;
        prefix_.clear();
        append_varint(prefix_, message.size());
        return std::fwrite(prefix_.data(), 1, prefix_.size(), log_) == prefix_.size()
            && std::fwrite(message.data(), 1, message.size(), log_) == message.size();
    \}

    void write_header(const char *producer_agent_id, const char *activity_id) {
        payload_.clear();
        append_string(payload_, 1, kSchemaHash);
        append_string(payload_, 2, producer_agent_id);
        append_string(payload_, 3, activity_id);
        message_.clear();
        append_bytes(message_, 1, payload_.data(), payload_.size());
        if (!write_delimited(message_)) ++write_errors_;
    \}

    void append_constraint(std::uint32_t field, const ConstraintSlot &slot) {
        slot_.clear();
        append_i64(slot_, 1, slot.active);
        append_double(slot_, 2, slot.error);
        append_double(slot_, 3, slot.output);
        append_i64(slot_, 4, slot.satisfied);
        append_double(slot_, 5, slot.sat_t);
        append_double(slot_, 6, slot.measured);
        append_double(slot_, 7, slot.setpoint);
        append_bytes(payload_, field, slot_.data(), slot_.size());
    \}

    void append_monitor(std::uint32_t field, const MonitorSlot &slot) {
        slot_.clear();
        append_i64(slot_, 1, slot.active);
        append_double(slot_, 2, slot.value);
        append_i64(slot_, 3, slot.satisfied);
        append_double(slot_, 4, slot.sat_t);
        append_bytes(payload_, field, slot_.data(), slot_.size());
    \}

    void append_trigger(std::uint32_t field, const Trigger &slot) {
        slot_.clear();
        append_i64(slot_, 1, slot.kind);
        append_i64(slot_, 2, slot.idx);
        append_i64(slot_, 3, slot.fsm_state);
        append_double(slot_, 4, slot.t);
        append_i64(slot_, 5, slot.wall_ns);
        append_bytes(payload_, field, slot_.data(), slot_.size());
    \}

    void append_pose(std::uint32_t field, const PoseSlot &slot) {
        slot_.clear();
        append_double(slot_, 1, slot.px);
        append_double(slot_, 2, slot.py);
        append_double(slot_, 3, slot.pz);
        append_double(slot_, 4, slot.qx);
        append_double(slot_, 5, slot.qy);
        append_double(slot_, 6, slot.qz);
        append_double(slot_, 7, slot.qw);
        append_bytes(payload_, field, slot_.data(), slot_.size());
    \}

    void append_twist(std::uint32_t field, const TwistSlot &slot) {
        slot_.clear();
        append_double(slot_, 1, slot.lx);
        append_double(slot_, 2, slot.ly);
        append_double(slot_, 3, slot.lz);
        append_double(slot_, 4, slot.ax);
        append_double(slot_, 5, slot.ay);
        append_double(slot_, 6, slot.az);
        append_bytes(payload_, field, slot_.data(), slot_.size());
    \}

    void append_wrench(std::uint32_t field, const WrenchSlot &slot) {
        slot_.clear();
        append_double(slot_, 1, slot.fx);
        append_double(slot_, 2, slot.fy);
        append_double(slot_, 3, slot.fz);
        append_double(slot_, 4, slot.tx);
        append_double(slot_, 5, slot.ty);
        append_double(slot_, 6, slot.tz);
        append_bytes(payload_, field, slot_.data(), slot_.size());
    \}

    void write_frame(const Frame &frame) {
        payload_.clear();
        append_double(payload_, 1, frame.t);
        append_uint(payload_, 2, frame.step);
        append_i64(payload_, 3, frame.fsm_state);
        append_i64(payload_, 4, frame.active_motion);
        append_i64(payload_, 5, frame.last_event);
        append_double(payload_, 6, frame.state_since_t);
        append_i64(payload_, 7, frame.state_since_wall_ns);
        append_double(payload_, 8, frame.event_t);
        append_i64(payload_, 9, frame.event_wall_ns);
        append_i64(payload_, 10, frame.wall_ns);
        append_i64(payload_, 11, frame.period_ns);
        append_i64(payload_, 12, frame.compute_ns);
        <introspection_artifacts.frame_layout.protobuf.fields.constraints:{f|append_constraint(<f.number>, frame.constraints[<f.index>]);}; separator="\n">
        <introspection_artifacts.frame_layout.protobuf.fields.monitors:{f|append_monitor(<f.number>, frame.monitors[<f.index>]);}; separator="\n">
        <introspection_artifacts.frame_layout.protobuf.fields.quantities:{f|append_double(payload_, <f.number>, frame.quantities[<f.index>]);}; separator="\n">
        <introspection_artifacts.frame_layout.protobuf.fields.triggers:{f|append_trigger(<f.number>, frame.triggers[<f.index>]);}; separator="\n">
        append_i64(payload_, 17, frame.trigger_count);
        <introspection_artifacts.frame_layout.protobuf.fields.poses:{f|append_pose(<f.number>, frame.poses[<f.index>]);}; separator="\n">
        <introspection_artifacts.frame_layout.protobuf.fields.twists:{f|append_twist(<f.number>, frame.twists[<f.index>]);}; separator="\n">
        <introspection_artifacts.frame_layout.protobuf.fields.wrenches:{f|append_wrench(<f.number>, frame.wrenches[<f.index>]);}; separator="\n">
        message_.clear();
        append_bytes(message_, 2, payload_.data(), payload_.size());
        if (write_delimited(message_)) {
            ++written_;
        \} else {
            ++write_errors_;
        \}
    \}

    void write_health() {
        std::FILE *health = std::fopen(health_path_.c_str(), "wb");
        if (!health) return;
        const std::uint64_t attempted = attempted_.load(std::memory_order_relaxed);
        const std::uint64_t accepted = accepted_.load(std::memory_order_relaxed);
        const std::uint64_t dropped = dropped_.load(std::memory_order_relaxed);
        std::fprintf(
            health,
            "{\n"
            "  \"attempted_frames\": %llu,\n"
            "  \"accepted_frames\": %llu,\n"
            "  \"written_frames\": %llu,\n"
            "  \"write_errors\": %llu,\n"
            "  \"dropped_frames\": %llu,\n"
            "  \"complete\": %s\n"
            "}\n",
            static_cast\<unsigned long long\>(attempted),
            static_cast\<unsigned long long\>(accepted),
            static_cast\<unsigned long long\>(written_),
            static_cast\<unsigned long long\>(write_errors_),
            static_cast\<unsigned long long\>(dropped),
            (dropped == 0 && accepted == written_ && write_errors_ == 0) ? "true" : "false");
        std::fclose(health);
    \}

    std::vector\<Frame\> ring_;
    std::uint64_t mask_ = 0;
    std::string health_path_;
    std::FILE *log_ = nullptr;
    std::string message_;
    std::string payload_;
    std::string slot_;
    std::string prefix_;
    std::thread writer_;
    std::atomic\<bool\> running_{false};
    std::atomic\<std::uint64_t\> head_{0};
    std::atomic\<std::uint64_t\> tail_{0};
    std::atomic\<std::uint64_t\> attempted_{0};
    std::atomic\<std::uint64_t\> accepted_{0};
    std::atomic\<std::uint64_t\> dropped_{0};
    std::uint64_t written_ = 0;
    std::uint64_t write_errors_ = 0;
};

class RunPublisher {
public:
    RunPublisher()
        : shm_(shm_name()),
          logger_(log_path(), kRuntimeProducerAgentId, kRuntimeActivityId) {}

    void begin_tick(double t, std::uint64_t step, std::int64_t active_motion) {
        begin_tick(t, step, active_motion, active_motion);
    \}

    void begin_tick(double t, std::uint64_t step, std::int64_t active_motion, std::int64_t fsm_state) {
        tick_start_ns_ = steady_time_ns();
        const std::int64_t now = wall_time_ns();
        scratch_ = Frame{};
        scratch_.t = t;
        scratch_.step = step;
        scratch_.fsm_state = fsm_state;
        scratch_.active_motion = active_motion;
        scratch_.last_event = -1;
        scratch_.wall_ns = now;
        scratch_.period_ns = last_tick_ns_ == 0 ? 0 : tick_start_ns_ - last_tick_ns_;
        last_tick_ns_ = tick_start_ns_;
        constraint_count_ = 0;
        monitor_count_ = 0;
    \}

    void constraint_sample(const char *uri, double error, double output, double measured, double setpoint, bool satisfied) {
        static_cast\<void\>(uri);
        if (constraint_count_ \>= kNumConstraints) return;
        ConstraintSlot &slot = scratch_.constraints[constraint_count_++];
        slot.active = 1;
        slot.error = error;
        slot.output = output;
        slot.measured = measured;
        slot.setpoint = setpoint;
        slot.satisfied = satisfied ? 1 : 0;
        slot.sat_t = scratch_.t;
    \}

    void monitor_sample(const char *uri, double value, bool satisfied) {
        static_cast\<void\>(uri);
        if (monitor_count_ \>= kNumMonitors) return;
        MonitorSlot &slot = scratch_.monitors[monitor_count_++];
        slot.active = 1;
        slot.value = value;
        slot.satisfied = satisfied ? 1 : 0;
        slot.sat_t = scratch_.t;
    \}

    void quantity_sample(std::size_t index, double value) {
        if (index \>= kNumQuantities) return;
        scratch_.quantities[index] = value;
    \}

    void pose_sample(std::size_t index, double px, double py, double pz, double qx, double qy, double qz, double qw) {
        if (index \>= kNumPoses) return;
        PoseSlot &s = scratch_.poses[index];
        s.px = px; s.py = py; s.pz = pz; s.qx = qx; s.qy = qy; s.qz = qz; s.qw = qw;
    \}

    void twist_sample(std::size_t index, double lx, double ly, double lz, double ax, double ay, double az) {
        if (index \>= kNumTwists) return;
        TwistSlot &s = scratch_.twists[index];
        s.lx = lx; s.ly = ly; s.lz = lz; s.ax = ax; s.ay = ay; s.az = az;
    \}

    void wrench_sample(std::size_t index, double fx, double fy, double fz, double tx, double ty, double tz) {
        if (index \>= kNumWrenches) return;
        WrenchSlot &s = scratch_.wrenches[index];
        s.fx = fx; s.fy = fy; s.fz = fz; s.tx = tx; s.ty = ty; s.tz = tz;
    \}

    void event_occurrences(std::int64_t event_count, const int *events, std::size_t capacity) {
        if (capacity == 0 || event_count \<= last_event_count_) return;
        std::int64_t start = last_event_count_;
        const std::int64_t oldest = event_count - static_cast\<std::int64_t\>(capacity);
        if (start \< oldest) start = oldest;
        for (std::int64_t count = start; count \< event_count; ++count) {
            append_event(events[count % static_cast\<std::int64_t\>(capacity)]);
        \}
        last_event_count_ = event_count;
    \}

    void append_event(std::int64_t event_idx) {
        if (event_idx \< 0 || kNumTriggers == 0) return;
        const std::int64_t idx = scratch_.trigger_count % static_cast\<std::int64_t\>(kNumTriggers);
        scratch_.last_event = event_idx;
        scratch_.event_t = scratch_.t;
        scratch_.event_wall_ns = wall_time_ns();
        Trigger &trigger = scratch_.triggers[idx];
        trigger.kind = 1;
        trigger.idx = event_idx;
        trigger.fsm_state = scratch_.fsm_state;
        trigger.t = scratch_.t;
        trigger.wall_ns = scratch_.event_wall_ns;
        ++scratch_.trigger_count;
    \}

    void end_tick() {
        scratch_.compute_ns = steady_time_ns() - tick_start_ns_;
        shm_.publish(scratch_);
        logger_.push(scratch_);
    \}

private:
    static std::string log_path() {
        if (const char *env = std::getenv("MOTION_SPEC_FRAME_LOG")) return env;
        return "frame_log.pb";
    \}

    static std::string shm_name() {
        if (const char *env = std::getenv("MOTION_SPEC_SHM_NAME")) return env;
        std::string suffix = kSchemaHash;
        if (suffix.size() > 16) suffix.resize(16);
        return "/motion_spec_" + suffix;
    \}

    Frame scratch_{};
    LatestFramePublisher shm_;
    FrameLogger logger_;
    std::size_t constraint_count_ = 0;
    std::size_t monitor_count_ = 0;
    std::int64_t tick_start_ns_ = 0;
    std::int64_t last_tick_ns_ = 0;
    std::int64_t last_event_count_ = 0;
};

} // namespace motion_spec::introspection
>>

introspection-controller-sample(slot) ::= <<
        pub.constraint_sample(<slot.uri>, <slot.error_expr>, <slot.output_expr>, <slot.measured_expr>, <slot.setpoint_expr>, constraint_satisfied(<slot.error_expr>));
>>

introspection-monitor-sample(slot) ::= <<
        pub.monitor_sample(<slot.uri>, <slot.value_expr>, <slot.satisfied_expr>);
>>

introspection-quantity-sample(slot) ::= <<
    pub.quantity_sample(<slot.index>, <slot.expr>);
>>

introspection-pose-sample(slot) ::= <<
    { double _qx, _qy, _qz, _qw; <slot.expr>.M.GetQuaternion(_qx, _qy, _qz, _qw); pub.pose_sample(<slot.index>, <slot.expr>.p.x(), <slot.expr>.p.y(), <slot.expr>.p.z(), _qx, _qy, _qz, _qw); \}
>>

introspection-twist-sample(slot) ::= <<
    pub.twist_sample(<slot.index>, <slot.expr>.vel.x(), <slot.expr>.vel.y(), <slot.expr>.vel.z(), <slot.expr>.rot.x(), <slot.expr>.rot.y(), <slot.expr>.rot.z());
>>

introspection-wrench-sample(slot) ::= <<
    pub.wrench_sample(<slot.index>, <slot.expr>.force.x(), <slot.expr>.force.y(), <slot.expr>.force.z(), <slot.expr>.torque.x(), <slot.expr>.torque.y(), <slot.expr>.torque.z());
>>

introspection-state-case(state) ::= <<
    case <state.index>:
<state.controllers:{slot | <introspection-controller-sample(slot)>}; separator="\n">
<state.monitors:{slot | <introspection-monitor-sample(slot)>}; separator="\n">
        break;
>>

introspect_model_header(introspection_artifacts) ::= <<
// GENERATED by motion-spec-codegen. Do not edit.
#pragma once

#include "introspection_runtime.hpp"
#include "runtime.hpp"
#include "shared_state.hpp"

#include \<cmath\>
#include \<cstdint\>

namespace motion_spec::introspection {

inline bool constraint_satisfied(double error) {
    return std::abs(error) \<= motion_spec::runtime::kConstraintTolerance;
}

inline void sample_model(RunPublisher &pub, int state_index, int active_motion, double t, std::uint64_t step, shared_data &shared) {
    static_cast\<void\>(shared);
    pub.begin_tick(t, step, active_motion, state_index);
    pub.event_occurrences(
        shared._motion_spec_event_count,
        shared._motion_spec_events,
        shared._motion_spec_event_buffer_size);
<introspection_artifacts.model.quantities:{slot | <introspection-quantity-sample(slot)>}; separator="\n">
<introspection_artifacts.model.poses:{slot | <introspection-pose-sample(slot)>}; separator="\n">
<introspection_artifacts.model.twists:{slot | <introspection-twist-sample(slot)>}; separator="\n">
<introspection_artifacts.model.wrenches:{slot | <introspection-wrench-sample(slot)>}; separator="\n">
    switch (state_index) {
<introspection_artifacts.model.states:{state | <introspection-state-case(state)>}; separator="\n">
    default:
        break;
    \}
    pub.end_tick();
}

} // namespace motion_spec::introspection
>>

// Per-model semantic frame-log wire contract. Field numbers come from the run's schema
// (motion_spec.introspection.artifacts.build_frame_log_proto_fields); the C++ writer in
// module.stg (write_frame) emits the matching numbers, so this .proto decodes logs/frame_log.pb.
frame_log_proto(introspection_artifacts) ::= <<
// SPDX-License-Identifier: MPL-2.0
// GENERATED by motion-spec-codegen from this model's schema. Do not edit.

syntax = "proto3";

package motion_spec.introspection;

message FrameLogHeader {
  string schema_hash = 1;
  string producer_agent_id = 2;
  string activity_id = 3;
}

message ConstraintSlot {
  sfixed64 active = 1;
  double error = 2;
  double output = 3;
  sfixed64 satisfied = 4;
  double sat_t = 5;
  double measured = 6;
  double setpoint = 7;
}

message MonitorSlot {
  sfixed64 active = 1;
  double value = 2;
  sfixed64 satisfied = 3;
  double sat_t = 4;
}

message Trigger {
  sfixed64 kind = 1;
  sfixed64 idx = 2;
  sfixed64 fsm_state = 3;
  double t = 4;
  sfixed64 wall_ns = 5;
}

message PoseSlot {
  double px = 1;
  double py = 2;
  double pz = 3;
  double qx = 4;
  double qy = 5;
  double qz = 6;
  double qw = 7;
}

message TwistSlot {
  double lx = 1;
  double ly = 2;
  double lz = 3;
  double ax = 4;
  double ay = 5;
  double az = 6;
}

message WrenchSlot {
  double fx = 1;
  double fy = 2;
  double fz = 3;
  double tx = 4;
  double ty = 5;
  double tz = 6;
}

message RuntimeFrame {
  double t = 1;
  uint64 step = 2;
  sfixed64 fsm_state = 3;
  sfixed64 active_motion = 4;
  sfixed64 last_event = 5;
  double state_since_t = 6;
  sfixed64 state_since_wall_ns = 7;
  double event_t = 8;
  sfixed64 event_wall_ns = 9;
  sfixed64 wall_ns = 10;
  sfixed64 period_ns = 11;
  sfixed64 compute_ns = 12;
  <introspection_artifacts.frame_layout.protobuf.fields.constraints:{f|ConstraintSlot <f.name> = <f.number>;}; separator="\n">
  <introspection_artifacts.frame_layout.protobuf.fields.monitors:{f|MonitorSlot <f.name> = <f.number>;}; separator="\n">
  <introspection_artifacts.frame_layout.protobuf.fields.quantities:{f|double <f.name> = <f.number>;}; separator="\n">
  <introspection_artifacts.frame_layout.protobuf.fields.triggers:{f|Trigger <f.name> = <f.number>;}; separator="\n">
  sfixed64 trigger_count = 17;
  <introspection_artifacts.frame_layout.protobuf.fields.poses:{f|PoseSlot <f.name> = <f.number>;}; separator="\n">
  <introspection_artifacts.frame_layout.protobuf.fields.twists:{f|TwistSlot <f.name> = <f.number>;}; separator="\n">
  <introspection_artifacts.frame_layout.protobuf.fields.wrenches:{f|WrenchSlot <f.name> = <f.number>;}; separator="\n">
}

message FrameLogRecord {
  oneof record {
    FrameLogHeader header = 1;
    RuntimeFrame frame = 2;
  }
}
>>
