>>

app-headless-print-Quantity-mj_kdl(item) ::= <<
        std::cout \<\< "<item.id>=" \<\< shared.<item.id> \<\< "\n";
>>

cmake_mj_kdl(motions, fsm_namespace) ::= <<
cmake_minimum_required(VERSION 3.16)
project(motion_spec_mj_kdl_target LANGUAGES CXX)

set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)

find_package(Eigen3 REQUIRED)
find_package(orocos_kdl REQUIRED CONFIG)
<if(fsm_namespace)>
find_package(coord2b REQUIRED)
<endif>
find_package(mj_kdl_wrapper 0.2.2 REQUIRED CONFIG)
find_package(Threads REQUIRED)

option(MOTION_SPEC_ENABLE_INTROSPECTION "Enable generated runtime introspection logging" OFF)
set(MOTION_SPEC_MCAP_INCLUDE_DIR "" CACHE PATH "Path to vendored mcap headers (default: motion-spec/thirdparty/mcap/include)")
if(NOT MOTION_SPEC_MCAP_INCLUDE_DIR)
    get_filename_component(_motion_spec_workspace_src "${CMAKE_CURRENT_SOURCE_DIR}/../../../.." ABSOLUTE)
    set(MOTION_SPEC_MCAP_INCLUDE_DIR "${_motion_spec_workspace_src}/motion-spec/thirdparty/mcap/include")
endif()

add_executable(main
    ref_main.cpp
)
target_include_directories(main PRIVATE
    ${EIGEN3_INCLUDE_DIRS}
    ${CMAKE_CURRENT_SOURCE_DIR}
    ${CMAKE_CURRENT_SOURCE_DIR}/headers
<if(fsm_namespace)>
    ${coord2b_INCLUDE_DIRS}
<endif>
)
target_link_libraries(main PRIVATE
    mj_kdl_wrapper::mj_kdl_wrapper
    orocos-kdl
<if(fsm_namespace)>
    ${coord2b_LIBRARIES}
<endif>
)
if(MOTION_SPEC_ENABLE_INTROSPECTION)
    if(NOT EXISTS "${MOTION_SPEC_MCAP_INCLUDE_DIR}/mcap/writer.hpp")
        message(FATAL_ERROR "Vendored MCAP C++ headers not found at ${MOTION_SPEC_MCAP_INCLUDE_DIR}/mcap/writer.hpp. Expected motion-spec/thirdparty/mcap/include; set MOTION_SPEC_MCAP_INCLUDE_DIR to override.")
    endif()
    target_include_directories(main PRIVATE ${MOTION_SPEC_MCAP_INCLUDE_DIR})
    target_compile_definitions(main PRIVATE MOTION_SPEC_ENABLE_INTROSPECTION)
    target_link_libraries(main PRIVATE Threads::Threads)
endif()
target_compile_options(main PRIVATE -Wall -Wextra)
>>
