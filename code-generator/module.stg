access-expr(id, views) ::= <<
<if(views.(id))><view-access-expr(views.(id))><else>shared.<id><endif>
>>

view-access-expr(view) ::= <<
<({view-access-expr-<view.superobject.type>-<view.subspace>})(view)>
>>

view-access-expr-Pose-Position(view) ::= <<
<if(view.axis)>shared.<view.superobject.id>.p[<axis-to-index.(view.axis)>]<else>shared.<view.superobject.id>.p<endif>
>>

view-access-expr-Pose-Rotation(view) ::= <<
<if(view.axis)>KDL::diff(KDL::Rotation::Identity(), shared.<view.superobject.id>.M)[<axis-to-index.(view.axis)>]<else>shared.<view.superobject.id>.M<endif>
>>


view-access-expr-VelocityTwist-AngularVelocity(view) ::= <<
shared.<view.superobject.id>.rot[<axis-to-index.(view.axis)>]
>>

view-access-expr-VelocityTwist-LinearVelocity(view) ::= <<
shared.<view.superobject.id>.vel[<axis-to-index.(view.axis)>]
>>

view-access-expr-AccelerationTwist-AngularAcceleration(view) ::= <<
shared.<view.superobject.id>.rot[<axis-to-index.(view.axis)>]
>>

view-access-expr-AccelerationTwist-LinearAcceleration(view) ::= <<
shared.<view.superobject.id>.vel[<axis-to-index.(view.axis)>]
>>

view-access-expr-PoseDifference-AngularDifference(view) ::= <<
shared.<view.superobject.id>.rot[<axis-to-index.(view.axis)>]
>>

view-access-expr-PoseDifference-LinearDifference(view) ::= <<
shared.<view.superobject.id>.vel[<axis-to-index.(view.axis)>]
>>

view-access-expr-Wrench-Torque(view) ::= <<
<if(view.axis)>shared.<view.superobject.id>.torque[<axis-to-index.(view.axis)>]<else>shared.<view.superobject.id>.torque<endif>
>>

view-access-expr-Wrench-Force(view) ::= <<
<if(view.axis)>shared.<view.superobject.id>.force[<axis-to-index.(view.axis)>]<else>shared.<view.superobject.id>.force<endif>
>>

shared-member(var) ::= <<
<({shared-member-<var.type>})(var)>
>>

indented-shared-member(var) ::= "    <shared-member(var)>"

shared-member-Direction(var) ::= <<
KDL::Vector <var.id><if(var.direction)> = KDL::Vector(<var.direction; separator=", ">)<endif>;
>>

shared-member-Pose(var) ::= <<
KDL::Frame <var.id>;
>>

shared-member-Position(var) ::= <<
KDL::Vector <var.id><if(var.position)> = KDL::Vector(<var.position; separator=", ">)<endif>;
>>

shared-member-Orientation(var) ::= <<
KDL::Rotation <var.id>;
>>

shared-member-FreeVector(var) ::= <<
KDL::Vector <var.id><if(var.vector)> = KDL::Vector(<var.vector; separator=", ">)<endif>;
>>

shared-member-VelocityTwist(var) ::= <<
KDL::Twist <var.id>;
>>

shared-member-AccelerationTwist(var) ::= <<
KDL::Twist <var.id>;
>>

shared-member-PoseDifference(var) ::= <<
KDL::Twist <var.id>;
>>

shared-member-Wrench(var) ::= <<
KDL::Wrench <var.id>;
>>

shared-member-Quantity(var) ::= <<
double <var.id> = <if(var.value)><var.value><else>0.0<endif>;
>>

shared-member-IntCounter(var) ::= <<
int <var.id> = 0;
>>

shared-member-Bool(var) ::= <<
bool <var.id> = false;
>>

shared-member-Trajectory(var) ::= <<
KDL::Frame <var.id>;
>>

controller-member(controller) ::= <<
<({controller-member-<controller.type>})(controller)>
>>

controller-member-ProportionalIntegralDerivative(controller) ::= <<
    motion_spec::runtime::PIDControl <controller.id>{<controller.proportional_gain>, <controller.integral_gain>, <controller.derivative_gain>, <if(controller.decay_rate)><controller.decay_rate><else>0.0<endif>, motion_spec::runtime::kControlPeriodS<if(controller.integral_saturation)>, true, <saturation-lower(controller.integral_saturation)>, <saturation-upper(controller.integral_saturation)><endif>};
>>

controller-member-ImpedanceController(controller) ::= <<
    motion_spec::runtime::ImpedanceControl <controller.id>{<controller.stiffness>, <controller.damping>, <if(controller.integral_gain)><controller.integral_gain><else>0.0<endif>};
>>

controller-member-FeedForwardController(controller) ::= <<
>>

monitor-member(monitor) ::= <<
<if(monitor.is_edge_triggered)>    bool <monitor.id>_previous = false;
    bool <monitor.id>_event_triggered = false;
<if(monitor.debounce_steps)>    int <monitor.id>_hold = 0;
<endif><else>    bool <monitor.flag> = false;<endif>
>>

emit-call(closure, views) ::= <<
<({emit-call-<closure.type>})(closure, views)>
>>

emit-call-AssignmentEvaluator(closure, views) ::= <<
shared.<closure.quantity> = <access-expr(closure.reference_value, views)>;
>>

emit-call-ErrorEvaluator-EqualityConstraint(closure, views) ::= <<
shared.<closure.error> = motion_spec::runtime::evaluate_equality_constraint(<access-expr(closure.reference_value, views)>, <access-expr(closure.quantity, views)>);
>>

emit-call-ErrorEvaluator-GreaterThanConstraint(closure, views) ::= <<
shared.<closure.error> = motion_spec::runtime::evaluate_greater_than_constraint(<access-expr(closure.quantity, views)>, <access-expr(closure.threshold, views)>);
>>

emit-call-ErrorEvaluator-LessThanConstraint(closure, views) ::= <<
shared.<closure.error> = motion_spec::runtime::evaluate_less_than_constraint(<access-expr(closure.quantity, views)>, <access-expr(closure.threshold, views)>);
>>

emit-call-ErrorEvaluator-BilateralConstraint(closure, views) ::= <<
shared.<closure.error> = motion_spec::runtime::evaluate_bilateral_constraint(<access-expr(closure.quantity, views)>, <access-expr(closure.lower_threshold, views)>, <access-expr(closure.upper_threshold, views)>);
>>

emit-call-ErrorEvaluator-OutsideConstraint(closure, views) ::= <<
shared.<closure.error> = motion_spec::runtime::evaluate_outside_constraint(<access-expr(closure.quantity, views)>, <access-expr(closure.lower_threshold, views)>, <access-expr(closure.upper_threshold, views)>);
>>

emit-call-ErrorEvaluator(closure, views) ::= <<
<({emit-call-ErrorEvaluator-<closure.constraint>})(closure, views)>
>>

emit-call-PoseDiffEvaluator(closure, views) ::= <<
shared.<closure.out> = KDL::diff(shared.<closure.in1>, shared.<closure.in2>);
>>

emit-call-Lerp(closure, views) ::= <<
{
    const KDL::Frame _lerp_goal_<closure.trajectory> = <closure.goal_expr>;
<if(closure.assign_goal)>    shared.<closure.goal> = _lerp_goal_<closure.trajectory>;
<endif>    shared.<closure.trajectory> = KDL::addDelta(shared.<closure.start>, KDL::diff(shared.<closure.start>, _lerp_goal_<closure.trajectory>), motion_spec::runtime::<easing-fn.(closure.profile)>(<access-expr(closure.alpha, views)>));
}
>>

emit-call-VelocityProfile(closure, views) ::= <<
{
    if (!state.<closure.controller>.vp_init) {
        state.<closure.controller>.vp_setpoint = <access-expr(closure.measured, views)>;
        state.<closure.controller>.vp_velocity = <if(closure.measured_velocity)><access-expr(closure.measured_velocity, views)><else>0.0<endif>;
        state.<closure.controller>.vp_accel = 0.0;
        state.<closure.controller>.vp_init = true;
    }
    shared.<closure.reference> = motion_spec::runtime::velocity_profile_step(
        state.<closure.controller>.vp_setpoint,
        state.<closure.controller>.vp_velocity,
        state.<closure.controller>.vp_accel,
        <access-expr(closure.goal, views)>,
        <access-expr(closure.max_velocity, views)>,
        <access-expr(closure.max_acceleration, views)>,
        <if(closure.max_jerk)><access-expr(closure.max_jerk, views)><else>0.0<endif>,
        motion_spec::runtime::kControlPeriodS,
        <velocity-profile-shape.(closure.shape)>);
    state.<closure.controller>.vp_setpoint = shared.<closure.reference>;
}
>>

emit-call-Admittance(closure, views) ::= <<
shared.<closure.reference> = state.<closure.controller>.adm_filter.step(<access-expr(closure.force, views)>, <closure.mass>, <closure.damping>, <closure.stiffness>, <closure.max_velocity>, motion_spec::runtime::kControlPeriodS);
>>

emit-call-Circle(closure, views) ::= <<
{
    const double _s_<closure.trajectory>     = motion_spec::runtime::smoothstep(<access-expr(closure.alpha, views)>);
    const double _angle_<closure.trajectory> = 2.0 * M_PI * _s_<closure.trajectory>;
    KDL::Vector _n_<closure.trajectory>   = shared.<closure.plane_normal>;
    _n_<closure.trajectory>.Normalize();
    // Radial arm from center to start: alpha=0 lands exactly on start, and the orbit
    // radius is the in-plane distance between start and center (they may differ freely).
    const KDL::Vector _arm_<closure.trajectory> = shared.<closure.start>.p - shared.<closure.center>;
    const KDL::Vector _pos_<closure.trajectory> = shared.<closure.center>
        + KDL::Rotation::Rot(_n_<closure.trajectory>, _angle_<closure.trajectory>) * _arm_<closure.trajectory>;
    shared.<closure.trajectory> = KDL::Frame(shared.<closure.start>.M, _pos_<closure.trajectory>);
}
>>

emit-call-Arc(closure, views) ::= <<
{
    KDL::Vector _n_<closure.trajectory> = shared.<closure.plane_normal>;
    _n_<closure.trajectory>.Normalize();
    // Circular arc from start to end that bows out of the chord by `amplitude` (the
    // sagitta). center, radius and swept angle are derived so the path begins at start,
    // ends exactly at end, and apexes amplitude away from the chord midpoint.
    // amplitude == |chord|/2 reproduces a clean semicircle (swept angle pi).
    const KDL::Vector _end_<closure.trajectory>   = <closure.end_position_expr>;
    const KDL::Vector _chord_<closure.trajectory> = _end_<closure.trajectory> - shared.<closure.start>.p;
        const double _a_<closure.trajectory>          = shared.<closure.amplitude>;
        const double _chordlen_<closure.trajectory>   = _chord_<closure.trajectory>.Norm();
    // Degenerate input (end == start, or non-positive amplitude) would divide by zero /
    // normalize a zero vector; hold at start instead of emitting NaN.
    KDL::Vector _pos_<closure.trajectory> = shared.<closure.start>.p;
    // _s is 0 in the degenerate case: hold at start orientation too.
    double _s_<closure.trajectory> = 0.0;
    if (_chordlen_<closure.trajectory> > 1e-9 && _a_<closure.trajectory> > 1e-9) {
        const KDL::Vector _chord_hat_<closure.trajectory> = _chord_<closure.trajectory> * (1.0 / _chordlen_<closure.trajectory>);
        const KDL::Vector _mid_<closure.trajectory>       = 0.5 * (shared.<closure.start>.p + _end_<closure.trajectory>);
        const double _m_<closure.trajectory>              = 0.5 * _chordlen_<closure.trajectory>;
        // Cap sagitta to half-chord so the arc stays in the minor-arc (\<=semicircle)
        // regime.  Amplitudes larger than |chord|/2 are silently reduced to a
        // semicircle; if a major arc is ever needed the cap must be lifted and the
        // angle-wrapping handled explicitly.
        const double _sagitta_<closure.trajectory> = std::min(_a_<closure.trajectory>, _m_<closure.trajectory>);
        // Arc-rotation axis: project plane_normal onto the subspace perpendicular to
        // the chord.  This removes any chord-parallel component so that
        // (start - center) is always perpendicular to the axis -- the necessary
        // condition for Rot(axis, angle)*(start-center) to trace a true circle
        // regardless of the angle between chord and plane_normal.
        KDL::Vector _arc_normal_<closure.trajectory> = _n_<closure.trajectory> - KDL::dot(_n_<closure.trajectory>, _chord_hat_<closure.trajectory>) * _chord_hat_<closure.trajectory>;
        if (_arc_normal_<closure.trajectory>.Norm() \< 1e-6) {
            // plane_normal nearly parallel to chord: pick any stable world-axis perp.
            _arc_normal_<closure.trajectory> = motion_spec::runtime::plane_reference(_chord_hat_<closure.trajectory>);
        } else {
            _arc_normal_<closure.trajectory>.Normalize();
        }
        // Sagitta (bulge) direction: in the arc plane, perpendicular to chord.
        // arc_normal x chord_hat lies in the arc plane and is perpendicular to chord_hat.
        KDL::Vector _perp_<closure.trajectory> = _arc_normal_<closure.trajectory> * _chord_hat_<closure.trajectory>;
        _perp_<closure.trajectory>.Normalize();
        const double _R_<closure.trajectory>     = (_sagitta_<closure.trajectory> * _sagitta_<closure.trajectory> + _m_<closure.trajectory> * _m_<closure.trajectory>) / (2.0 * _sagitta_<closure.trajectory>);
        const double _d_<closure.trajectory>     = (_sagitta_<closure.trajectory> * _sagitta_<closure.trajectory> - _m_<closure.trajectory> * _m_<closure.trajectory>) / (2.0 * _sagitta_<closure.trajectory>);
        const KDL::Vector _center_<closure.trajectory> = _mid_<closure.trajectory> + _d_<closure.trajectory> * _perp_<closure.trajectory>;
        const double _theta_<closure.trajectory> = 2.0 * std::acos(std::max(-1.0, std::min(1.0, -_d_<closure.trajectory> / _R_<closure.trajectory>)));
        const KDL::Vector _v0_<closure.trajectory>     = shared.<closure.start>.p - _center_<closure.trajectory>;
        if (state.active_steps == 0) {
            shared.<closure.alpha> = 0.0;
        }
        // Time-based alpha: advance at a fixed arc-speed each control step.
        // The setpoint is fully decoupled from the measured EE pose -- external
        // pushes or admittance excursions do NOT drag the setpoint along with the arm.
        {
            const double _arc_length_<closure.trajectory> = std::max(_R_<closure.trajectory> * _theta_<closure.trajectory>, 1e-9);
            const double _arc_speed_<closure.trajectory>  = 0.05;  // m/s along the arc
            const double _dalpha_<closure.trajectory>     = (_arc_speed_<closure.trajectory> * motion_spec::runtime::kControlPeriodS) / _arc_length_<closure.trajectory>;
            shared.<closure.alpha> = motion_spec::runtime::clamp01(shared.<closure.alpha> + _dalpha_<closure.trajectory>);
        }
        // Apply smoothstep to the open-loop alpha for smooth start/stop easing.
        // This must come AFTER alpha is updated, not before, so the easing is
        // applied to the current step's alpha rather than the previous step's value.
        _s_<closure.trajectory>   = motion_spec::runtime::smoothstep(shared.<closure.alpha>);
        _pos_<closure.trajectory> = _center_<closure.trajectory>
            + KDL::Rotation::Rot(_arc_normal_<closure.trajectory>, -_theta_<closure.trajectory> * _s_<closure.trajectory>) * _v0_<closure.trajectory>;
    }
    const KDL::Frame _rot_start_<closure.trajectory>(shared.<closure.start>.M, KDL::Vector(0.0, 0.0, 0.0));
    const KDL::Frame _rot_goal_<closure.trajectory>(<closure.end_orientation_expr>, KDL::Vector(0.0, 0.0, 0.0));
    const KDL::Rotation _rot_<closure.trajectory> =
        KDL::addDelta(_rot_start_<closure.trajectory>, KDL::diff(_rot_start_<closure.trajectory>, _rot_goal_<closure.trajectory>), _s_<closure.trajectory>).M;
    shared.<closure.trajectory> = KDL::Frame(_rot_<closure.trajectory>, _pos_<closure.trajectory>);
}
>>

emit-call-Helix(closure, views) ::= <<
{
    const double _s_<closure.trajectory>     = motion_spec::runtime::smoothstep(<access-expr(closure.alpha, views)>);
    const double _angle_<closure.trajectory> = shared.<closure.revolutions> * 2.0 * M_PI * _s_<closure.trajectory>;
    const double _rise_<closure.trajectory>  = shared.<closure.pitch> * shared.<closure.revolutions> * _s_<closure.trajectory>;
    KDL::Vector _ax_<closure.trajectory>  = shared.<closure.axis>;
    _ax_<closure.trajectory>.Normalize();
    // Radial arm from center to start: alpha=0 lands exactly on start; the helix winds
    // around the axis through center and rises along it (start and center may differ freely).
    const KDL::Vector _arm_<closure.trajectory> = shared.<closure.start>.p - shared.<closure.center>;
    const KDL::Vector _pos_<closure.trajectory> = shared.<closure.center>
        + KDL::Rotation::Rot(_ax_<closure.trajectory>, _angle_<closure.trajectory>) * _arm_<closure.trajectory>
        + _ax_<closure.trajectory> * _rise_<closure.trajectory>;
    shared.<closure.trajectory> = KDL::Frame(shared.<closure.start>.M, _pos_<closure.trajectory>);
}
>>

emit-call-Figure8(closure, views) ::= <<
<({emit-call-Figure8-<closure.form>})(closure, views)>
>>

emit-call-Figure8-Gerono(closure, views) ::= <<
{
    const double _s_<closure.trajectory> = motion_spec::runtime::smoothstep(<access-expr(closure.alpha, views)>);
    // Phase offset of pi/2 puts alpha=0 at the curve's center crossing (the anchor),
    // so the path starts and ends at the anchor instead of darting out to a tip.
    const double _t_<closure.trajectory> = 2.0 * M_PI * _s_<closure.trajectory> + 0.5 * M_PI;
    KDL::Vector _n_<closure.trajectory>   = shared.<closure.plane_normal>;
    _n_<closure.trajectory>.Normalize();
    const KDL::Vector _u_<closure.trajectory> = motion_spec::runtime::plane_reference(_n_<closure.trajectory>);
    const KDL::Vector _v_<closure.trajectory> = _n_<closure.trajectory> * _u_<closure.trajectory>;
    const double _ct_<closure.trajectory> = std::cos(_t_<closure.trajectory>);
    const double _st_<closure.trajectory> = std::sin(_t_<closure.trajectory>);
    const KDL::Vector _pos_<closure.trajectory> = shared.<closure.anchor>.p
        + shared.<closure.radius> * (_ct_<closure.trajectory> * _u_<closure.trajectory>
            + (_st_<closure.trajectory> * _ct_<closure.trajectory>) * _v_<closure.trajectory>);
    shared.<closure.trajectory> = KDL::Frame(shared.<closure.anchor>.M, _pos_<closure.trajectory>);
}
>>

emit-call-Figure8-Bernoulli(closure, views) ::= <<
{
    const double _s_<closure.trajectory> = motion_spec::runtime::smoothstep(<access-expr(closure.alpha, views)>);
    // Phase offset of pi/2 puts alpha=0 at the curve's center crossing (the anchor),
    // so the path starts and ends at the anchor instead of darting out to a tip.
    const double _t_<closure.trajectory> = 2.0 * M_PI * _s_<closure.trajectory> + 0.5 * M_PI;
    KDL::Vector _n_<closure.trajectory>   = shared.<closure.plane_normal>;
    _n_<closure.trajectory>.Normalize();
    const KDL::Vector _u_<closure.trajectory> = motion_spec::runtime::plane_reference(_n_<closure.trajectory>);
    const KDL::Vector _v_<closure.trajectory> = _n_<closure.trajectory> * _u_<closure.trajectory>;
    const double _ct_<closure.trajectory> = std::cos(_t_<closure.trajectory>);
    const double _st_<closure.trajectory> = std::sin(_t_<closure.trajectory>);
    const double _d_<closure.trajectory>  = 1.0 + _st_<closure.trajectory> * _st_<closure.trajectory>;
    const KDL::Vector _pos_<closure.trajectory> = shared.<closure.anchor>.p
        + shared.<closure.radius> * ((_ct_<closure.trajectory> / _d_<closure.trajectory>) * _u_<closure.trajectory>
            + ((_st_<closure.trajectory> * _ct_<closure.trajectory>) / _d_<closure.trajectory>) * _v_<closure.trajectory>);
    shared.<closure.trajectory> = KDL::Frame(shared.<closure.anchor>.M, _pos_<closure.trajectory>);
}
>>

pose-axis-error-component(component) ::= <<
shared.<component.error> = _pose_axis_error_<component.subspace>_<component.axis>;
>>

pose-axis-error-group(pose_group, views) ::= <<
    {
<if(pose_group.is_pose)><pose-axis-error-group-pose(pose_group, views)><endif>
<if(pose_group.is_twist)><pose-axis-error-group-twist(pose_group, views)><endif>
<if(pose_group.is_wrench)><pose-axis-error-group-wrench(pose_group, views)><endif>
<pose_group.components:{component |         <pose-axis-error-component(component)>}; separator="\n">
    }
>>

pose-axis-error-group-pose(g, views) ::= <<
        KDL::Frame _pose_axis_target_<g.id> = shared.<g.pose>;
<if(g.linear_x)>        _pose_axis_target_<g.id>.p[0] = <access-expr(g.linear_x, views)>;
<endif>
<if(g.linear_y)>        _pose_axis_target_<g.id>.p[1] = <access-expr(g.linear_y, views)>;
<endif>
<if(g.linear_z)>        _pose_axis_target_<g.id>.p[2] = <access-expr(g.linear_z, views)>;
<endif>
<if(g.has_angular)>        const double _pose_axis_roll_<g.id> = <if(g.angular_x)><access-expr(g.angular_x, views)><else>0.0<endif>;
        const double _pose_axis_pitch_<g.id> = <if(g.angular_y)><access-expr(g.angular_y, views)><else>0.0<endif>;
        const double _pose_axis_yaw_<g.id> = <if(g.angular_z)><access-expr(g.angular_z, views)><else>0.0<endif>;
        _pose_axis_target_<g.id>.M = KDL::Rotation::RPY(_pose_axis_roll_<g.id>, _pose_axis_pitch_<g.id>, _pose_axis_yaw_<g.id>);
<endif>
        const KDL::Twist _pose_axis_error_<g.id> = KDL::diff(shared.<g.pose>, _pose_axis_target_<g.id>);
<if(g.linear_x)>        const double _pose_axis_error_linear_X = _pose_axis_error_<g.id>.vel.x();
<endif>
<if(g.linear_y)>        const double _pose_axis_error_linear_Y = _pose_axis_error_<g.id>.vel.y();
<endif>
<if(g.linear_z)>        const double _pose_axis_error_linear_Z = _pose_axis_error_<g.id>.vel.z();
<endif>
<if(g.angular_x)>        const double _pose_axis_error_angular_X = _pose_axis_error_<g.id>.rot.x();
<endif>
<if(g.angular_y)>        const double _pose_axis_error_angular_Y = _pose_axis_error_<g.id>.rot.y();
<endif>
<if(g.angular_z)>        const double _pose_axis_error_angular_Z = _pose_axis_error_<g.id>.rot.z();
<endif>
>>

pose-axis-error-group-twist(g, views) ::= <<
        KDL::Twist _pose_axis_target_<g.id> = KDL::Twist::Zero();
<if(g.linear_x)>        _pose_axis_target_<g.id>.vel[0] = <access-expr(g.linear_x, views)>;
<endif>
<if(g.linear_y)>        _pose_axis_target_<g.id>.vel[1] = <access-expr(g.linear_y, views)>;
<endif>
<if(g.linear_z)>        _pose_axis_target_<g.id>.vel[2] = <access-expr(g.linear_z, views)>;
<endif>
<if(g.angular_x)>        _pose_axis_target_<g.id>.rot[0] = <access-expr(g.angular_x, views)>;
<endif>
<if(g.angular_y)>        _pose_axis_target_<g.id>.rot[1] = <access-expr(g.angular_y, views)>;
<endif>
<if(g.angular_z)>        _pose_axis_target_<g.id>.rot[2] = <access-expr(g.angular_z, views)>;
<endif>
        const KDL::Twist _pose_axis_error_<g.id> = _pose_axis_target_<g.id> - shared.<g.pose>;
<if(g.linear_x)>        const double _pose_axis_error_linear_X = _pose_axis_error_<g.id>.vel.x();
<endif>
<if(g.linear_y)>        const double _pose_axis_error_linear_Y = _pose_axis_error_<g.id>.vel.y();
<endif>
<if(g.linear_z)>        const double _pose_axis_error_linear_Z = _pose_axis_error_<g.id>.vel.z();
<endif>
<if(g.angular_x)>        const double _pose_axis_error_angular_X = _pose_axis_error_<g.id>.rot.x();
<endif>
<if(g.angular_y)>        const double _pose_axis_error_angular_Y = _pose_axis_error_<g.id>.rot.y();
<endif>
<if(g.angular_z)>        const double _pose_axis_error_angular_Z = _pose_axis_error_<g.id>.rot.z();
<endif>
>>

pose-axis-error-group-wrench(g, views) ::= <<
        KDL::Wrench _pose_axis_target_<g.id> = KDL::Wrench::Zero();
<if(g.linear_x)>        _pose_axis_target_<g.id>.force[0] = <access-expr(g.linear_x, views)>;
<endif>
<if(g.linear_y)>        _pose_axis_target_<g.id>.force[1] = <access-expr(g.linear_y, views)>;
<endif>
<if(g.linear_z)>        _pose_axis_target_<g.id>.force[2] = <access-expr(g.linear_z, views)>;
<endif>
<if(g.angular_x)>        _pose_axis_target_<g.id>.torque[0] = <access-expr(g.angular_x, views)>;
<endif>
<if(g.angular_y)>        _pose_axis_target_<g.id>.torque[1] = <access-expr(g.angular_y, views)>;
<endif>
<if(g.angular_z)>        _pose_axis_target_<g.id>.torque[2] = <access-expr(g.angular_z, views)>;
<endif>
        const KDL::Wrench _pose_axis_error_<g.id> = _pose_axis_target_<g.id> - shared.<g.pose>;
<if(g.linear_x)>        const double _pose_axis_error_linear_X = _pose_axis_error_<g.id>.force.x();
<endif>
<if(g.linear_y)>        const double _pose_axis_error_linear_Y = _pose_axis_error_<g.id>.force.y();
<endif>
<if(g.linear_z)>        const double _pose_axis_error_linear_Z = _pose_axis_error_<g.id>.force.z();
<endif>
<if(g.angular_x)>        const double _pose_axis_error_angular_X = _pose_axis_error_<g.id>.torque.x();
<endif>
<if(g.angular_y)>        const double _pose_axis_error_angular_Y = _pose_axis_error_<g.id>.torque.y();
<endif>
<if(g.angular_z)>        const double _pose_axis_error_angular_Z = _pose_axis_error_<g.id>.torque.z();
<endif>
>>

emit-call-Controller(closure, views) ::= <<
{
    const double _control_signal = <if(closure.reference_signal)><access-expr(closure.reference_signal, views)><else>state.<closure.id>.control(<access-expr(closure.error_signal, views)><if(closure.measured_derivative)>, -(<access-expr(closure.measured_derivative, views)>)<endif>)<endif>;
<if(closure.output_saturation)>
    shared.<closure.control_signal> = motion_spec::runtime::clamp_range(_control_signal, <saturation-lower(closure.output_saturation)>, <saturation-upper(closure.output_saturation)>);
<else>
    shared.<closure.control_signal> = _control_signal;
<endif>
<closure.internal_state_samples:{sample |     shared.<sample.id> = state.<closure.id>.<sample.getter>();}; separator="\n">
}
>>

emit-call-PlanarAngleFromDirections(closure, views) ::= <<
shared.<closure.angle> = KDL::dot(<closure.from_directions:{d | <access-expr(d, views)>}; separator=", ">);
>>

emit-call-InvertAngle(closure, views) ::= <<
shared.<closure.out> = -<access-expr(closure.in, views)>;
>>

emit-call-RotateDirectionDistalToProximalWithPose(closure, views) ::= <<
shared.<closure.to> = shared.<closure.pose>.M * <access-expr(closure.from, views)>;
>>

emit-call-ComposePose(closure, views) ::= <<
shared.<closure.composite> = <access-expr(closure.in1, views)> * <access-expr(closure.in2, views)>;
>>

emit-call-InvertPose(closure, views) ::= <<
shared.<closure.out> = shared.<closure.pose>.Inverse();
>>

emit-call-PoseToLinearDistance(closure, views) ::= <<
shared.<closure.distance> = shared.<closure.pose>.p.Norm();
>>

emit-call-PoseToDirection(closure, views) ::= <<
shared.<closure.direction> = shared.<closure.pose>.p;
shared.<closure.direction>.Normalize();
>>

emit-call-PoseToAngleAroundAxis(closure, views) ::= <<
KDL::Vector diff_<closure.angle> = KDL::diff(KDL::Rotation::Identity(), shared.<closure.pose>.M);
shared.<closure.angle> = diff_<closure.angle>[<axis-to-index.(closure.axis)>];
>>

emit-call-RotateVelocityTwistToProximalWithPose(closure, views) ::= <<
shared.<closure.to> = shared.<closure.pose>.M * <access-expr(closure.from, views)>;
>>

emit-call-WrenchFromPositionDirectionAndMagnitude(closure, views) ::= <<
shared.<closure.wrench> = KDL::Wrench(<access-expr(closure.direction, views)> * <access-expr(closure.magnitude, views)>, KDL::Vector(0.0, 0.0, 0.0)).RefPoint(-<access-expr(closure.position, views)>);
>>

emit-call-RotateWrenchToDistalWithPose(closure, views) ::= <<
shared.<closure.to> = shared.<closure.pose>.M.Inverse(<access-expr(closure.from, views)>);
>>

emit-call-RotateWrenchToProximalWithPose(closure, views) ::= <<
shared.<closure.to> = shared.<closure.pose>.M * <access-expr(closure.from, views)>;
>>

emit-call-TransformWrenchToProximal(closure, views) ::= <<
shared.<closure.to> = shared.<closure.pose> * <access-expr(closure.from, views)>;
>>

emit-call-AddQuantity(closure, views) ::= <<
shared.<closure.out> = <access-expr(closure.in1, views)> + <access-expr(closure.in2, views)>;
>>

emit-call-Norm(closure, views) ::= <<
shared.<closure.out> = <access-expr(closure.in1, views)>.Norm();
>>

emit-call-AddWrench(closure, views) ::= <<
shared.<closure.out> = <access-expr(closure.in1, views)> + <access-expr(closure.in2, views)>;
>>

schedule-step(step, closures, views) ::= <<
    // <step>
    <emit-call(closures.(step), views)>
>>

schedule-block(steps, closures, views) ::= <<
<steps:{step | <schedule-step(step, closures, views)>}; separator="\n">
>>

update-monitor(monitor, suppress_initial_active) ::= <<
<if(monitor.active_condition)>
    {
        const bool active = <monitor.active_condition>;
<if(monitor.is_edge_triggered)>
        const bool detected = <if(monitor.debounce_steps)>motion_spec::runtime::sustained_edge(
            state.<monitor.id>_hold,
            active,
            <monitor.debounce_steps>)<else><if(suppress_initial_active)>motion_spec::runtime::rising_edge_after(
            state.<monitor.id>_previous,
            active,
            state.active_steps >= motion_spec::runtime::kMonitorArmSteps)<else>motion_spec::runtime::rising_edge(state.<monitor.id>_previous, active)<endif><endif>;
<if(monitor.fsm_namespace)>
        // coord2b is the sequencer: fire the FSM event on the rising edge while in this state.
        if (detected) {
            shared._motion_spec_record_event(<monitor.fsm_event_idx>);
        \}
        if (detected && robot.fsm_events) {
            produce_event(robot.fsm_events, <monitor.fsm_namespace>::<monitor.event_name>);
            std::cerr \<\< "[fsm] event   " \<\< <monitor.fsm_namespace>::EVENT_URIS[<monitor.fsm_namespace>::<monitor.event_name>] \<\< std::endl;
        \}
<else>
        if (state.active && detected) {
            shared._motion_spec_record_event(<monitor.event_idx>);
            state.<monitor.id>_event_triggered = true;
            motion_spec::runtime::warn_produce_event_not_implemented("<monitor.event>");
        \}
<endif>
<else>
        motion_spec::runtime::set_flag(state.<monitor.flag>, active);
<endif>
    }
<else>
<if(monitor.is_edge_triggered)>
    {
        const bool active = motion_spec::runtime::constraint_satisfied(shared.<monitor.error.id>);
        const bool detected = <if(monitor.debounce_steps)>motion_spec::runtime::sustained_edge(
            state.<monitor.id>_hold,
            active,
            <monitor.debounce_steps>)<else><if(suppress_initial_active)>motion_spec::runtime::rising_edge_after(
            state.<monitor.id>_previous,
            active,
            state.active_steps >= motion_spec::runtime::kMonitorArmSteps)<else>motion_spec::runtime::rising_edge(state.<monitor.id>_previous, active)<endif><endif>;
<if(monitor.fsm_namespace)>
        // coord2b is the sequencer: fire the FSM event on the rising edge while in this state.
        if (detected) {
            shared._motion_spec_record_event(<monitor.fsm_event_idx>);
        \}
        if (detected && robot.fsm_events) {
            produce_event(robot.fsm_events, <monitor.fsm_namespace>::<monitor.event_name>);
            std::cerr \<\< "[fsm] event   " \<\< <monitor.fsm_namespace>::EVENT_URIS[<monitor.fsm_namespace>::<monitor.event_name>] \<\< std::endl;
        \}
<else>
        if (state.active && detected) {
            shared._motion_spec_record_event(<monitor.event_idx>);
            state.<monitor.id>_event_triggered = true;
            motion_spec::runtime::warn_produce_event_not_implemented("<monitor.event>");
        \}
<endif>
    }
<else>
    motion_spec::runtime::set_flag(
        state.<monitor.flag>,
        motion_spec::runtime::constraint_satisfied(shared.<monitor.error.id>));
<endif>
<endif>
>>

monitor-block(monitors, suppress_initial_active) ::= <<
<monitors:{monitor | <update-monitor(monitor, suppress_initial_active)>}; separator="\n\n">
>>

motion-done-condition(motion) ::= <<
<motion.done_condition>
>>

materialize-pose-component(pose) ::= <<
    shared.<pose.id> = KDL::Frame(
        KDL::Rotation::RPY(<pose.orientation_x_expr>, <pose.orientation_y_expr>, <pose.orientation_z_expr>),
        KDL::Vector(<pose.position_x_expr>, <pose.position_y_expr>, <pose.position_z_expr>));
>>

motion-prelude(wrench_outputs, arm_solvers, backend) ::= <<
<wrench_outputs:{wrench | <sync-wrench(wrench)>}; separator="\n">
<if(arm_solvers)>

<arm-prepare-block(arm_solvers, backend)>
<endif>
>>

motion-when-block(steps, closures, views) ::= <<
<if(first(steps))>
<schedule-block(steps, closures, views)>
<endif>
>>

sync-wrench(wrench) ::= <<
    if (robot.<wrench.id> != nullptr) {
        shared.<wrench.id> = *robot.<wrench.id>;
    }
>>

solver-state-struct(solver, backend) ::= <<
struct <solver.id>_solver_state {
    bool initialized = false;
    int num_constraints = 0;
    int num_joints = 0;
    int num_segments = 0;
    KDL::Twist root_acc;
    KDL::JntArray q;
    KDL::JntArray qd;
    KDL::JntArray qdd;
    KDL::JntArray tau_ff;
    KDL::JntArray tau_ctrl;
    KDL::Wrenches f_ext;
    KDL::Jacobian f_cstr;
    KDL::JntArray e_acc;
    std::unique_ptr\<KDL::ChainHdSolver_Vereshchagin_Fext_FixedJoint\> achd_fext;
    std::unique_ptr\<KDL::ChainHdSolver_Vereshchagin_Fixed_Joint\> achd_acc;
<solver-state-struct-extra(solver, backend)>
};
>>

solver-state-struct-extra(solver, backend) ::= <<
<({solver-state-struct-extra-<backend>})(solver)>
>>

solver-state-struct-extra-mj_kdl(solver) ::= <<
    std::unique_ptr\<KDL::ChainIdSolver_RNE\> rnea;
    std::unique_ptr\<KDL::ChainJntToJacSolver\> jac_solver;
    std::unique_ptr\<KDL::ChainJntToJacDotSolver\> jac_dot_solver;
>>

solver-state-struct-extra-robif2b(solver) ::= <<
>>

assign-constraint-force(constraint, solver_state, column) ::= <<
<if(constraint.direction)>
<if(constraint.base_aligned)>
    state.<solver_state>.f_cstr(motion_spec::runtime::constraint_row(motion_spec::runtime::<subspace-to-runtime-subspace.(constraint.subspace)>, motion_spec::runtime::Axis::X), <column>) = shared.<constraint.direction.id>.x();
    state.<solver_state>.f_cstr(motion_spec::runtime::constraint_row(motion_spec::runtime::<subspace-to-runtime-subspace.(constraint.subspace)>, motion_spec::runtime::Axis::Y), <column>) = shared.<constraint.direction.id>.y();
    state.<solver_state>.f_cstr(motion_spec::runtime::constraint_row(motion_spec::runtime::<subspace-to-runtime-subspace.(constraint.subspace)>, motion_spec::runtime::Axis::Z), <column>) = shared.<constraint.direction.id>.z();
<else>
    {
        KDL::Frame alpha_frame_<solver_state>_<column>;
        KDL::ChainFkSolverPos_recursive alpha_fk_<solver_state>_<column>(*robot.<solver_state>.chain);
        alpha_fk_<solver_state>_<column>.JntToCart(
            state.<solver_state>.q,
            alpha_frame_<solver_state>_<column>,
            motion_spec::runtime::find_segment_index(*robot.<solver_state>.chain, "<constraint.as_seen_by.id>"));
        const KDL::Vector alpha_axis_<solver_state>_<column> =
            alpha_frame_<solver_state>_<column>.M * shared.<constraint.direction.id>;
        state.<solver_state>.f_cstr(motion_spec::runtime::constraint_row(motion_spec::runtime::<subspace-to-runtime-subspace.(constraint.subspace)>, motion_spec::runtime::Axis::X), <column>) = alpha_axis_<solver_state>_<column>[0];
        state.<solver_state>.f_cstr(motion_spec::runtime::constraint_row(motion_spec::runtime::<subspace-to-runtime-subspace.(constraint.subspace)>, motion_spec::runtime::Axis::Y), <column>) = alpha_axis_<solver_state>_<column>[1];
        state.<solver_state>.f_cstr(motion_spec::runtime::constraint_row(motion_spec::runtime::<subspace-to-runtime-subspace.(constraint.subspace)>, motion_spec::runtime::Axis::Z), <column>) = alpha_axis_<solver_state>_<column>[2];
    }
<endif>
<else>
<if(constraint.base_aligned)>
    state.<solver_state>.f_cstr(motion_spec::runtime::constraint_row(motion_spec::runtime::<subspace-to-runtime-subspace.(constraint.subspace)>, motion_spec::runtime::Axis::<constraint.axis>), <column>) = 1.0;
<else>
    {
        KDL::Frame alpha_frame_<solver_state>_<column>;
        KDL::ChainFkSolverPos_recursive alpha_fk_<solver_state>_<column>(*robot.<solver_state>.chain);
        alpha_fk_<solver_state>_<column>.JntToCart(
            state.<solver_state>.q,
            alpha_frame_<solver_state>_<column>,
            motion_spec::runtime::find_segment_index(*robot.<solver_state>.chain, "<constraint.as_seen_by.id>"));
        const KDL::Vector alpha_axis_<solver_state>_<column> =
            alpha_frame_<solver_state>_<column>.M * KDL::Vector(<axis-to-vector.(constraint.axis)>);
        state.<solver_state>.f_cstr(motion_spec::runtime::constraint_row(motion_spec::runtime::<subspace-to-runtime-subspace.(constraint.subspace)>, motion_spec::runtime::Axis::X), <column>) = alpha_axis_<solver_state>_<column>[0];
        state.<solver_state>.f_cstr(motion_spec::runtime::constraint_row(motion_spec::runtime::<subspace-to-runtime-subspace.(constraint.subspace)>, motion_spec::runtime::Axis::Y), <column>) = alpha_axis_<solver_state>_<column>[1];
        state.<solver_state>.f_cstr(motion_spec::runtime::constraint_row(motion_spec::runtime::<subspace-to-runtime-subspace.(constraint.subspace)>, motion_spec::runtime::Axis::Z), <column>) = alpha_axis_<solver_state>_<column>[2];
    }
<endif>
<endif>
<if(constraint.saturation)>
    state.<solver_state>.e_acc(<column>) = motion_spec::runtime::clamp_range(shared.<constraint.acceleration_energy.id>, <saturation-lower(constraint.saturation)>, <saturation-upper(constraint.saturation)>);
<else>
    state.<solver_state>.e_acc(<column>) = shared.<constraint.acceleration_energy.id>;
<endif>
>>

// num_constraints=0 is valid for posture-only handlers: Vereshchagin runs
// in unconstrained mode and passes tau_ff through to tau_ctrl unchanged.
// Confirmed correct per KDL implementation; see validation TODO in todo.md.
solver-init(solver, motion_driver, backend) ::= <<
if (!state.<solver.id>.initialized) {
        state.<solver.id>.num_constraints = <if(motion_driver.acceleration_constraint)><length(first(motion_driver.acceleration_constraint).constraints)><else>0<endif>;
        state.<solver.id>.num_joints = robot.<solver.id>.chain->getNrOfJoints();
        state.<solver.id>.num_segments = robot.<solver.id>.chain->getNrOfSegments();
        state.<solver.id>.q = KDL::JntArray(state.<solver.id>.num_joints);
        state.<solver.id>.qd = KDL::JntArray(state.<solver.id>.num_joints);
        state.<solver.id>.qdd = KDL::JntArray(state.<solver.id>.num_joints);
        state.<solver.id>.tau_ff = KDL::JntArray(state.<solver.id>.num_joints);
        state.<solver.id>.tau_ctrl = KDL::JntArray(state.<solver.id>.num_joints);
<if(motion_driver.has_cartesian_force)> 
        state.<solver.id>.f_ext = KDL::Wrenches(state.<solver.id>.num_segments);
<else>
<if(solver.algorithm_is_rne)>        state.<solver.id>.f_ext = KDL::Wrenches(state.<solver.id>.num_segments);
<endif>
<endif>
        state.<solver.id>.f_cstr = KDL::Jacobian(state.<solver.id>.num_constraints);
        state.<solver.id>.e_acc = KDL::JntArray(state.<solver.id>.num_constraints);
<if(solver.gravity)>
        state.<solver.id>.root_acc.vel = KDL::Vector(<solver.gravity; separator=", ">);
<else>
<if(solver.root_acc)>
        state.<solver.id>.root_acc.vel = KDL::Vector(<solver.root_acc; separator=", ">);
<endif>
<endif>
<if(motion_driver.has_cartesian_force)>
        state.<solver.id>.achd_fext = std::make_unique\<KDL::ChainHdSolver_Vereshchagin_Fext_FixedJoint\>(*robot.<solver.id>.chain, state.<solver.id>.root_acc, state.<solver.id>.num_constraints);
<endif>
        state.<solver.id>.achd_acc = std::make_unique\<KDL::ChainHdSolver_Vereshchagin_Fixed_Joint\>(*robot.<solver.id>.chain, state.<solver.id>.root_acc, state.<solver.id>.num_constraints);
<solver-init-extra(solver, backend)>
        state.<solver.id>.initialized = true;
    }
>>

solver-init-extra(solver, backend) ::= <<
<({solver-init-extra-<backend>})(solver)>
>>

solver-init-extra-mj_kdl(solver) ::= <<
        state.<solver.id>.rnea = std::make_unique\<KDL::ChainIdSolver_RNE\>(*robot.<solver.id>.chain, KDL::Vector(<if(solver.root_acc)><solver.root_acc; separator=", "><else>0.0, 0.0, 0.0<endif>));
<if(solver.algorithm_is_rne)>        state.<solver.id>.jac_solver = std::make_unique\<KDL::ChainJntToJacSolver\>(*robot.<solver.id>.chain);
        state.<solver.id>.jac_dot_solver = std::make_unique\<KDL::ChainJntToJacDotSolver\>(*robot.<solver.id>.chain);
<endif>
>>

solver-init-extra-robif2b(solver) ::= <<
>>

solver-sync-input(solver, backend) ::= <<
<({solver-sync-input-<backend>})(solver)>
>>
solver-sync-input-robif2b(solver) ::= <<
for (int i = 0; i \< state.<solver.id>.num_joints; ++i) {
    state.<solver.id>.q(i) = robot.<solver.id>.state->pos_msr[i];
    state.<solver.id>.qd(i) = robot.<solver.id>.state->vel_msr[i];
}
KDL::JntArrayVel q_qd_<solver.id>(state.<solver.id>.q, state.<solver.id>.qd);
>>
solver-sync-input-mj_kdl(solver) ::= <<
mj_kdl::update(robot.<solver.id>.robot);
for (int i = 0; i \< state.<solver.id>.num_joints; ++i) {
    state.<solver.id>.q(i) = robot.<solver.id>.robot->jnt_pos_msr[i];
    state.<solver.id>.qd(i) = robot.<solver.id>.robot->jnt_vel_msr[i];
}
KDL::JntArrayVel q_qd_<solver.id>(state.<solver.id>.q, state.<solver.id>.qd);
>>

solver-output-Pose(solver, out, backend) ::= <<
<({solver-output-Pose-<backend>})(solver, out)>
>>

solver-output-Pose-robif2b(solver, out) ::= <<
{
    KDL::ChainFkSolverPos_recursive fk(*robot.<solver.id>.chain);
    fk.JntToCart(
        state.<solver.id>.q,
        shared.<out.id>,
        motion_spec::runtime::find_segment_index(*robot.<solver.id>.chain, "<out.of.id>"));
}
>>

solver-output-Pose-mj_kdl(solver, out) ::= <<
{
<if(out.of.is_scene_object)>
    KDL::Frame _body_frame_<out.id>;
    if (!mj_kdl::get_body_frame(
            robot.<solver.id>.robot->model,
            robot.<solver.id>.robot->data,
            "<out.of.body>",
            &_body_frame_<out.id>)) {
        throw std::runtime_error("MuJoCo body not found for scene object pose output: <out.of.body>");
    }
    KDL::Frame _base_world_frame_<solver.id>;
    mj_kdl::get_body_frame(
            robot.<solver.id>.robot->model,
            robot.<solver.id>.robot->data,
            "<solver.chain_root>",
            &_base_world_frame_<solver.id>);
    shared.<out.id> = _base_world_frame_<solver.id>.Inverse() * _body_frame_<out.id>;
<else>
    KDL::ChainFkSolverPos_recursive fk(*robot.<solver.id>.chain);
    fk.JntToCart(
        state.<solver.id>.q,
        shared.<out.id>,
        motion_spec::runtime::find_segment_index(*robot.<solver.id>.chain, "<if(out.of.id)><out.of.id><else><solver.chain_end><endif>"));
<endif>
}
>>

solver-output-VelocityTwist(solver, out, backend) ::= <<
{
    KDL::ChainFkSolverVel_recursive fk(*robot.<solver.id>.chain);
    KDL::FrameVel tmp;
    fk.JntToCart(
        q_qd_<solver.id>,
        tmp,
        motion_spec::runtime::find_segment_index(*robot.<solver.id>.chain, "<out.of.id>"));
    shared.<out.id> = tmp.deriv();
}
>>

solver-output-JointPosition(solver, out, backend) ::= <<
<({solver-output-JointPosition-<backend>})(solver, out)>
>>

solver-output-JointPosition-robif2b(solver, out) ::= <<
shared.<out.id> = state.<solver.id>.q(motion_spec::runtime::find_joint_index(*robot.<solver.id>.chain, "<out.joint_name>"));
>>

solver-output-JointPosition-mj_kdl(solver, out) ::= <<
{
    double _joint_position_<out.id> = 0.0;
    if (mj_kdl::get_joint_position(
            robot.<solver.id>.robot->model,
            robot.<solver.id>.robot->data,
            "<out.joint_name>",
            &_joint_position_<out.id>)) {
        shared.<out.id> = _joint_position_<out.id>;
    } else {
        shared.<out.id> = state.<solver.id>.q(motion_spec::runtime::find_joint_index(*robot.<solver.id>.chain, "<out.joint_name>"));
    }
}
>>

solver-output-Wrench(solver, out, backend) ::= <<
<({solver-output-Wrench-<backend>})(solver, out)>
>>

solver-output-Wrench-mj_kdl(solver, out) ::= <<
{
    // FT force -> world, minus startup-tared bias, into shared.<out.id>.force.
    // startup tare assumes constant tool load; per-entry tare if that changes.
    const mj_kdl::ForceTorqueSensor *ft_<out.id> = mj_kdl::find_ft_sensor(robot.<solver.id>.robot, "<out.sensor_name>");
    KDL::Vector f_world_<out.id> = KDL::Vector::Zero();
    if (ft_<out.id> && ft_<out.id>->frame_site_id >= 0) {
        KDL::Frame site_frame_<out.id>;
        if (mj_kdl::get_site_frame(robot.<solver.id>.robot->model, robot.<solver.id>.robot->data, ft_<out.id>->frame_site.c_str(), &site_frame_<out.id>)) {
            f_world_<out.id> = site_frame_<out.id>.M * ft_<out.id>->wrench.force;
        }
    }
    if (shared.<out.id>_ft_settle \< 200) {       // fixed settle; author it if startup transients vary
        ++shared.<out.id>_ft_settle;
        shared.<out.id>_ft_bias = f_world_<out.id>;   // last settle step is the tare sample
        shared.<out.id>.force = KDL::Vector::Zero();
    } else {
        shared.<out.id>.force = shared.<out.id>_ft_bias - f_world_<out.id>;
    }
}
>>

solver-output-Wrench-robif2b(solver, out) ::= <<
    // robif2b has no sim FT sensor; a real build wires a hardware FT driver here.
    shared.<out.id>.force = KDL::Vector::Zero();
>>

solver-output(solver, out, backend) ::= <<
<({solver-output-<out.type>})(solver, out, backend)>
>>

solver-run(solver, motion_driver, backend) ::= <<
    KDL::SetToZero(state.<solver.id>.f_cstr);
<if(motion_driver.acceleration_constraint)>
<first(motion_driver.acceleration_constraint).constraints:{c | <assign-constraint-force(c, solver.id, i0)>}; separator="\n">
<endif>
    KDL::SetToZero(state.<solver.id>.tau_ff);
<motion_driver.joint_force:{jf |     state.<solver.id>.tau_ff(motion_spec::runtime::find_joint_index(*robot.<solver.id>.chain, "<jf.joint_name>")) += shared.<jf.force_id>;}; separator="\n">
<if(motion_driver.has_cartesian_force)>
    for (int i = 0; i \< state.<solver.id>.num_segments; ++i) {
        KDL::SetToZero(state.<solver.id>.f_ext[i]);
    }
<motion_driver.cartesian_force:{f |     <solver-assign-f-ext-modular(solver, f)>}; separator="\n">
<solver-run-fext-pre(solver, motion_driver, backend)>
<else>
<if(solver.algorithm_is_rne)>    for (int i = 0; i \< state.<solver.id>.num_segments; ++i) {
        KDL::SetToZero(state.<solver.id>.f_ext[i]);
    }
<endif>
<endif>
    KDL::Wrenches f_ext_zero_<solver.id>(state.<solver.id>.num_segments);
    for (int i = 0; i \< state.<solver.id>.num_segments; ++i) {
        KDL::SetToZero(f_ext_zero_<solver.id>[i]);
    }
<if(solver.algorithm_is_rne)>
<solver-run-RNE(solver, motion_driver, backend)>
<else>
    KDL::JntArray tau_ctrl_acc_<solver.id>(state.<solver.id>.num_joints);
    state.<solver.id>.achd_acc->CartToJnt(
        state.<solver.id>.q,
        state.<solver.id>.qd,
        state.<solver.id>.qdd,
        state.<solver.id>.f_cstr,
        state.<solver.id>.e_acc,
        <solver-achd-f_ext-arg(solver, motion_driver, backend)>,
        state.<solver.id>.tau_ff,
        tau_ctrl_acc_<solver.id>);
<solver-run-finalize(solver, motion_driver, backend)>
<endif>
>>

solver-run-RNE(solver, motion_driver, backend) ::= <<
<({solver-run-RNE-<backend>})(solver, motion_driver)>
>>

solver-run-RNE-mj_kdl(solver, motion_driver) ::= <<
    KDL::Jacobian jac_<solver.id>(state.<solver.id>.num_joints);
    state.<solver.id>.jac_solver->JntToJac(state.<solver.id>.q, jac_<solver.id>);
    // Task-space velocity-product term Jdot*qdot (base frame, ee ref point):
    // xdd = J*qdd + Jdot*qdot, so subtract it from the desired task accel before
    // resolving qdd. Projected onto the constraint directions to match e_acc.
    KDL::Twist jdot_qd_<solver.id>;
    state.<solver.id>.jac_dot_solver->JntToJacDot(
        KDL::JntArrayVel(state.<solver.id>.q, state.<solver.id>.qd), jdot_qd_<solver.id>);
    Eigen::Matrix\<double, 6, 1\> jdot_qd_vec_<solver.id>;
    jdot_qd_vec_<solver.id> \<\< jdot_qd_<solver.id>.vel.x(), jdot_qd_<solver.id>.vel.y(), jdot_qd_<solver.id>.vel.z(),
                               jdot_qd_<solver.id>.rot.x(), jdot_qd_<solver.id>.rot.y(), jdot_qd_<solver.id>.rot.z();
    const Eigen::VectorXd task_bias_<solver.id> = state.<solver.id>.f_cstr.data.transpose() * jdot_qd_vec_<solver.id>;
    KDL::JntArray qdd_des_<solver.id>(state.<solver.id>.num_joints);
    motion_spec::runtime::resolve_constraint_acceleration(
        jac_<solver.id>,
        state.<solver.id>.f_cstr,
        state.<solver.id>.e_acc,
        &task_bias_<solver.id>,
        motion_spec::runtime::kRneDampingLambda,
        qdd_des_<solver.id>);
    state.<solver.id>.rnea->CartToJnt(
        state.<solver.id>.q,
        state.<solver.id>.qd,
        qdd_des_<solver.id>,
        state.<solver.id>.f_ext,
        state.<solver.id>.tau_ctrl);
    for (int i = 0; i \< state.<solver.id>.num_joints; ++i) {
        state.<solver.id>.tau_ctrl(i) += state.<solver.id>.tau_ff(i);
    }
>>

solver-run-RNE-robif2b(solver, motion_driver) ::= <<
    static_assert(false, "Standalone RNE is only supported on mj_kdl");
>>

solver-run-fext-pre(solver, motion_driver, backend) ::= <<
<({solver-run-fext-pre-<backend>})(solver, motion_driver)>
>>

solver-run-fext-pre-mj_kdl(solver, motion_driver) ::= <<
>>

solver-run-fext-pre-robif2b(solver, motion_driver) ::= <<
    KDL::JntArray qdd_fext_<solver.id>(state.<solver.id>.num_joints);
    KDL::Jacobian alpha_zero_<solver.id>(state.<solver.id>.num_constraints);
    KDL::JntArray beta_zero_<solver.id>(state.<solver.id>.num_constraints);
    KDL::JntArray ff_zero_<solver.id>(state.<solver.id>.num_joints);
    KDL::SetToZero(alpha_zero_<solver.id>);
    KDL::SetToZero(beta_zero_<solver.id>);
    KDL::SetToZero(ff_zero_<solver.id>);
    KDL::JntArray tau_cstr_fext_<solver.id>(state.<solver.id>.num_joints);
    state.<solver.id>.achd_fext->CartToJnt(
        state.<solver.id>.q,
        state.<solver.id>.qd,
        qdd_fext_<solver.id>,
        alpha_zero_<solver.id>,
        beta_zero_<solver.id>,
        state.<solver.id>.f_ext,
        ff_zero_<solver.id>,
        tau_cstr_fext_<solver.id>);
>>

solver-achd-f_ext-arg(solver, motion_driver, backend) ::= <<
<({solver-achd-f_ext-arg-<backend>})(solver, motion_driver)>
>>

solver-achd-f_ext-arg-mj_kdl(solver, motion_driver) ::= <<
<if(motion_driver.has_cartesian_force)>state.<solver.id>.f_ext<else>f_ext_zero_<solver.id><endif>
>>

solver-achd-f_ext-arg-robif2b(solver, motion_driver) ::= <<
f_ext_zero_<solver.id>
>>

solver-run-finalize(solver, motion_driver, backend) ::= <<
<({solver-run-finalize-<backend>})(solver, motion_driver)>
>>

solver-run-finalize-mj_kdl(solver, motion_driver) ::= <<
    state.<solver.id>.rnea->CartToJnt(
        state.<solver.id>.q,
        state.<solver.id>.qd,
        state.<solver.id>.qdd,
        f_ext_zero_<solver.id>,
        state.<solver.id>.tau_ctrl);
>>

solver-run-finalize-robif2b(solver, motion_driver) ::= <<
<if(motion_driver.has_cartesian_force)>
    KDL::Add(tau_cstr_fext_<solver.id>, tau_ctrl_acc_<solver.id>, state.<solver.id>.tau_ctrl);
<else>
    state.<solver.id>.achd_acc->getTotalTorque(state.<solver.id>.tau_ctrl);
<endif>
>>

solver-assign-f-ext-modular(solver, force) ::= <<
state.<solver.id>.f_ext[motion_spec::runtime::find_segment_index(*robot.<solver.id>.chain, "<force.attached_to.id>") - 1] += shared.<force.force.id>;
>>

solver-stage-output(solver, backend) ::= <<
<({solver-stage-output-<backend>})(solver)>
>>
solver-stage-output-robif2b(solver) ::= <<
    for (int i = 0; i \< state.<solver.id>.num_joints; ++i) {
        robot.<solver.id>.state->eff_cmd[i] = state.<solver.id>.tau_ctrl(i);
    }
>>
solver-stage-output-mj_kdl(solver) ::= <<
    for (int i = 0; i \< state.<solver.id>.num_joints; ++i) {
<if(solver.torque_saturation)>        robot.<solver.id>.robot->jnt_trq_cmd[i] = motion_spec::runtime::clamp_range(state.<solver.id>.tau_ctrl(i), <saturation-lower(solver.torque_saturation)>, <saturation-upper(solver.torque_saturation)>);
<else>        robot.<solver.id>.robot->jnt_trq_cmd[i] = state.<solver.id>.tau_ctrl(i);
<endif>
    }
>>

solver-apply-output(solver, backend) ::= <<
<({solver-apply-output-<backend>})(solver)>
>>
solver-apply-output-robif2b(solver) ::= <<
>>
solver-apply-output-mj_kdl(solver) ::= <<
>>

shared-schedule-block(steps, closures, views) ::= <<
<if(first(steps))>
<schedule-block(steps, closures, views)>
<endif>
>>

