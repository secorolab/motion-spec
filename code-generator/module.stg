>>

robot-state-init(solver, backend) ::= <<
<({robot-state-init-<backend>-<solver.robot_model>})(solver)>
>>

robot-init(solver, backend) ::= <<
<({robot-init-<backend>-<solver.robot_model>})(solver)>
>>

