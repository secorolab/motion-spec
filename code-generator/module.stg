>>

arm-stage-block-JointTorque(arm_solvers, backend) ::= <<
<arm_solvers:{solver |     <solver-stage-output(solver, backend)>}; separator="\n">
>>

arm-stage-block(control_mode, arm_solvers, backend) ::= <<
<({arm-stage-block-<control_mode>})(arm_solvers, backend)>
>>

arm-apply-block(arm_solvers, backend) ::= <<
<arm_solvers:{solver |     <solver-apply-output(solver, backend)>}; separator="\n">
>>

