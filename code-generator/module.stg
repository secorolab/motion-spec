>>

command-forwarding-mj_kdl(motion) ::= <<
<motion.forwarded_commands:{cmd | <if(cmd.target)>    {
        const int actuator_id = mj_name2id(robot.<motion.command_robot_id>.robot->model, mjOBJ_ACTUATOR, "<cmd.target>");
        if (actuator_id >= 0) {
            robot.<motion.command_robot_id>.robot->data->ctrl[actuator_id] = shared.<cmd.control_signal.id>;
        \}
    \}
<endif>}; separator="\n">
