// SPDX-License-Identifier: MPL-2.0
// Motion assembly: schedule/monitor blocks, chain/base cycle, per-motion + mobile-base headers.

import "closures.stg"
import "robif2b_backend.stg"
import "shared_data.stg"
import "solver.stg"

schedule-step(step, closures, views) ::= <<
    // <step>
    <emit-call(closures.(step), views)>
>>

schedule-block(steps, closures, views) ::= <<
<steps:{step | <schedule-step(step, closures, views)>}; separator="\n">
>>

// Boolean-condition rendering: fold a list of structured terms into a C++ expression.
// empty -> empty_default; one term -> the term; many -> parenthesized, joined by any/all.
cond-term(t) ::= <<
<({cond-term-<t.kind>})(t)>
>>

cond-term-constraint(t) ::= <<
motion_spec::runtime::constraint_satisfied(shared.<t.error_id>)
>>

cond-term-elapsed(t) ::= <<
(shared.clock_time_s - state.<t.start_field> <t.op> <t.threshold>)
>>

cond-term-elapsed-eq(t) ::= <<
(std::abs((shared.clock_time_s - state.<t.start_field>) - <t.threshold>) \<= <t.tolerance>)
>>

cond-term-flag(t) ::= <<
<t.motion_id>_state_instance.<t.flag>
>>

cond-term-event(t) ::= <<
<t.motion_id>_state_instance.<t.monitor_id>_event_triggered
>>

// Precondition: terms is non-empty (callers render the empty-default literal themselves).
bool-condition(terms, any) ::= <<
<if(rest(terms))>(<if(any)><terms:{t | <cond-term(t)>}; separator=" || "><else><terms:{t | <cond-term(t)>}; separator=" && "><endif>)<else><cond-term(first(terms))><endif>
>>

// Generated-function signature + call-args, built from capability booleans (state/shared/
// robot). Multiline params match the historical layout: leading "\n    ", ",\n    " joins,
// trailing "\n"; empty when no context is needed.
sig-params(mid, needs_state, needs_shared, needs_robot) ::= <<
<if(needs_state)>
    <mid>_state &state<endif><if(needs_shared)><if(needs_state)>,<endif>
    shared_data &shared<endif><if(needs_robot)><if(needs_state||needs_shared)>,<endif>
    const robot_io &robot<endif><if(needs_state||needs_shared||needs_robot)>
<endif>
>>

sig-args(mid, needs_state, needs_shared, needs_robot) ::= <<
<if(needs_state)><mid>_state_instance<endif><if(needs_shared)><if(needs_state)>, <endif>shared<endif><if(needs_robot)><if(needs_state||needs_shared)>, <endif>robot<endif>
>>

update-monitor(monitor, suppress_initial_active) ::= <<
<if(monitor.has_active)>
    {
        const bool active = <if(monitor.active_terms_present)><bool-condition(monitor.active_terms, monitor.active_any)><else>false<endif>;
<if(monitor.is_edge_triggered)>
        const bool detected = <if(monitor.debounce_steps)>motion_spec::runtime::sustained_edge(
            state.<monitor.id>_hold,
            active,
            <monitor.debounce_steps>)<else><if(suppress_initial_active)>motion_spec::runtime::rising_edge_after(
            state.<monitor.id>_previous,
            active,
            state.active_steps >= motion_spec::runtime::kMonitorArmSteps)<else>motion_spec::runtime::rising_edge(state.<monitor.id>_previous, active)<endif><endif>;
<monitor-ros-publish(monitor)>
<if(monitor.fsm_namespace)>
        // coord2b is the sequencer: fire the FSM event on the rising edge while in this state.
        if (detected) {
            shared._motion_spec_record_event(<monitor.fsm_event_idx>);
        \}
        if (detected && robot.fsm_events) {
            produce_event(robot.fsm_events, <monitor.fsm_namespace>::<monitor.event_name>);
            std::cerr \<\< "[fsm] event   " \<\< <monitor.fsm_namespace>::EVENT_URIS[<monitor.fsm_namespace>::<monitor.event_name>] \<\< std::endl;
        \}
<else>
        if (state.active && detected) {
            shared._motion_spec_record_event(<monitor.event_idx>);
            state.<monitor.id>_event_triggered = true;
            motion_spec::runtime::warn_produce_event_not_implemented("<monitor.event>");
        \}
<endif>
<else>
        motion_spec::runtime::set_flag(state.<monitor.flag>, active);
<endif>
    }
<else>
<if(monitor.is_edge_triggered)>
    {
        const bool active = motion_spec::runtime::constraint_satisfied(shared.<monitor.error.id>);
        const bool detected = <if(monitor.debounce_steps)>motion_spec::runtime::sustained_edge(
            state.<monitor.id>_hold,
            active,
            <monitor.debounce_steps>)<else><if(suppress_initial_active)>motion_spec::runtime::rising_edge_after(
            state.<monitor.id>_previous,
            active,
            state.active_steps >= motion_spec::runtime::kMonitorArmSteps)<else>motion_spec::runtime::rising_edge(state.<monitor.id>_previous, active)<endif><endif>;
<monitor-ros-publish(monitor)>
<if(monitor.fsm_namespace)>
        // coord2b is the sequencer: fire the FSM event on the rising edge while in this state.
        if (detected) {
            shared._motion_spec_record_event(<monitor.fsm_event_idx>);
        \}
        if (detected && robot.fsm_events) {
            produce_event(robot.fsm_events, <monitor.fsm_namespace>::<monitor.event_name>);
            std::cerr \<\< "[fsm] event   " \<\< <monitor.fsm_namespace>::EVENT_URIS[<monitor.fsm_namespace>::<monitor.event_name>] \<\< std::endl;
        \}
<else>
        if (state.active && detected) {
            shared._motion_spec_record_event(<monitor.event_idx>);
            state.<monitor.id>_event_triggered = true;
            motion_spec::runtime::warn_produce_event_not_implemented("<monitor.event>");
        \}
<endif>
    }
<else>
    motion_spec::runtime::set_flag(
        state.<monitor.flag>,
        motion_spec::runtime::constraint_satisfied(shared.<monitor.error.id>));
<endif>
<endif>
>>

// RT-safe publish of the monitored condition: non-blocking trylock, the RealtimePublisher's
// own thread does the DDS publish. Skips the cycle if the publisher thread holds the lock.
monitor-ros-publish(monitor) ::= <<
<if(monitor.ros_channel)>
        if (robot.<monitor.ros_pub_id> && robot.<monitor.ros_pub_id>->trylock()) {
            robot.<monitor.ros_pub_id>->msg_.value =
                active ? <monitor.ros_cpp_type>::TRUE : <monitor.ros_cpp_type>::FALSE;
            robot.<monitor.ros_pub_id>->unlockAndPublish();
        \}
<endif>
>>

monitor-block(monitors, suppress_initial_active) ::= <<
<monitors:{monitor | <update-monitor(monitor, suppress_initial_active)>}; separator="\n\n">
>>

motion-done-condition(motion) ::= <<
<if(motion.done_terms_present)><bool-condition(motion.done_terms, motion.until_any)><else>true<endif>
>>

component-value(comp, views) ::= <<
<if(comp.ref)><access-expr(comp.ref, views)><else><comp.value><endif>
>>

pose-frame-inline(pose, views) ::= <%
KDL::Frame(KDL::Rotation::RPY(<component-value(pose.orientation_x, views)>, <component-value(pose.orientation_y, views)>, <component-value(pose.orientation_z, views)>), KDL::Vector(<component-value(pose.position_x, views)>, <component-value(pose.position_y, views)>, <component-value(pose.position_z, views)>))
%>

materialize-pose-component(pose, views) ::= <<
    shared.<pose.id> = KDL::Frame(
        KDL::Rotation::RPY(<component-value(pose.orientation_x, views)>, <component-value(pose.orientation_y, views)>, <component-value(pose.orientation_z, views)>),
        KDL::Vector(<component-value(pose.position_x, views)>, <component-value(pose.position_y, views)>, <component-value(pose.position_z, views)>));
>>

motion-prelude(wrench_outputs, serial_chain_solvers, backend) ::= <<
<wrench_outputs:{wrench | <sync-wrench(wrench)>}; separator="\n">
<if(serial_chain_solvers)>

<chain-prepare-block(serial_chain_solvers, backend)>
<endif>
>>

motion-when-block(steps, closures, views) ::= <<
<if(first(steps))>
<schedule-block(steps, closures, views)>
<endif>
>>

shared-schedule-block(steps, closures, views) ::= <<
<if(first(steps))>
<schedule-block(steps, closures, views)>
<endif>
>>

wrench-pointer-member(wrench) ::= <<
    KDL::Wrench *<wrench.id> = nullptr;
>>

wrench-measurement(wrench) ::= <<
    KDL::Wrench <wrench.id>_measurement;
>>

chain-robot-member(solver) ::= <<
    manipulator_robot <solver.id>;
>>

motion-state-member(motion) ::= <<
    <motion.id>_state <motion.id>_state_instance;
>>

motion-include(motion) ::= <<
#include "<motion.id>.hpp"
>>

mobile-base-cycle-include() ::= <<
#include "mobile_base_cycle.hpp"
>>

app-prepare-call(motion) ::= <<
        update_<motion.id>(<motion.id>_state_instance, shared, robot);
>>

app-run-call(motion) ::= <<
        if (!<motion.id>_state_instance.active && can_start_<motion.id>(<sig-args(motion.id, motion.can_start_needs_state, motion.can_start_needs_shared, motion.can_start_needs_robot)>)) {
            <motion.id>_state_instance.active = true;
            <motion.id>_state_instance.active_steps = 0;
<motion.progress_constraints:{entry |             shared.<entry.parameter> = 0.0;}; separator="\n">
<motion.until_monitors:{m |             <motion.id>_state_instance.<m.id>_previous = false;
            <motion.id>_state_instance.<m.id>_event_triggered = false;}; separator="
">
        \}
        if (<motion.id>_state_instance.active) {
            control_<motion.id>(<motion.id>_state_instance, shared, robot);
        \}
>>

progress-block(entries) ::= <<
<entries:{entry |     shared.<entry.parameter> = motion_spec::runtime::path_progress_step(
        shared.<entry.parameter>,
        <entry.errors:{error | motion_spec::runtime::constraint_satisfied(shared.<error>)}; separator=" && ">,
        <entry.advancement>,
        motion_spec::runtime::kControlPeriodS);}; separator="\n">
>>

app-stage-call(motion) ::= <<
        if (<motion.id>_state_instance.active) {
            apply_<motion.id>(<sig-args(motion.id, motion.apply_needs_state, motion.apply_needs_shared, motion.apply_needs_robot)>);
<if(motion.has_until_condition)>
            // TODO: replace this temporary event latch bridge with real event-driven FSM transitions.
            if (<motion.id>_state_instance.active_steps > 0 && (<motion-done-condition(motion)>)) {
                <motion.id>_state_instance.active = false;
            \}
<else>
            <motion.id>_state_instance.active = false;
<endif>
            ++<motion.id>_state_instance.active_steps;
        \}
>>

app-base-control-call(has_mobile_base) ::= <<
<if(has_mobile_base)>
        control_mobile_base(mobile_base_state_instance, shared, robot);
<endif>
>>

base-force-solver-hddc2b_example_frc_sc1(solver) ::= <<
hddc2b_pltf_drv_algn_dst(NUM_DRIVES, mobile_base.drive_attachment, mobile_base.w_align, kelo_msr.pvt_pos, mobile_base.f_platform, &mobile_base.f_drive_ref[1], 2);
hddc2b_pltf_frc_pltf_to_drv(NUM_DRIVES, EPS, mobile_base.g, mobile_base.w_platform, mobile_base.f_platform, mobile_base.w_drive, mobile_base.f_drive_ref, mobile_base.f_prim, mobile_base.f_scnd);
motion_spec::runtime::hddc2b_rescale(mobile_base.f_scnd);
hddc2b_pltf_frc_redu_ref_fini(NUM_DRIVES, mobile_base.f_prim, mobile_base.f_scnd, mobile_base.f_drive);
hddc2b_drv_frc_pvt_to_gnd(NUM_DRIVES, mobile_base.wheel_distance, mobile_base.castor_offset, mobile_base.f_drive, mobile_base.f_wheel);
hddc2b_whl_frc_gnd_to_hub(NUM_DRIVES, mobile_base.wheel_diameter, mobile_base.f_wheel, kelo_cmd.trq);
>>

base-force-solver-hddc2b_example_frc_sc2(solver) ::= <<
hddc2b_pltf_drv_algn_dst(NUM_DRIVES, mobile_base.drive_attachment, mobile_base.w_align, kelo_msr.pvt_pos, mobile_base.f_platform, &mobile_base.f_drive[1], 2);
hddc2b_drv_frc_pvt_to_gnd(NUM_DRIVES, mobile_base.wheel_distance, mobile_base.castor_offset, mobile_base.f_drive, mobile_base.f_wheel);
hddc2b_whl_frc_gnd_to_hub(NUM_DRIVES, mobile_base.wheel_diameter, mobile_base.f_wheel, kelo_cmd.trq);
>>

base-force-solver(solver) ::= <<
<({base-force-solver-<solver.configuration>})(solver)>
>>

base-cycle-begin(base_velocity_solvers) ::= <<
    {
        auto &mobile_base = shared.mobile_base;
        auto &ecat = *robot.mobile_base.ethercat;
        auto &drive_enc = *robot.mobile_base.drive_encoder;
        auto &kelo_msr = *robot.mobile_base.measurement;

        <robif2b-update-ethercat()>
        <robif2b-update-kelo-encoder()>
        hddc2b_pltf_frc_comp_mat(NUM_DRIVES, mobile_base.drive_attachment, kelo_msr.pvt_pos, mobile_base.g);
<base_velocity_solvers:{solver |

        hddc2b_whl_vel_hub_to_gnd(NUM_DRIVES, mobile_base.wheel_diameter, kelo_msr.whl_vel, mobile_base.xd_ground);
        hddc2b_drv_vel_gnd_to_pvt(NUM_DRIVES, mobile_base.wheel_distance, mobile_base.castor_offset, mobile_base.xd_ground, mobile_base.xd_drive);
        motion_spec::runtime::hddc2b_pltf_vel_drv_to_pltf(NUM_DRIVES, EPS, mobile_base.g, mobile_base.w_drive, mobile_base.xd_drive, mobile_base.w_platform, mobile_base.xd_platform);
        shared.<solver.velocity.id>.vel.x(mobile_base.xd_platform[0]);
        shared.<solver.velocity.id>.vel.y(mobile_base.xd_platform[1]);
        shared.<solver.velocity.id>.rot.z(mobile_base.xd_platform[2]);
}; separator="\n">
    }
>>

base-cycle-force(base_force_solvers) ::= <<
    {
        auto &mobile_base = shared.mobile_base;
        auto &kelo_msr = *robot.mobile_base.measurement;
        auto &kelo_cmd = *robot.mobile_base.command;
<base_force_solvers:{solver |

        mobile_base.f_platform[0] = shared.<solver.force.id>.force.x();
        mobile_base.f_platform[1] = shared.<solver.force.id>.force.y();
        mobile_base.f_platform[2] = shared.<solver.force.id>.torque.z();
        <base-force-solver(solver)>
}; separator="\n">
    }
>>

chain-solver-members(serial_chain_solvers, backend) ::= <<
<serial_chain_solvers:{solver | <solver-state-struct(solver, backend)>}; separator="\n\n">
>>

chain-state-members(serial_chain_solvers) ::= <<
<serial_chain_solvers:{solver |     <solver.id>_solver_state <solver.id>;}; separator="\n">
>>

chain-init-block(serial_chain_solvers, backend) ::= <<
<serial_chain_solvers:{solver |     <solver-init(solver, solver.motion_driver, backend)>}; separator="\n">
>>

chain-prepare-block(serial_chain_solvers, backend) ::= <<
<serial_chain_solvers:{solver |
    <solver-sync-input(solver, backend)>
    <solver.output:{out | <solver-output(solver, out, backend)>}; separator="\n\n">
}; separator="\n\n">
>>

chain-run-block(serial_chain_solvers, backend) ::= <<
<serial_chain_solvers:{solver |     <solver-run(solver, solver.motion_driver, backend)>}; separator="\n">
>>

chain-stage-block(serial_chain_solvers, backend) ::= <<
<serial_chain_solvers:{solver |     <solver-stage-output(solver, backend)>}; separator="\n">
>>

chain-apply-block(serial_chain_solvers, backend) ::= <<
<serial_chain_solvers:{solver |     <solver-apply-output(solver, backend)>}; separator="\n">
>>

command-forwarding(backend, motion) ::= <<
<({command-forwarding-<backend>})(motion)>
>>

command-forwarding-robif2b(motion) ::= <<
>>

command-forwarding-mj_kdl(motion) ::= <<
<motion.forwarded_commands:{cmd | <if(cmd.target)>    {
        const mjModel *model = robot.<cmd.robot_id>.robot->model;
        int actuator_id = mj_name2id(model, mjOBJ_ACTUATOR, "<cmd.target>");
        const int joint_id = mj_name2id(model, mjOBJ_JOINT, "<cmd.target>");
        for (int i = 0; actuator_id \< 0 && joint_id >= 0 && i \< model->nu; ++i) {
            if (model->actuator_trntype[i] == mjTRN_JOINT
                && model->actuator_trnid[2 * i] == joint_id) actuator_id = i;
        \}
        if (actuator_id >= 0) {
            robot.<cmd.robot_id>.robot->data->ctrl[actuator_id] = shared.<cmd.control_signal.id>;
        \}
    \}
<endif>}; separator="\n">
>>

mobile_base_cycle_header(has_mobile_base, platform_velocity_solvers, platform_force_solvers) ::= <<
#pragma once

#include "shared_state.hpp"

<if(has_mobile_base)>
struct mobile_base_state {
    bool initialized = false;
};

inline void reset_mobile_base(mobile_base_state &state) {
    state = mobile_base_state{};
}

inline void init_mobile_base(mobile_base_state &state, shared_data &shared, const robot_io &robot) {
    state.initialized = true;
}

inline void update_mobile_base(
    mobile_base_state &state,
    shared_data &shared,
    const robot_io &robot) {
    init_mobile_base(state, shared, robot);
<base-cycle-begin(platform_velocity_solvers)>
}

inline void control_mobile_base(
    mobile_base_state &state,
    shared_data &shared,
    const robot_io &robot) {
<base-cycle-force(platform_force_solvers)>
}

inline void apply_mobile_base(
    mobile_base_state &state,
    shared_data &shared,
    const robot_io &robot) {
    auto &wheel_act = *robot.mobile_base.wheel_actuator;
    <robif2b-update-kelo-driver()>
}
<endif>
>>

emit-relative-pose(rp) ::= <<
    if (!state.<rp.id>_start_captured) {
        state.<rp.id>_start_frame = shared.<rp.fk_pose_id>;
        state.<rp.id>_start_captured = true;
    }
    shared.<rp.id> = state.<rp.id>_start_frame.Inverse() * shared.<rp.fk_pose_id>;
>>

emit-snapshot(snap, closures, views) ::= <<
<if(snap.source_closure_id)>
        <({emit-call-<closures.(snap.source_closure_id).type>})(closures.(snap.source_closure_id), views)>
<endif>
        shared.<snap.target_id> = <access-expr(snap.source_id, views)>;
>>

// An event-triggered snapshot re-samples on every occurrence of its trigger. The FSM fires
// the event into the future buffer as it transitions, so it is readable for exactly the one
// tick that is this motion's first after entry.
emit-triggered-snapshot(snap, closures, views) ::= <<
<if(snap.trigger_event)>

    if (robot.fsm_events && consume_event(robot.fsm_events, <snap.fsm_namespace>::<snap.trigger_event>)) {
    <emit-snapshot(snap, closures, views)>
    \}
<endif>
>>

motion_header(motion, closures, views, wrench_outputs, platform_velocity_solvers, platform_force_solvers, has_mobile_base, backend, declared_pose_components, pose_axis_error_groups) ::= <<
/// Motion: <motion.name>
<if(motion.description)>/// <motion.description>
<endif>
#pragma once

#include "runtime.hpp"
#include "shared_state.hpp"

struct <motion.id>_state {
    bool active = false;
    int active_steps = 0;
<if(motion.has_active_elapsed)>    double motion_start_time = -1.0;
<endif>
<if(motion.has_when_elapsed)>    double when_start_time = -1.0;
<endif>
<chain-state-members(motion.serial_chain_solvers)>
<if(motion.snapshots)>    bool snapshot_taken = false;
<endif>
<motion.relative_poses:{rp |     KDL::Frame <rp.id>_start_frame;
    bool <rp.id>_start_captured = false;
}; separator="\n">
<motion.controllers:{controller | <controller-member(controller)>}; separator="\n">
<motion.when_monitors:{monitor | <monitor-member(monitor)>}; separator="\n">
<motion.while_monitors:{monitor | <monitor-member(monitor)>}; separator="\n">
<motion.until_monitors:{monitor | <monitor-member(monitor)>}; separator="\n">
};

inline void reset_<motion.id>(<motion.id>_state &state) {
    state = <motion.id>_state{};
}

inline void init_<motion.id>(<motion.id>_state &state, const robot_io &robot) {
<if(motion.serial_chain_solvers)>
<chain-init-block(motion.serial_chain_solvers, backend)>
<endif>
}

inline void update_<motion.id>(
    <motion.id>_state &state,
    shared_data &shared,
    const robot_io &robot) {
    init_<motion.id>(state, robot);
<if(motion.has_active_elapsed)>    if (state.motion_start_time \< 0.0) {
        state.motion_start_time = shared.clock_time_s;
    }
<endif>
<motion-prelude(wrench_outputs, motion.serial_chain_solvers, backend)>
<motion.relative_poses:{rp | <emit-relative-pose(rp)>}; separator="\n">
<motion.scene_relative_poses:{srp |
<if(srp.base_seen)>    shared.<srp.id> = KDL::Frame(shared.<srp.fk_pose_id>.M, shared.<srp.fk_pose_id>.p - shared.<srp.scene_pose_id>.p);
<else>    shared.<srp.id> = shared.<srp.scene_pose_id>.Inverse() * shared.<srp.fk_pose_id>;
<endif>
}; separator="\n">
<if(motion.snapshots)>
    if (!state.snapshot_taken) {
<motion.snapshots:{snap | <emit-snapshot(snap, closures, views)>}; separator="\n">
        state.snapshot_taken = true;
    }
<motion.snapshots:{snap | <emit-triggered-snapshot(snap, closures, views)>}; separator="">
<endif>
<declared_pose_components:{pose | <materialize-pose-component(pose, views)>}; separator="\n">
}

inline bool can_start_<motion.id>(<sig-params(motion.id, motion.can_start_needs_state, motion.can_start_needs_shared, motion.can_start_needs_robot)>) {
<if(motion.has_when_elapsed)>    if (state.when_start_time \< 0.0) {
        state.when_start_time = shared.clock_time_s;
    }
<endif>
<motion-when-block(motion.when_schedule, closures, views)>
    return <if(motion.when_terms_present)><bool-condition(motion.when_terms, motion.when_any)><else>true<endif>;
}

inline void monitor_when_<motion.id>(<sig-params(motion.id, motion.when_needs_state, motion.when_needs_shared, motion.when_needs_robot)>) {
<if(motion.has_when_elapsed)>    if (state.when_start_time \< 0.0) {
        state.when_start_time = shared.clock_time_s;
    }
<endif>
<declared_pose_components:{pose | <materialize-pose-component(pose, views)>}; separator="\n">
<shared-schedule-block(motion.when_schedule, closures, views)>
<if(first(motion.when_monitors))>
<monitor-block(motion.when_monitors, false)>
<endif>
}

inline void monitor_until_<motion.id>(<sig-params(motion.id, motion.until_needs_state, motion.until_needs_shared, motion.until_needs_robot)>) {
<shared-schedule-block(motion.until_schedule, closures, views)>
<if(first(motion.until_monitors))>
<monitor-block(motion.until_monitors, false)>
<endif>
}

inline void monitor_<motion.id>(<sig-params(motion.id, motion.monitor_needs_state, motion.monitor_needs_shared, motion.monitor_needs_robot)>) {
<shared-schedule-block(motion.when_schedule, closures, views)>
<if(first(motion.when_monitors))>
<monitor-block(motion.when_monitors, false)>
<endif>
<shared-schedule-block(motion.until_schedule, closures, views)>
<if(first(motion.until_monitors))>
<monitor-block(motion.until_monitors, false)>
<endif>
}

inline void control_<motion.id>(
    <motion.id>_state &state,
    shared_data &shared,
    const robot_io &robot) {
<shared-schedule-block(motion.while_pre_schedule, closures, views)>
<pose_axis_error_groups:{group | <pose-axis-error-group(group, views)>}; separator="\n">
<shared-schedule-block(motion.while_schedule, closures, views)>
<if(first(motion.while_monitors))>

<monitor-block(motion.while_monitors, true)>
<endif>
<if(motion.serial_chain_solvers)>

<chain-run-block(motion.serial_chain_solvers, backend)>
<endif>
<if(first(motion.progress_constraints))>
<progress-block(motion.progress_constraints)>
<endif>
}

inline void apply_<motion.id>(<sig-params(motion.id, motion.apply_needs_state, motion.apply_needs_shared, motion.apply_needs_robot)>) {
<if(motion.serial_chain_solvers)>
<chain-stage-block(motion.serial_chain_solvers, backend)>
<chain-apply-block(motion.serial_chain_solvers, backend)>
<endif>
<command-forwarding(backend, motion)>
}
>>
