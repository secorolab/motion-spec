// SPDX-License-Identifier: MPL-2.0
// motion-spec codegen, as it is today. Measured on pick_place_single.
digraph current {
  rankdir=LR
  compound=true
  fontname="Helvetica" labelloc=t labeljust=l
  label=<<b>current — templates</b><br align="left"/>
        <font point-size="10">350 rules · one flat namespace · 24 IR keys · 179 pass-through params · 66 dead params</font><br align="left"/>>
  node [fontname="Helvetica" fontsize=10 shape=box style=filled]
  edge [fontname="Helvetica" fontsize=9]

  subgraph cluster_gen {
    label="ir_gen (rdf_parser/ir.py, 7.9k lines)" style=filled fillcolor="#f4f4f4"
    graph_ [label="RDF app graph" fillcolor="#dbe7f5"]
    build  [label="build_motion_units\nbuild_pose_components\nannotate_dataflow\n…" fillcolor="#dbe7f5"]
    graph_ -> build
  }

  // ---- the interface: one flat JSON object, every key a sibling ----
  subgraph cluster_ir {
    label="ir.json — the ir_gen/codegen interface: 24 flat sibling keys, 4.2 MiB" style=filled fillcolor="#fff6e0"
    node [shape=record fillcolor="#ffe9b8"]
    live   [label="{live|motions|closures|views|shared_data|wrench_outputs|serial_chain_solvers|backend|fsm|ros|mobile_base|platform|scene|trace|introspection|control_period_ns|needs_clock_time|has_serial_chain}"]
    dead   [label="{read by nothing|cstr_hdl  203 KiB|data  171 KiB|pose_components|declared_pose_components|schedule|shared_schedule}" fillcolor="#f8c8c8"]
    dupe   [label="{duplicated|uris  1054 KiB\n== introspection.uris}" fillcolor="#f8c8c8"]
  }
  build -> live [lhead=cluster_ir label="write"]

  // ---- renderers ----
  subgraph cluster_cg {
    label="codegen.py — 12 render calls" style=filled fillcolor="#f4f4f4"
    cg [label="generate_code()" fillcolor="#dbe7f5"]
    pm [label="per-motion payload\nre-serializes closures+views\nonce per motion (1.4 MiB)" fillcolor="#f8c8c8"]
    cg -> pm
  }
  live -> cg [ltail=cluster_ir label="read"]

  // ---- templates: one flat namespace, imports inert ----
  subgraph cluster_tpl {
    label="templates/*.stg — 11 files, but -t <dir> makes ONE flat namespace (imports inert)"
    style=filled fillcolor="#eef7ee"
    node [fillcolor="#cfe8cf"]
    main_  [label="main.stg\nref_main (185 ln, 14 params)\nshared_state_header"]
    motion_[label="motion.stg\nmotion_header"]
    solver_[label="solver.stg"]
    shared_[label="shared_data.stg\naccess-expr"]
    clos_  [label="closures.stg\nemit-call"]
    intro_ [label="introspection.stg\nno imports declared"]
    robot_ [label="robot.stg"]
    mjkdl_ [label="mj_kdl_backend.stg"]
    rob2b_ [label="robif2b_backend.stg"]
    kelo_  [label="kelo_base.stg\nnothing renders it" fillcolor="#f8c8c8"]
    rt_    [label="runtime.stg\n538 ln, 1% templated\n87 escaped delimiters" fillcolor="#f8dcc8"]
    irt_   [label="introspection_runtime_header\n418 ln, 1% templated\n140 escaped delimiters" fillcolor="#f8dcc8"]

    main_ -> motion_  main_ -> robot_  main_ -> shared_  main_ -> kelo_ [style=dashed]
    motion_ -> solver_  motion_ -> shared_
    motion_ -> clos_ [color="#c0392b"]  clos_ -> motion_ [color="#c0392b" label="cycle"]
    robot_ -> mjkdl_ [color="#c0392b"]  mjkdl_ -> robot_ [color="#c0392b" label="cycle"]
    robot_ -> rob2b_ [color="#c0392b"]  rob2b_ -> robot_ [color="#c0392b" label="cycle"]
    intro_ -> motion_ [style=dotted label="undeclared"]
    intro_ -> shared_ [style=dotted label="undeclared"]
    solver_ -> shared_
  }
  cg -> main_ [lhead=cluster_tpl label="12 entry rules"]
  pm -> motion_

  out [label="generated C++\nref_main.cpp · headers/ · CMakeLists.txt" fillcolor="#dbe7f5"]
  main_ -> out [ltail=cluster_tpl]

  note [shape=note fillcolor="#ffffcc" label=<
    <b>measured problems</b><br align="left"/>
    · imports are inert — every rule is globally visible<br align="left"/>
    · 3 dependency cycles between groups<br align="left"/>
    · 179 params exist only to pass a value down; 66 are dead<br align="left"/>
    · views: read by 4 rules, declared on 77<br align="left"/>
    · backend: dispatches in 33 rules, threaded through 19 more<br align="left"/>
    · 44% of all lines contain no ST4 expression at all<br align="left"/>
    · schedule order is nondeterministic between runs<br align="left"/>
  >]
}
