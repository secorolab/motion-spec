// L3 assembly — control-loop scaffolding: chain setup, clock, telemetry, ROS.

// The one anchor that puts every backend leaf in the render closure; call sites dispatch.
import "backend_mj_kdl.stg"
import "backend_robif2b.stg"
import "backend_kelo.stg"

app-chain-includes(backend, has_serial_chain) ::= <<
<({app-chain-includes-<backend>})(has_serial_chain)>
>>

app-chain-setup(backend, serial_chain_solvers, scene, config_path) ::= <<
<({app-chain-setup-<backend>})(serial_chain_solvers, scene, config_path)>
>>

app-loop-condition(backend, has_serial_chain) ::= <<
<({app-loop-condition-<backend>})(has_serial_chain)>
>>

app-chain-cleanup(backend, has_serial_chain) ::= <<
<({app-chain-cleanup-<backend>})(has_serial_chain)>
>>

app-chain-post-setup(backend, serial_chain_solvers, motions, agent_homes) ::= <<
<({app-chain-post-setup-<backend>})(serial_chain_solvers, motions, agent_homes)>
>>

app-chain-post-setup-robif2b(serial_chain_solvers, motions, agent_homes) ::= <<
>>

app-chain-loop-reset(backend, serial_chain_solvers, fsm) ::= <<
<({app-chain-loop-reset-<backend>})(serial_chain_solvers, fsm)>
>>

app-chain-loop-reset-robif2b(serial_chain_solvers, fsm) ::= <<
>>

app-chain-runtime-step(backend, serial_chain_solvers) ::= <<
<({app-chain-runtime-step-<backend>})(serial_chain_solvers)>
>>

clock-time-source(backend, serial_chain_solvers, has_serial_chain) ::= <<
<if(has_serial_chain)><({clock-time-source-<backend>})(serial_chain_solvers)><else>motion_spec::runtime::monotonic_time_s()<endif>
>>

clock-time-source-mj_kdl(serial_chain_solvers) ::= <<
robot.<first(serial_chain_solvers).id>.robot->data->time
>>

clock-time-source-robif2b(serial_chain_solvers) ::= <<
motion_spec::runtime::monotonic_time_s()
>>

app-chain-trace-update(backend, serial_chain_solvers, trace) ::= <<
<({app-chain-trace-update-<backend>})(serial_chain_solvers, trace)>
>>

app-headless-telemetry(backend, shared_data, serial_chain_solvers, scene) ::= <<
<({app-headless-telemetry-<backend>})(shared_data, serial_chain_solvers, scene)>
>>

// ROS publish is decoupled from the control loop: each RealtimePublisher owns a background
// thread that does the DDS publish; the RT loop only does a non-blocking trylock/unlockAndPublish.

ros-includes(ros) ::= <<
#include \<rclcpp/rclcpp.hpp\>
#include \<realtime_tools/realtime_publisher.hpp\>
<ros.publishers:{p | #include "<p.include>"}; separator="\n">
>>

ros-io-members(ros) ::= <<
    rclcpp::Node::SharedPtr ros_node = nullptr;
<ros.publishers:{p |     std::shared_ptr\<realtime_tools::RealtimePublisher\<<p.cpp_type>\>\> <p.pub_id> = nullptr;}; separator="\n">
>>

ros-setup(ros) ::= <<
    rclcpp::init(argc, argv);
    robot.ros_node = std::make_shared\<rclcpp::Node\>("<ros.node_name>");
<ros.publishers:{p |     robot.<p.pub_id> = std::make_shared\<realtime_tools::RealtimePublisher\<<p.cpp_type>\>\>(
        robot.ros_node->create_publisher\<<p.cpp_type>\>("<p.channel>", rclcpp::QoS(10)));}; separator="\n">
>>

ros-shutdown(ros) ::= <<
<ros.publishers:{p |     robot.<p.pub_id>.reset();}; separator="\n">
    robot.ros_node.reset();
    rclcpp::shutdown();
>>
