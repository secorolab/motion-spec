// SPDX-License-Identifier: MPL-2.0
// L3 assembly — control-loop scaffolding: chain setup, clock, telemetry.

// The one anchor that puts every backend leaf in the render closure; call sites dispatch.
import "backend_mj_kdl.stg"
import "backend_robif2b.stg"
import "backend_kelo.stg"

app-chain-includes(backend, has_serial_chain, resources, ros) ::= <<
<({app-chain-includes-<backend>})(has_serial_chain, resources, ros)>
>>

// The ros block travels with the scene because a camera in it publishes through the node the
// program already owns.
app-chain-setup(backend, serial_chain_solvers, scene, config_path, ros) ::= <<
<({app-chain-setup-<backend>})(serial_chain_solvers, scene, config_path, ros)>
>>

app-loop-condition(backend, has_serial_chain) ::= <<
<({app-loop-condition-<backend>})(has_serial_chain)>
>>

app-chain-cleanup(backend, has_serial_chain) ::= <<
<({app-chain-cleanup-<backend>})(has_serial_chain)>
>>

app-chain-post-setup(backend, serial_chain_solvers, motions, agent_homes) ::= <<
<({app-chain-post-setup-<backend>})(serial_chain_solvers, motions, agent_homes)>
>>

app-chain-loop-reset(backend, serial_chain_solvers, fsm) ::= <<
<({app-chain-loop-reset-<backend>})(serial_chain_solvers, fsm)>
>>

app-chain-loop-reset-robif2b(serial_chain_solvers, fsm) ::= <<
>>

app-chain-provider-update(backend, serial_chain_solvers) ::= <<
<({app-chain-provider-update-<backend>})(serial_chain_solvers)>
>>

app-chain-runtime-step(backend, serial_chain_solvers, active_motion) ::= <<
<({app-chain-runtime-step-<backend>})(serial_chain_solvers, active_motion)>
>>

app-chain-introspection-sample(backend, serial_chain_solvers) ::= <<
<({app-chain-introspection-sample-<backend>})(serial_chain_solvers)>
>>

app-chain-control-apply(backend, serial_chain_solvers) ::= <<
<({app-chain-control-apply-<backend>})(serial_chain_solvers)>
>>

app-chain-control-paused-step(backend, serial_chain_solvers) ::= <<
<({app-chain-control-paused-step-<backend>})(serial_chain_solvers)>
>>

// Cameras render against the simulated scene, so only a simulation backend serves them.
app-chain-camera-publish(backend, cameras) ::= <<
<({app-chain-camera-publish-<backend>})(cameras)>
>>

app-chain-camera-publish-robif2b(cameras) ::= <<
>>

app-chain-camera-cleanup(backend, cameras) ::= <<
<({app-chain-camera-cleanup-<backend>})(cameras)>
>>

app-chain-camera-cleanup-robif2b(cameras) ::= <<

>>

clock-time-source(backend, serial_chain_solvers, has_serial_chain) ::= <<
<if(has_serial_chain)><({clock-time-source-<backend>})(serial_chain_solvers)><else>motion_spec::runtime::monotonic_time_s()<endif>
>>

clock-time-source-mj_kdl(serial_chain_solvers) ::= <<
robot.<first(serial_chain_solvers).id>.robot->data->time
>>

clock-time-source-robif2b(serial_chain_solvers) ::= <<
motion_spec::runtime::monotonic_time_s()
>>

// How fast the loop should run relative to wall time. 0.0 means uncapped -- run as fast as the
// machine allows. With a window the viewer's factor is the one setting: the dashboard writes its
// speed into it, so reading it here picks up both that and the ,/. keys without applying either
// twice. Headless has no viewer, so the dashboard speed scales the requested rate directly, and
// an uncapped run stays uncapped whatever the speed says. Hardware runs at wall speed.
loop-rtf-source(backend, serial_chain_solvers, has_serial_chain) ::= <<
<if(has_serial_chain)><({loop-rtf-source-<backend>})(serial_chain_solvers)><else>1.0<endif>
>>

loop-rtf-source-mj_kdl(serial_chain_solvers) ::= <<
(headless ? _headless_rtf * _ctrl_speed_applied : mj_kdl::realtime_factor_of(&mj_viewer))
>>

loop-rtf-source-robif2b(serial_chain_solvers) ::= <<
1.0
>>

app-chain-trace-update(backend, serial_chain_solvers, trace) ::= <<
<({app-chain-trace-update-<backend>})(serial_chain_solvers, trace)>
>>

perturbation-arrows(backend, perturbations, trace) ::= <<
<({perturbation-arrows-<backend>})(perturbations, trace)>
>>
