// L3 assembly — schedules, the motion cycle, chain and device members.

import "domain_closures.stg"
import "domain_controllers.stg"
import "domain_monitors.stg"
import "domain_poses.stg"
import "domain_solver.stg"
import "expr_values.stg"

schedule-step(step, closures, views) ::= <<
    // <step>
    <emit-call(closures.(step), views)>
>>

schedule-block(steps, closures, views) ::= <<
<steps:{step | <schedule-step(step, closures, views)>}; separator="\n">
>>

// Boolean-condition rendering: fold a list of structured terms into a C++ expression.
// empty -> empty_default; one term -> the term; many -> parenthesized, joined by any/all.

sig-params(mid, needs_state, needs_shared, needs_robot, needs_events=false) ::= <<
<if(needs_state)>
    <mid>_state &state<endif><if(needs_shared)><if(needs_state)>,<endif>
    shared_data &shared<endif><if(needs_robot)><if(needs_state||needs_shared)>,<endif>
    const robot_io &robot<endif><if(needs_events)><if(needs_state||needs_shared||needs_robot)>,<endif>
    motion_spec_event_buffer &events<endif><if(needs_state||needs_shared||needs_robot||needs_events)>
<endif>
>>

sig-args(mid, needs_state, needs_shared, needs_robot, needs_events=false) ::= <<
<if(needs_state)><mid>_state_instance<endif><if(needs_shared)><if(needs_state)>, <endif>shared<endif><if(needs_robot)><if(needs_state||needs_shared)>, <endif>robot<endif><if(needs_events)><if(needs_state||needs_shared||needs_robot)>, <endif>events<endif>
>>

motion-prelude(serial_chain_solvers, solvers, backend) ::= <<
<if(serial_chain_solvers)>
<chain-prepare-block(serial_chain_solvers, solvers, backend)>
<endif>
>>

shared-schedule-block(steps, closures, views) ::= <<
<if(steps)>
<schedule-block(steps, closures, views)>
<endif>
>>

chain-robot-member(solver) ::= <<
    manipulator_robot <solver.id>;
>>

// What a bound device exposes to the motion functions. Only a runtime owner declares them:
// the solvers sharing that runtime reach the same device through it.

chain-device-members(solver, backend) ::= <<
<if(solver.runtime.owner)><({chain-device-members-<backend>})(solver)><endif>
>>

motion-state-member(motion) ::= <<
    <motion.id>_state <motion.id>_state_instance;
>>

motion-include(motion) ::= <<
#include "<motion.id>.hpp"
>>

chain-solver-members(serial_chain_solvers, backend) ::= <<
<serial_chain_solvers:{solver | <solver-state-struct(solver, backend)>}; separator="\n\n">
>>

chain-state-members(serial_chain_solvers) ::= <<
<serial_chain_solvers:{solver |     <solver.id>_solver_state <solver.id>;}; separator="\n">
>>

chain-init-block(serial_chain_solvers, solvers, backend) ::= <<
<serial_chain_solvers:{solver |     <solver-init(solver, solvers.(solver.solver_id), solver.motion_driver, backend)>}; separator="\n">
>>

// The motion mirrors the measurements its own solve reads, and reads what only that mirror can
// answer. The world model and everything answered by it were updated for this cycle before the
// FSM was dispatched, so a quantity the scene shares is fresh whether or not this motion runs.
chain-prepare-block(serial_chain_solvers, solvers, backend) ::= <<
<serial_chain_solvers:{solver |
    <solver-sync-input(solver, solvers.(solver.solver_id))>}; separator="\n">
<serial_chain_solvers:{solver |
    <solvers.(solver.solver_id).state_output:{out | <solver-output(solver, solvers.(solver.solver_id), out, backend)>}; separator="\n\n">
<solver.gripper_joint_outputs:{out |     <gripper-joint-output(solver, solvers.(solver.solver_id), out, backend)>}; separator="\n">
}; separator="\n\n">
>>

// One pass per tick, before the FSM is dispatched: every provider is read, the one world model is
// updated from those readings, and every observation it answers is written. Interleaved with the
// motions, arm 1 would read forward kinematics from before arm 2 had been read.
world-state-block(observations, serial_chain_solvers, solvers, backend) ::= <<
<({app-chain-provider-update-<backend>})(serial_chain_solvers)>
        robot.world->update(robot.control_cycle);
<serial_chain_solvers:{solver | <world-to-root(solver)>}; separator="">
<observations:{obs |
        <solver-output(solvers.(obs.solver_id), solvers.(obs.solver_id), obs.out, backend)>
}; separator="\n">
>>

// The chain root inverted once per runtime: every record on it stands on the same root, so the
// rest copy that one frame rather than each inverting it again.
world-to-root(solver) ::= <<
<if(solver.runtime.owner)>        // This chain's root is not the tree's, so every pose it reports is relative to that root.
        robot.<solver.id>.world_to_root =
            robot.world->pose(robot.<solver.id>.world_root, robot.control_cycle).Inverse();
<else>        robot.<solver.id>.world_to_root = robot.<solver.runtime.owner_id>.world_to_root;
<endif>
>>

chain-run-block(serial_chain_solvers, solvers, backend) ::= <<
<serial_chain_solvers:{solver |     <solver-run(solver, solvers.(solver.solver_id), solver.motion_driver, backend)>}; separator="\n">
>>

chain-stage-block(serial_chain_solvers, solvers, backend) ::= <<
<serial_chain_solvers:{solver |     <solver-stage-output(solver, solvers.(solver.solver_id), backend)>}; separator="\n">
>>

chain-gravity-block(serial_chain_solvers, solvers, backend) ::= <<
<serial_chain_solvers:{solver | <solver-gravity-hold(solver, solvers.(solver.solver_id), backend)>}; separator="\n">
>>

// A forwarded command exists only where a gripper joint is commanded, and generation rejects
// that without an actuator bound -- so the port is wired by the time this runs.
command-forwarding(motion) ::= <<
<motion.forwarded_commands:{cmd | <if(cmd.target)>    *robot.aux_cmd_<cmd.world_slot> = shared.<cmd.control_signal.id>;
<endif>}; separator="">
>>

// The window: it opens the first time the gate holds while the state is active, stays open for
// the authored duration, and never opens twice on one activation. What it writes is the wrench
// in the world frame the simulator applies wrenches in -- the ops composed it in the frame the
// authored direction is seen by, which is the arm's base, so it is rotated on the way out.
perturbation-apply(perturbation, views) ::= <<
    {
        const bool gate = <if(perturbation.has_gate)><bool-condition(perturbation.terms, perturbation.gate_any)><else>true<endif>;
        if (!state.<perturbation.id>_fired && gate) {
            state.<perturbation.id>_fired = true;
            state.<perturbation.id>_open = true;
            state.<perturbation.id>_elapsed_s = 0.0;
        \}
<if(perturbation.duration_id)>        if (state.<perturbation.id>_open) {
            state.<perturbation.id>_elapsed_s += shared.dt_measured_s;
            if (state.<perturbation.id>_elapsed_s >= shared.<perturbation.duration_id>) {
                state.<perturbation.id>_open = false;
            \}
        \}
<endif>        shared.<perturbation.active_id> = state.<perturbation.id>_open;
        if (state.<perturbation.id>_open) {
            shared.<perturbation.applied_id> =
                robot.<perturbation.robot_id>.world_to_root.M.Inverse() * shared.<perturbation.wrench_id>;
        \}
    \}
>>

perturbation-apply-block(motion, views) ::= <<
<motion.perturbations:{p | <perturbation-apply(p, views)>}; separator="\n">
>>

// Cleared before the states are dispatched, written after: the simulator holds an applied wrench
// until something clears it, and the tick a state exits on selects no motion to clear it from.
perturbation-clear-block(perturbations) ::= <<
<perturbations:{p |         shared.<p.applied_id> = KDL::Wrench::Zero();
        shared.<p.active_id> = false;}; separator="\n">
>>

// One write per body, carrying the sum of everything pushing it: a closed window contributes a
// zero rather than erasing a live push, and the port is written every tick rather than left
// alone, since the platform holds an applied wrench until something clears it.
perturbation-write-block(bodies) ::= <<
<bodies:{b |         *robot.wrench_cmd_<b.slot> = <b.members:{p|shared.<p.applied_id>}; separator=" + ">;}; separator="\n">
>>

emit-relative-pose(rp) ::= <<
    if (!state.<rp.id>_start_captured) {
        state.<rp.id>_start_frame = shared.<rp.fk_pose_id>;
        state.<rp.id>_start_captured = true;
    }
    shared.<rp.id> = state.<rp.id>_start_frame.Inverse() * shared.<rp.fk_pose_id>;
>>

emit-snapshot(snap, closures, views) ::= <<
<if(snap.source_closure_id)>
        <({emit-call-<closures.(snap.source_closure_id).type>})(closures.(snap.source_closure_id), views)>
<endif>
        shared.<snap.target_id> = <access-expr(snap.source_id, views)>;
>>

// An event-triggered snapshot re-samples on every occurrence of its trigger. The FSM fires
// the event into the future buffer as it transitions, so it is readable for exactly the one
// tick that is this motion's first after entry.

emit-triggered-snapshot(snap, closures, views) ::= <<
<if(snap.trigger_event)>

    if (robot.fsm_events && consume_event(robot.fsm_events, <snap.fsm_namespace>::<snap.trigger_event>)) {
    <emit-snapshot(snap, closures, views)>
    \}
<endif>
>>
