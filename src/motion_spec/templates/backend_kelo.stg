// SPDX-License-Identifier: MPL-2.0
// The KELO mobile base, end to end: the EtherCAT fieldbus it is driven over, its drive and
// wheel I/O, the hddc2b platform/drive/wheel solvers, and the control cycle that runs them.
// EtherCAT lives here rather than with the robif2b backend because only this base is driven
// over it.

// The program reaches this base only through these dictionaries, so the backend that carries a
// KELO base is named here and nowhere in the shared groups.
base-nothing() ::= <<>>

mobile-base-cycle-include-impl ::= [
    "robif2b": "mobile-base-cycle-include",
    default: "base-nothing"
]

app-main-base-setup-impl ::= [
    "robif2b": "app-main-base-setup",
    default: "base-nothing"
]

robif2b-update-ethercat() ::= <<
robif2b_ethercat_update(&ecat);
>>

robif2b-update-kelo-encoder() ::= <<
robif2b_kelo_drive_encoder_update(&drive_enc);
>>

robif2b-update-kelo-driver() ::= <<
robif2b_kelo_drive_actuator_update(&wheel_act);
>>

app-main-base-setup() ::= <<
    int num_drives = NUM_DRIVES;
    ecat_comm ecat_comm{};
    ecat_state ethercat_state{};
    ethercat_state.ethernet_if = "net0";
    ethercat_state.num_exposed_slaves = NUM_SLAVES;
    ethercat_state.slave_idx[0] = 3;
    ethercat_state.slave_idx[1] = 4;
    ethercat_state.slave_idx[2] = 6;
    ethercat_state.slave_idx[3] = 7;

    for (int i = 0; i \< NUM_DRIVES; ++i) {
        ethercat_state.name[i] = "KELOD105";
        ethercat_state.prod_code[i] = 0x02001001;
        ethercat_state.input_size[i] = sizeof(ecat_comm.drv_msr_pdo[i]);
        ethercat_state.output_size[i] = sizeof(ecat_comm.drv_cmd_pdo[i]);
    }

    void *input_array[NUM_SLAVES] = {
        &ecat_comm.drv_msr_pdo[0],
        &ecat_comm.drv_msr_pdo[1],
        &ecat_comm.drv_msr_pdo[2],
        &ecat_comm.drv_msr_pdo[3],
    };
    const void *output_array[NUM_SLAVES] = {
        &ecat_comm.drv_cmd_pdo[0],
        &ecat_comm.drv_cmd_pdo[1],
        &ecat_comm.drv_cmd_pdo[2],
        &ecat_comm.drv_cmd_pdo[3],
    };

    robif2b_ethercat ecat{};
    ecat.ethernet_if = &ethercat_state.ethernet_if[0];
    ecat.num_exposed_slaves = &ethercat_state.num_exposed_slaves;
    ecat.slave_idx = &ethercat_state.slave_idx[0];
    ecat.name = &ethercat_state.name[0];
    ecat.product_code = &ethercat_state.prod_code[0];
    ecat.input_size = &ethercat_state.input_size[0];
    ecat.output_size = &ethercat_state.output_size[0];
    ecat.error_code = &ethercat_state.error_code;
    ecat.num_initial_slaves = &ethercat_state.num_found_slaves;
    ecat.num_current_slaves = &ethercat_state.num_active_slaves;
    ecat.is_connected = &ethercat_state.is_connected[0];
    ecat.input = input_array;
    ecat.output = output_array;

    kelo_msr kelo_msr{};
    robif2b_kelo_drive_encoder drive_enc{};
    drive_enc.num_drives = &num_drives;
    drive_enc.msr_pdo = &ecat_comm.drv_msr_pdo[0];
    drive_enc.wheel_pos_msr = &kelo_msr.whl_pos[0];
    drive_enc.wheel_vel_msr = &kelo_msr.whl_vel[0];
    drive_enc.pivot_pos_msr = &kelo_msr.pvt_pos[0];
    drive_enc.pivot_vel_msr = &kelo_msr.pvt_vel[0];
    drive_enc.pivot_pos_off = &kelo_msr.pvt_off[0];

    kelo_cmd kelo_cmd{};
    for (int i = 0; i \< NUM_DRIVES; ++i) {
        kelo_cmd.ctrl_mode[i] = ROBIF2B_CTRL_MODE_FORCE;
        kelo_cmd.max_current[i * 2 + 0] = 10.0;
        kelo_cmd.max_current[i * 2 + 1] = 10.0;
        kelo_cmd.trq_const[i * 2 + 0] = 0.29;
        kelo_cmd.trq_const[i * 2 + 1] = 0.29;
    }

    robif2b_kelo_drive_actuator wheel_act{
        .num_drives = &num_drives,
        .cmd_pdo = &ecat_comm.drv_cmd_pdo[0],
        .ctrl_mode = &kelo_cmd.ctrl_mode[0],
        .act_vel_cmd = &kelo_cmd.vel[0],
        .act_trq_cmd = &kelo_cmd.trq[0],
        .act_cur_cmd = &kelo_cmd.cur[0],
        .max_current = &kelo_cmd.max_current[0],
        .trq_const = &kelo_cmd.trq_const[0],
    };

    robot.mobile_base = mobile_base_robot{
        .num_drives = &num_drives,
        .ethercat_state = &ethercat_state,
        .ethercat_comm = &ecat_comm,
        .ethercat = &ecat,
        .measurement = &kelo_msr,
        .command = &kelo_cmd,
        .drive_encoder = &drive_enc,
        .wheel_actuator = &wheel_act,
    };
>>

mobile-base-cycle-include() ::= <<
#include "mobile_base_cycle.hpp"
>>

base-force-solver-hddc2b_example_frc_sc1(solver) ::= <<
hddc2b_pltf_drv_algn_dst(NUM_DRIVES, state.cfg.drive_attachment.data(), state.cfg.w_align.data(), kelo_msr.pvt_pos, state.f_platform, &state.f_drive_ref[1], 2);
hddc2b_pltf_frc_pltf_to_drv(NUM_DRIVES, EPS, state.g, state.cfg.w_platform.data(), state.f_platform, state.cfg.w_drive.data(), state.f_drive_ref, state.f_prim, state.f_scnd);
motion_spec::runtime::hddc2b_rescale(state.f_scnd);
hddc2b_pltf_frc_redu_ref_fini(NUM_DRIVES, state.f_prim, state.f_scnd, state.f_drive);
hddc2b_drv_frc_pvt_to_gnd(NUM_DRIVES, state.cfg.wheel_distance.data(), state.cfg.castor_offset.data(), state.f_drive, state.f_wheel);
hddc2b_whl_frc_gnd_to_hub(NUM_DRIVES, state.cfg.wheel_diameter.data(), state.f_wheel, kelo_cmd.trq);
>>

base-force-solver-hddc2b_example_frc_sc2(solver) ::= <<
hddc2b_pltf_drv_algn_dst(NUM_DRIVES, state.cfg.drive_attachment.data(), state.cfg.w_align.data(), kelo_msr.pvt_pos, state.f_platform, &state.f_drive[1], 2);
hddc2b_drv_frc_pvt_to_gnd(NUM_DRIVES, state.cfg.wheel_distance.data(), state.cfg.castor_offset.data(), state.f_drive, state.f_wheel);
hddc2b_whl_frc_gnd_to_hub(NUM_DRIVES, state.cfg.wheel_diameter.data(), state.f_wheel, kelo_cmd.trq);
>>

base-force-solver(solver) ::= <<
<({base-force-solver-<solver.configuration>})(solver)>
>>

base-cycle-begin(base_velocity_solvers) ::= <<
    {
        auto &ecat = *robot.mobile_base.ethercat;
        auto &drive_enc = *robot.mobile_base.drive_encoder;
        auto &kelo_msr = *robot.mobile_base.measurement;

        <robif2b-update-ethercat()>
        <robif2b-update-kelo-encoder()>
        hddc2b_pltf_frc_comp_mat(NUM_DRIVES, state.cfg.drive_attachment.data(), kelo_msr.pvt_pos, state.g);
<base_velocity_solvers:{solver |

        hddc2b_whl_vel_hub_to_gnd(NUM_DRIVES, state.cfg.wheel_diameter.data(), kelo_msr.whl_vel, state.xd_ground);
        hddc2b_drv_vel_gnd_to_pvt(NUM_DRIVES, state.cfg.wheel_distance.data(), state.cfg.castor_offset.data(), state.xd_ground, state.xd_drive);
        motion_spec::runtime::hddc2b_pltf_vel_drv_to_pltf(NUM_DRIVES, EPS, state.g, state.cfg.w_drive.data(), state.xd_drive, state.cfg.w_platform.data(), state.xd_platform);
        shared.<solver.velocity.id>.vel.x(state.xd_platform[0]);
        shared.<solver.velocity.id>.vel.y(state.xd_platform[1]);
        shared.<solver.velocity.id>.rot.z(state.xd_platform[2]);
}; separator="\n">
    }
>>

base-cycle-force(base_force_solvers) ::= <<
    {
        auto &kelo_msr = *robot.mobile_base.measurement;
        auto &kelo_cmd = *robot.mobile_base.command;
<base_force_solvers:{solver |

        state.f_platform[0] = shared.<solver.force.id>.force.x();
        state.f_platform[1] = shared.<solver.force.id>.force.y();
        state.f_platform[2] = shared.<solver.force.id>.torque.z();
        <base-force-solver(solver)>
}; separator="\n">
    }
>>

mobile_base_cycle_header(resources, platform) ::= <<
#pragma once

#include "robot_config.hpp"
#include "shared_state.hpp"

<if(resources.by_kind.mobile_base)>
// The base's own solver state, mirroring \<solver\>_solver_state on a serial chain: the
// platform it drives (read from the deployment config) and the hddc2b solve intermediates.
// None of it is a shared value, so none of it is on the blackboard.
struct mobile_base_state {
    bool initialized = false;
    motion_spec::config::Kelo cfg;
    double g[NUM_DRIVES * NUM_G_COORD] = {0.0};
    double f_platform[NUM_PLTF_COORD] = {0.0, 0.0, 0.0};
    double f_drive_ref[NUM_DRIVES * NUM_DRV_COORD] = {0.0};
    double f_drive[NUM_DRIVES * NUM_DRV_COORD] = {0.0};
    double f_wheel[NUM_DRIVES * NUM_GND_COORD] = {0.0};
    double f_prim[NUM_DRIVES * NUM_DRV_COORD] = {0.0};
    double f_scnd[NUM_DRIVES * NUM_DRV_COORD] = {0.0};
    double xd_ground[NUM_DRIVES * NUM_DRV_COORD] = {0.0};
    double xd_drive[NUM_DRIVES * NUM_DRV_COORD] = {0.0};
    double xd_platform[NUM_PLTF_COORD] = {0.0, 0.0, 0.0};
};

inline void reset_mobile_base(mobile_base_state &state) {
    state = mobile_base_state{};
}

// Reads the config file, so the `initialized` latch is load-bearing: the platform is parsed on
// the first cycle (or the first after a reset), never per tick.
inline void init_mobile_base(mobile_base_state &state, shared_data &shared, const robot_io &robot) {
    if (state.initialized) return;
    state.cfg = motion_spec::config::kelo(motion_spec::config::load("<platform.config>"), "kelo");
    state.initialized = true;
}

inline void update_mobile_base(
    mobile_base_state &state,
    shared_data &shared,
    const robot_io &robot) {
    init_mobile_base(state, shared, robot);
<base-cycle-begin(resources.by_kind.mobile_base.velocity_solvers)>
}

inline void control_mobile_base(
    mobile_base_state &state,
    shared_data &shared,
    const robot_io &robot) {
<base-cycle-force(resources.by_kind.mobile_base.force_solvers)>
}

inline void apply_mobile_base(
    mobile_base_state &state,
    shared_data &shared,
    const robot_io &robot) {
    auto &wheel_act = *robot.mobile_base.wheel_actuator;
    <robif2b-update-kelo-driver()>
}
<endif>
>>
