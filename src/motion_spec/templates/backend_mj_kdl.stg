// SPDX-License-Identifier: MPL-2.0
// mj_kdl backend tool: MuJoCo+KDL simulation robot impl (KinovaGen3) and CMake generation.

import "backend_robot.stg"
robot-driver-include-mj_kdl-KinovaGen3(solver, model_name, resources) ::= <<
#include \<mj_kdl_wrapper/mj_kdl_wrapper.hpp\>
#include "headers/<model_name>.kdl.hpp"
>>

robot-state-struct-mj_kdl-KinovaGen3(solver) ::= <<
>>

robot-manipulator-struct-mj_kdl-KinovaGen3(solver) ::= <<
struct manipulator_robot {
    mj_kdl::Robot *robot = nullptr;
    KDL::Chain *chain = nullptr;
    // Where this chain's endpoints sit in the one world model. Per instance, though the struct
    // type is shared: two arms sliced from one tree end at different segments.
    int world_root = -1;
    int world_tip = -1;
};
>>

world-joint-address-mj_kdl(solver, index) ::= <<
&robot.<solver.id>.robot->jnt_pos_msr[<index>]
>>

// A simulated sensor exposes the one deployment property it has, under the same member name and
// the same config key the driven sensor uses -- the tare length belongs to the sensor, not to
// whichever platform is reading it.
chain-device-members-mj_kdl(solver) ::= <<
<solver.sensors:{s | <({mj-sensor-member-<s.type>})(solver, s)>}; separator="">
>>

mj-sensor-member-ForceTorque(solver, sensor) ::= <<
    int ft_<sensor.id>_bias_samples = 0;
>>

robot-state-init-mj_kdl-KinovaGen3(solver) ::= <<
>>

mj-sensor-ForceTorque(solver, sensor) ::= <<
    mj_tool_<solver.runtime.id>.ft_sensors.push_back(mj_kdl::ForceTorqueSensorSpec{ .name = "<sensor.id>", .frame_site = "<sensor.frame>" \});
>>

robot-init-mj_kdl-KinovaGen3(solver) ::= <<
<if(solver.runtime.owner)>    mj_kdl::Robot mj_<solver.runtime.id>{};
<if(solver.hardware.tool_body)>    mj_kdl::ToolFrameSpec mj_tool_<solver.runtime.id>{};
<solver.sensors:{s |<({mj-sensor-<s.type>})(solver, s)>
}>    KDL::Chain built_chain_<solver.runtime.id>{};
    if (!scene_kdl::make_chain_<solver.chain.name>(world_tree_<solver.chain.tree>, &built_chain_<solver.runtime.id>)) {
        std::cerr \<\< "make_chain_<solver.chain.name>() failed for runtime <solver.runtime.id>\n";
        mj_kdl::cleanup(&mj_env);
        return 1;
    \}
    if (!mj_kdl::init_robot_from_chain(&mj_<solver.runtime.id>, mj_env.model, mj_env.data, built_chain_<solver.runtime.id>, {<solver.chain.joints:{j |"<j>"}; separator=", ">\}, "<solver.runtime.prefix>", &mj_tool_<solver.runtime.id>)) {
<else>    KDL::Chain built_chain_<solver.runtime.id>{};
    if (!scene_kdl::make_chain_<solver.chain.name>(world_tree_<solver.chain.tree>, &built_chain_<solver.runtime.id>)) {
        std::cerr \<\< "make_chain_<solver.chain.name>() failed for runtime <solver.runtime.id>\n";
        mj_kdl::cleanup(&mj_env);
        return 1;
    \}
    if (!mj_kdl::init_robot_from_chain(&mj_<solver.runtime.id>, mj_env.model, mj_env.data, built_chain_<solver.runtime.id>, {<solver.chain.joints:{j |"<j>"}; separator=", ">\}, "<solver.runtime.prefix>")) {
<endif>
        std::cerr \<\< "init_robot_from_chain() failed for runtime <solver.runtime.id>\n";
        mj_kdl::cleanup(&mj_env);
        return 1;
    \}
    mj_<solver.runtime.id>.ctrl_mode = mj_kdl::CtrlMode::TORQUE;
    mj_kdl::env_add_robot(&mj_env, &mj_<solver.runtime.id>);
<endif>
>>

robot-chain-mj_kdl-KinovaGen3(solver) ::= <<
<if(solver.runtime.owner)>    KDL::Chain *chain_<solver.runtime.id> = &mj_<solver.runtime.id>.chain;
<endif>
>>

robot-assign-mj_kdl-KinovaGen3(solver) ::= <<
    robot.<solver.id> = manipulator_robot{
        .robot = &mj_<solver.runtime.id>,
        .chain = chain_<solver.runtime.id>,
    };
>>

mj-sensor-io-assign(solver) ::= <<
<if(solver.runtime.owner)><solver.sensors:{s | <({mj-sensor-config-<s.type>})(solver, s)>}; separator=""><endif>
>>

mj-sensor-config-ForceTorque(solver, sensor) ::= <<
    robot.ft_<sensor.id>_bias_samples = motion_spec::config::bias_samples(robot_config, "<sensor.config_key>");
>>

robot-configure-mj_kdl-KinovaGen3(solver) ::= <<
>>

robot-shutdown-mj_kdl-KinovaGen3(solver) ::= <<
<if(solver.runtime.owner)>    mj_kdl::cleanup(&mj_<solver.runtime.id>);
<endif>
>>

app-chain-includes-mj_kdl(has_serial_chain, resources) ::= <<
<if(has_serial_chain)>
#include \<cstring\>
#include \<cstdlib\>
#include \<deque\>
#include \<filesystem\>
#include \<iostream\>
#include \<string\>
#include \<vector\>
#include "robot_config.hpp"
<endif>
>>

app-chain-setup-mj_kdl(serial_chain_solvers, scene, config_path) ::= <<
    const auto robot_config = motion_spec::config::load("<config_path>");
    bool headless = false;
    bool steps_limited = false;
    int headless_steps = 0;
    // Headless runs as fast as the machine allows unless asked for a rate: the simulation clock
    // drives dt, so wall speed changes how long the run takes and nothing about what it does.
    double _headless_rtf = 0.0;
    for (int i = 1; i \< argc; ++i) {
        if (std::strcmp(argv[i], "--headless") == 0) {
            headless = true;
        } else if (std::strcmp(argv[i], "--steps") == 0 && i + 1 \< argc) {
            headless_steps = std::atoi(argv[++i]);
            steps_limited = true;
        } else if (std::strcmp(argv[i], "--rtf") == 0 && i + 1 \< argc) {
            _headless_rtf = std::atof(argv[++i]);
        }
    }

    const auto cache_root = []() -> std::filesystem::path {
        if (const char *xdg = std::getenv("XDG_CACHE_HOME"); xdg && *xdg) {
            return std::filesystem::path(xdg) / "mj_kdl_wrapper";
        }
        if (const char *home = std::getenv("HOME"); home && *home) {
            return std::filesystem::path(home) / ".cache" / "mj_kdl_wrapper";
        }
        return {};
    };

    const auto find_asset_path = [&cache_root](const std::vector\<std::filesystem::path\> &relative_paths) -> std::filesystem::path {
        std::vector\<std::filesystem::path\> roots = {std::filesystem::current_path()};
        roots.push_back(std::filesystem::path(__FILE__).parent_path());
        const auto cache = cache_root();
        const auto append_cache_candidate = [&cache](std::vector\<std::filesystem::path\> &candidates,
                                                     const std::filesystem::path &relative) {
            if (cache.empty()) {
                return;
            }
            const auto text = relative.generic_string();
            const auto append_suffix = [&](const std::string &marker, const std::filesystem::path &cache_subdir) {
                const auto pos = text.find(marker);
                if (pos != std::string::npos) {
                    candidates.push_back(cache / cache_subdir / text.substr(pos + marker.size()));
                }
            };
            append_suffix("third_party/menagerie/", "menagerie");
            append_suffix("src/mj_kdl_wrapper/assets/", "assets");
            append_suffix("src/examples/assets/", "assets");
        };

        for (const auto &start : roots) {
            for (auto root = start; !root.empty(); root = root.parent_path()) {
                for (const auto &relative : relative_paths) {
                    if (relative.is_absolute() && std::filesystem::exists(relative)) {
                        return relative;
                    }
                    const auto candidate = root / relative;
                    if (std::filesystem::exists(candidate)) {
                        return candidate;
                    }
                }
                if (root == root.root_path()) {
                    break;
                }
            }
        }
        for (const auto &relative : relative_paths) {
            std::vector\<std::filesystem::path\> cache_candidates;
            if (const char *menagerie = std::getenv("MJ_KDL_MENAGERIE"); menagerie && *menagerie) {
                const auto text = relative.generic_string();
                const auto pos = text.find("third_party/menagerie/");
                if (pos != std::string::npos) {
                    cache_candidates.push_back(std::filesystem::path(menagerie) / text.substr(pos + std::string("third_party/menagerie/").size()));
                }
            }
            append_cache_candidate(cache_candidates, relative);
            for (const auto &candidate : cache_candidates) {
                if (std::filesystem::exists(candidate)) {
                    return candidate;
                }
            }
        }
        return {};
    };

    mj_kdl::Env mj_env{};
    mj_kdl::SceneSpec mj_scene{};
    mj_scene.timestep = <scene.timestep_s>;
    mj_scene.add_floor = true;
    mj_scene.add_skybox = true;
    std::deque\<std::string\> mj_path_storage;
<scene.robots:{robot |
    {
        const std::filesystem::path robot_mjcf_path = find_asset_path({"<robot.path>"\});
        if (robot_mjcf_path.empty()) {
            std::cerr \<\< "MJCF model not found: <robot.path>\\n";
            return 1;
        \}
        mj_path_storage.push_back(robot_mjcf_path.string());
        mj_kdl::RobotSpec mj_robot_spec{\};
        mj_robot_spec.path = mj_path_storage.back().c_str();
        mj_robot_spec.prefix = "<robot.prefix>";
        mj_robot_spec.attach_to.kind = mj_kdl::AttachKind::<robot.attach_kind>;
        mj_robot_spec.attach_to.name = "<robot.attach_name>";
        mj_robot_spec.pos[0] = <robot.pos_x>;
        mj_robot_spec.pos[1] = <robot.pos_y>;
        mj_robot_spec.pos[2] = <robot.pos_z>;
        mj_robot_spec.quat[0] = <robot.quat_x>;
        mj_robot_spec.quat[1] = <robot.quat_y>;
        mj_robot_spec.quat[2] = <robot.quat_z>;
        mj_robot_spec.quat[3] = <robot.quat_w>;
<robot.attachments:{attachment |
        {
            const std::filesystem::path attachment_path = find_asset_path({"<attachment.path>"\});
            if (attachment_path.empty()) {
                std::cerr \<\< "MJCF attachment not found: <attachment.path>\\n";
                return 1;
            \}
            mj_path_storage.push_back(attachment_path.string());
            mj_kdl::AttachmentSpec attachment_spec{\};
            attachment_spec.mjcf_path = mj_path_storage.back().c_str();
            attachment_spec.attach_to.kind = mj_kdl::AttachKind::<attachment.attach_kind>;
            attachment_spec.attach_to.name = "<attachment.attach_to>";
            attachment_spec.prefix = "<attachment.prefix>";
            attachment_spec.pos[0] = <attachment.pos_x>;
            attachment_spec.pos[1] = <attachment.pos_y>;
            attachment_spec.pos[2] = <attachment.pos_z>;
            attachment_spec.quat[0] = <attachment.quat_x>;
            attachment_spec.quat[1] = <attachment.quat_y>;
            attachment_spec.quat[2] = <attachment.quat_z>;
            attachment_spec.quat[3] = <attachment.quat_w>;
            mj_robot_spec.attachments.push_back(attachment_spec);
        \}
}; separator="\n">
        mj_scene.robots.push_back(mj_robot_spec);
    \}
}; separator="\n">
<scene.objects:{object |
    {
        mj_kdl::SceneObject object_spec{\};
        object_spec.name = "<object.body>";
        object_spec.attach_to.kind = mj_kdl::AttachKind::<object.attach_kind>;
        object_spec.attach_to.name = "<object.attach_name>";
<if(object.has_path)>        const std::filesystem::path object_path = find_asset_path({"<object.path>"\});
        if (object_path.empty()) {
            std::cerr \<\< "MJCF object not found: <object.path>\\n";
            return 1;
        \}
        object_spec.mjcf_path = object_path.string();
<endif>        object_spec.pos[0] = <object.pos_x>;
        object_spec.pos[1] = <object.pos_y>;
        object_spec.pos[2] = <object.pos_z>;
        object_spec.quat[0] = <object.quat_x>;
        object_spec.quat[1] = <object.quat_y>;
        object_spec.quat[2] = <object.quat_z>;
        object_spec.quat[3] = <object.quat_w>;
        object_spec.fixed = <object.fixed>;
<if(!object.has_path)>        object_spec.shape = mj_kdl::Shape::<object.shape>;
        object_spec.size[0] = <object.size_x>;
        object_spec.size[1] = <object.size_y>;
        object_spec.size[2] = <object.size_z>;
        object_spec.rgba[0] = <object.color_r>f;
        object_spec.rgba[1] = <object.color_g>f;
        object_spec.rgba[2] = <object.color_b>f;
        object_spec.rgba[3] = <object.color_a>f;
        object_spec.mass = <object.mass>;
        object_spec.condim = mj_kdl::Condim::Rolling;
        object_spec.friction[0] = <object.friction_slide>;
        object_spec.friction[1] = <object.friction_torsion>;
        object_spec.friction[2] = <object.friction_roll>;
<endif>        mj_scene.objects.push_back(object_spec);
    \}
}; separator="\n">

    if (!mj_kdl::init_env(&mj_env, &mj_scene)) {
        std::cerr \<\< "mj_kdl::init_env() failed\\n";
        return 1;
    }

    // Contact-solver policy: accuracy and grip fidelity bought with sim time per step.
    constexpr int kMjSolverIterations = 100;
    constexpr double kMjSolverTolerance = 1e-10;
    constexpr double kMjImpratio = 20.0;
    mj_env.model->opt.iterations = kMjSolverIterations;
    mj_env.model->opt.tolerance  = kMjSolverTolerance;
    mj_env.model->opt.impratio   = kMjImpratio;
    mj_env.model->opt.cone       = mjCONE_ELLIPTIC;
<serial_chain_solvers:{solver |<robot-state-init(solver, "mj_kdl")>
<robot-init(solver, "mj_kdl")>
<robot-chain(solver, "mj_kdl")>
<robot-assign(solver, "mj_kdl")>
<mj-sensor-io-assign(solver)>}; separator="\n">

    mj_kdl::Viewer mj_viewer{};
    if (_headless_rtf > 0.0) mj_viewer.realtime_factor = _headless_rtf;
    if (!headless) {
        if (!mj_kdl::init_window_sim(&mj_viewer, &mj_<first(serial_chain_solvers).runtime.id>)) {
            std::cerr \<\< "mj_kdl::init_window_sim() failed\\n";
            mj_kdl::cleanup(&mj_env);
            return 1;
        }
    }
>>

app-chain-post-setup-mj_kdl(serial_chain_solvers, motions, agent_homes) ::= <<
    mj_env.on_reset = [&](mj_kdl::ResetContext *) {
<serial_chain_solvers:{solver | <if(solver.runtime.owner)>        {
            const double _q_home[] = {<agent_homes.(solver.runtime.config_key); separator=", ">\};
            KDL::JntArray _q(mj_<solver.runtime.id>.n_joints);
            for (int _i = 0; _i \< mj_<solver.runtime.id>.n_joints && _i \< static_cast\<int\>(std::size(_q_home)); ++_i)
                _q(_i) = _q_home[_i];
            mj_kdl::set_joint_pos(&mj_<solver.runtime.id>, _q, false);
        \}
<endif>}; separator="">
        <motions:{m | reset_<m.id>(<m.id>_state_instance);}; separator="\n        ">
    };
    mj_kdl::reset(&mj_env);
    double _prev_sim_time = mj_<first(serial_chain_solvers).runtime.id>.data->time;
>>

app-chain-loop-reset-mj_kdl(serial_chain_solvers, fsm) ::= <<
        if (mj_<first(serial_chain_solvers).runtime.id>.data->time \< _prev_sim_time - 1e-6) {
            mj_kdl::reset(&mj_env);
<if(fsm)>
            fsm->currentStateIndex = fsm->startStateIndex;
<endif>
        }
        _prev_sim_time = mj_<first(serial_chain_solvers).runtime.id>.data->time;
>>

app-loop-condition-mj_kdl(has_serial_chain) ::= <<
(!headless || !steps_limited || headless_steps-- > 0)
>>

app-chain-cleanup-mj_kdl(has_serial_chain) ::= <<
<if(has_serial_chain)>    if (!headless) {
        mj_kdl::cleanup(&mj_viewer);
    }
    mj_kdl::cleanup(&mj_env);<endif>
>>

app-chain-runtime-step-mj_kdl(serial_chain_solvers) ::= <<
<serial_chain_solvers:{solver | <if(solver.runtime.owner)>        mj_kdl::update(&mj_<solver.runtime.id>);
<endif>}; separator="">
        // Closing the viewer ends the run, but it must end the same way S_DONE does. std::exit
        // skips destructors, so the frame logger's writer thread never drained and the log was
        // left with a half-written record and no health file -- break, and let teardown run.
        if (!mj_kdl::step(&mj_<first(serial_chain_solvers).runtime.id>)) {
            break;
        }
>>

app-chain-trace-update-mj_kdl(serial_chain_solvers, trace) ::= <<
<if(trace.enabled)>
<if(trace.has_targets)>
        if (!headless) {
            // Live EE trajectory trace: one bounded polyline per referenced link,
            // each link's world frame read straight from MuJoCo. Length and colour
            // come from the ENVIRONMENT TRACE block in the .robmot model.
            static constexpr size_t kTraceMax = <trace.length>; // bounded by user_scn maxgeom (init_window_sim)
            static constexpr float kTraceRGBA[4] = {
                <trace.color_r>f, <trace.color_g>f, <trace.color_b>f, <trace.color_a>f};
            mj_kdl::clear_trace(&mj_viewer);
<trace.targets:{target |            static std::deque\<KDL::Vector> _trace<i0>;
            KDL::Frame _f<i0>;
            if (mj_kdl::get_site_frame(mj_<first(serial_chain_solvers).runtime.id>.model, mj_<first(serial_chain_solvers).runtime.id>.data, "<target.link>", &_f<i0>) || mj_kdl::get_body_frame(mj_<first(serial_chain_solvers).runtime.id>.model, mj_<first(serial_chain_solvers).runtime.id>.data, "<target.link>", &_f<i0>)) _trace<i0>.push_back(_f<i0>.p);
            if (_trace<i0>.size() > kTraceMax) _trace<i0>.pop_front();
            for (size_t _i = 1; _i \< _trace<i0>.size(); ++_i)
                mj_kdl::add_trace_segment(&mj_viewer, _trace<i0>[_i - 1], _trace<i0>[_i], kTraceRGBA);
}>        }
<else>
        if (!headless) {
            // Live EE trajectory trace: bounded ring of recent EE positions in
            // world frame, redrawn each frame as a polyline overlay. pose_ee_base
            // is FK output in the chain-root frame, so lift it into world via the
            // base body pose (cached once; base is fixed). Length and colour come
            // from the ENVIRONMENT TRACE block in the .robmot model.
            static std::deque\<KDL::Vector> _trace;
            static constexpr size_t kTraceMax = <trace.length>; // bounded by user_scn maxgeom (init_window_sim)
            static constexpr float kTraceRGBA[4] = {
                <trace.color_r>f, <trace.color_g>f, <trace.color_b>f, <trace.color_a>f};
            static bool _trace_base_ok = false;
            static KDL::Frame _trace_world_T_base;
            if (!_trace_base_ok) {
                _trace_base_ok = mj_kdl::get_body_frame(
                    mj_<first(serial_chain_solvers).runtime.id>.model, mj_<first(serial_chain_solvers).runtime.id>.data,
                    "<first(serial_chain_solvers).chain.root>", &_trace_world_T_base);
            }
            _trace.push_back(_trace_world_T_base * shared.pose_ee_base.p);
            if (_trace.size() > kTraceMax) _trace.pop_front();
            mj_kdl::clear_trace(&mj_viewer);
            for (size_t _i = 1; _i \< _trace.size(); ++_i) {
                mj_kdl::add_trace_segment(&mj_viewer, _trace[_i - 1], _trace[_i], kTraceRGBA);
            }
        }
<endif>
<endif>
>>
