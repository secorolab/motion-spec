// SPDX-License-Identifier: MPL-2.0
// robif2b backend: EtherCAT/KELO driver bindings and the robif2b KinovaGen3 robot impl.

import "backend_robot.stg"
robot-driver-include-robif2b-KinovaGen3(solver) ::= <<
#include "headers/<solver.chain.kdl_header>"
#include \<robif2b/functions/kinova_gen3.h\>
#include \<robif2b/functions/robotiq_gripper.h\>
#include \<robif2b/functions/robotiq_ft_sensor.h\>
>>

robot-state-struct-robif2b-KinovaGen3(solver) ::= <<
// The gripper closes under its own speed and force loop; the model commands position only. What
// speed and what force come from the robot config -- see motion_spec::config::gripper_pct.

struct kinova_state {
    bool success = false;
    enum robif2b_ctrl_mode ctrl_mode = ROBIF2B_CTRL_MODE_FORCE;
    double pos_msr[KINOVA_NUM_JOINTS] = {0.0};
    double vel_msr[KINOVA_NUM_JOINTS] = {0.0};
    double eff_msr[KINOVA_NUM_JOINTS] = {0.0};
    double cur_msr[KINOVA_NUM_JOINTS] = {0.0};
    double pos_cmd[KINOVA_NUM_JOINTS] = {0.0};
    double vel_cmd[KINOVA_NUM_JOINTS] = {0.0};
    double eff_cmd[KINOVA_NUM_JOINTS] = {0.0};
    double cur_cmd[KINOVA_NUM_JOINTS] = {0.0};
};

// Gripper over the arm's interconnect: every port is a percentage of travel.
struct kg3_gripper_state {
    bool success = false;
    float pos_msr = 0.0f;
    float vel_msr = 0.0f;
    float cur_msr = 0.0f;
    float pos_cmd = 0.0f;
    float vel_cmd = 0.0f;
    float frc_cmd = 0.0f;
};

// Gripper on its own serial line: the same ports, counted 0-255.
struct serial_gripper_state {
    bool success = false;
    uint8_t position_msr = 0;
    bool is_moving = false;
    robif2b_robotiq_gripper_obj_status obj_status = ROBIF2B_ROBOTIQ_OBJ_UNKNOWN;
    robif2b_robotiq_gripper_status status = ROBIF2B_ROBOTIQ_UNKNOWN;
    uint8_t position_cmd = 0;
    uint8_t speed_cmd = 0;
    uint8_t force_cmd = 0;
    robif2b_robotiq_gripper_error error = ROBIF2B_ROBOTIQ_NO_ERROR;
};

struct ft_sensor_state {
    bool success = false;
    float force[3] = {0.0f};
    float force_offset[3] = {0.0f};
    float moment[3] = {0.0f};
    float moment_offset[3] = {0.0f};
};
>>

robot-manipulator-struct-robif2b-KinovaGen3(solver) ::= <<
struct manipulator_robot {
    kinova_state *state = nullptr;
    robif2b_kinova_gen3_nbx *robot = nullptr;
    KDL::Chain *chain = nullptr;
    // The commanded gripper joint position [rad], as the model authored it. Which device that
    // reaches, and in whose units, is settled at generation by the bound device's rule set.
    double *gripper_cmd = nullptr;
    // The measured gripper joint position [rad]: the mimic joint is not in the chain, so the
    // bound gripper device reports it.
    double *gripper_pos = nullptr;
};
>>

robot-state-init-robif2b-KinovaGen3(solver) ::= <<
<if(solver.runtime.owner)>    kinova_state kinova_<solver.runtime.id>_state{};
    kinova_<solver.runtime.id>_state.ctrl_mode = ROBIF2B_CTRL_MODE_FORCE;
<solver.devices:{device | <({<device-state-init-impl.(device.kind)>})(solver, device)>}; separator="\n">
<endif>
>>

// Device hooks name the kinds that contribute something and let every other kind fall through to
// the empty default, so adding a device kind costs a rule only where it has content to emit.
device-nothing(solver, device) ::= <<>>

device-io-member-impl ::= [
    "RobotiqFT300s": "device-io-member-robif2b-RobotiqFT300s",
    default: "device-nothing"
]

chain-device-members-robif2b(solver) ::= <<
<solver.devices:{device | <({<device-io-member-impl.(device.kind)>})(solver, device)>}; separator="">
>>

// The motion functions read the sensor through here; main owns the driver's state.
device-io-member-robif2b-RobotiqFT300s(solver, device) ::= <<
    const ft_sensor_state *ft_<device.drives> = nullptr;
    int ft_<device.drives>_bias_samples = 0;
>>

device-io-assign-impl ::= [
    "RobotiqFT300s": "device-io-assign-robif2b-RobotiqFT300s",
    default: "device-nothing"
]

device-io-assign-robif2b-RobotiqFT300s(solver, device) ::= <<
    robot.ft_<device.drives> = &ft_<device.drives>_state;
    robot.ft_<device.drives>_bias_samples = motion_spec::config::bias_samples(robot_config, "<device.config_key>");
>>

device-state-init-impl ::= [
    "KinovaGen3-2F85": "device-state-init-robif2b-KinovaGen3-2F85",
    "Robotiq2F85": "device-state-init-robif2b-Robotiq2F85",
    "RobotiqFT300s": "device-state-init-robif2b-RobotiqFT300s",
    default: "device-nothing"
]

device-state-init-robif2b-KinovaGen3-2F85(solver, device) ::= <<
    kg3_gripper_state gripper_<solver.runtime.id>_state{};
    gripper_<solver.runtime.id>_state.vel_cmd = static_cast\<float\>(motion_spec::config::gripper_pct(robot_config, "<device.config_key>", "gripper_speed_pct"));
    gripper_<solver.runtime.id>_state.frc_cmd = static_cast\<float\>(motion_spec::config::gripper_pct(robot_config, "<device.config_key>", "gripper_force_pct"));
    double gripper_<solver.runtime.id>_cmd = 0.0;
    double gripper_<solver.runtime.id>_pos_rad = 0.0;
>>

device-state-init-robif2b-Robotiq2F85(solver, device) ::= <<
    serial_gripper_state gripper_<solver.runtime.id>_state{};
    gripper_<solver.runtime.id>_state.speed_cmd = motion_spec::config::gripper_pct_byte(robot_config, "<device.config_key>", "gripper_speed_pct");
    gripper_<solver.runtime.id>_state.force_cmd = motion_spec::config::gripper_pct_byte(robot_config, "<device.config_key>", "gripper_force_pct");
    double gripper_<solver.runtime.id>_cmd = 0.0;
    double gripper_<solver.runtime.id>_pos_rad = 0.0;
>>

device-state-init-robif2b-RobotiqFT300s(solver, device) ::= <<
    ft_sensor_state ft_<device.drives>_state{};
>>

// Each bound device opens its own connection, except a gripper on the arm's interconnect --
// there the arm was the device named, so the arm's rule set wires both.
device-init-robif2b(solver, device) ::= <<
<({device-init-robif2b-<device.kind>})(solver, device)>
>>

device-configure-robif2b(solver, device) ::= <<
<({device-configure-robif2b-<device.kind>})(solver, device)>
>>

device-update-robif2b(solver, device) ::= <<
<({device-update-robif2b-<device.kind>})(solver, device)>
>>

device-shutdown-robif2b(solver, device) ::= <<
<({device-shutdown-robif2b-<device.kind>})(solver, device)>
>>

// The 2F-85's driver joint travels 0.8 rad from fully open to fully closed. A device fact:
// every 2F-85 is the same gripper, whichever route reaches it.
gripper-travel-Robotiq2F85() ::= "0.8"

device-init-robif2b-KinovaGen3(solver, device) ::= <<
<if(solver.runtime.owner)>    const auto cfg_<solver.runtime.id> = motion_spec::config::device(robot_config, "<device.config_key>");
    robif2b_kinova_gen3_nbx kinova_<solver.runtime.id>{};
    kinova_<solver.runtime.id>.conf.ip_address = cfg_<solver.runtime.id>.ip.c_str();
    kinova_<solver.runtime.id>.conf.port = cfg_<solver.runtime.id>.port;
    kinova_<solver.runtime.id>.conf.port_real_time = cfg_<solver.runtime.id>.port_real_time;
    kinova_<solver.runtime.id>.conf.user = cfg_<solver.runtime.id>.user.c_str();
    kinova_<solver.runtime.id>.conf.password = cfg_<solver.runtime.id>.password.c_str();
    kinova_<solver.runtime.id>.conf.session_timeout = cfg_<solver.runtime.id>.session_timeout_ms;
    kinova_<solver.runtime.id>.conf.connection_timeout = cfg_<solver.runtime.id>.connection_timeout_ms;
    // The arm integrates a velocity command over this, and asserts on it every update: it is
    // the period the model declares, the same one the loop sleeps to.
    kinova_<solver.runtime.id>.cycle_time = &motion_spec::runtime::kControlPeriodS;
    kinova_<solver.runtime.id>.ctrl_mode = &kinova_<solver.runtime.id>_state.ctrl_mode;
    kinova_<solver.runtime.id>.jnt_pos_msr = &kinova_<solver.runtime.id>_state.pos_msr[0];
    kinova_<solver.runtime.id>.jnt_vel_msr = &kinova_<solver.runtime.id>_state.vel_msr[0];
    kinova_<solver.runtime.id>.jnt_trq_msr = &kinova_<solver.runtime.id>_state.eff_msr[0];
    kinova_<solver.runtime.id>.act_cur_msr = &kinova_<solver.runtime.id>_state.cur_msr[0];
    kinova_<solver.runtime.id>.jnt_pos_cmd = &kinova_<solver.runtime.id>_state.pos_cmd[0];
    kinova_<solver.runtime.id>.jnt_vel_cmd = &kinova_<solver.runtime.id>_state.vel_cmd[0];
    kinova_<solver.runtime.id>.jnt_trq_cmd = &kinova_<solver.runtime.id>_state.eff_cmd[0];
    kinova_<solver.runtime.id>.act_cur_cmd = &kinova_<solver.runtime.id>_state.cur_cmd[0];
    kinova_<solver.runtime.id>.success = &kinova_<solver.runtime.id>_state.success;
<endif>
>>

// One device, one connection: the gripper rides the arm's interconnect and needs no section
// of its own, so this is the arm's rule set plus the gripper hanging off its comm.
device-init-robif2b-KinovaGen3-2F85(solver, device) ::= <<
<device-init-robif2b-KinovaGen3(solver, device)>
<if(solver.runtime.owner)>    robif2b_kg3_robotiq_gripper_nbx gripper_<solver.runtime.id>{};
    gripper_<solver.runtime.id>.gripper_pos_msr = &gripper_<solver.runtime.id>_state.pos_msr;
    gripper_<solver.runtime.id>.gripper_vel_msr = &gripper_<solver.runtime.id>_state.vel_msr;
    gripper_<solver.runtime.id>.gripper_cur_msr = &gripper_<solver.runtime.id>_state.cur_msr;
    gripper_<solver.runtime.id>.gripper_pos_cmd = &gripper_<solver.runtime.id>_state.pos_cmd;
    gripper_<solver.runtime.id>.gripper_vel_cmd = &gripper_<solver.runtime.id>_state.vel_cmd;
    gripper_<solver.runtime.id>.gripper_frc_cmd = &gripper_<solver.runtime.id>_state.frc_cmd;
    gripper_<solver.runtime.id>.success = &gripper_<solver.runtime.id>_state.success;
<endif>
>>

device-init-robif2b-Robotiq2F85(solver, device) ::= <<
<if(solver.runtime.owner)>    const auto cfg_gripper_<solver.runtime.id> = motion_spec::config::serial(robot_config, "<device.config_key>");
    robif2b_robotiq_gripper_nbx gripper_<solver.runtime.id>{};
    gripper_<solver.runtime.id>.serial.port = cfg_gripper_<solver.runtime.id>.port.c_str();
    gripper_<solver.runtime.id>.serial.baudrate = cfg_gripper_<solver.runtime.id>.baudrate;
    gripper_<solver.runtime.id>.serial.timeout_ms = cfg_gripper_<solver.runtime.id>.timeout_ms;
    gripper_<solver.runtime.id>.serial.slave_address = cfg_gripper_<solver.runtime.id>.slave_address;
    gripper_<solver.runtime.id>.position_msr = &gripper_<solver.runtime.id>_state.position_msr;
    gripper_<solver.runtime.id>.is_gripper_moving = &gripper_<solver.runtime.id>_state.is_moving;
    gripper_<solver.runtime.id>.obj_detection_status = &gripper_<solver.runtime.id>_state.obj_status;
    gripper_<solver.runtime.id>.gripper_status = &gripper_<solver.runtime.id>_state.status;
    gripper_<solver.runtime.id>.position_cmd = &gripper_<solver.runtime.id>_state.position_cmd;
    gripper_<solver.runtime.id>.speed_cmd = &gripper_<solver.runtime.id>_state.speed_cmd;
    gripper_<solver.runtime.id>.force_cmd = &gripper_<solver.runtime.id>_state.force_cmd;
    gripper_<solver.runtime.id>.error = &gripper_<solver.runtime.id>_state.error;
    gripper_<solver.runtime.id>.success = &gripper_<solver.runtime.id>_state.success;
<endif>
>>

device-init-robif2b-RobotiqFT300s(solver, device) ::= <<
<if(solver.runtime.owner)>    const auto cfg_ft_<device.drives> = motion_spec::config::serial(robot_config, "<device.config_key>");
    robif2b_robotiq_ft_sensor_nbx ft_<device.drives>{};
    ft_<device.drives>.serial.port = cfg_ft_<device.drives>.port.c_str();
    ft_<device.drives>.serial.baudrate = cfg_ft_<device.drives>.baudrate;
    ft_<device.drives>.serial.timeout_ms = cfg_ft_<device.drives>.timeout_ms;
    ft_<device.drives>.serial.slave_address = cfg_ft_<device.drives>.slave_address;
    ft_<device.drives>.force_msr = &ft_<device.drives>_state.force[0];
    ft_<device.drives>.force_offset = &ft_<device.drives>_state.force_offset[0];
    ft_<device.drives>.moment_msr = &ft_<device.drives>_state.moment[0];
    ft_<device.drives>.moment_offset = &ft_<device.drives>_state.moment_offset[0];
    ft_<device.drives>.success = &ft_<device.drives>_state.success;
<endif>
>>

device-configure-robif2b-KinovaGen3(solver, device) ::= <<
    <robif2b-configure-kinova(solver.runtime.id)>
    <robif2b-recover-kinova(solver.runtime.id)>
    <robif2b-start-kinova(solver.runtime.id)>
>>

device-configure-robif2b-KinovaGen3-2F85(solver, device) ::= <<
<device-configure-robif2b-KinovaGen3(solver, device)>
    robif2b_kg3_robotiq_gripper_configure(&gripper_<solver.runtime.id>, &kinova_<solver.runtime.id>);
    robif2b_kg3_robotiq_gripper_start(&gripper_<solver.runtime.id>);
>>

device-configure-robif2b-Robotiq2F85(solver, device) ::= <<
    robif2b_robotiq_gripper_configure(&gripper_<solver.runtime.id>);
>>

device-configure-robif2b-RobotiqFT300s(solver, device) ::= <<
    robif2b_robotiq_ft_configure(&ft_<device.drives>);
>>

device-update-robif2b-KinovaGen3(solver, device) ::= <<
        <robif2b-update-kinova(solver.runtime.id)>
>>

device-update-robif2b-KinovaGen3-2F85(solver, device) ::= <<
<device-update-robif2b-KinovaGen3(solver, device)>
        gripper_<solver.runtime.id>_state.pos_cmd = static_cast\<float\>(
            100.0 * motion_spec::runtime::gripper_closed_fraction(
                gripper_<solver.runtime.id>_cmd, <gripper-travel-Robotiq2F85()>));
        robif2b_kg3_robotiq_gripper_update(&gripper_<solver.runtime.id>);
        gripper_<solver.runtime.id>_pos_rad =
            <gripper-travel-Robotiq2F85()> * (gripper_<solver.runtime.id>_state.pos_msr / 100.0);
>>

device-update-robif2b-Robotiq2F85(solver, device) ::= <<
        gripper_<solver.runtime.id>_state.position_cmd = static_cast\<uint8_t\>(std::lround(
            255.0 * motion_spec::runtime::gripper_closed_fraction(
                gripper_<solver.runtime.id>_cmd, <gripper-travel-Robotiq2F85()>)));
        robif2b_robotiq_gripper_update(&gripper_<solver.runtime.id>);
        gripper_<solver.runtime.id>_pos_rad =
            <gripper-travel-Robotiq2F85()> * (gripper_<solver.runtime.id>_state.position_msr / 255.0);
>>

device-update-robif2b-RobotiqFT300s(solver, device) ::= <<
        robif2b_robotiq_ft_update(&ft_<device.drives>);
>>

device-shutdown-robif2b-KinovaGen3(solver, device) ::= <<
    <robif2b-stop-kinova(solver.runtime.id)>
    <robif2b-shutdown-kinova(solver.runtime.id)>
>>

device-shutdown-robif2b-KinovaGen3-2F85(solver, device) ::= <<
    robif2b_kg3_robotiq_gripper_stop(&gripper_<solver.runtime.id>);
<device-shutdown-robif2b-KinovaGen3(solver, device)>
>>

device-shutdown-robif2b-Robotiq2F85(solver, device) ::= <<
    robif2b_robotiq_gripper_shutdown(&gripper_<solver.runtime.id>);
>>

device-shutdown-robif2b-RobotiqFT300s(solver, device) ::= <<
    robif2b_robotiq_ft_shutdown(&ft_<device.drives>);
>>

// Where the forwarding block leaves the commanded joint position for this chain's gripper.
device-assign-impl ::= [
    "KinovaGen3-2F85": "device-assign-robif2b-gripper-cmd",
    "Robotiq2F85": "device-assign-robif2b-gripper-cmd",
    default: "device-nothing"
]

device-assign-robif2b-gripper-cmd(solver, device) ::= <<
        .gripper_cmd = &gripper_<solver.runtime.id>_cmd,
        .gripper_pos = &gripper_<solver.runtime.id>_pos_rad,
>>

robot-chain-robif2b-KinovaGen3(solver) ::= <<
<if(solver.runtime.owner)>    KDL::Tree built_tree_<solver.runtime.id>{};
    if (!scene_kdl::make_tree_<solver.chain.kdl_tree>(&built_tree_<solver.runtime.id>)) {
        std::cerr \<\< "make_tree_<solver.chain.kdl_tree>() failed for runtime <solver.runtime.id>\n";
        return 1;
    \}
    KDL::Chain chain_<solver.runtime.id>{};
    if (!scene_kdl::make_chain_<solver.chain.kdl_chain>(built_tree_<solver.runtime.id>, &chain_<solver.runtime.id>)) {
        std::cerr \<\< "make_chain_<solver.chain.kdl_chain>() failed for runtime <solver.runtime.id>\n";
        return 1;
    \}
<endif>
>>

robot-assign-robif2b-KinovaGen3(solver) ::= <<
    robot.<solver.id> = manipulator_robot{
        .state = &kinova_<solver.runtime.id>_state,
        .robot = &kinova_<solver.runtime.id>,
        .chain = &chain_<solver.runtime.id>,
<solver.devices:{device | <({<device-assign-impl.(device.kind)>})(solver, device)>}; separator="">
    };
>>

robot-configure-robif2b-KinovaGen3(solver) ::= <<
<if(solver.runtime.owner)><solver.devices:{device | <device-configure-robif2b(solver, device)>}; separator="\n">
<endif>
>>

robot-shutdown-robif2b-KinovaGen3(solver) ::= <<
<if(solver.runtime.owner)><solver.devices:{device | <device-shutdown-robif2b(solver, device)>}; separator="\n">
<endif>
>>

app-chain-includes-robif2b(has_serial_chain) ::= <<
<if(has_serial_chain)>
#include \<iostream\>
#include "robot_config.hpp"
<endif>
>>

app-chain-setup-robif2b(serial_chain_solvers, scene, config_path) ::= <<
    const auto robot_config = motion_spec::config::load("<config_path>");
<serial_chain_solvers:{solver |

<robot-state-init(solver, "robif2b")>

<if(solver.runtime.owner)><solver.devices:{device | <device-init-robif2b(solver, device)>}; separator="\n"><endif>

<robot-chain(solver, "robif2b")>

<robot-assign(solver, "robif2b")>
<if(solver.runtime.owner)><solver.devices:{device | <({<device-io-assign-impl.(device.kind)>})(solver, device)>}; separator=""><endif>
}; separator="\n">
>>

app-loop-condition-robif2b(has_serial_chain) ::= <<
true
>>

app-chain-runtime-step-robif2b(serial_chain_solvers) ::= <<
<serial_chain_solvers:{solver | <if(solver.runtime.owner)><solver.devices:{device | <device-update-robif2b(solver, device)>
}; separator=""><endif>}; separator="">
>>

app-chain-trace-update-robif2b(serial_chain_solvers, trace) ::= <<
>>

app-chain-cleanup-robif2b(has_serial_chain) ::= <<
>>


cmake-device-link-KinovaGen3() ::= <<
    robif2b::kinova_gen3
>>

cmake-device-link-KinovaGen3-2F85() ::= <<
    robif2b::kinova_gen3
>>

cmake-device-link-Robotiq2F85() ::= <<
    robif2b::robotiq_gripper
>>

cmake-device-link-RobotiqFT300s() ::= <<
    robif2b::robotiq_ft_sensor
>>

robif2b-configure-kinova(side) ::= <<
robif2b_kinova_gen3_configure(&kinova_<side>);
>>

robif2b-recover-kinova(side) ::= <<
robif2b_kinova_gen3_recover(&kinova_<side>);
>>

robif2b-start-kinova(side) ::= <<
robif2b_kinova_gen3_start(&kinova_<side>);
>>

robif2b-update-kinova(side) ::= <<
robif2b_kinova_gen3_update(&kinova_<side>);
>>

robif2b-stop-kinova(side) ::= <<
robif2b_kinova_gen3_stop(&kinova_<side>);
>>

robif2b-shutdown-kinova(side) ::= <<
robif2b_kinova_gen3_shutdown(&kinova_<side>);
>>
