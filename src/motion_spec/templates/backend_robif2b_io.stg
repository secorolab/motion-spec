// SPDX-License-Identifier: MPL-2.0
// robif2b backend: the lock-free handoff between the control loop and one thread per serial device.

device_io_header(resources) ::= <<
// GENERATED by motion-spec codegen. Do not edit.
#pragma once

#include \<atomic\>
#include \<chrono\>
#include \<cstdint\>
#include \<iostream\>
#include \<stdexcept\>
#include \<stop_token\>
#include \<string\>
#include \<string_view\>
#include \<thread\>
#include \<type_traits\>

<resources.by_kind.serial_chain:{solver | <if(solver.runtime.owner)><solver.devices:{device | <({<device-io-include-impl.(device.kind)>})(solver, device)>}; separator=""><endif>}; separator="">
#include "robot_config.hpp"
#include "runtime.hpp"

namespace motion_spec::config {

// How long a device may go without completing a transaction before the run stops. Optional like
// every property no connection depends on; a bus that cannot deliver within it is not a bus the
// loop can command against.
inline double stale_after_ms(const toml::table &config, const std::string &key) {
    const double value = config.at_path(key + ".stale_after_ms").value_or(100.0);
    if (value \<= 0.0) {
        throw std::runtime_error("robot config [" + key + "] has a non-positive 'stale_after_ms'");
    \}
    return value;
\}

// How long failed transactions may persist before the run stops. Zero stops on the first one;
// a deployment whose driver reconnects by itself states the window that recovery needs.
inline double invalid_after_ms(const toml::table &config, const std::string &key) {
    const double value = config.at_path(key + ".invalid_after_ms").value_or(0.0);
    if (value \< 0.0) {
        throw std::runtime_error("robot config [" + key + "] has a negative 'invalid_after_ms'");
    \}
    return value;
\}

// The Robotiq example leaves this gap after each update. The driver already waits while reading;
// this is the quiet time before the next read, kept tunable for the real serial adapter.
inline double ft_poll_interval_ms(const toml::table &config, const std::string &key) {
    const double value = config.at_path(key + ".poll_interval_ms").value_or(10.0);
    if (value \< 0.0) {
        throw std::runtime_error("robot config [" + key + "] has a negative 'poll_interval_ms'");
    \}
    return value;
\}

\} // namespace motion_spec::config

namespace motion_spec::io {

// A device command is one byte the loop stores and the thread loads: the thread sends whatever is
// current when it reaches its next transaction, and a command from three cycles ago has no value.
// The loop must never wait to leave one behind.
static_assert(std::atomic\<std::uint8_t\>::is_always_lock_free);

// How many cycles the loop waits for a device before it counts as stalled.
inline std::uint64_t stale_after_cycles(double stale_after_ms, double period_s) {
    return 1 + static_cast\<std::uint64_t\>(stale_after_ms * 1e-3 / period_s);
\}

// What the loop remembers about one device between cycles.
struct Staleness {
    std::uint64_t limit = 0;
    std::uint64_t last = 0;
    std::uint64_t cycles = 0;
    std::uint64_t invalid_limit = 1;
    std::uint64_t invalid_cycles = 0;
};

// A device thread that stops advancing is as bad as one that fails: its measurement keeps the
// value it last had, so the next solve would price a pose nothing stands behind. The loop cannot
// see a transaction in flight, so freshness is what it checks instead of a per-cycle result.
inline void require_fresh(Staleness &staleness, std::uint64_t seq, bool ok, bool required,
                          std::string_view device) {
    if (motion_spec::runtime::stop_requested()) return;
    const bool advanced = seq != staleness.last;
    if (advanced) {
        staleness.last = seq;
        staleness.cycles = 0;
        if (!ok) {
            std::cerr \<\< "[run] device '" \<\< device \<\< "' reported a failed transaction"
                      \<\< std::endl;
        \}
    \}
    if (!required) {
        staleness.cycles = 0;
        staleness.invalid_cycles = 0;
        return;
    \}
    if (!ok) {
        // The driver recovers a dropped connection on its own, which takes it a moment: the grace
        // period is how long the loop lets it try. Past that the sensor is gone, not busy.
        if (++staleness.invalid_cycles \< staleness.invalid_limit) return;
        std::cerr \<\< "[run] device '" \<\< device
                  \<\< "' had no valid reading for its grace period; stopping" \<\< std::endl;
        motion_spec::runtime::request_stop(0);
        return;
    \}
    staleness.invalid_cycles = 0;
    if (advanced) return;
    if (++staleness.cycles \< staleness.limit) return;
    std::cerr \<\< "[run] device '" \<\< device \<\< "' completed no transaction in time; stopping"
              \<\< std::endl;
    motion_spec::runtime::request_stop(0);
\}

\} // namespace motion_spec::io

<resources.by_kind.serial_chain:{solver | <if(solver.runtime.owner)><solver.devices:{device | <({<device-io-section-impl.(device.kind)>})(solver, device)>}; separator="\n\n"><endif>}; separator="\n\n">
>>

device-io-include-impl ::= [
    "Robotiq2F85": "device-io-include-Robotiq2F85",
    "RobotiqFT300s": "device-io-include-RobotiqFT300s",
    default: "device-io-nothing"
]

device-io-include-Robotiq2F85(solver, device) ::= <<
#include \<robif2b/functions/robotiq_gripper.h\>

>>

device-io-include-RobotiqFT300s(solver, device) ::= <<
#include \<robif2b/functions/robotiq_ft_sensor.h\>

>>

// One section per device the deployment binds: a model without an FT carries no FT code.
device-io-section-impl ::= [
    "Robotiq2F85": "device-io-section-Robotiq2F85",
    "RobotiqFT300s": "device-io-section-RobotiqFT300s",
    default: "device-io-nothing"
]

device-io-nothing(solver, device) ::= <<>>

device-io-section-Robotiq2F85(solver, device) ::= <<
// Gripper on its own serial line: the same ports as the interconnect route, counted 0-255.
struct serial_gripper_state {
    bool success = false;
    uint8_t position_msr = 0;
    double current_msr = 0.0;
    bool is_moving = false;
    robif2b_robotiq_gripper_obj_status obj_status = ROBIF2B_ROBOTIQ_OBJ_UNKNOWN;
    robif2b_robotiq_gripper_status status = ROBIF2B_ROBOTIQ_UNKNOWN;
    uint8_t position_cmd = 0;
    uint8_t speed_cmd = 0;
    uint8_t force_cmd = 0;
    robif2b_robotiq_gripper_error error = ROBIF2B_ROBOTIQ_NO_ERROR;
\};

<sampled-buffer({serial_gripper_state}, {serial_gripper_sample})>

// Everything one serial gripper needs to live off the loop: the thread owns the driver
// transaction and the state it writes through; the loop touches only the command byte, the
// sampled measurement and the staleness count.
struct serial_gripper_io {
    serial_gripper_state state{\};
    serial_gripper_sample sample;
    std::atomic\<std::uint8_t\> wire_cmd{0\};
    motion_spec::io::Staleness stale;
    std::jthread thread;

    // Start only once the connection exists. The first transaction must command the gripper to
    // where configure just read it -- an unset command byte would fling it open. No sleep and
    // no pacing: the bus transaction is the rate limit.
    void start(robif2b_robotiq_gripper_nbx &driver) {
        wire_cmd = state.position_msr;
        thread = std::jthread([this, &driver](std::stop_token token) {
            while (!token.stop_requested()) {
                state.position_cmd = wire_cmd;
                robif2b_robotiq_gripper_update(&driver);
                sample.publish(state);
            \}
        \});
    \}

    // Stop before the driver's shutdown: the thread must not touch a deleted connection.
    void stop() {
        thread.request_stop();
        if (thread.joinable()) thread.join();
    \}
\};
>>

device-io-section-RobotiqFT300s(solver, device) ::= <<
struct ft_sensor_state {
    bool success = false;
    float force[3] = {0.0f\};
    float force_offset[3] = {0.0f\};
    float moment[3] = {0.0f\};
    float moment_offset[3] = {0.0f\};
\};

<sampled-buffer({ft_sensor_state}, {ft_sensor_sample})>

struct ft_sensor_io {
    ft_sensor_state state{\};
    ft_sensor_sample sample;
    motion_spec::io::Staleness stale;
    std::jthread thread;

    void start(robif2b_robotiq_ft_sensor_nbx &driver, double poll_interval_ms) {
        thread = std::jthread([this, &driver, poll_interval_ms](std::stop_token token) {
            while (!token.stop_requested()) {
                robif2b_robotiq_ft_update(&driver);
                sample.publish(state);
                std::this_thread::sleep_for(
                    std::chrono::duration\<double, std::milli\>(poll_interval_ms));
            \}
        \});
    \}

    void stop() {
        thread.request_stop();
        if (thread.joinable()) thread.join();
    \}
\};
>>

// Thread -> loop, stamped once per device state type so the generated code stays template-free.
// The last completed measurement and the sequence it was published under: the loop reads a
// last-known value with an age, never a reading taken this cycle. One writer and one reader, and
// the loop copies in nanoseconds while a transaction takes milliseconds, so the reader cannot be
// lapped mid-copy and needs no retry.
sampled-buffer(state, sample) ::= <<
struct <sample> {
    struct snapshot {
        <state> value{};
        std::uint64_t seq = 0;   // 0: the device has not measured yet
    \};

    void publish(const <state> &value) {
        const std::uint64_t seq = published.load(std::memory_order_relaxed);
        slot[seq & 1] = value;
        published.store(seq + 1, std::memory_order_release);
    \}

    snapshot read() const {
        const std::uint64_t seq = published.load(std::memory_order_acquire);
        if (seq == 0) return snapshot{\};
        return snapshot{slot[(seq - 1) & 1], seq\};
    \}

    // Startup only, where waiting is allowed: the first cycle must not run against a device
    // that has never measured.
    snapshot await(double timeout_ms) const {
        const auto deadline = std::chrono::steady_clock::now() +
                              std::chrono::duration\<double, std::milli\>(timeout_ms);
        snapshot latest = read();
        while (latest.seq == 0 && std::chrono::steady_clock::now() \< deadline) {
            std::this_thread::yield();
            latest = read();
        \}
        return latest;
    \}

    <state> slot[2]{\};
    std::atomic\<std::uint64_t\> published{0\};
\};
static_assert(std::is_trivially_copyable_v\<<state>\>, "a measurement crosses the handoff by copy");
>>
