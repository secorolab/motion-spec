// SPDX-License-Identifier: MPL-2.0
// Backend-neutral robot driver dispatch (include/state/init/chain/shutdown).
// A backend that drives real hardware dispatches on to the robot model itself.


robot-driver-include(solver, backend, model_name, resources) ::= <<
<({robot-driver-include-<backend>})(solver, model_name, resources)>
>>

solver-rnea-include(backend) ::= <<
<({solver-rnea-include-<backend>})()>
>>

solver-rnea-include-mj_kdl() ::= <<
#include \<kdl/chainidsolver_recursive_newton_euler.hpp\>
#include \<kdl/chainexternalwrenchestimator.hpp\>
#include \<kdl/chainjnttojacsolver.hpp\>
#include \<kdl/chainjnttojacdotsolver.hpp\>
>>

solver-rnea-include-robif2b() ::= <<
#include \<kdl/chainidsolver_recursive_newton_euler.hpp\>
#include \<kdl/chainexternalwrenchestimator.hpp\>
#include \<kdl/chainjnttojacsolver.hpp\>
#include \<kdl/chainjnttojacdotsolver.hpp\>
>>

robot-num-joints-def(solver, backend) ::= <<
<({robot-num-joints-def-<backend>})(solver)>
>>

robot-state-struct(solver, backend) ::= <<
<({robot-state-struct-<backend>})(solver)>
>>

robot-manipulator-struct(solver, backend) ::= <<
<({robot-manipulator-struct-<backend>})(solver)>
>>

robot-state-init(solver, backend) ::= <<
<({robot-state-init-<backend>})(solver)>
>>

robot-init(solver, backend) ::= <<
<({robot-init-<backend>})(solver)>
>>

robot-chain(solver, backend) ::= <<
<({robot-chain-<backend>})(solver)>
>>

robot-assign(solver, backend) ::= <<
<({robot-assign-<backend>})(solver)>
>>

robot-configure(solver, backend) ::= <<
<({robot-configure-<backend>})(solver)>
>>

robot-shutdown(solver, backend) ::= <<
<({robot-shutdown-<backend>})(solver)>
>>

// Where this backend already keeps the chain's nth joint. The port table binds those addresses
// rather than copying, so the world model, the solvers and the driver read one buffer.
world-chain-port-address(solver, backend, index) ::= <<
<({world-chain-port-address-<backend>})(solver, index)>
>>

// The provider address of one port of the table. A backend that provides nothing of that kind
// falls through to the null default, which startup refuses by name.
world-port-address(backend, kind, port) ::= <<
<({<world-port-address-impl.({<kind>-<backend>})>})(port)>
>>

world-port-none(port) ::= "nullptr"

world-port-address-impl ::= [
    "free_root-mj_kdl": "world-port-free-root-mj_kdl",
    "free_root_seq-mj_kdl": "world-port-free-root-seq-mj_kdl",
    "joint-mj_kdl": "world-port-joint-mj_kdl",
    "joint_velocity-mj_kdl": "world-port-joint-velocity-mj_kdl",
    "aux_cmd-mj_kdl": "world-port-aux-cmd-mj_kdl",
    "wrench_cmd-mj_kdl": "world-port-wrench-cmd-mj_kdl",
    "joint-robif2b": "world-port-joint-robif2b",
    "joint_velocity-robif2b": "world-port-joint-velocity-robif2b",
    "joint_current-robif2b": "world-port-joint-current-robif2b",
    "aux_cmd-robif2b": "world-port-aux-cmd-robif2b",
    default: "world-port-none"
]
