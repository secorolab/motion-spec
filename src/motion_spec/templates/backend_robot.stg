// SPDX-License-Identifier: MPL-2.0
// Backend-neutral robot driver dispatch (include/state/init/chain/shutdown).


robot-driver-include(solver, backend, model_name, resources) ::= <<
<({robot-driver-include-<backend>-<solver.hardware.model>})(solver, model_name, resources)>
>>

solver-rnea-include(backend) ::= <<
<({solver-rnea-include-<backend>})()>
>>

solver-rnea-include-mj_kdl() ::= <<
#include \<kdl/chainidsolver_recursive_newton_euler.hpp\>
#include \<kdl/chainexternalwrenchestimator.hpp\>
#include \<kdl/chainjnttojacsolver.hpp\>
#include \<kdl/chainjnttojacdotsolver.hpp\>
>>

solver-rnea-include-robif2b() ::= <<
#include \<kdl/chainidsolver_recursive_newton_euler.hpp\>
#include \<kdl/chainexternalwrenchestimator.hpp\>
#include \<kdl/chainjnttojacsolver.hpp\>
#include \<kdl/chainjnttojacdotsolver.hpp\>
>>

robot-num-joints-def(solver) ::= <<
<({robot-num-joints-def-<solver.hardware.model>})(solver)>
>>
robot-num-joints-def-KinovaGen3(solver) ::= <<
inline constexpr int KINOVA_NUM_JOINTS = 7;
>>

robot-state-struct(solver, backend) ::= <<
<({robot-state-struct-<backend>-<solver.hardware.model>})(solver)>
>>

robot-manipulator-struct(solver, backend) ::= <<
<({robot-manipulator-struct-<backend>-<solver.hardware.model>})(solver)>
>>

robot-state-init(solver, backend) ::= <<
<({robot-state-init-<backend>-<solver.hardware.model>})(solver)>
>>

robot-init(solver, backend) ::= <<
<({robot-init-<backend>-<solver.hardware.model>})(solver)>
>>

robot-chain(solver, backend) ::= <<
<({robot-chain-<backend>-<solver.hardware.model>})(solver)>
>>

robot-assign(solver, backend) ::= <<
<({robot-assign-<backend>-<solver.hardware.model>})(solver)>
>>

robot-configure(solver, backend) ::= <<
<({robot-configure-<backend>-<solver.hardware.model>})(solver)>
>>

robot-shutdown(solver, backend) ::= <<
<({robot-shutdown-<backend>-<solver.hardware.model>})(solver)>
>>

// The one backend-specific fact the world model's wiring needs: where this backend already keeps
// the measured position of the chain's nth joint. The world model binds that address rather than
// copying, so it and the dynamics read one buffer.
world-joint-address(solver, backend, index) ::= <<
<({world-joint-address-<backend>})(solver, index)>
>>
