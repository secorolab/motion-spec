// SPDX-License-Identifier: MPL-2.0
// Function/evaluator library (emit-call) and pose-axis error groups.

import "values.stg"
import "poses.stg"

emit-call(function, views) ::= <<
<({emit-call-<function.type>})(function, views)>
>>

emit-call-AssignmentEvaluator(function, views) ::= <<
data.<function.quantity> = <access-expr(function.reference_value, views)>;
>>

// error_normalization: the controller states the interval its error is read into.
// angular_wrap: the joint is continuous, so the error is the shortest arc, never the long way round.
emit-call-ErrorEvaluator-EqualityConstraint(function, views) ::= <<
data.<function.error> = <if(function.error_normalization)>motion_spec::runtime::normalize_joint_position(motion_spec::runtime::evaluate_equality_constraint(<access-expr(function.reference_value, views)>, <access-expr(function.quantity, views)>), <function.error_normalization.lower>, <function.error_normalization.upper>)<elseif(function.angular_wrap)>motion_spec::runtime::wrap_angle(motion_spec::runtime::evaluate_equality_constraint(<access-expr(function.reference_value, views)>, <access-expr(function.quantity, views)>))<else>motion_spec::runtime::evaluate_equality_constraint(<access-expr(function.reference_value, views)>, <access-expr(function.quantity, views)>)<endif>;
>>

emit-call-ErrorEvaluator-GreaterThanConstraint(function, views) ::= <<
data.<function.error> = motion_spec::runtime::evaluate_greater_than_constraint(<access-expr(function.quantity, views)>, <access-expr(function.threshold, views)>);
>>

emit-call-ErrorEvaluator-LessThanConstraint(function, views) ::= <<
data.<function.error> = motion_spec::runtime::evaluate_less_than_constraint(<access-expr(function.quantity, views)>, <access-expr(function.threshold, views)>);
>>

emit-call-ErrorEvaluator-BilateralConstraint(function, views) ::= <<
data.<function.error> = motion_spec::runtime::evaluate_bilateral_constraint(<access-expr(function.quantity, views)>, <access-expr(function.lower_threshold, views)>, <access-expr(function.upper_threshold, views)>);
>>

emit-call-ErrorEvaluator-OutsideConstraint(function, views) ::= <<
data.<function.error> = motion_spec::runtime::evaluate_outside_constraint(<access-expr(function.quantity, views)>, <access-expr(function.lower_threshold, views)>, <access-expr(function.upper_threshold, views)>);
>>

emit-call-ErrorEvaluator(function, views) ::= <<
<({emit-call-ErrorEvaluator-<function.constraint>})(function, views)>
>>

emit-call-PoseDiffEvaluator(function, views) ::= <<
data.<function.out> = KDL::diff(data.<function.in1>, data.<function.in2>);
<function.errors:{error | data.<error> = <access-expr(error, views)>;}; separator="\n">
>>

// A path's geometry is one definition: `path-eval-<shape>` binds it to a local `_path_eval`
// so the projection can sample it while searching, and every use evaluates the same curve.
path-eval(function, views) ::= <<
<({path-eval-<function.shape>})(function, views)>
>>

emit-call-PathProjection(function, views) ::= <<
{
<path-eval(function, views)>
    data.<function.path_parameter> = motion_spec::runtime::path_project(
        _path_eval, data.<function.pose>.p, data.<function.path_parameter>);
}
>>

emit-call-PathTangentFrame(function, views) ::= <<
{
<path-eval(function, views)>
    motion_spec::runtime::path_frame(
        _path_eval, data.<function.path_parameter>,
        data.<function.tangent>, data.<function.normal_a>, data.<function.normal_b>);
}
>>

// Measured at the attachment point rather than differentiated from the parameter, so it
// stays honest once the frame reaches the end of the path.
emit-call-TwistToLinearVelocityAlong(function, views) ::= <<
data.<function.along_speed> = KDL::dot(data.<function.in>.vel, data.<function.direction>);
>>

// The direction need not be unit: the projection divides by its own length squared.
emit-call-VectorNorm(function, views) ::= <<
<if(function.direction)>{
    const KDL::Vector _v = <access-expr(function.in, views)>;
    const KDL::Vector _n = data.<function.direction>;
    data.<function.norm> = (_v - (KDL::dot(_v, _n) / KDL::dot(_n, _n)) * _n).Norm();
}<else>data.<function.norm> = (<access-expr(function.in, views)>).Norm();<endif>
>>

emit-call-PathEvaluator(function, views) ::= <<
{
<path-eval(function, views)>
    data.<function.setpoint> = _path_eval(data.<function.path_parameter>);
}
>>

path-eval-LinearPath(function, views) ::= <<
    const KDL::Frame _goal = <if(function.assign_goal)><pose-frame-inline(function.goal_components, views)><else>data.<function.goal><endif>;
<if(function.assign_goal)>    data.<function.goal> = _goal;
<endif>    const auto _path_eval = [&](double _s) -> KDL::Frame {
        return KDL::addDelta(data.<function.start>, KDL::diff(data.<function.start>, _goal),
                             std::clamp(_s, 0.0, 1.0));
    };
>>

emit-call-VelocityProfile(function, views) ::= <<
<if(function.path_parameter)><emit-call-PathVelocityProfile(function, views)><else><emit-call-TargetVelocityProfile(function, views)><endif>
>>

emit-call-TargetVelocityProfile(function, views) ::= <<
{
    if (!state.<function.controller>.vp_init) {
        state.<function.controller>.vp_setpoint = <access-expr(function.measured, views)>;
        state.<function.controller>.vp_velocity = <if(function.in)><access-expr(function.in, views)><else>0.0<endif>;
        state.<function.controller>.vp_accel = 0.0;
        state.<function.controller>.vp_init = true;
    }
    data.<function.out> = motion_spec::runtime::velocity_profile_step(
        state.<function.controller>.vp_setpoint,
        state.<function.controller>.vp_velocity,
        state.<function.controller>.vp_accel,
        <access-expr(function.profile_target, views)>,
        <access-expr(function.maximum_velocity, views)>,
        <access-expr(function.maximum_acceleration, views)>,
        <if(function.maximum_jerk)><access-expr(function.maximum_jerk, views)><else>0.0<endif>,
        data.dt_measured_s,
        <velocity-profile-shape.(function.shape)>);
    state.<function.controller>.vp_setpoint = data.<function.out>;
}
>>

emit-call-PathVelocityProfile(function, views) ::= <<
{
<path-eval(function, views)>
    if (!state.<function.controller>.vp_init) {
        state.<function.controller>.vp_setpoint = <access-expr(function.measured, views)>;
        state.<function.controller>.vp_accel = 0.0;
        state.<function.controller>.vp_init = true;
    }
    const double _remaining = motion_spec::runtime::remaining_path_length(
        _path_eval, data.<function.path_parameter>);
    data.<function.out> = motion_spec::runtime::path_velocity_profile_step(
        state.<function.controller>.vp_setpoint,
        state.<function.controller>.vp_accel,
        <access-expr(function.profile_target, views)>,
        <access-expr(function.maximum_velocity, views)>,
        <access-expr(function.maximum_acceleration, views)>,
        <if(function.maximum_jerk)><access-expr(function.maximum_jerk, views)><else>0.0<endif>,
        _remaining,
        data.dt_measured_s,
        <velocity-profile-shape.(function.profile_shape)>);
    state.<function.controller>.vp_setpoint = data.<function.out>;
}
>>

path-eval-Circle(function, views) ::= <<
    KDL::Vector _n = data.<function.plane_normal>;
    _n.Normalize();
    // Radial arm from center to start: alpha=0 lands exactly on start, and the orbit
    // radius is the in-plane distance between start and center (they may differ freely).
    const KDL::Vector _arm = data.<function.start>.p - data.<function.center>;
    const auto _path_eval = [&](double _s) -> KDL::Frame {
        const double _angle = 2.0 * M_PI * std::clamp(_s, 0.0, 1.0);
        return KDL::Frame(data.<function.start>.M,
                          data.<function.center> + KDL::Rotation::Rot(_n, _angle) * _arm);
    };
>>

path-eval-Arc(function, views) ::= <<
    KDL::Vector _n = data.<function.plane_normal>;
    // Circular arc from start to end that bows out of the chord by `amplitude` (the
    // sagitta). center, radius and swept angle are derived so the path begins at start,
    // ends exactly at end, and apexes amplitude away from the chord midpoint.
    // amplitude == |chord|/2 reproduces a clean semicircle (swept angle pi).
    const KDL::Vector _chord = data.<function.end>.p - data.<function.start>.p;
    const double _a = data.<function.amplitude>;
    const double _chordlen = _chord.Norm();
    // A dynamically-resolved start/end can still land on a degenerate chord at runtime;
    // hold at start rather than dividing by zero. A computed amplitude with no bulge left
    // makes the arc its chord.
    bool _valid = _chordlen > 1e-9 && _a > 1e-9;
    KDL::Vector _center = data.<function.start>.p;
    KDL::Vector _v0 = KDL::Vector::Zero();
    double _theta = 0.0;
    if (_valid) {
        const KDL::Vector _chord_hat = _chord * (1.0 / _chordlen);
        // plane-normal only names which side the arc bows to. A component along the chord
        // would tilt the sweep out of the plane and miss the end point, so drop it; a
        // normal parallel to the chord names no plane at all.
        _n = _n - KDL::dot(_n, _chord_hat) * _chord_hat;
        _valid = _n.Normalize() > 1e-9;
        if (_valid) {
            const KDL::Vector _mid = 0.5 * (data.<function.start>.p + data.<function.end>.p);
            const double _m = 0.5 * _chordlen;
            // normal x chord_hat is now the unit bulge direction directly.
            const KDL::Vector _perp = _n * _chord_hat;
            const double _R = (_a * _a + _m * _m) / (2.0 * _a);
            const double _d = (_a * _a - _m * _m) / (2.0 * _a);
            _center = _mid + _d * _perp;
            _theta = 2.0 * std::acos(std::max(-1.0, std::min(1.0, -_d / _R)));
            _v0 = data.<function.start>.p - _center;
        }
    }
    const bool _flat = _chordlen > 1e-9 && !_valid;
    const KDL::Frame _rot_start(data.<function.start>.M, KDL::Vector(0.0, 0.0, 0.0));
    const KDL::Frame _rot_goal(data.<function.end>.M, KDL::Vector(0.0, 0.0, 0.0));
    const auto _path_eval = [&](double _s) -> KDL::Frame {
        const double _sc = (_valid || _flat) ? std::clamp(_s, 0.0, 1.0) : 0.0;
        const KDL::Vector _pos = _valid ? _center + KDL::Rotation::Rot(_n, -_theta * _sc) * _v0
                               : _flat  ? data.<function.start>.p + _sc * _chord
                                        : data.<function.start>.p;
        return KDL::Frame(
            KDL::addDelta(_rot_start, KDL::diff(_rot_start, _rot_goal), _sc).M, _pos);
    };
>>

path-eval-Helix(function, views) ::= <<
    KDL::Vector _ax = data.<function.axis>;
    _ax.Normalize();
    // Radial arm from center to start: alpha=0 lands exactly on start; the helix winds
    // around the axis through center and rises along it (start and center may differ freely).
    const KDL::Vector _arm = data.<function.start>.p - data.<function.center>;
    const auto _path_eval = [&](double _s) -> KDL::Frame {
        const double _sc = std::clamp(_s, 0.0, 1.0);
        const double _angle = data.<function.revolutions> * 2.0 * M_PI * _sc;
        const double _rise = data.<function.pitch> * data.<function.revolutions> * _sc;
        return KDL::Frame(data.<function.start>.M,
                          data.<function.center>
                              + KDL::Rotation::Rot(_ax, _angle) * _arm
                              + _ax * _rise);
    };
>>

path-eval-Figure8(function, views) ::= <<
<({path-eval-Figure8-<function.form>})(function, views)>
>>

// In-plane reference axis: the anchor frame's x-axis, projected onto the plane and
// normalized (Gram-Schmidt) so it stays perpendicular to plane-normal.
figure8-plane(function) ::= <<
    KDL::Vector _n = data.<function.plane_normal>;
    _n.Normalize();
    KDL::Vector _u = data.<function.anchor>.M.UnitX();
    _u -= KDL::dot(_u, _n) * _n;
    _u.Normalize();
    const KDL::Vector _v = _n * _u;
>>

path-eval-Figure8-gerono(function, views) ::= <<
<figure8-plane(function)>
    const auto _path_eval = [&](double _s) -> KDL::Frame {
        // Phase offset of pi/2 puts alpha=0 at the curve's center crossing (the anchor),
        // so the path starts and ends at the anchor instead of darting out to a tip.
        const double _t = 2.0 * M_PI * std::clamp(_s, 0.0, 1.0) + 0.5 * M_PI;
        const double _ct = std::cos(_t);
        const double _st = std::sin(_t);
        return KDL::Frame(data.<function.anchor>.M,
                          data.<function.anchor>.p
                              + data.<function.radius> * (_ct * _u + (_st * _ct) * _v));
    };
>>

path-eval-Figure8-bernoulli(function, views) ::= <<
<figure8-plane(function)>
    const auto _path_eval = [&](double _s) -> KDL::Frame {
        const double _t = 2.0 * M_PI * std::clamp(_s, 0.0, 1.0) + 0.5 * M_PI;
        const double _ct = std::cos(_t);
        const double _st = std::sin(_t);
        const double _d = 1.0 + _st * _st;
        return KDL::Frame(data.<function.anchor>.M,
                          data.<function.anchor>.p
                              + data.<function.radius> * ((_ct / _d) * _u
                                  + ((_st * _ct) / _d) * _v));
    };
>>

pose-axis-error-component(component) ::= <<
data.<component.error> = _pose_axis_error_<component.subspace>_<component.axis>;
>>

pose-axis-error-group(pose_group, views) ::= <<
    {
<if(pose_group.is_pose)><pose-axis-error-group-pose(pose_group, views)><endif>
<if(pose_group.is_twist)><pose-axis-error-group-twist(pose_group, views)><endif>
<if(pose_group.is_wrench)><pose-axis-error-group-wrench(pose_group, views)><endif>
<pose_group.components:{component |         <pose-axis-error-component(component)>}; separator="\n">
    }
>>

pose-axis-error-group-pose(g, views) ::= <<
        KDL::Frame _pose_axis_target_<g.id> = data.<g.pose>;
<if(g.linear_x)>        _pose_axis_target_<g.id>.p[0] = <access-expr(g.linear_x, views)>;
<endif>
<if(g.linear_y)>        _pose_axis_target_<g.id>.p[1] = <access-expr(g.linear_y, views)>;
<endif>
<if(g.linear_z)>        _pose_axis_target_<g.id>.p[2] = <access-expr(g.linear_z, views)>;
<endif>
<if(g.has_angular)>        // The stated axes are PoseToAngleAroundAxis values, rotation-vector components, so the
        // target is composed in that space; an axis the motion does not state keeps the arm's.
        KDL::Vector _pose_axis_rotvec_<g.id> = KDL::diff(KDL::Rotation::Identity(), data.<g.pose>.M);
<if(g.angular_x)>        _pose_axis_rotvec_<g.id>[0] = <access-expr(g.angular_x, views)>;
<endif>
<if(g.angular_y)>        _pose_axis_rotvec_<g.id>[1] = <access-expr(g.angular_y, views)>;
<endif>
<if(g.angular_z)>        _pose_axis_rotvec_<g.id>[2] = <access-expr(g.angular_z, views)>;
<endif>
        _pose_axis_target_<g.id>.M = KDL::Rotation::Rot(_pose_axis_rotvec_<g.id>, _pose_axis_rotvec_<g.id>.Norm());
<endif>
        const KDL::Twist _pose_axis_error_<g.id> = KDL::diff(data.<g.pose>, _pose_axis_target_<g.id>);
<if(g.linear_x)>        const double _pose_axis_error_linear_X = _pose_axis_error_<g.id>.vel.x();
<endif>
<if(g.linear_y)>        const double _pose_axis_error_linear_Y = _pose_axis_error_<g.id>.vel.y();
<endif>
<if(g.linear_z)>        const double _pose_axis_error_linear_Z = _pose_axis_error_<g.id>.vel.z();
<endif>
<if(g.angular_x)>        const double _pose_axis_error_angular_X = _pose_axis_error_<g.id>.rot.x();
<endif>
<if(g.angular_y)>        const double _pose_axis_error_angular_Y = _pose_axis_error_<g.id>.rot.y();
<endif>
<if(g.angular_z)>        const double _pose_axis_error_angular_Z = _pose_axis_error_<g.id>.rot.z();
<endif>
>>

pose-axis-error-group-twist(g, views) ::= <<
        KDL::Twist _pose_axis_target_<g.id> = KDL::Twist::Zero();
<if(g.linear_x)>        _pose_axis_target_<g.id>.vel[0] = <access-expr(g.linear_x, views)>;
<endif>
<if(g.linear_y)>        _pose_axis_target_<g.id>.vel[1] = <access-expr(g.linear_y, views)>;
<endif>
<if(g.linear_z)>        _pose_axis_target_<g.id>.vel[2] = <access-expr(g.linear_z, views)>;
<endif>
<if(g.angular_x)>        _pose_axis_target_<g.id>.rot[0] = <access-expr(g.angular_x, views)>;
<endif>
<if(g.angular_y)>        _pose_axis_target_<g.id>.rot[1] = <access-expr(g.angular_y, views)>;
<endif>
<if(g.angular_z)>        _pose_axis_target_<g.id>.rot[2] = <access-expr(g.angular_z, views)>;
<endif>
        const KDL::Twist _pose_axis_error_<g.id> = _pose_axis_target_<g.id> - data.<g.pose>;
<if(g.linear_x)>        const double _pose_axis_error_linear_X = _pose_axis_error_<g.id>.vel.x();
<endif>
<if(g.linear_y)>        const double _pose_axis_error_linear_Y = _pose_axis_error_<g.id>.vel.y();
<endif>
<if(g.linear_z)>        const double _pose_axis_error_linear_Z = _pose_axis_error_<g.id>.vel.z();
<endif>
<if(g.angular_x)>        const double _pose_axis_error_angular_X = _pose_axis_error_<g.id>.rot.x();
<endif>
<if(g.angular_y)>        const double _pose_axis_error_angular_Y = _pose_axis_error_<g.id>.rot.y();
<endif>
<if(g.angular_z)>        const double _pose_axis_error_angular_Z = _pose_axis_error_<g.id>.rot.z();
<endif>
>>

pose-axis-error-group-wrench(g, views) ::= <<
        KDL::Wrench _pose_axis_target_<g.id> = KDL::Wrench::Zero();
<if(g.linear_x)>        _pose_axis_target_<g.id>.force[0] = <access-expr(g.linear_x, views)>;
<endif>
<if(g.linear_y)>        _pose_axis_target_<g.id>.force[1] = <access-expr(g.linear_y, views)>;
<endif>
<if(g.linear_z)>        _pose_axis_target_<g.id>.force[2] = <access-expr(g.linear_z, views)>;
<endif>
<if(g.angular_x)>        _pose_axis_target_<g.id>.torque[0] = <access-expr(g.angular_x, views)>;
<endif>
<if(g.angular_y)>        _pose_axis_target_<g.id>.torque[1] = <access-expr(g.angular_y, views)>;
<endif>
<if(g.angular_z)>        _pose_axis_target_<g.id>.torque[2] = <access-expr(g.angular_z, views)>;
<endif>
        const KDL::Wrench _pose_axis_error_<g.id> = _pose_axis_target_<g.id> - data.<g.pose>;
<if(g.linear_x)>        const double _pose_axis_error_linear_X = _pose_axis_error_<g.id>.force.x();
<endif>
<if(g.linear_y)>        const double _pose_axis_error_linear_Y = _pose_axis_error_<g.id>.force.y();
<endif>
<if(g.linear_z)>        const double _pose_axis_error_linear_Z = _pose_axis_error_<g.id>.force.z();
<endif>
<if(g.angular_x)>        const double _pose_axis_error_angular_X = _pose_axis_error_<g.id>.torque.x();
<endif>
<if(g.angular_y)>        const double _pose_axis_error_angular_Y = _pose_axis_error_<g.id>.torque.y();
<endif>
<if(g.angular_z)>        const double _pose_axis_error_angular_Z = _pose_axis_error_<g.id>.torque.z();
<endif>
>>

emit-call-PlanarAngleFromDirections(function, views) ::= <<
data.<function.angle> = std::atan2(
    (<access-expr(first(function.from_directions), views)> * <access-expr(first(rest(function.from_directions)), views)>).Norm(),
    KDL::dot(<function.from_directions:{d | <access-expr(d, views)>}; separator=", ">));
>>

emit-call-InvertAngle(function, views) ::= <<
data.<function.out> = -<access-expr(function.in, views)>;
>>

emit-call-RotationVectorFromDirections(function, views) ::= <<
{
    const KDL::Vector _cross_<function.out> = <access-expr(function.in1, views)> * <access-expr(function.in2, views)>;
    const double _sin_<function.out> = _cross_<function.out>.Norm();
    const double _angle_<function.out> = std::atan2(_sin_<function.out>, KDL::dot(<access-expr(function.in1, views)>, <access-expr(function.in2, views)>));
    // The rotation to answer for: the whole angle, or only what exceeds the band the
    // constraint tolerates. Scaling the cross product by it gives the rotation vector.
    const double _drive_<function.out> = <if(function.band)>std::max(0.0, _angle_<function.out> - data.<function.band>)<else>_angle_<function.out><endif>;
    data.<function.out> = (_sin_<function.out> > 1e-9)
        ? _cross_<function.out> * (_drive_<function.out> / _sin_<function.out>)
        : KDL::Vector::Zero();
}
>>

// Table IIa: signed distance of a point from a plane, along the plane's normal. The gradient is
// the normal itself -- the direction the point moves to increase the distance.
emit-call-PointPlaneToLinearDistance(function, views) ::= <<
{
    KDL::Vector _n_<function.distance> = <access-expr(function.direction, views)>;
    _n_<function.distance>.Normalize();
    data.<function.distance> = KDL::dot(_n_<function.distance>, data.<function.in1>.p - data.<function.in2>.p);
    data.<function.gradient> = _n_<function.distance>;
}
>>

// Table IIa: unsigned distance from a point to a line riding the frame the point is measured
// in (the line's origin IS that frame's origin). With P the point in that frame and d the
// line direction, D = |P x d| and D' = (u x d).v + ((P.d) u).w for the frame's own twist
// (v, w) in its coordinates, u = (P x d)/D: the linear gradient plus the angular half a
// tilting axis contributes. On the line both vanish and command nothing.
emit-call-PointBodyLineToLinearDistance(function, views) ::= <<
{
    KDL::Vector _d_<function.distance> = <access-expr(function.direction, views)>;
    _d_<function.distance>.Normalize();
    const KDL::Vector _p_<function.distance> = data.<function.in1>.p;
    const KDL::Vector _c_<function.distance> = _p_<function.distance> * _d_<function.distance>;
    const double _norm_<function.distance> = _c_<function.distance>.Norm();
    data.<function.distance> = _norm_<function.distance>;
    if (_norm_<function.distance> > 1e-9) {
        const KDL::Vector _u_<function.distance> = _c_<function.distance> / _norm_<function.distance>;
        data.<function.gradient> = _u_<function.distance> * _d_<function.distance>;
        data.<function.gradient_moment> = _u_<function.distance> * KDL::dot(_p_<function.distance>, _d_<function.distance>);
    } else {
        data.<function.gradient> = KDL::Vector::Zero();
        data.<function.gradient_moment> = KDL::Vector::Zero();
    }
}
>>

// Table IIa: unsigned distance from a point to a line; the gradient points from the line's
// nearest point to the point. On the line the distance is zero and the gradient commands nothing.
emit-call-PointLineToLinearDistance(function, views) ::= <<
{
    KDL::Vector _d_<function.distance> = <access-expr(function.direction, views)>;
    _d_<function.distance>.Normalize();
    const KDL::Vector _v_<function.distance> = data.<function.in1>.p - data.<function.in2>.p;
    const KDL::Vector _perp_<function.distance> = _v_<function.distance> - _d_<function.distance> * KDL::dot(_v_<function.distance>, _d_<function.distance>);
    const double _norm_<function.distance> = _perp_<function.distance>.Norm();
    data.<function.distance> = _norm_<function.distance>;
    data.<function.gradient> = (_norm_<function.distance> > 1e-9)
        ? _perp_<function.distance> / _norm_<function.distance>
        : KDL::Vector::Zero();
}
>>

// Table IIa: signed travel of a point along a line's axis, from the line's origin.
emit-call-PointOnLineProjection(function, views) ::= <<
{
    KDL::Vector _d_<function.distance> = <access-expr(function.direction, views)>;
    _d_<function.distance>.Normalize();
    data.<function.distance> = KDL::dot(data.<function.in1>.p - data.<function.in2>.p, _d_<function.distance>);
    data.<function.gradient> = _d_<function.distance>;
}
>>

// Table IIa: signed distance between two lines along their common normal. Parallel lines have
// no common normal, so the distance falls back to the perpendicular offset and the gradient
// commands nothing.
emit-call-LineLineToLinearDistance(function, views) ::= <<
{
    const KDL::Vector _a_<function.distance> = <access-expr(function.in1, views)>;
    KDL::Vector _b_<function.distance> = <access-expr(function.in2, views)>;
    // `pose` is KDL::diff(A's origin, B's origin), so its vel runs B-to-A the wrong way round:
    // the signed value is A's origin relative to B's, as it is for every point-family operator.
    const KDL::Vector _dp_<function.distance> = -data.<function.pose>.vel;
    KDL::Vector _n_<function.distance> = _a_<function.distance> * _b_<function.distance>;
    const double _norm_<function.distance> = _n_<function.distance>.Norm();
    if (_norm_<function.distance> > 1e-9) {
        _n_<function.distance> = _n_<function.distance> / _norm_<function.distance>;
        data.<function.distance> = KDL::dot(_dp_<function.distance>, _n_<function.distance>);
        data.<function.gradient> = _n_<function.distance>;
    } else {
        _b_<function.distance>.Normalize();
        const KDL::Vector _perp_<function.distance> = _dp_<function.distance> - _b_<function.distance> * KDL::dot(_dp_<function.distance>, _b_<function.distance>);
        data.<function.distance> = _perp_<function.distance>.Norm();
        data.<function.gradient> = KDL::Vector::Zero();
    }
}
>>

// Table IIa: signed travel of line A's origin along line B's axis, from B's origin.
emit-call-LineOnLineProjection(function, views) ::= <<
{
    KDL::Vector _b_<function.distance> = <access-expr(function.in2, views)>;
    _b_<function.distance>.Normalize();
    // `pose` is KDL::diff(A's origin, B's origin), so its vel runs B-to-A the wrong way round:
    // the travel is A's origin from B's, as it is for every point-family operator.
    const KDL::Vector _dp_<function.distance> = -data.<function.pose>.vel;
    data.<function.distance> = KDL::dot(_dp_<function.distance>, _b_<function.distance>);
    data.<function.gradient> = _b_<function.distance>;
}
>>

// Table IIb: the incident angle a direction makes with a plane, signed positive on the normal's
// side. The gradient is the axis a positive rotation of the direction turns about to open it.
emit-call-DirectionPlaneToAngularDistance(function, views) ::= <<
{
    const KDL::Vector _d_<function.angle> = <access-expr(function.in1, views)>;
    const KDL::Vector _n_<function.angle> = <access-expr(function.in2, views)>;
    data.<function.angle> = std::asin(std::clamp(KDL::dot(_d_<function.angle>, _n_<function.angle>), -1.0, 1.0));
    const KDL::Vector _axis_<function.angle> = _d_<function.angle> * _n_<function.angle>;
    const double _norm_<function.angle> = _axis_<function.angle>.Norm();
    // Parallel to the normal there is no axis to turn about, so the gradient vanishes.
    data.<function.gradient> = (_norm_<function.angle> > 1e-9)
        ? _axis_<function.angle> / _norm_<function.angle>
        : KDL::Vector::Zero();
}
>>

// The angle's true gradient: the axis a positive rotation of `in1` about opens the angle to
// `in2`, so the row convention matches every other Table-II gradient (d(angle)/dt = gradient . w).
emit-call-AngleGradientFromDirections(function, views) ::= <<
{
    const KDL::Vector _axis_<function.gradient> = <access-expr(function.in2, views)> * <access-expr(function.in1, views)>;
    const double _norm_<function.gradient> = _axis_<function.gradient>.Norm();
    data.<function.gradient> = (_norm_<function.gradient> > 1e-9)
        ? _axis_<function.gradient> / _norm_<function.gradient>
        : KDL::Vector::Zero();
}
>>

emit-call-RotateDirectionDistalToProximalWithPose(function, views) ::= <<
data.<function.to> = data.<function.pose>.M * <access-expr(function.from, views)>;
>>

emit-call-ComposePose(function, views) ::= <<
data.<function.composite> = <access-expr(function.in1, views)> * <access-expr(function.in2, views)>;
>>

emit-call-InvertPose(function, views) ::= <<
data.<function.out> = data.<function.pose>.Inverse();
>>

emit-call-PoseToLinearDistance(function, views) ::= <<
data.<function.distance> = data.<function.pose>.p.Norm();
>>

emit-call-PoseToDirection(function, views) ::= <<
data.<function.direction> = data.<function.pose>.p;
data.<function.direction>.Normalize();
>>

emit-call-PoseToAngleAroundAxis(function, views) ::= <<
KDL::Vector diff_<function.angle> = KDL::diff(KDL::Rotation::Identity(), data.<function.pose>.M);
data.<function.angle> = diff_<function.angle>[<axis-to-index.(function.axis)>];
>>

emit-call-RotateVelocityTwistToProximalWithPose(function, views) ::= <<
data.<function.to> = data.<function.pose>.M * <access-expr(function.from, views)>;
>>

emit-call-WrenchFromPositionDirectionAndMagnitude(function, views) ::= <<
data.<function.wrench> = KDL::Wrench(<access-expr(function.direction, views)> * <access-expr(function.magnitude, views)>, KDL::Vector(0.0, 0.0, 0.0)).RefPoint(-<access-expr(function.position, views)>);
>>

emit-call-WrenchFromDirectionAndMoment(function, views) ::= <<
data.<function.wrench> = KDL::Wrench(KDL::Vector::Zero(), <access-expr(function.direction, views)> * <access-expr(function.moment, views)>);
>>

emit-call-RotateWrenchToDistalWithPose(function, views) ::= <<
data.<function.to> = data.<function.pose>.M.Inverse(<access-expr(function.from, views)>);
>>

emit-call-RotateWrenchToProximalWithPose(function, views) ::= <<
data.<function.to> = data.<function.pose>.M * <access-expr(function.from, views)>;
>>

emit-call-TransformWrenchToProximal(function, views) ::= <<
data.<function.to> = data.<function.pose> * <access-expr(function.from, views)>;
>>

emit-call-Addition(function, views) ::= <<
data.<function.out> = <function.in:{operand | <access-expr(operand, views)>}; separator=" + ">;
>>

emit-call-Subtraction(function, views) ::= <<
data.<function.out> = <access-expr(function.minuend, views)> - <access-expr(function.subtrahend, views)>;
>>

emit-call-Multiplication(function, views) ::= <<
data.<function.out> = <function.in:{operand | <access-expr(operand, views)>}; separator=" * ">;
>>

emit-call-Division(function, views) ::= <<
data.<function.out> = motion_spec::runtime::quotient(<access-expr(function.dividend, views)>, <access-expr(function.divisor, views)>);
>>

emit-call-AddWrench(function, views) ::= <<
data.<function.out> = <access-expr(function.in1, views)> + <access-expr(function.in2, views)>;
>>

// The runtime helpers the functions above call, each emitted only when a function of its kind runs.
function-runtime(uses) ::= <<
<if(uses.("Division"))>
inline double quotient(double dividend, double divisor) { return dividend / divisor; }

// A direction divided by a vanishing length has no direction: it stays zero rather than NaN.
inline KDL::Vector quotient(const KDL::Vector &dividend, double divisor) {
    return std::abs(divisor) > 1e-9 ? dividend / divisor : KDL::Vector::Zero();
}

<endif>
<if(uses.("PathProjection") || uses.("PathTangentFrame") || uses.("PathVelocityProfile"))>
// Central-difference step for the tangent, in path parameter. Also the resolution the
// projection converges to: refining the parameter finer than the step the curve is
// differentiated at buys nothing.
inline constexpr double kPathTangentStep = 1e-4;

<endif>
<if(uses.("PathProjection"))>
// Closest point on a path, refined locally around the previous parameter.
// The window is derived, not tuned: how far the frame drifted off the last projection is how
// far it can have travelled in the control period that passed. The closest point is no farther
// away than P(previous) already is, so P(s*) is within 2d of P(previous) in arc length, and
// dividing by the local |dP/ds| turns that into the parameter bound searched here. A tuned window
// would either lag a fast motion or, when generous, reach across a fold of a self-intersecting
// path; one control period of measured motion can do neither.
template \<typename Eval\>
inline double path_project(const Eval &eval, const KDL::Vector &point, double previous) {
    const auto distance2 = [&](double s) {
        const KDL::Vector delta = eval(s).p - point;
        return KDL::dot(delta, delta);
    };
    const double lo_s = std::max(0.0, previous - kPathTangentStep);
    const double hi_s = std::min(1.0, previous + kPathTangentStep);
    const double ds = hi_s - lo_s;
    if (ds \< 1e-12) return std::clamp(previous, 0.0, 1.0);
    const double speed = (eval(hi_s).p - eval(lo_s).p).Norm() / ds;
    if (speed \< 1e-9) return std::clamp(previous, 0.0, 1.0);  // stationary curve: nothing to search along
    const double window = 2.0 * std::sqrt(distance2(previous)) / speed;
    double a = std::max(0.0, previous - window);
    double b = std::min(1.0, previous + window);
    // Golden section: the distance is unimodal over a window this size, so no coarse scan is
    // needed to bracket. The shrink factor bounds the loop -- worst case is a full-length
    // window, ~19 iterations to the tangent step -- so the tick cost stays deterministic.
    constexpr double kInvPhi = 0.6180339887498949;
    double c = b - kInvPhi * (b - a);
    double d = a + kInvPhi * (b - a);
    double fc = distance2(c);
    double fd = distance2(d);
    while (b - a > kPathTangentStep) {
        if (fc \< fd) {
            b = d; d = c; fd = fc;
            c = b - kInvPhi * (b - a);
            fc = distance2(c);
        } else {
            a = c; c = d; fc = fd;
            d = a + kInvPhi * (b - a);
            fd = distance2(d);
        }
    }
    return std::clamp(0.5 * (a + b), 0.0, 1.0);
}

<endif>
<if(uses.("PathTangentFrame"))>
// Frenet-style frame at a point on the path: the tangent by central difference, then two
// normals carried forward from the previous tick (parallel transport). Rebuilding the normals
// from a world axis every tick would flip them as the tangent turns, and the lateral rows
// would jump with them; transport keeps the frame continuous.
template \<typename Eval\>
inline void path_frame(const Eval &eval, double s, KDL::Vector &tangent,
                       KDL::Vector &normal_a, KDL::Vector &normal_b) {
    const double lo = std::max(0.0, s - kPathTangentStep);
    const double hi = std::min(1.0, s + kPathTangentStep);
    tangent = eval(hi).p - eval(lo).p;
    if (tangent.Norm() \< 1e-12) {
        tangent = KDL::Vector(1.0, 0.0, 0.0);
    } else {
        tangent.Normalize();
    }
    KDL::Vector candidate = normal_a - KDL::dot(normal_a, tangent) * tangent;
    if (candidate.Norm() \< 1e-6) {
        // No usable previous normal (first tick, or the tangent turned onto it): start from the
        // world axis least aligned with the tangent, which keeps the cross product conditioned.
        const double ax = std::fabs(tangent.x());
        const double ay = std::fabs(tangent.y());
        const double az = std::fabs(tangent.z());
        const KDL::Vector helper = (ax \<= ay && ax \<= az) ? KDL::Vector(1.0, 0.0, 0.0)
                                 : (ay \<= az)             ? KDL::Vector(0.0, 1.0, 0.0)
                                                          : KDL::Vector(0.0, 0.0, 1.0);
        candidate = tangent * helper;
    }
    candidate.Normalize();
    normal_a = candidate;
    normal_b = tangent * normal_a;
    normal_b.Normalize();
}

<endif>
<if(uses.("VelocityProfile"))>
enum class VelocityProfileShape { Trapezoidal, SCurve };

<endif>
<if(uses.("TargetVelocityProfile"))>
// SCurve is a cascaded jerk limiter, not a time-optimal phase planner.
// Feed-forward online generator: the setpoint must LEAD the plant to drive a
// position controller, so v is the profile's own integrated velocity, not the
// measured one. (Resetting v to the measured velocity each step glues the
// setpoint to the plant -> zero tracking error -> no drive -> deadlock from
// rest.) The measured state seeds vp_velocity once at init in the caller.
inline double velocity_profile_step(double x, double &v, double &a, double goal,
                                    double vmax, double amax, double jmax, double dt,
                                    VelocityProfileShape shape) {
    vmax = std::max(vmax, 1e-9);
    amax = std::max(amax, 1e-9);
    const double dir = (goal >= x) ? 1.0 : -1.0;
    const double dist = std::abs(goal - x);
    const double v_brake = std::sqrt(2.0 * amax * dist);
    const double v_target = dir * std::min(vmax, v_brake);
    if (shape == VelocityProfileShape::Trapezoidal) {
        const double dv = std::clamp(v_target - v, -amax * dt, amax * dt);
        v += dv;
        a = dv / dt;
    } else {
        jmax = std::max(jmax, 1e-9);
        const double a_target = std::clamp((v_target - v) / dt, -amax, amax);
        a += std::clamp(a_target - a, -jmax * dt, jmax * dt);
        v += a * dt;
    }
    v = std::clamp(v, -vmax, vmax);
    double nx = x + v * dt;
    if ((goal - nx) * dir \< 0.0) {
        nx = goal;
        v = 0.0;
        a = 0.0;
    }
    return nx;
}

<endif>
<if(uses.("PathVelocityProfile"))>
template \<typename PathEvaluator\>
inline double remaining_path_length(const PathEvaluator &evaluate, double parameter) {
    constexpr int samples = 16;
    const double start = std::clamp(parameter, 0.0, 1.0);
    // path_project resolves the parameter only to kPathTangentStep, so a start within that of
    // the end is the end. Reporting the sub-resolution tail floors the profile's braking
    // velocity at sqrt(2*a*tail) and the motion creeps past the goal instead of stopping.
    if (1.0 - start \<= kPathTangentStep) return 0.0;
    KDL::Vector previous = evaluate(start).p;
    double length = 0.0;
    for (int i = 1; i \<= samples; ++i) {
        const double s = start + (1.0 - start) * static_cast\<double\>(i) / samples;
        const KDL::Vector current = evaluate(s).p;
        length += (current - previous).Norm();
        previous = current;
    }
    return length;
}

inline double path_velocity_profile_step(double velocity, double &acceleration,
                                         double cruise_velocity, double maximum_velocity,
                                         double maximum_acceleration, double maximum_jerk,
                                         double remaining_distance, double dt,
                                         VelocityProfileShape shape) {
    maximum_velocity = std::max(std::abs(maximum_velocity), 1e-9);
    maximum_acceleration = std::max(std::abs(maximum_acceleration), 1e-9);
    const double direction = cruise_velocity >= 0.0 ? 1.0 : -1.0;
    const double cruise = std::min(std::abs(cruise_velocity), maximum_velocity);
    const double braking = std::sqrt(2.0 * maximum_acceleration
                                     * std::max(remaining_distance, 0.0));
    const double target = direction * std::min(cruise, braking);
    if (shape == VelocityProfileShape::Trapezoidal) {
        const double delta = std::clamp(target - velocity,
                                        -maximum_acceleration * dt,
                                        maximum_acceleration * dt);
        velocity += delta;
        acceleration = delta / dt;
    } else {
        maximum_jerk = std::max(std::abs(maximum_jerk), 1e-9);
        const double target_acceleration = std::clamp(
            (target - velocity) / dt, -maximum_acceleration, maximum_acceleration);
        acceleration += std::clamp(target_acceleration - acceleration,
                                   -maximum_jerk * dt, maximum_jerk * dt);
        velocity += acceleration * dt;
    }
    return std::clamp(velocity, -maximum_velocity, maximum_velocity);
}

<endif>
<if(uses.("JointNormalization"))>
// A measured joint position, moved onto the turn the model's normalization interval is stated
// on. A backend reporting [0, 2*pi) and a model stating (-pi, pi] describe the same pose one
// turn apart; normalizing where the reading is taken means every constraint, solve and log
// downstream sees the same one. Whole turns only, so a reading outside the interval stays
// outside rather than being clamped onto it.
inline double normalize_joint_position(double position, double lower, double upper) {
    const double turn = 2.0 * M_PI;
    const double centre = 0.5 * (lower + upper);
    return position - turn * std::round((position - centre) / turn);
}

<endif>
<if(uses.("ErrorEvaluator-EqualityConstraint"))>
inline double evaluate_equality_constraint(double quantity, double reference) {
    return quantity - reference;
}

// Shortest signed angular distance, in (-pi, pi]: a continuous joint's error lives on the circle.
inline double wrap_angle(double angle) {
    return std::remainder(angle, 2.0 * M_PI);
}

inline double evaluate_equality_constraint(const KDL::Vector &target, const KDL::Vector &current) {
    return (target - current).Norm();
}

// The geodesic angle between two orientations: the one rotation that carries current onto
// target, measured the way a satisfaction band on an orientation is authored -- in radians.
inline double evaluate_equality_constraint(const KDL::Rotation &target, const KDL::Rotation &current) {
    KDL::Vector axis;
    return (current.Inverse() * target).GetRotAngle(axis);
}

inline KDL::Frame evaluate_equality_constraint(const KDL::Frame &target, const KDL::Frame &current) {
    return current.Inverse() * target;
}

<endif>
<if(uses.("ErrorEvaluator-LessThanConstraint"))>
inline double evaluate_less_than_constraint(double quantity, double threshold) {
    return (quantity \< threshold) ? 0.0 : threshold - quantity;
}

<endif>
<if(uses.("ErrorEvaluator-GreaterThanConstraint"))>
inline double evaluate_greater_than_constraint(double quantity, double threshold) {
    return (quantity \> threshold) ? 0.0 : threshold - quantity;
}

<endif>
<if(uses.("ErrorEvaluator-BilateralConstraint"))>
inline double evaluate_bilateral_constraint(double quantity, double lower, double upper) {
    if (quantity \< lower) return lower - quantity;
    if (quantity \> upper) return upper - quantity;
    return 0.0;
}

<endif>
<if(uses.("ErrorEvaluator-OutsideConstraint"))>
inline double evaluate_outside_constraint(double quantity, double lower, double upper) {
    // Complement of bilateral: satisfied (0) when outside [lower, upper]; otherwise
    // the remaining distance to the nearer band edge (still inside -> not yet satisfied).
    if (quantity \<= lower || quantity \>= upper) return 0.0;
    return std::min(quantity - lower, upper - quantity);
}

<endif>
>>
