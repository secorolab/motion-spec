// SPDX-License-Identifier: MPL-2.0
// Shared data model (leaf): lookup maps, saturation, member declarations, view access expressions.

subspace-to-runtime-subspace ::= [
    "Linear": "Subspace::Linear",
    "Angular": "Subspace::Angular"
]

// The other half of the twist: where a mixed row's moment direction lands.
other-runtime-subspace ::= [
    "Linear": "Subspace::Angular",
    "Angular": "Subspace::Linear"
]

axis-to-vector ::= [
    "X": "1.0, 0.0, 0.0",
    "Y": "0.0, 1.0, 0.0",
    "Z": "0.0, 0.0, 1.0"
]

axis-to-index ::= [
    "X": "0",
    "Y": "1",
    "Z": "2",
    "x": "0",
    "y": "1",
    "z": "2"
]

velocity-profile-shape ::= [
    "s_curve": "motion_spec::runtime::VelocityProfileShape::SCurve",
    "trapezoidal": "motion_spec::runtime::VelocityProfileShape::Trapezoidal",
    default: "motion_spec::runtime::VelocityProfileShape::Trapezoidal"
]

saturation-lower(saturation) ::= <<
<if(saturation.maximum)>-<saturation.maximum.value><else><saturation.lower.value><endif>
>>

saturation-upper(saturation) ::= <<
<if(saturation.maximum)><saturation.maximum.value><else><saturation.upper.value><endif>
>>

data-member(var) ::= <<
<({data-member-<var.type>})(var)>
>>

data-member-Direction(var) ::= <<
KDL::Vector <var.id><if(var.direction)> = KDL::Vector(<var.direction; separator=", ">)<endif>;
>>

data-member-Pose(var) ::= <<
KDL::Frame <var.id>;
>>

data-member-Position(var) ::= <<
KDL::Vector <var.id><if(var.position)> = KDL::Vector(<var.position; separator=", ">)<endif>;
>>

data-member-Orientation(var) ::= <<
KDL::Rotation <var.id>;
>>

data-member-FreeVector(var) ::= <<
KDL::Vector <var.id><if(var.vector)> = KDL::Vector(<var.vector; separator=", ">)<endif>;
>>

data-member-VelocityTwist(var) ::= <<
KDL::Twist <var.id>;
>>

data-member-AccelerationTwist(var) ::= <<
KDL::Twist <var.id>;
>>

data-member-PoseDifference(var) ::= <<
KDL::Twist <var.id>;
>>

data-member-Wrench(var) ::= <<
KDL::Wrench <var.id>;
>>

data-member-Quantity(var) ::= <<
double <var.id> = <if(var.unset)>-std::numeric_limits\<double\>::infinity()<elseif(var.value)><var.value><else>0.0<endif>;
>>

data-member-IntCounter(var) ::= <<
int <var.id> = 0;
>>

data-member-Bool(var) ::= <<
bool <var.id> = false;
>>

monitor-member(monitor) ::= <<
<if(monitor.is_edge_triggered)>    bool <monitor.id>_previous = false;
    bool <monitor.id>_event_triggered = false;
<if(monitor.debounce_id)>    double <monitor.id>_hold_s = 0.0;
<endif><elseif(monitor.flag)>    bool <monitor.flag> = false;<endif>
>>

// One shot per activation: `fired` says the window has already had its turn, `open` whether it
// is having it now, and `elapsed_s` how long it has been open. Three flags rather than one
// counter, so a window that closes cannot be told apart from one that never opened.
perturbation-member(perturbation) ::= <<
    bool <perturbation.id>_fired = false;
    bool <perturbation.id>_open = false;
    double <perturbation.id>_elapsed_s = 0.0;
>>

perturbation-rearm(motion_id, perturbation) ::= <<
        <motion_id>_state_instance.<perturbation.id>_fired = false;
        <motion_id>_state_instance.<perturbation.id>_open = false;
        <motion_id>_state_instance.<perturbation.id>_elapsed_s = 0.0;
>>

// An edge is an edge within one activation: a condition still true from the previous one must
// hold afresh before it fires again, or a re-entered motion carries a monitor that can never
// re-trigger. A flag monitor needs none -- it is recomputed every tick.
monitor-rearm(motion_id, monitor) ::= <<
<if(monitor.is_edge_triggered)>        <motion_id>_state_instance.<monitor.id>_previous = false;
        <motion_id>_state_instance.<monitor.id>_event_triggered = false;
<if(monitor.debounce_id)>        <motion_id>_state_instance.<monitor.id>_hold_s = 0.0;<endif><endif>
>>

access-expr(id, views) ::= <<
<if(views.(id))><view-access-expr(views.(id))><else>data.<id><endif>
>>

view-access-expr(view) ::= <<
<if(view.subspace)><({view-access-expr-<view.superobject.type>-<view.subspace>})(view)><else><({view-access-expr-<view.superobject.type>})(view)><endif>
>>

// A superobject that is itself a 3-vector has no subspace: the axis alone names the component.
view-access-expr-Direction(view) ::= <<
data.<view.superobject.id>[<axis-to-index.(view.axis)>]
>>

view-access-expr-Pose-Linear(view) ::= <<
<if(view.axis)>data.<view.superobject.id>.p[<axis-to-index.(view.axis)>]<else>data.<view.superobject.id>.p<endif>
>>

view-access-expr-Pose-Angular(view) ::= <<
<if(view.axis)>KDL::diff(KDL::Rotation::Identity(), data.<view.superobject.id>.M)[<axis-to-index.(view.axis)>]<else>data.<view.superobject.id>.M<endif>
>>


view-access-expr-VelocityTwist-Angular(view) ::= <<
<if(view.axis)>data.<view.superobject.id>.rot[<axis-to-index.(view.axis)>]<else>data.<view.superobject.id>.rot<endif>
>>

view-access-expr-VelocityTwist-Linear(view) ::= <<
<if(view.direction)>KDL::dot(data.<view.superobject.id>.vel, data.<view.direction.id>)<elseif(view.axis)>data.<view.superobject.id>.vel[<axis-to-index.(view.axis)>]<else>data.<view.superobject.id>.vel<endif>
>>

view-access-expr-AccelerationTwist-Angular(view) ::= <<
<if(view.axis)>data.<view.superobject.id>.rot[<axis-to-index.(view.axis)>]<else>data.<view.superobject.id>.rot<endif>
>>

view-access-expr-AccelerationTwist-Linear(view) ::= <<
<if(view.axis)>data.<view.superobject.id>.vel[<axis-to-index.(view.axis)>]<else>data.<view.superobject.id>.vel<endif>
>>

view-access-expr-PoseDifference-Angular(view) ::= <<
<if(view.axis)>data.<view.superobject.id>.rot[<axis-to-index.(view.axis)>]<else>data.<view.superobject.id>.rot<endif>
>>

view-access-expr-PoseDifference-Linear(view) ::= <<
<if(view.direction)>KDL::dot(data.<view.superobject.id>.vel, data.<view.direction.id>)<elseif(view.axis)>data.<view.superobject.id>.vel[<axis-to-index.(view.axis)>]<else>data.<view.superobject.id>.vel<endif>
>>

view-access-expr-FreeVector-Angular(view) ::= <<
data.<view.superobject.id>[<axis-to-index.(view.axis)>]
>>

view-access-expr-Wrench-Angular(view) ::= <<
<if(view.axis)>data.<view.superobject.id>.torque[<axis-to-index.(view.axis)>]<else>data.<view.superobject.id>.torque<endif>
>>

view-access-expr-Wrench-Linear(view) ::= <<
<if(view.axis)>data.<view.superobject.id>.force[<axis-to-index.(view.axis)>]<else>data.<view.superobject.id>.force<endif>
>>

// Frame-log sample expression, dispatched on the descriptor kind emitted by
// ir_gen (add_quantity_samples). Renders the scalar C++ expression sampled per tick.
sample-expr(desc, views) ::= <<
<({sample-expr-<desc.kind>})(desc, views)>
>>

sample-expr-literal(desc, views) ::= <<
<desc.value>
>>

sample-expr-access(desc, views) ::= <<
<access-expr(desc.ref, views)>
>>

sample-expr-data(desc, views) ::= <<
data.<desc.id>
>>

sample-expr-vec(desc, views) ::= <<
data.<desc.id>[<desc.axis>]
>>

sample-expr-orientation(desc, views) ::= <<
KDL::diff(KDL::Rotation::Identity(), data.<desc.id>)[<desc.axis>]
>>

sample-expr-pose_pos(desc, views) ::= <<
data.<desc.id>.p[<desc.axis>]
>>

sample-expr-pose_orient(desc, views) ::= <<
KDL::diff(KDL::Rotation::Identity(), data.<desc.id>.M)[<desc.axis>]
>>

sample-expr-member(desc, views) ::= <<
data.<desc.id>.<desc.member>[<desc.axis>]
>>

sample-expr-bool(desc, views) ::= <<
data.<desc.id> ? 1.0 : 0.0
>>

sample-expr-int(desc, views) ::= <<
static_cast\<double\>(data.<desc.id>)
>>
