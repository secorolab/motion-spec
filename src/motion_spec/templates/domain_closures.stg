// SPDX-License-Identifier: MPL-2.0
// Closure/evaluator library (emit-call) and pose-axis error groups.

import "expr_values.stg"
import "domain_poses.stg"

emit-call(closure, views) ::= <<
<({emit-call-<closure.type>})(closure, views)>
>>

emit-call-AssignmentEvaluator(closure, views) ::= <<
shared.<closure.quantity> = <access-expr(closure.reference_value, views)>;
>>

// error_normalization: the controller states the interval its error is read into.
// angular_wrap: the joint is continuous, so the error is the shortest arc, never the long way round.
emit-call-ErrorEvaluator-EqualityConstraint(closure, views) ::= <<
shared.<closure.error> = <if(closure.error_normalization)>motion_spec::runtime::normalize_joint_position(motion_spec::runtime::evaluate_equality_constraint(<access-expr(closure.reference_value, views)>, <access-expr(closure.quantity, views)>), <closure.error_normalization.lower>, <closure.error_normalization.upper>)<elseif(closure.angular_wrap)>motion_spec::runtime::wrap_angle(motion_spec::runtime::evaluate_equality_constraint(<access-expr(closure.reference_value, views)>, <access-expr(closure.quantity, views)>))<else>motion_spec::runtime::evaluate_equality_constraint(<access-expr(closure.reference_value, views)>, <access-expr(closure.quantity, views)>)<endif>;
>>

emit-call-ErrorEvaluator-GreaterThanConstraint(closure, views) ::= <<
shared.<closure.error> = motion_spec::runtime::evaluate_greater_than_constraint(<access-expr(closure.quantity, views)>, <access-expr(closure.threshold, views)>);
>>

emit-call-ErrorEvaluator-LessThanConstraint(closure, views) ::= <<
shared.<closure.error> = motion_spec::runtime::evaluate_less_than_constraint(<access-expr(closure.quantity, views)>, <access-expr(closure.threshold, views)>);
>>

emit-call-ErrorEvaluator-BilateralConstraint(closure, views) ::= <<
shared.<closure.error> = motion_spec::runtime::evaluate_bilateral_constraint(<access-expr(closure.quantity, views)>, <access-expr(closure.lower_threshold, views)>, <access-expr(closure.upper_threshold, views)>);
>>

emit-call-ErrorEvaluator-OutsideConstraint(closure, views) ::= <<
shared.<closure.error> = motion_spec::runtime::evaluate_outside_constraint(<access-expr(closure.quantity, views)>, <access-expr(closure.lower_threshold, views)>, <access-expr(closure.upper_threshold, views)>);
>>

emit-call-ErrorEvaluator(closure, views) ::= <<
<({emit-call-ErrorEvaluator-<closure.constraint>})(closure, views)>
>>

emit-call-PoseDiffEvaluator(closure, views) ::= <<
shared.<closure.out> = KDL::diff(shared.<closure.in1>, shared.<closure.in2>);
<closure.errors:{error | shared.<error> = <access-expr(error, views)>;}; separator="\n">
>>

// A path's geometry is one definition: `path-eval-<shape>` binds it to a local `_path_eval`
// so the projection can sample it while searching, and every use evaluates the same curve.
path-eval(closure, views) ::= <<
<({path-eval-<closure.shape>})(closure, views)>
>>

emit-call-PathProjection(closure, views) ::= <<
{
<path-eval(closure, views)>
    shared.<closure.path_parameter> = motion_spec::runtime::path_project(
        _path_eval, shared.<closure.pose>.p, shared.<closure.path_parameter>);
}
>>

emit-call-PathTangentFrame(closure, views) ::= <<
{
<path-eval(closure, views)>
    motion_spec::runtime::path_frame(
        _path_eval, shared.<closure.path_parameter>,
        shared.<closure.tangent>, shared.<closure.normal_a>, shared.<closure.normal_b>);
}
>>

// Measured at the attachment point rather than differentiated from the parameter, so it
// stays honest once the frame reaches the end of the path.
emit-call-TwistToLinearVelocityAlong(closure, views) ::= <<
shared.<closure.along_speed> = KDL::dot(shared.<closure.in>.vel, shared.<closure.direction>);
>>

emit-call-PathEvaluator(closure, views) ::= <<
{
<path-eval(closure, views)>
    shared.<closure.setpoint> = _path_eval(shared.<closure.path_parameter>);
}
>>

path-eval-LinearPath(closure, views) ::= <<
    const KDL::Frame _goal = <if(closure.assign_goal)><pose-frame-inline(closure.goal_components, views)><else>shared.<closure.goal><endif>;
<if(closure.assign_goal)>    shared.<closure.goal> = _goal;
<endif>    const auto _path_eval = [&](double _s) -> KDL::Frame {
        return KDL::addDelta(shared.<closure.start>, KDL::diff(shared.<closure.start>, _goal),
                             motion_spec::runtime::clamp01(_s));
    };
>>

emit-call-VelocityProfile(closure, views) ::= <<
<if(closure.path_parameter)><emit-call-PathVelocityProfile(closure, views)><else><emit-call-TargetVelocityProfile(closure, views)><endif>
>>

emit-call-TargetVelocityProfile(closure, views) ::= <<
{
    if (!state.<closure.controller>.vp_init) {
        state.<closure.controller>.vp_setpoint = <access-expr(closure.measured, views)>;
        state.<closure.controller>.vp_velocity = <if(closure.in)><access-expr(closure.in, views)><else>0.0<endif>;
        state.<closure.controller>.vp_accel = 0.0;
        state.<closure.controller>.vp_init = true;
    }
    shared.<closure.out> = motion_spec::runtime::velocity_profile_step(
        state.<closure.controller>.vp_setpoint,
        state.<closure.controller>.vp_velocity,
        state.<closure.controller>.vp_accel,
        <access-expr(closure.profile_target, views)>,
        <access-expr(closure.maximum_velocity, views)>,
        <access-expr(closure.maximum_acceleration, views)>,
        <if(closure.maximum_jerk)><access-expr(closure.maximum_jerk, views)><else>0.0<endif>,
        shared.dt_measured_s,
        <velocity-profile-shape.(closure.shape)>);
    state.<closure.controller>.vp_setpoint = shared.<closure.out>;
}
>>

emit-call-PathVelocityProfile(closure, views) ::= <<
{
<path-eval(closure, views)>
    if (!state.<closure.controller>.vp_init) {
        state.<closure.controller>.vp_setpoint = <access-expr(closure.measured, views)>;
        state.<closure.controller>.vp_accel = 0.0;
        state.<closure.controller>.vp_init = true;
    }
    const double _remaining = motion_spec::runtime::remaining_path_length(
        _path_eval, shared.<closure.path_parameter>);
    shared.<closure.out> = motion_spec::runtime::path_velocity_profile_step(
        state.<closure.controller>.vp_setpoint,
        state.<closure.controller>.vp_accel,
        <access-expr(closure.profile_target, views)>,
        <access-expr(closure.maximum_velocity, views)>,
        <access-expr(closure.maximum_acceleration, views)>,
        <if(closure.maximum_jerk)><access-expr(closure.maximum_jerk, views)><else>0.0<endif>,
        _remaining,
        shared.dt_measured_s,
        <velocity-profile-shape.(closure.profile_shape)>);
    state.<closure.controller>.vp_setpoint = shared.<closure.out>;
}
>>

path-eval-Circle(closure, views) ::= <<
    KDL::Vector _n = shared.<closure.plane_normal>;
    _n.Normalize();
    // Radial arm from center to start: alpha=0 lands exactly on start, and the orbit
    // radius is the in-plane distance between start and center (they may differ freely).
    const KDL::Vector _arm = shared.<closure.start>.p - shared.<closure.center>;
    const auto _path_eval = [&](double _s) -> KDL::Frame {
        const double _angle = 2.0 * M_PI * motion_spec::runtime::clamp01(_s);
        return KDL::Frame(shared.<closure.start>.M,
                          shared.<closure.center> + KDL::Rotation::Rot(_n, _angle) * _arm);
    };
>>

path-eval-Arc(closure, views) ::= <<
    KDL::Vector _n = shared.<closure.plane_normal>;
    _n.Normalize();
    // Circular arc from start to end that bows out of the chord by `amplitude` (the
    // sagitta). center, radius and swept angle are derived so the path begins at start,
    // ends exactly at end, and apexes amplitude away from the chord midpoint.
    // amplitude == |chord|/2 reproduces a clean semicircle (swept angle pi).
    const KDL::Vector _chord = shared.<closure.end>.p - shared.<closure.start>.p;
    const double _a = shared.<closure.amplitude>;
    const double _chordlen = _chord.Norm();
    // A dynamically-resolved start/end can still land on a degenerate chord at runtime;
    // hold at start rather than dividing by zero.
    const bool _valid = _chordlen > 1e-9 && _a > 1e-9;
    KDL::Vector _center = shared.<closure.start>.p;
    KDL::Vector _v0 = KDL::Vector::Zero();
    double _theta = 0.0;
    if (_valid) {
        const KDL::Vector _chord_hat = _chord * (1.0 / _chordlen);
        const KDL::Vector _mid = 0.5 * (shared.<closure.start>.p + shared.<closure.end>.p);
        const double _m = 0.5 * _chordlen;
        // plane-normal is authored perpendicular to the chord, so normal x chord_hat is
        // the unit bulge direction directly, with no fallback axis needed.
        const KDL::Vector _perp = _n * _chord_hat;
        const double _R = (_a * _a + _m * _m) / (2.0 * _a);
        const double _d = (_a * _a - _m * _m) / (2.0 * _a);
        _center = _mid + _d * _perp;
        _theta = 2.0 * std::acos(std::max(-1.0, std::min(1.0, -_d / _R)));
        _v0 = shared.<closure.start>.p - _center;
    }
    const KDL::Frame _rot_start(shared.<closure.start>.M, KDL::Vector(0.0, 0.0, 0.0));
    const KDL::Frame _rot_goal(shared.<closure.end>.M, KDL::Vector(0.0, 0.0, 0.0));
    const auto _path_eval = [&](double _s) -> KDL::Frame {
        const double _sc = _valid ? motion_spec::runtime::clamp01(_s) : 0.0;
        const KDL::Vector _pos = _valid
            ? _center + KDL::Rotation::Rot(_n, -_theta * _sc) * _v0
            : shared.<closure.start>.p;
        return KDL::Frame(
            KDL::addDelta(_rot_start, KDL::diff(_rot_start, _rot_goal), _sc).M, _pos);
    };
>>

path-eval-Helix(closure, views) ::= <<
    KDL::Vector _ax = shared.<closure.axis>;
    _ax.Normalize();
    // Radial arm from center to start: alpha=0 lands exactly on start; the helix winds
    // around the axis through center and rises along it (start and center may differ freely).
    const KDL::Vector _arm = shared.<closure.start>.p - shared.<closure.center>;
    const auto _path_eval = [&](double _s) -> KDL::Frame {
        const double _sc = motion_spec::runtime::clamp01(_s);
        const double _angle = shared.<closure.revolutions> * 2.0 * M_PI * _sc;
        const double _rise = shared.<closure.pitch> * shared.<closure.revolutions> * _sc;
        return KDL::Frame(shared.<closure.start>.M,
                          shared.<closure.center>
                              + KDL::Rotation::Rot(_ax, _angle) * _arm
                              + _ax * _rise);
    };
>>

path-eval-Figure8(closure, views) ::= <<
<({path-eval-Figure8-<closure.form>})(closure, views)>
>>

// In-plane reference axis: the anchor frame's x-axis, projected onto the plane and
// normalized (Gram-Schmidt) so it stays perpendicular to plane-normal.
figure8-plane(closure) ::= <<
    KDL::Vector _n = shared.<closure.plane_normal>;
    _n.Normalize();
    KDL::Vector _u = shared.<closure.anchor>.M.UnitX();
    _u -= KDL::dot(_u, _n) * _n;
    _u.Normalize();
    const KDL::Vector _v = _n * _u;
>>

path-eval-Figure8-gerono(closure, views) ::= <<
<figure8-plane(closure)>
    const auto _path_eval = [&](double _s) -> KDL::Frame {
        // Phase offset of pi/2 puts alpha=0 at the curve's center crossing (the anchor),
        // so the path starts and ends at the anchor instead of darting out to a tip.
        const double _t = 2.0 * M_PI * motion_spec::runtime::clamp01(_s) + 0.5 * M_PI;
        const double _ct = std::cos(_t);
        const double _st = std::sin(_t);
        return KDL::Frame(shared.<closure.anchor>.M,
                          shared.<closure.anchor>.p
                              + shared.<closure.radius> * (_ct * _u + (_st * _ct) * _v));
    };
>>

path-eval-Figure8-bernoulli(closure, views) ::= <<
<figure8-plane(closure)>
    const auto _path_eval = [&](double _s) -> KDL::Frame {
        const double _t = 2.0 * M_PI * motion_spec::runtime::clamp01(_s) + 0.5 * M_PI;
        const double _ct = std::cos(_t);
        const double _st = std::sin(_t);
        const double _d = 1.0 + _st * _st;
        return KDL::Frame(shared.<closure.anchor>.M,
                          shared.<closure.anchor>.p
                              + shared.<closure.radius> * ((_ct / _d) * _u
                                  + ((_st * _ct) / _d) * _v));
    };
>>

pose-axis-error-component(component) ::= <<
shared.<component.error> = _pose_axis_error_<component.subspace>_<component.axis>;
>>

pose-axis-error-group(pose_group, views) ::= <<
    {
<if(pose_group.is_pose)><pose-axis-error-group-pose(pose_group, views)><endif>
<if(pose_group.is_twist)><pose-axis-error-group-twist(pose_group, views)><endif>
<if(pose_group.is_wrench)><pose-axis-error-group-wrench(pose_group, views)><endif>
<pose_group.components:{component |         <pose-axis-error-component(component)>}; separator="\n">
    }
>>

pose-axis-error-group-pose(g, views) ::= <<
        KDL::Frame _pose_axis_target_<g.id> = shared.<g.pose>;
<if(g.linear_x)>        _pose_axis_target_<g.id>.p[0] = <access-expr(g.linear_x, views)>;
<endif>
<if(g.linear_y)>        _pose_axis_target_<g.id>.p[1] = <access-expr(g.linear_y, views)>;
<endif>
<if(g.linear_z)>        _pose_axis_target_<g.id>.p[2] = <access-expr(g.linear_z, views)>;
<endif>
<if(g.has_angular)>        const double _pose_axis_roll_<g.id> = <if(g.angular_x)><access-expr(g.angular_x, views)><else>0.0<endif>;
        const double _pose_axis_pitch_<g.id> = <if(g.angular_y)><access-expr(g.angular_y, views)><else>0.0<endif>;
        const double _pose_axis_yaw_<g.id> = <if(g.angular_z)><access-expr(g.angular_z, views)><else>0.0<endif>;
        _pose_axis_target_<g.id>.M = KDL::Rotation::RPY(_pose_axis_roll_<g.id>, _pose_axis_pitch_<g.id>, _pose_axis_yaw_<g.id>);
<endif>
        const KDL::Twist _pose_axis_error_<g.id> = KDL::diff(shared.<g.pose>, _pose_axis_target_<g.id>);
<if(g.linear_x)>        const double _pose_axis_error_linear_X = _pose_axis_error_<g.id>.vel.x();
<endif>
<if(g.linear_y)>        const double _pose_axis_error_linear_Y = _pose_axis_error_<g.id>.vel.y();
<endif>
<if(g.linear_z)>        const double _pose_axis_error_linear_Z = _pose_axis_error_<g.id>.vel.z();
<endif>
<if(g.angular_x)>        const double _pose_axis_error_angular_X = _pose_axis_error_<g.id>.rot.x();
<endif>
<if(g.angular_y)>        const double _pose_axis_error_angular_Y = _pose_axis_error_<g.id>.rot.y();
<endif>
<if(g.angular_z)>        const double _pose_axis_error_angular_Z = _pose_axis_error_<g.id>.rot.z();
<endif>
>>

pose-axis-error-group-twist(g, views) ::= <<
        KDL::Twist _pose_axis_target_<g.id> = KDL::Twist::Zero();
<if(g.linear_x)>        _pose_axis_target_<g.id>.vel[0] = <access-expr(g.linear_x, views)>;
<endif>
<if(g.linear_y)>        _pose_axis_target_<g.id>.vel[1] = <access-expr(g.linear_y, views)>;
<endif>
<if(g.linear_z)>        _pose_axis_target_<g.id>.vel[2] = <access-expr(g.linear_z, views)>;
<endif>
<if(g.angular_x)>        _pose_axis_target_<g.id>.rot[0] = <access-expr(g.angular_x, views)>;
<endif>
<if(g.angular_y)>        _pose_axis_target_<g.id>.rot[1] = <access-expr(g.angular_y, views)>;
<endif>
<if(g.angular_z)>        _pose_axis_target_<g.id>.rot[2] = <access-expr(g.angular_z, views)>;
<endif>
        const KDL::Twist _pose_axis_error_<g.id> = _pose_axis_target_<g.id> - shared.<g.pose>;
<if(g.linear_x)>        const double _pose_axis_error_linear_X = _pose_axis_error_<g.id>.vel.x();
<endif>
<if(g.linear_y)>        const double _pose_axis_error_linear_Y = _pose_axis_error_<g.id>.vel.y();
<endif>
<if(g.linear_z)>        const double _pose_axis_error_linear_Z = _pose_axis_error_<g.id>.vel.z();
<endif>
<if(g.angular_x)>        const double _pose_axis_error_angular_X = _pose_axis_error_<g.id>.rot.x();
<endif>
<if(g.angular_y)>        const double _pose_axis_error_angular_Y = _pose_axis_error_<g.id>.rot.y();
<endif>
<if(g.angular_z)>        const double _pose_axis_error_angular_Z = _pose_axis_error_<g.id>.rot.z();
<endif>
>>

pose-axis-error-group-wrench(g, views) ::= <<
        KDL::Wrench _pose_axis_target_<g.id> = KDL::Wrench::Zero();
<if(g.linear_x)>        _pose_axis_target_<g.id>.force[0] = <access-expr(g.linear_x, views)>;
<endif>
<if(g.linear_y)>        _pose_axis_target_<g.id>.force[1] = <access-expr(g.linear_y, views)>;
<endif>
<if(g.linear_z)>        _pose_axis_target_<g.id>.force[2] = <access-expr(g.linear_z, views)>;
<endif>
<if(g.angular_x)>        _pose_axis_target_<g.id>.torque[0] = <access-expr(g.angular_x, views)>;
<endif>
<if(g.angular_y)>        _pose_axis_target_<g.id>.torque[1] = <access-expr(g.angular_y, views)>;
<endif>
<if(g.angular_z)>        _pose_axis_target_<g.id>.torque[2] = <access-expr(g.angular_z, views)>;
<endif>
        const KDL::Wrench _pose_axis_error_<g.id> = _pose_axis_target_<g.id> - shared.<g.pose>;
<if(g.linear_x)>        const double _pose_axis_error_linear_X = _pose_axis_error_<g.id>.force.x();
<endif>
<if(g.linear_y)>        const double _pose_axis_error_linear_Y = _pose_axis_error_<g.id>.force.y();
<endif>
<if(g.linear_z)>        const double _pose_axis_error_linear_Z = _pose_axis_error_<g.id>.force.z();
<endif>
<if(g.angular_x)>        const double _pose_axis_error_angular_X = _pose_axis_error_<g.id>.torque.x();
<endif>
<if(g.angular_y)>        const double _pose_axis_error_angular_Y = _pose_axis_error_<g.id>.torque.y();
<endif>
<if(g.angular_z)>        const double _pose_axis_error_angular_Z = _pose_axis_error_<g.id>.torque.z();
<endif>
>>

emit-call-PlanarAngleFromDirections(closure, views) ::= <<
shared.<closure.angle> = KDL::dot(<closure.from_directions:{d | <access-expr(d, views)>}; separator=", ">);
>>

emit-call-InvertAngle(closure, views) ::= <<
shared.<closure.out> = -<access-expr(closure.in, views)>;
>>

emit-call-RotateDirectionDistalToProximalWithPose(closure, views) ::= <<
shared.<closure.to> = shared.<closure.pose>.M * <access-expr(closure.from, views)>;
>>

emit-call-ComposePose(closure, views) ::= <<
shared.<closure.composite> = <access-expr(closure.in1, views)> * <access-expr(closure.in2, views)>;
>>

emit-call-InvertPose(closure, views) ::= <<
shared.<closure.out> = shared.<closure.pose>.Inverse();
>>

emit-call-PoseToLinearDistance(closure, views) ::= <<
shared.<closure.distance> = shared.<closure.pose>.p.Norm();
>>

emit-call-PoseToDirection(closure, views) ::= <<
shared.<closure.direction> = shared.<closure.pose>.p;
shared.<closure.direction>.Normalize();
>>

emit-call-PoseToAngleAroundAxis(closure, views) ::= <<
KDL::Vector diff_<closure.angle> = KDL::diff(KDL::Rotation::Identity(), shared.<closure.pose>.M);
shared.<closure.angle> = diff_<closure.angle>[<axis-to-index.(closure.axis)>];
>>

emit-call-RotateVelocityTwistToProximalWithPose(closure, views) ::= <<
shared.<closure.to> = shared.<closure.pose>.M * <access-expr(closure.from, views)>;
>>

emit-call-WrenchFromPositionDirectionAndMagnitude(closure, views) ::= <<
shared.<closure.wrench> = KDL::Wrench(<access-expr(closure.direction, views)> * <access-expr(closure.magnitude, views)>, KDL::Vector(0.0, 0.0, 0.0)).RefPoint(-<access-expr(closure.position, views)>);
>>

emit-call-WrenchFromDirectionAndMoment(closure, views) ::= <<
shared.<closure.wrench> = KDL::Wrench(KDL::Vector::Zero(), <access-expr(closure.direction, views)> * <access-expr(closure.moment, views)>);
>>

emit-call-RotateWrenchToDistalWithPose(closure, views) ::= <<
shared.<closure.to> = shared.<closure.pose>.M.Inverse(<access-expr(closure.from, views)>);
>>

emit-call-RotateWrenchToProximalWithPose(closure, views) ::= <<
shared.<closure.to> = shared.<closure.pose>.M * <access-expr(closure.from, views)>;
>>

emit-call-TransformWrenchToProximal(closure, views) ::= <<
shared.<closure.to> = shared.<closure.pose> * <access-expr(closure.from, views)>;
>>

emit-call-Addition(closure, views) ::= <<
shared.<closure.out> = <closure.in:{operand | <access-expr(operand, views)>}; separator=" + ">;
>>

emit-call-AddWrench(closure, views) ::= <<
shared.<closure.out> = <access-expr(closure.in1, views)> + <access-expr(closure.in2, views)>;
>>
