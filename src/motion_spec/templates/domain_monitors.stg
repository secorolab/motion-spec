// SPDX-License-Identifier: MPL-2.0
// L2 domain — monitors: conditions, edges, flags.

import "expr_values.stg"

cond-term(t) ::= <<
<({cond-term-<t.kind>})(t)>
>>

// The authored band, or the exact zero every non-equality constraint is satisfied within.

band(tolerance_id) ::= "<if(tolerance_id)>shared.<tolerance_id><else>0.0<endif>"

cond-term-constraint(t) ::= <<
motion_spec::runtime::constraint_satisfied(shared.<t.error_id>, <band(t.tolerance_id)>)
>>

// The elapsed seconds are a shared value, like every other term's input: the motion owns the
// phase's start time, and whoever reads the condition -- the motion itself, or the
// introspection sample running outside its state -- reads the same number.

cond-term-elapsed(t) ::= <<
(shared.<t.elapsed_id> <t.op> <t.threshold>)
>>

cond-term-elapsed-eq(t) ::= <<
(std::abs(shared.<t.elapsed_id> - <t.threshold>) \<= <t.tolerance>)
>>

// The status the client staged, against the constant the model named. The constants come from
// action_msgs, which the client's own header pulls in.

cond-term-goal-status(t) ::= <<
(shared.<t.status_id> == action_msgs::msg::GoalStatus::<t.value>)
>>

cond-term-flag(t) ::= <<
<t.motion_id>_state_instance.<t.flag>
>>

cond-term-event(t) ::= <<
<t.motion_id>_state_instance.<t.monitor_id>_event_triggered
>>

// Precondition: terms is non-empty (callers render the empty-default literal themselves).

bool-condition(terms, any) ::= <<
<if(rest(terms))>(<if(any)><terms:{t | <cond-term(t)>}; separator=" || "><else><terms:{t | <cond-term(t)>}; separator=" && "><endif>)<else><cond-term(first(terms))><endif>
>>

// Generated-function signature + call-args, built from capability booleans (state/shared/
// robot). Multiline params match the historical layout: leading "\n    ", ",\n    " joins,
// trailing "\n"; empty when no context is needed.

// Whether the monitored condition holds this cycle: the aggregate's boolean terms, or the
// error of the one constraint it watches against its band. The publish tick reads the same
// answer from outside the motion, so both sides can never disagree.

monitor-satisfied-expr(monitor) ::= <<
<if(monitor.has_active)><if(monitor.active_terms_present)><bool-condition(monitor.active_terms, monitor.active_any)><else>false<endif><else>motion_spec::runtime::constraint_satisfied(shared.<monitor.error.id>, <band(monitor.tolerance.id)>)<endif>
>>

update-monitor(monitor) ::= <<
<if(monitor.is_edge_triggered)>
    {
        const bool active = <monitor-satisfied-expr(monitor)>;
        const bool detected = <if(monitor.debounce_duration_s)>motion_spec::runtime::sustained_edge(
            state.<monitor.id>_hold_s,
            active,
            shared.dt_measured_s,
            <monitor.debounce_duration_s>)<else>motion_spec::runtime::rising_edge(state.<monitor.id>_previous, active)<endif>;
<if(monitor.fsm_namespace)>
        // coord2b is the sequencer: fire the FSM event on the rising edge while in this state.
        if (detected) {
            events.record(<monitor.fsm_event_idx>);
        \}
        if (detected && robot.fsm_events) {
            produce_event(robot.fsm_events, <monitor.fsm_namespace>::<monitor.event_name>);
            std::cerr \<\< "[fsm] event   " \<\< <monitor.fsm_namespace>::EVENT_URIS[<monitor.fsm_namespace>::<monitor.event_name>] \<\< std::endl;
        \}
<else>
        if (state.active && detected) {
            events.record(<monitor.event_idx>);
            state.<monitor.id>_event_triggered = true;
            motion_spec::runtime::warn_produce_event_not_implemented("<monitor.event>");
        \}
<endif>
    }
<elseif(monitor.flag)>
    motion_spec::runtime::set_flag(state.<monitor.flag>, <monitor-satisfied-expr(monitor)>);
<endif>
>>

monitor-block(monitors) ::= <<
<monitors:{monitor | <update-monitor(monitor)>}; separator="\n\n">
>>
