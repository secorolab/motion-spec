// Author: Vamsi Kalagaturu
// Modular Vereshchagin/RNEA dynamics solver: state, init, sync, outputs, run stages.

import "expr_values.stg"

solver-state-struct(solver, backend) ::= <<
struct <solver.id>_solver_state {
    bool initialized = false;
    int num_spatial_directions = 0;
    int num_joints = 0;
    int num_segments = 0;
    KDL::Twist root_acc;
    KDL::JntArray q;
    KDL::JntArray qd;
    KDL::JntArray qdd;
    KDL::JntArray tau_ff;
    KDL::JntArray tau_ctrl;
    KDL::Wrenches f_ext;
    KDL::Jacobian spatial_directions;
    // The velocity solver's input, filled in place each cycle rather than rebuilt.
    KDL::JntArrayVel q_qd;
    // This chain's root, as of this cycle's world update: every pose it reports is composed onto
    // this, so the chain-relative reading is unchanged by where the arm stands in the scene. It
    // is a member because positional outputs run in `update_motion_*` while alpha directions are
    // consumed later, in `control_motion_*` of the same dispatch.
<solver-state-algorithm-fields(solver)>
<solver-state-struct-extra(solver, backend)>
};
>>

// A solver nothing drives never solves, so it carries no algorithm state. This hook is handed the
// resource solver, which states the algorithm it was resolved to; `read_only` is a motion slice's
// word for the same thing and is not a field here.
solver-state-algorithm-fields(solver) ::= <<
<if(solver.algorithm_name)><({solver-state-algorithm-fields-<solver.algorithm_name>})(solver)><endif>
>>

solver-state-algorithm-fields-ACHD(solver) ::= <<
    KDL::JntArray acceleration_energy;
    // Zero after initialization and never written again: the pass that must not see a wrench.
    KDL::Wrenches f_ext_zero;
    KDL::JntArray tau_ctrl_acc;
    std::unique_ptr\<KDL::ChainHdSolver_Vereshchagin_Fext_FixedJoint\> achd_fext;
    std::unique_ptr\<KDL::ChainHdSolver_Vereshchagin_Fixed_Joint\> achd_acc;
>>

solver-state-algorithm-fields-RNE(solver) ::= <<
    KDL::JntArray cartesian_acceleration;
    KDL::Jacobian jac;
    KDL::JntArray qdd_des;
    Eigen::VectorXd task_bias;
    motion_spec::runtime::CartesianAccelerationWorkspace accel_work;
    std::unique_ptr\<KDL::ChainIdSolver_RNE\> rnea;
    std::unique_ptr\<KDL::ChainJntToJacSolver\> jac_solver;
    std::unique_ptr\<KDL::ChainJntToJacDotSolver\> jac_dot_solver;
    // Where each externally-forced segment sits this cycle: RNEA reads f_ext in the segment's
    // own frame, so the modelled wrench has to be rotated onto it.
    std::unique_ptr\<KDL::ChainFkSolverPos_recursive\> fk_pos;
>>

// Solver state beyond the algorithm's own fields depends on the algorithm *and* the backend, so
// these hooks dispatch on the pair rather than nesting one axis inside the other. Only the pairs
// that contribute anything need a rule; the rest fall through to the empty default.
solver-state-struct-extra-impl ::= [
    "ACHD-mj_kdl": "solver-state-struct-extra-ACHD-mj_kdl",
    "ACHD-robif2b": "solver-state-struct-extra-ACHD-robif2b",
    default: "solver-no-extra"
]

solver-no-extra(solver, chain_solver="", motion_driver="") ::= <<>>

solver-state-struct-extra(solver, backend) ::= <<
<if(solver.algorithm_name)><({<solver-state-struct-extra-impl.({<solver.algorithm_name>-<backend>})>})(solver)><endif>
>>

// mj_kdl gravity-compensates the ACHD command with a separate RNE pass.
solver-state-struct-extra-ACHD-mj_kdl(solver) ::= <<
    std::unique_ptr\<KDL::ChainIdSolver_RNE\> rnea;
>>

// The hardware external-wrench pass runs its own ACHD solve, whose inputs are constant zero and
// whose outputs KDL overwrites -- so all of them are sized once here.
solver-state-struct-extra-ACHD-robif2b(solver) ::= <<
    KDL::JntArray qdd_fext;
    KDL::Jacobian alpha_zero;
    KDL::JntArray beta_zero;
    KDL::JntArray ff_zero;
    KDL::JntArray tau_cstr_fext;
>>

// The frame an alpha direction is taken in comes off the one world model, composed back onto this
// chain's root. Only that source changes here: the constraint's row and column are untouched.
alpha-frame(specification, solver_state, column) ::= <<
        const KDL::Frame alpha_frame_<solver_state>_<column> =
            robot.<solver_state>.world_to_root
            * robot.world->pose(robot.world_<solver_state>_<specification.as_seen_by.id>, robot.control_cycle);
>>

assign-spatial-direction(specification, solver_state, column, chain_root) ::= <<
<if(specification.direction)>
<if(specification.base_aligned)>
    state.<solver_state>.spatial_directions(motion_spec::runtime::constraint_row(motion_spec::runtime::<subspace-to-runtime-subspace.(specification.subspace)>, motion_spec::runtime::Axis::X), <column>) = shared.<specification.direction.id>.x();
    state.<solver_state>.spatial_directions(motion_spec::runtime::constraint_row(motion_spec::runtime::<subspace-to-runtime-subspace.(specification.subspace)>, motion_spec::runtime::Axis::Y), <column>) = shared.<specification.direction.id>.y();
    state.<solver_state>.spatial_directions(motion_spec::runtime::constraint_row(motion_spec::runtime::<subspace-to-runtime-subspace.(specification.subspace)>, motion_spec::runtime::Axis::Z), <column>) = shared.<specification.direction.id>.z();
<else>
    {
<alpha-frame(specification, solver_state, column)>
        const KDL::Vector alpha_axis_<solver_state>_<column> =
            alpha_frame_<solver_state>_<column>.M * shared.<specification.direction.id>;
        state.<solver_state>.spatial_directions(motion_spec::runtime::constraint_row(motion_spec::runtime::<subspace-to-runtime-subspace.(specification.subspace)>, motion_spec::runtime::Axis::X), <column>) = alpha_axis_<solver_state>_<column>[0];
        state.<solver_state>.spatial_directions(motion_spec::runtime::constraint_row(motion_spec::runtime::<subspace-to-runtime-subspace.(specification.subspace)>, motion_spec::runtime::Axis::Y), <column>) = alpha_axis_<solver_state>_<column>[1];
        state.<solver_state>.spatial_directions(motion_spec::runtime::constraint_row(motion_spec::runtime::<subspace-to-runtime-subspace.(specification.subspace)>, motion_spec::runtime::Axis::Z), <column>) = alpha_axis_<solver_state>_<column>[2];
    }
<endif>
<else>
<if(specification.base_aligned)>
    state.<solver_state>.spatial_directions(motion_spec::runtime::constraint_row(motion_spec::runtime::<subspace-to-runtime-subspace.(specification.subspace)>, motion_spec::runtime::Axis::<specification.axis>), <column>) = 1.0;
<else>
    {
<alpha-frame(specification, solver_state, column)>
        const KDL::Vector alpha_axis_<solver_state>_<column> =
            alpha_frame_<solver_state>_<column>.M * KDL::Vector(<axis-to-vector.(specification.axis)>);
        state.<solver_state>.spatial_directions(motion_spec::runtime::constraint_row(motion_spec::runtime::<subspace-to-runtime-subspace.(specification.subspace)>, motion_spec::runtime::Axis::X), <column>) = alpha_axis_<solver_state>_<column>[0];
        state.<solver_state>.spatial_directions(motion_spec::runtime::constraint_row(motion_spec::runtime::<subspace-to-runtime-subspace.(specification.subspace)>, motion_spec::runtime::Axis::Y), <column>) = alpha_axis_<solver_state>_<column>[1];
        state.<solver_state>.spatial_directions(motion_spec::runtime::constraint_row(motion_spec::runtime::<subspace-to-runtime-subspace.(specification.subspace)>, motion_spec::runtime::Axis::Z), <column>) = alpha_axis_<solver_state>_<column>[2];
    }
<endif>
<endif>
>>

assign-acceleration-constraint(constraint, solver_state, column, chain_root) ::= <<
<assign-spatial-direction(constraint, solver_state, column, chain_root)>
    state.<solver_state>.acceleration_energy(<column>) = shared.<constraint.acceleration_energy.id>;
>>

assign-cartesian-acceleration(specification, solver_state, column, chain_root) ::= <<
<assign-spatial-direction(specification, solver_state, column, chain_root)>
    state.<solver_state>.cartesian_acceleration(<column>) = shared.<specification.acceleration.id>;
>>

// Zero spatial directions is valid for posture-only handlers: Vereshchagin runs
// in unconstrained mode and passes tau_ff through to tau_ctrl unchanged.
// Confirmed correct per KDL implementation.
solver-init(solver, chain_solver, motion_driver, backend) ::= <<
if (!state.<solver.id>.initialized) {
        state.<solver.id>.num_joints = robot.<solver.id>.chain->getNrOfJoints();
        state.<solver.id>.num_segments = robot.<solver.id>.chain->getNrOfSegments();
        state.<solver.id>.q = KDL::JntArray(state.<solver.id>.num_joints);
        state.<solver.id>.qd = KDL::JntArray(state.<solver.id>.num_joints);
        state.<solver.id>.qdd = KDL::JntArray(state.<solver.id>.num_joints);
        state.<solver.id>.tau_ff = KDL::JntArray(state.<solver.id>.num_joints);
        state.<solver.id>.tau_ctrl = KDL::JntArray(state.<solver.id>.num_joints);
        state.<solver.id>.q_qd = KDL::JntArrayVel(state.<solver.id>.num_joints);
<if(chain_solver.derived_root_acceleration)>
        state.<solver.id>.root_acc.vel = KDL::Vector(<chain_solver.derived_root_acceleration; separator=", ">);
<endif>
<solver-init-algorithm(solver, chain_solver, motion_driver)>
<solver-init-extra(solver, chain_solver, motion_driver, backend)>
        state.<solver.id>.initialized = true;
    }
>>

solver-init-algorithm(solver, chain_solver, motion_driver) ::= <<
<if(solver.read_only)><else><({solver-init-algorithm-<chain_solver.algorithm_name>})(solver, chain_solver, motion_driver)><endif>
>>

solver-init-algorithm-ACHD(solver, chain_solver, motion_driver) ::= <<
        state.<solver.id>.num_spatial_directions = <if(motion_driver.acceleration_constraint)><length(motion_driver.acceleration_constraint)><else>0<endif>;
        state.<solver.id>.spatial_directions = KDL::Jacobian(state.<solver.id>.num_spatial_directions);
        state.<solver.id>.acceleration_energy = KDL::JntArray(state.<solver.id>.num_spatial_directions);
        // KDL::Wrench default-constructs to zero, which is the only value this one ever holds.
        state.<solver.id>.f_ext_zero = KDL::Wrenches(state.<solver.id>.num_segments);
        state.<solver.id>.tau_ctrl_acc = KDL::JntArray(state.<solver.id>.num_joints);
<if(motion_driver.has_cartesian_force)>
        state.<solver.id>.f_ext = KDL::Wrenches(state.<solver.id>.num_segments);
        state.<solver.id>.achd_fext = std::make_unique\<KDL::ChainHdSolver_Vereshchagin_Fext_FixedJoint\>(*robot.<solver.id>.chain, state.<solver.id>.root_acc, state.<solver.id>.num_spatial_directions);
<endif>
        state.<solver.id>.achd_acc = std::make_unique\<KDL::ChainHdSolver_Vereshchagin_Fixed_Joint\>(*robot.<solver.id>.chain, state.<solver.id>.root_acc, state.<solver.id>.num_spatial_directions);
>>

solver-init-algorithm-RNE(solver, chain_solver, motion_driver) ::= <<
        state.<solver.id>.f_ext = KDL::Wrenches(state.<solver.id>.num_segments);
        state.<solver.id>.num_spatial_directions = <if(motion_driver.cartesian_acceleration)><length(motion_driver.cartesian_acceleration)><else>0<endif>;
        state.<solver.id>.spatial_directions = KDL::Jacobian(state.<solver.id>.num_spatial_directions);
        state.<solver.id>.cartesian_acceleration = KDL::JntArray(state.<solver.id>.num_spatial_directions);
        state.<solver.id>.jac = KDL::Jacobian(state.<solver.id>.num_joints);
        state.<solver.id>.qdd_des = KDL::JntArray(state.<solver.id>.num_joints);
        state.<solver.id>.task_bias = Eigen::VectorXd::Zero(state.<solver.id>.num_spatial_directions);
        state.<solver.id>.accel_work.resize(state.<solver.id>.num_spatial_directions, state.<solver.id>.num_joints);
        state.<solver.id>.rnea = std::make_unique\<KDL::ChainIdSolver_RNE\>(*robot.<solver.id>.chain, KDL::Vector(<if(chain_solver.gravity)><chain_solver.gravity; separator=", "><else>0.0, 0.0, 0.0<endif>));
        state.<solver.id>.jac_solver = std::make_unique\<KDL::ChainJntToJacSolver\>(*robot.<solver.id>.chain);
        state.<solver.id>.jac_dot_solver = std::make_unique\<KDL::ChainJntToJacDotSolver\>(*robot.<solver.id>.chain);
<if(motion_driver.has_cartesian_force)>
        state.<solver.id>.fk_pos = std::make_unique\<KDL::ChainFkSolverPos_recursive\>(*robot.<solver.id>.chain);
<endif>
>>

solver-init-extra-impl ::= [
    "ACHD-mj_kdl": "solver-init-extra-ACHD-mj_kdl",
    "ACHD-robif2b": "solver-init-extra-ACHD-robif2b",
    default: "solver-no-extra"
]

solver-init-extra(solver, chain_solver, motion_driver, backend) ::= <<
<if(solver.read_only)><else><({<solver-init-extra-impl.({<chain_solver.algorithm_name>-<backend>})>})(solver, chain_solver, motion_driver)><endif>
>>

// The one place a sign is not the author's: this pass gravity-compensates the ACHD command, so
// it is built with the field itself rather than with the root acceleration ACHD was given.
solver-init-extra-ACHD-mj_kdl(solver, chain_solver, motion_driver) ::= <<
        state.<solver.id>.rnea = std::make_unique\<KDL::ChainIdSolver_RNE\>(*robot.<solver.id>.chain, KDL::Vector(<if(chain_solver.gravity_compensation)><chain_solver.gravity_compensation; separator=", "><else>0.0, 0.0, 0.0<endif>));
>>

solver-init-extra-ACHD-robif2b(solver, chain_solver, motion_driver) ::= <<
<if(motion_driver.has_cartesian_force)>
        state.<solver.id>.qdd_fext = KDL::JntArray(state.<solver.id>.num_joints);
        state.<solver.id>.alpha_zero = KDL::Jacobian(state.<solver.id>.num_spatial_directions);
        state.<solver.id>.beta_zero = KDL::JntArray(state.<solver.id>.num_spatial_directions);
        state.<solver.id>.ff_zero = KDL::JntArray(state.<solver.id>.num_joints);
        state.<solver.id>.tau_cstr_fext = KDL::JntArray(state.<solver.id>.num_joints);
        KDL::SetToZero(state.<solver.id>.alpha_zero);
        KDL::SetToZero(state.<solver.id>.beta_zero);
        KDL::SetToZero(state.<solver.id>.ff_zero);
<endif>
>>

solver-sync-input(solver, backend, joint_normalization) ::= <<
<({solver-sync-input-<backend>})(solver)>
>>

// The turn a measured joint angle is read onto. Applied to the measurement a model names and
// constraints read -- not to the solver's own joint array, which FK and the dynamics see only
// through sin/cos and which a joint resting on the interval's edge would make discontinuous.
normalized-joint-read(expression, joint_normalization) ::= <<
<if(joint_normalization)>motion_spec::runtime::normalize_joint_position(<expression>, <joint_normalization.lower>, <joint_normalization.upper>)<else><expression><endif>
>>
solver-sync-input-robif2b(solver) ::= <<
for (int i = 0; i \< state.<solver.id>.num_joints; ++i) {
    state.<solver.id>.q(i) = robot.<solver.id>.state->pos_msr[i];
    state.<solver.id>.qd(i) = robot.<solver.id>.state->vel_msr[i];
    state.<solver.id>.q_qd.q(i) = state.<solver.id>.q(i);
    state.<solver.id>.q_qd.qdot(i) = state.<solver.id>.qd(i);
}
>>
// The robot was read once for this cycle before the FSM was dispatched; this mirrors that
// reading into the solver's own joint arrays.
solver-sync-input-mj_kdl(solver) ::= <<
for (int i = 0; i \< state.<solver.id>.num_joints; ++i) {
    state.<solver.id>.q(i) = robot.<solver.id>.robot->jnt_pos_msr[i];
    state.<solver.id>.qd(i) = robot.<solver.id>.robot->jnt_vel_msr[i];
    state.<solver.id>.q_qd.q(i) = state.<solver.id>.q(i);
    state.<solver.id>.q_qd.qdot(i) = state.<solver.id>.qd(i);
}
>>

// The command that means "stay put": RNE at the measured configuration, at rest, unloaded. Uses
// the solver's own arrays -- the motion owning them is not running, and it refills them on entry.
solver-gravity-hold(solver, chain_solver, backend) ::= <<
    {
        static KDL::ChainIdSolver_RNE _gravity_<solver.id>(*robot.<solver.id>.chain, KDL::Vector(<if(chain_solver.gravity)><chain_solver.gravity; separator=", "><else>0.0, 0.0, 0.0<endif>));
        <solver-sync-input(solver, backend, "")>
        KDL::SetToZero(state.<solver.id>.qd);
        KDL::SetToZero(state.<solver.id>.qdd);
        for (auto &_w : state.<solver.id>.f_ext) {
            _w = KDL::Wrench::Zero();
        \}
        _gravity_<solver.id>.CartToJnt(
            state.<solver.id>.q,
            state.<solver.id>.qd,
            state.<solver.id>.qdd,
            state.<solver.id>.f_ext,
            state.<solver.id>.tau_ctrl);
    <({solver-stage-output-<backend>})(solver, chain_solver)>
    <solver-apply-output(solver, backend)>
    \}
>>

solver-output-Pose(solver, chain_solver, out, backend) ::= <<
<({solver-output-Pose-<backend>})(solver, chain_solver, out)>
>>

// One indexed read out of this cycle's world update, composed back onto the chain's own root --
// the same "target relative to this chain's base" the chain solver reported.
world-pose(solver, index) ::= <<
robot.<solver.id>.world_to_root * robot.world->pose(<index>, robot.control_cycle)
>>

solver-output-Pose-robif2b(solver, chain_solver, out) ::= <<
shared.<out.id> = <world-pose(solver, {robot.world_<solver.id>_<out.of.id>})>;
>>

solver-output-Pose-mj_kdl(solver, chain_solver, out) ::= <<
{
<if(out.of.is_scene_object)>
    KDL::Frame _body_frame_<out.id>;
<if(out.of.site)>    if (!mj_kdl::get_site_frame(
            robot.<solver.id>.robot->model,
            robot.<solver.id>.robot->data,
            "<out.of.site>",
            &_body_frame_<out.id>)) {
        throw std::runtime_error("MuJoCo site not found for scene object frame pose output: <out.of.site>");
    }
<else>    if (!mj_kdl::get_body_frame(
            robot.<solver.id>.robot->model,
            robot.<solver.id>.robot->data,
            "<out.of.body>",
            &_body_frame_<out.id>)) {
        throw std::runtime_error("MuJoCo body not found for scene object pose output: <out.of.body>");
    }
<endif>
    // Unchecked, a miss leaves the default-constructed identity here and the pose below comes
    // out stated in world rather than in the chain's base -- a target off by the whole base
    // transform, with nothing said about it.
    KDL::Frame _base_world_frame_<solver.id>;
    if (!mj_kdl::get_body_frame(
            robot.<solver.id>.robot->model,
            robot.<solver.id>.robot->data,
            "<chain_solver.chain.root>",
            &_base_world_frame_<solver.id>)) {
        throw std::runtime_error("MuJoCo body not found for chain root: <chain_solver.chain.root>");
    }
    shared.<out.id> = _base_world_frame_<solver.id>.Inverse() * _body_frame_<out.id>;
<else>
    shared.<out.id> = <world-pose(solver, {<if(out.of.id)>robot.world_<solver.id>_<out.of.id><else>robot.<solver.id>.world_tip<endif>})>;
<endif>
}
>>

solver-output-VelocityTwist(solver, chain_solver, out, backend) ::= <<
{
    KDL::ChainFkSolverVel_recursive fk(*robot.<solver.id>.chain);
    KDL::FrameVel tmp;
    fk.JntToCart(
        state.<solver.id>.q_qd,
        tmp,
        <out.of.segment>);
<if(out.seen_by_root)>
    shared.<out.id> = tmp.deriv();
<else>
    // Seen by a frame that moves with the arm: the same twist about the same point, turned
    // into that frame's axes, so a rotation the arm carries along reads as a constant.
    shared.<out.id> = (<world-pose(solver, {robot.world_<solver.id>_<out.as_seen_by.id>})>).M.Inverse() * tmp.deriv();
<endif>
}
>>

solver-output-JointPosition(solver, chain_solver, out, backend) ::= <<
<({solver-output-JointPosition-<backend>})(solver, chain_solver, out)>
>>

solver-output-JointPosition-robif2b(solver, chain_solver, out) ::= <<
shared.<out.id> = <normalized-joint-read({state.<solver.id>.q(<out.joint_index>)}, out.normalization)>;  // <out.joint_name>
>>

// A gripper mimic joint the chain does not articulate: the bound gripper device reports it,
// so the read never touches chain joint state.
gripper-joint-output(solver, chain_solver, out, backend) ::= <<
<({gripper-joint-output-<backend>})(solver, chain_solver, out)>
>>

gripper-joint-output-robif2b(solver, chain_solver, out) ::= <<
shared.<out.id> = <normalized-joint-read({*robot.<solver.id>.gripper_pos}, out.normalization)>;
>>

// The simulator answers for a joint the chain does not articulate -- a gripper mimic -- so the
// name is asked of it first. A joint that is on the chain falls back to the resolved index; one
// that is not has nowhere else to come from, so a miss has to say so.
solver-output-JointPosition-mj_kdl(solver, chain_solver, out) ::= <<
{
    double _joint_position_<out.id> = 0.0;
    if (mj_kdl::get_joint_position(
            robot.<solver.id>.robot->model,
            robot.<solver.id>.robot->data,
            "<out.joint_name>",
            &_joint_position_<out.id>)) {
        shared.<out.id> = <normalized-joint-read({_joint_position_<out.id>}, out.normalization)>;
    } else {
<if(out.joint_index)>        shared.<out.id> = <normalized-joint-read({robot.<solver.id>.robot->jnt_pos_msr[<out.joint_index>]}, out.normalization)>;
<else>        throw std::runtime_error("MuJoCo reports no joint '<out.joint_name>', and it is not on the chain");
<endif>    }
}
>>

solver-output-Wrench(solver, chain_solver, out, backend) ::= <<
<({solver-output-Wrench-<backend>})(solver, chain_solver, out)>
>>

solver-output-Wrench-mj_kdl(solver, chain_solver, out) ::= <<
{
    const mj_kdl::ForceTorqueSensor *ft_<out.id> = mj_kdl::find_ft_sensor(robot.<solver.id>.robot, "<out.sensor_name>");
    if (!ft_<out.id>) {
        throw std::runtime_error("FT sensor '<out.sensor_name>' is unavailable");
    }
    const auto frame_<out.id> = [&](const char *name) {
        KDL::Frame frame;
        if (!mj_kdl::get_site_frame(robot.<solver.id>.robot->model, robot.<solver.id>.robot->data, name, &frame)
            && !mj_kdl::get_body_frame(robot.<solver.id>.robot->model, robot.<solver.id>.robot->data, name, &frame)) {
            throw std::runtime_error(std::string("FT wrench frame '") + name + "' is unavailable");
        }
        return frame;
    };
    const KDL::Wrench measured_<out.id> = motion_spec::runtime::transform_wrench(
        ft_<out.id>->wrench,
        frame_<out.id>("<out.sensor_frame.id>"),
        frame_<out.id>("<out.reference_point.id>"),
        frame_<out.id>("<out.as_seen_by.id>"));
<ft-tare(out, {measured_<out.id>})>
}
>>

// A tare is what the sensor reads unloaded and at rest. The window keeps a running mean rather
// than its last sample, and a reading that drifts from that mean is the arm still moving, so the
// window starts over. Only a completed window replaces the standing bias: re-taring therefore
// leaves the previous zero in force instead of blinding every consumer for the window's length.
ft-tare(out, sample) ::= <<
<retare-on(out)>    if (robot.ft_<out.sensor_name>_bias_samples > 0 && shared.<out.id>_ft_settle \< robot.ft_<out.sensor_name>_bias_samples) {
        if (shared.<out.id>_ft_settle > 0 && robot.ft_<out.sensor_name>_bias_max_drift > 0.0
            && (<sample> - shared.<out.id>_ft_bias_new).force.Norm() > robot.ft_<out.sensor_name>_bias_max_drift) {
            shared.<out.id>_ft_settle = 0;
        \}
        ++shared.<out.id>_ft_settle;
        shared.<out.id>_ft_bias_new = shared.<out.id>_ft_bias_new
            + (<sample> - shared.<out.id>_ft_bias_new) / static_cast\<double>(shared.<out.id>_ft_settle);
        if (shared.<out.id>_ft_settle >= robot.ft_<out.sensor_name>_bias_samples) {
            shared.<out.id>_ft_bias = shared.<out.id>_ft_bias_new;
            ++shared.<out.id>_ft_tares;
        \}
    \}
    shared.<out.id> = (shared.<out.id>_ft_tares > 0 || robot.ft_<out.sensor_name>_bias_samples == 0)
        ? shared.<out.id>_ft_bias - <sample>
        : KDL::Wrench::Zero();
>>

// Re-arm the settle: the bias is only what the sensor reads unloaded, and the load changes.
retare-on(out) ::= <<
<if(out.retare_events_present)>    if (robot.fsm_events && (<out.retare_events:{e | consume_event(robot.fsm_events, <e>)}; separator=" || ">)) {
        shared.<out.id>_ft_settle = 0;
    \}
<endif>
>>

solver-output-Wrench-robif2b(solver, chain_solver, out) ::= <<
{
    // The driver reports in the sensor's own frame; the model asked for it at its reference
    // point, seen by another frame. Both come off the same forward kinematics as a pose does.
    const auto <out.id>_sample = robot.ft_<out.sensor_name>->read();
    const KDL::Wrench measured_<out.id>(
        KDL::Vector(<out.id>_sample.value.force[0], <out.id>_sample.value.force[1], <out.id>_sample.value.force[2]),
        KDL::Vector(<out.id>_sample.value.moment[0], <out.id>_sample.value.moment[1], <out.id>_sample.value.moment[2]));
    const KDL::Wrench at_<out.id> = motion_spec::runtime::transform_wrench(
        measured_<out.id>,
        <world-pose(solver, {robot.world_<solver.id>_<out.sensor_frame.id>})>,
        <world-pose(solver, {robot.world_<solver.id>_<out.reference_point.id>})>,
        <world-pose(solver, {robot.world_<solver.id>_<out.as_seen_by.id>})>);
<ft-tare(out, {at_<out.id>})>
}
>>

solver-output(solver, chain_solver, out, backend) ::= <<
<({solver-output-<out.type>})(solver, chain_solver, out, backend)>
>>

// A read-only solver serves state and FK only: no solve runs and the staged command is zero.
// The q/qd mirrors still publish so the frame log records the observed arm.
solver-run(solver, chain_solver, motion_driver, backend) ::= <<
<if(solver.read_only)>
<solver-log-joint-space(solver, backend)>
<else>
<solver-run-full(solver, chain_solver, motion_driver, backend)>
<endif>
>>

solver-run-full(solver, chain_solver, motion_driver, backend) ::= <<
    KDL::SetToZero(state.<solver.id>.spatial_directions);
<solver-assign-acceleration-input(solver, chain_solver, motion_driver)>
    KDL::SetToZero(state.<solver.id>.tau_ff);
<motion_driver.joint_force:{jf |     state.<solver.id>.tau_ff(<jf.joint_index>) += shared.<jf.force_id>;  // <jf.joint_name>}; separator="\n">
<solver-clear-external-forces(solver, chain_solver, motion_driver)>
<if(motion_driver.has_cartesian_force)>
<motion_driver.cartesian_force:{f |     <solver-assign-f-ext-modular(solver, chain_solver, f)>}; separator="\n">
<solver-run-fext-pre(solver, chain_solver, motion_driver, backend)>
<endif>
<solver-execute-algorithm(solver, chain_solver, motion_driver, backend)>
<solver-log-joint-space(solver, backend)>
>>

// Mirror the solver's joint-space signals into shared_data so the frame log can carry them:
// state.<solver> lives in the per-motion struct, which sample_model never sees.
solver-log-joint-space(solver, backend) ::= <<
<solver.joint_space_samples:{s |     shared.<s.id> = <joint-space-expr(s, solver, backend)>;}; separator="\n">
>>

joint-space-expr(s, solver, backend) ::= <<
<({joint-space-expr-<s.channel>})(s, solver, backend)>
>>

joint-space-expr-q(s, solver, backend)        ::= "state.<solver.id>.q(<s.index>)"
joint-space-expr-qd(s, solver, backend)       ::= "state.<solver.id>.qd(<s.index>)"
joint-space-expr-qdd(s, solver, backend)      ::= "state.<solver.id>.qdd(<s.index>)"
joint-space-expr-tau_ctrl(s, solver, backend) ::= "state.<solver.id>.tau_ctrl(<s.index>)"

// Only backends that actually measure joint torque get this channel (see _JOINT_SPACE_CHANNELS).
// No mj_kdl branch on purpose: its jnt_trq_msr mirrors qfrc_actuator, which torque control zeroes.
joint-space-expr-tau_msr(s, solver, backend) ::= <<
<({joint-space-expr-tau_msr-<backend>})(s, solver)>
>>
joint-space-expr-tau_msr-robif2b(s, solver) ::= "robot.<solver.id>.state->eff_msr[<s.index>]"

// Read back from the port, so what is logged is what was sent -- not a second evaluation of
// clamp_range, which could drift from what the store wrote.
solver-log-joint-space-cmd(solver, backend) ::= <<
<solver.joint_space_cmd_samples:{s |     shared.<s.id> = <joint-space-cmd-expr(s, solver, backend)>;}; separator="\n">
>>

joint-space-cmd-expr(s, solver, backend) ::= <<
<({joint-space-cmd-expr-<backend>})(s, solver)>
>>
joint-space-cmd-expr-mj_kdl(s, solver)  ::= "robot.<solver.id>.robot->jnt_trq_cmd[<s.index>]"
joint-space-cmd-expr-robif2b(s, solver) ::= "robot.<solver.id>.state->eff_cmd[<s.index>]"

solver-clear-external-forces(solver, chain_solver, motion_driver) ::= <<
<({solver-clear-external-forces-<chain_solver.algorithm_name>})(solver, motion_driver)>
>>

solver-clear-external-forces-ACHD(solver, motion_driver) ::= <<
<if(motion_driver.has_cartesian_force)>
    for (int i = 0; i \< state.<solver.id>.num_segments; ++i) {
        KDL::SetToZero(state.<solver.id>.f_ext[i]);
    }
<endif>
>>

solver-clear-external-forces-RNE(solver, motion_driver) ::= <<
    for (int i = 0; i \< state.<solver.id>.num_segments; ++i) {
        KDL::SetToZero(state.<solver.id>.f_ext[i]);
    }
>>

solver-assign-acceleration-input(solver, chain_solver, motion_driver) ::= <<
<({solver-assign-acceleration-input-<chain_solver.algorithm_name>})(solver, chain_solver, motion_driver)>
>>

solver-assign-acceleration-input-RNE(solver, chain_solver, motion_driver) ::= <<
<if(motion_driver.cartesian_acceleration)>
<motion_driver.cartesian_acceleration:{a | <assign-cartesian-acceleration(a, solver.id, i0, chain_solver.chain.root)>}; separator="\n">
<endif>
>>

solver-assign-acceleration-input-ACHD(solver, chain_solver, motion_driver) ::= <<
<if(motion_driver.acceleration_constraint)>
<motion_driver.acceleration_constraint:{c | <assign-acceleration-constraint(c, solver.id, i0, chain_solver.chain.root)>}; separator="\n">
<endif>
>>

solver-execute-algorithm(solver, chain_solver, motion_driver, backend) ::= <<
<({solver-execute-algorithm-<chain_solver.algorithm_name>})(solver, motion_driver, backend)>
>>

solver-execute-algorithm-RNE(solver, motion_driver, backend) ::= <<
<solver-run-RNE(solver, motion_driver, backend)>
>>

solver-execute-algorithm-ACHD(solver, motion_driver, backend) ::= <<
    state.<solver.id>.achd_acc->CartToJnt(
        state.<solver.id>.q,
        state.<solver.id>.qd,
        state.<solver.id>.qdd,
        state.<solver.id>.spatial_directions,
        state.<solver.id>.acceleration_energy,
        <solver-achd-f_ext-arg(solver, motion_driver, backend)>,
        state.<solver.id>.tau_ff,
        state.<solver.id>.tau_ctrl_acc);
<solver-run-finalize(solver, motion_driver, backend)>
>>

solver-run-RNE(solver, motion_driver, backend) ::= <<
    state.<solver.id>.jac_solver->JntToJac(state.<solver.id>.q, state.<solver.id>.jac);
    // Task-space velocity-product term Jdot*qdot (base frame, ee ref point):
    // xdd = J*qdd + Jdot*qdot, so subtract it from the desired task accel before
    // resolving the joint acceleration consumed by RNEA. This Cartesian-to-joint
    // mapping is an upstream kinematic adapter, not part of RNEA itself.
    KDL::Twist jdot_qd_<solver.id>;
    state.<solver.id>.jac_dot_solver->JntToJacDot(state.<solver.id>.q_qd, jdot_qd_<solver.id>);
    Eigen::Matrix\<double, 6, 1\> jdot_qd_vec_<solver.id>;
    jdot_qd_vec_<solver.id> \<\< jdot_qd_<solver.id>.vel.x(), jdot_qd_<solver.id>.vel.y(), jdot_qd_<solver.id>.vel.z(),
                               jdot_qd_<solver.id>.rot.x(), jdot_qd_<solver.id>.rot.y(), jdot_qd_<solver.id>.rot.z();
    state.<solver.id>.task_bias.noalias() = state.<solver.id>.spatial_directions.data.transpose() * jdot_qd_vec_<solver.id>;
    motion_spec::runtime::resolve_cartesian_acceleration(
        state.<solver.id>.jac,
        state.<solver.id>.spatial_directions,
        state.<solver.id>.cartesian_acceleration,
        &state.<solver.id>.task_bias,
        state.<solver.id>.accel_work,
        state.<solver.id>.qdd_des);
    state.<solver.id>.rnea->CartToJnt(
        state.<solver.id>.q,
        state.<solver.id>.qd,
        state.<solver.id>.qdd_des,
        state.<solver.id>.f_ext,
        state.<solver.id>.tau_ctrl);
    // Publish the resolved acceleration RNE was given; ACHD writes state.qdd itself, this is the
    // RNE path's equivalent. Copied after CartToJnt, never passed in as the input in its place.
    state.<solver.id>.qdd = state.<solver.id>.qdd_des;
    for (int i = 0; i \< state.<solver.id>.num_joints; ++i) {
        state.<solver.id>.tau_ctrl(i) += state.<solver.id>.tau_ff(i);
    }
>>

solver-run-fext-pre-impl ::= [
    "ACHD-robif2b": "solver-run-fext-pre-ACHD-robif2b",
    default: "solver-no-fext-pre"
]

solver-no-fext-pre(solver, motion_driver) ::= <<>>

solver-run-fext-pre(solver, chain_solver, motion_driver, backend) ::= <<
<({<solver-run-fext-pre-impl.({<chain_solver.algorithm_name>-<backend>})>})(solver, motion_driver)>
>>

// On hardware the external-wrench pass runs its own ACHD solve first; mj_kdl reads f_ext straight
// from the simulator, so nothing precedes it there.
solver-run-fext-pre-ACHD-robif2b(solver, motion_driver) ::= <<
    state.<solver.id>.achd_fext->CartToJnt(
        state.<solver.id>.q,
        state.<solver.id>.qd,
        state.<solver.id>.qdd_fext,
        state.<solver.id>.alpha_zero,
        state.<solver.id>.beta_zero,
        state.<solver.id>.f_ext,
        state.<solver.id>.ff_zero,
        state.<solver.id>.tau_cstr_fext);
>>

solver-achd-f_ext-arg(solver, motion_driver, backend) ::= <<
<({solver-achd-f_ext-arg-<backend>})(solver, motion_driver)>
>>

// The wrench belongs in the constrained solve; the RNEA pass below is only the bridge to
// MuJoCo's raw torque interface and must stay wrench-free (mj_kdl_wrapper docs/howto/torque_control.md).
solver-achd-f_ext-arg-mj_kdl(solver, motion_driver) ::= <<
<if(motion_driver.has_cartesian_force)>state.<solver.id>.f_ext<else>state.<solver.id>.f_ext_zero<endif>
>>

solver-achd-f_ext-arg-robif2b(solver, motion_driver) ::= <<
state.<solver.id>.f_ext_zero
>>

solver-run-finalize(solver, motion_driver, backend) ::= <<
<({solver-run-finalize-<backend>})(solver, motion_driver)>
>>

// ACHD's constraint torque lives in the gravity-absorbed ABA frame (~ M*qdd - c); MuJoCo's
// qfrc_applied needs M*qdd + c, so RNEA re-prices the resolved qdd. Zero wrench here, always.
solver-run-finalize-mj_kdl(solver, motion_driver) ::= <<
    state.<solver.id>.rnea->CartToJnt(
        state.<solver.id>.q,
        state.<solver.id>.qd,
        state.<solver.id>.qdd,
        state.<solver.id>.f_ext_zero,
        state.<solver.id>.tau_ctrl);
>>

solver-run-finalize-robif2b(solver, motion_driver) ::= <<
<if(motion_driver.has_cartesian_force)>
    KDL::Add(state.<solver.id>.tau_cstr_fext, state.<solver.id>.tau_ctrl_acc, state.<solver.id>.tau_ctrl);
<else>
    state.<solver.id>.tau_ctrl = state.<solver.id>.tau_ctrl_acc;
<endif>
>>

// The modelled wrench is one the arm generates on the segment it is attached to, stated in the
// chain root's orientation about that segment's origin. What each algorithm wants of it differs
// on both counts, so the two take separate rules.
solver-assign-f-ext-modular(solver, chain_solver, force) ::= <<
<({solver-assign-f-ext-<chain_solver.algorithm_name>})(solver, force)>
>>

// Vereshchagin rotates f_ext onto the segment itself and enters it as a bias force of the sign
// the model states, so the wrench goes in as authored.
solver-assign-f-ext-ACHD(solver, force) ::= <<
state.<solver.id>.f_ext[<force.attached_to.segment> - 1] += shared.<force.force.id>;
>>

// RNEA does neither: it reads f_ext[i] in segment i's own frame, and enters it as `-J_i^T f_ext`
// -- the wrench the environment applies to the arm. Rotating onto the segment and negating is
// what turns that into the force the arm generates there.
solver-assign-f-ext-RNE(solver, force) ::= <<
{
    KDL::Frame f_ext_frame_<force.force.id>;
    state.<solver.id>.fk_pos->JntToCart(state.<solver.id>.q, f_ext_frame_<force.force.id>, <force.attached_to.segment>);
    state.<solver.id>.f_ext[<force.attached_to.segment> - 1] -=
        f_ext_frame_<force.force.id>.M.Inverse() * shared.<force.force.id>;
}
>>

solver-stage-output(solver, chain_solver, backend) ::= <<
<if(solver.read_only)>
<({solver-stage-zero-<backend>})(solver)>
<else>
<({solver-stage-output-<backend>})(solver, chain_solver)>
<endif>
<solver-log-joint-space-cmd(solver, backend)>
>>
// An undriven solver stages a zero torque command on its runtime.
solver-stage-zero-robif2b(solver) ::= <<
    for (int i = 0; i \< state.<solver.id>.num_joints; ++i) {
        robot.<solver.id>.state->eff_cmd[i] = 0.0;
    }
>>
solver-stage-zero-mj_kdl(solver) ::= <<
    for (int i = 0; i \< state.<solver.id>.num_joints; ++i) {
        robot.<solver.id>.robot->jnt_trq_cmd[i] = 0.0;
    }
>>
// The authored torque limit binds on every backend: it protects the joint, so the simulator and
// the real arm must clamp the same command by the same bound.
solver-torque-command(solver, chain_solver) ::= <<
motion_spec::runtime::finite_or_stop(<if(chain_solver.torque_saturation)>motion_spec::runtime::clamp_range(state.<solver.id>.tau_ctrl(i), <saturation-lower(chain_solver.torque_saturation)>, <saturation-upper(chain_solver.torque_saturation)>)<else>state.<solver.id>.tau_ctrl(i)<endif>, i)
>>
solver-stage-output-robif2b(solver, chain_solver) ::= <<
    for (int i = 0; i \< state.<solver.id>.num_joints; ++i) {
        robot.<solver.id>.state->eff_cmd[i] = <solver-torque-command(solver, chain_solver)>;
    }
>>
solver-stage-output-mj_kdl(solver, chain_solver) ::= <<
    for (int i = 0; i \< state.<solver.id>.num_joints; ++i) {
        robot.<solver.id>.robot->jnt_trq_cmd[i] = <solver-torque-command(solver, chain_solver)>;
    }
>>

solver-apply-output(solver, backend) ::= <<
<({solver-apply-output-<backend>})(solver)>
>>
solver-apply-output-robif2b(solver) ::= <<
>>
solver-apply-output-mj_kdl(solver) ::= <<
>>
