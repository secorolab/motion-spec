// Author: Vamsi Kalagaturu
// Modular Vereshchagin/RNEA dynamics solver: state, init, sync, outputs, run stages.

import "expr_values.stg"

solver-state-struct(solver, backend) ::= <<
struct <solver.id>_solver_state {
    bool initialized = false;
    int num_spatial_directions = 0;
    int num_joints = 0;
    int num_segments = 0;
    KDL::Twist root_acc;
    KDL::JntArray q;
    KDL::JntArray qd;
    KDL::JntArray qdd;
    KDL::JntArray tau_ff;
    KDL::JntArray tau_ctrl;
    KDL::Wrenches f_ext;
    KDL::Jacobian spatial_directions;
    // The velocity solver's input, filled in place each cycle rather than rebuilt.
    KDL::JntArrayVel q_qd;
    // This chain's root, as of this cycle's world update: every pose it reports is composed onto
    // this, so the chain-relative reading is unchanged by where the arm stands in the scene. It
    // is a member because positional outputs run in `update_motion_*` while alpha directions are
    // consumed later, in `control_motion_*` of the same dispatch.
<solver-state-algorithm-fields(solver)>
<solver-state-struct-extra(solver, backend)>
};
>>

// A solver nothing drives never solves, so it carries no algorithm state. This hook is handed the
// resource solver, which states the algorithm it was resolved to; `read_only` is a motion slice's
// word for the same thing and is not a field here.
solver-state-algorithm-fields(solver) ::= <<
<if(solver.algorithm_name)><({solver-state-algorithm-fields-<solver.algorithm_name>})(solver)><endif>
>>

solver-state-algorithm-fields-ACHD(solver) ::= <<
    KDL::JntArray acceleration_energy;
    // Zero after initialization and never written again: the pass that must not see a wrench.
    KDL::Wrenches f_ext_zero;
    KDL::JntArray tau_ctrl_acc;
    std::unique_ptr\<KDL::ChainHdSolver_Vereshchagin\> achd;
>>

solver-state-algorithm-fields-RNE(solver) ::= <<
    KDL::JntArray cartesian_acceleration;
    KDL::Jacobian jac;
    KDL::JntArray qdd_des;
    Eigen::VectorXd task_bias;
    motion_spec::runtime::CartesianAccelerationWorkspace accel_work;
    std::unique_ptr\<KDL::ChainIdSolver_RNE\> rnea;
    std::unique_ptr\<KDL::ChainJntToJacSolver\> jac_solver;
    std::unique_ptr\<KDL::ChainJntToJacDotSolver\> jac_dot_solver;
>>

// Solver state beyond the algorithm's own fields depends on the algorithm *and* the backend, so
// these hooks dispatch on the pair rather than nesting one axis inside the other. Only the pairs
// that contribute anything need a rule; the rest fall through to the empty default.
solver-state-struct-extra-impl ::= [
    "ACHD-mj_kdl": "solver-state-struct-extra-ACHD-mj_kdl",
    "ACHD-robif2b": "solver-state-struct-extra-ACHD-robif2b",
    default: "solver-no-extra"
]

solver-no-extra(solver, chain_solver="", motion_driver="") ::= <<>>

solver-state-struct-extra(solver, backend) ::= <<
<if(solver.algorithm_name)><({<solver-state-struct-extra-impl.({<solver.algorithm_name>-<backend>})>})(solver)><endif>
>>

// mj_kdl gravity-compensates the ACHD command with a separate RNE pass.
solver-state-struct-extra-ACHD-mj_kdl(solver) ::= <<
    std::unique_ptr\<KDL::ChainIdSolver_RNE\> rnea;
>>

// A wrench the arm exerts never enters the constraint torque robif2b sends, so J^T f_ext is.
solver-state-struct-extra-ACHD-robif2b(solver) ::= <<
    KDL::Jacobian jac;
    KDL::JntArray tau_fext;
    std::unique_ptr\<KDL::ChainJntToJacSolver\> jac_solver;
>>

// The frame an alpha direction is taken in comes off the one world model, composed back onto this
// chain's root. Only that source changes here: the constraint's row and column are untouched.
alpha-frame(specification, solver_state, column, owner) ::= <<
        const KDL::Frame alpha_frame_<solver_state>_<column> =
            robot.<solver_state>.world_to_root
            * robot.world->pose(robot.world_<owner>_<specification.as_seen_by.id>, robot.control_cycle);
>>

assign-spatial-direction(specification, solver_state, column, owner) ::= <<
<if(specification.direction)>
<if(specification.base_aligned)>
    state.<solver_state>.spatial_directions(motion_spec::runtime::constraint_row(motion_spec::runtime::<subspace-to-runtime-subspace.(specification.subspace)>, motion_spec::runtime::Axis::X), <column>) = shared.<specification.direction.id>.x();
    state.<solver_state>.spatial_directions(motion_spec::runtime::constraint_row(motion_spec::runtime::<subspace-to-runtime-subspace.(specification.subspace)>, motion_spec::runtime::Axis::Y), <column>) = shared.<specification.direction.id>.y();
    state.<solver_state>.spatial_directions(motion_spec::runtime::constraint_row(motion_spec::runtime::<subspace-to-runtime-subspace.(specification.subspace)>, motion_spec::runtime::Axis::Z), <column>) = shared.<specification.direction.id>.z();
<if(specification.moment_direction)>
    state.<solver_state>.spatial_directions(motion_spec::runtime::constraint_row(motion_spec::runtime::<other-runtime-subspace.(specification.subspace)>, motion_spec::runtime::Axis::X), <column>) = shared.<specification.moment_direction.id>.x();
    state.<solver_state>.spatial_directions(motion_spec::runtime::constraint_row(motion_spec::runtime::<other-runtime-subspace.(specification.subspace)>, motion_spec::runtime::Axis::Y), <column>) = shared.<specification.moment_direction.id>.y();
    state.<solver_state>.spatial_directions(motion_spec::runtime::constraint_row(motion_spec::runtime::<other-runtime-subspace.(specification.subspace)>, motion_spec::runtime::Axis::Z), <column>) = shared.<specification.moment_direction.id>.z();
<endif>
<else>
    {
<alpha-frame(specification, solver_state, column, owner)>
        const KDL::Vector alpha_axis_<solver_state>_<column> =
            alpha_frame_<solver_state>_<column>.M * shared.<specification.direction.id>;
        state.<solver_state>.spatial_directions(motion_spec::runtime::constraint_row(motion_spec::runtime::<subspace-to-runtime-subspace.(specification.subspace)>, motion_spec::runtime::Axis::X), <column>) = alpha_axis_<solver_state>_<column>[0];
        state.<solver_state>.spatial_directions(motion_spec::runtime::constraint_row(motion_spec::runtime::<subspace-to-runtime-subspace.(specification.subspace)>, motion_spec::runtime::Axis::Y), <column>) = alpha_axis_<solver_state>_<column>[1];
        state.<solver_state>.spatial_directions(motion_spec::runtime::constraint_row(motion_spec::runtime::<subspace-to-runtime-subspace.(specification.subspace)>, motion_spec::runtime::Axis::Z), <column>) = alpha_axis_<solver_state>_<column>[2];
<if(specification.moment_direction)>
        const KDL::Vector alpha_moment_<solver_state>_<column> =
            alpha_frame_<solver_state>_<column>.M * shared.<specification.moment_direction.id>;
        state.<solver_state>.spatial_directions(motion_spec::runtime::constraint_row(motion_spec::runtime::<other-runtime-subspace.(specification.subspace)>, motion_spec::runtime::Axis::X), <column>) = alpha_moment_<solver_state>_<column>[0];
        state.<solver_state>.spatial_directions(motion_spec::runtime::constraint_row(motion_spec::runtime::<other-runtime-subspace.(specification.subspace)>, motion_spec::runtime::Axis::Y), <column>) = alpha_moment_<solver_state>_<column>[1];
        state.<solver_state>.spatial_directions(motion_spec::runtime::constraint_row(motion_spec::runtime::<other-runtime-subspace.(specification.subspace)>, motion_spec::runtime::Axis::Z), <column>) = alpha_moment_<solver_state>_<column>[2];
<endif>
    }
<endif>
<else>
<if(specification.base_aligned)>
    state.<solver_state>.spatial_directions(motion_spec::runtime::constraint_row(motion_spec::runtime::<subspace-to-runtime-subspace.(specification.subspace)>, motion_spec::runtime::Axis::<specification.axis>), <column>) = 1.0;
<else>
    {
<alpha-frame(specification, solver_state, column, owner)>
        const KDL::Vector alpha_axis_<solver_state>_<column> =
            alpha_frame_<solver_state>_<column>.M * KDL::Vector(<axis-to-vector.(specification.axis)>);
        state.<solver_state>.spatial_directions(motion_spec::runtime::constraint_row(motion_spec::runtime::<subspace-to-runtime-subspace.(specification.subspace)>, motion_spec::runtime::Axis::X), <column>) = alpha_axis_<solver_state>_<column>[0];
        state.<solver_state>.spatial_directions(motion_spec::runtime::constraint_row(motion_spec::runtime::<subspace-to-runtime-subspace.(specification.subspace)>, motion_spec::runtime::Axis::Y), <column>) = alpha_axis_<solver_state>_<column>[1];
        state.<solver_state>.spatial_directions(motion_spec::runtime::constraint_row(motion_spec::runtime::<subspace-to-runtime-subspace.(specification.subspace)>, motion_spec::runtime::Axis::Z), <column>) = alpha_axis_<solver_state>_<column>[2];
    }
<endif>
<endif>
>>

assign-acceleration-constraint(constraint, solver_state, column, owner) ::= <<
<assign-spatial-direction(constraint, solver_state, column, owner)>
    state.<solver_state>.acceleration_energy(<column>) = shared.<constraint.acceleration_energy.id>;
>>

assign-cartesian-acceleration(specification, solver_state, column, owner) ::= <<
<assign-spatial-direction(specification, solver_state, column, owner)>
    state.<solver_state>.cartesian_acceleration(<column>) = shared.<specification.acceleration.id>;
>>

// Zero spatial directions is valid for posture-only handlers: Vereshchagin runs
// in unconstrained mode and passes tau_ff through to tau_ctrl unchanged.
// Confirmed correct per KDL implementation.
solver-init(solver, chain_solver, motion_driver, backend) ::= <<
if (!state.<solver.id>.initialized) {
        state.<solver.id>.num_joints = robot.<solver.id>.chain->getNrOfJoints();
        state.<solver.id>.num_segments = robot.<solver.id>.chain->getNrOfSegments();
        state.<solver.id>.q = KDL::JntArray(state.<solver.id>.num_joints);
        state.<solver.id>.qd = KDL::JntArray(state.<solver.id>.num_joints);
        state.<solver.id>.qdd = KDL::JntArray(state.<solver.id>.num_joints);
        state.<solver.id>.tau_ff = KDL::JntArray(state.<solver.id>.num_joints);
        state.<solver.id>.tau_ctrl = KDL::JntArray(state.<solver.id>.num_joints);
        state.<solver.id>.q_qd = KDL::JntArrayVel(state.<solver.id>.num_joints);
<if(chain_solver.derived_root_acceleration)>
        state.<solver.id>.root_acc.vel = KDL::Vector(<chain_solver.derived_root_acceleration; separator=", ">);
<endif>
<solver-init-algorithm(solver, chain_solver, motion_driver)>
<solver-init-extra(solver, chain_solver, motion_driver, backend)>
        state.<solver.id>.initialized = true;
    }
>>

solver-init-algorithm(solver, chain_solver, motion_driver) ::= <<
<if(solver.read_only)><else><({solver-init-algorithm-<chain_solver.algorithm_name>})(solver, chain_solver, motion_driver)><endif>
>>

solver-init-algorithm-ACHD(solver, chain_solver, motion_driver) ::= <<
        state.<solver.id>.num_spatial_directions = <if(motion_driver.acceleration_constraint)><length(motion_driver.acceleration_constraint)><else>0<endif>;
        state.<solver.id>.spatial_directions = KDL::Jacobian(state.<solver.id>.num_spatial_directions);
        state.<solver.id>.acceleration_energy = KDL::JntArray(state.<solver.id>.num_spatial_directions);
        // KDL::Wrench default-constructs to zero, which is the only value this one ever holds.
        state.<solver.id>.f_ext_zero = KDL::Wrenches(state.<solver.id>.num_segments);
        state.<solver.id>.tau_ctrl_acc = KDL::JntArray(state.<solver.id>.num_joints);
        state.<solver.id>.achd = std::make_unique\<KDL::ChainHdSolver_Vereshchagin\>(*robot.<solver.id>.chain, state.<solver.id>.root_acc, state.<solver.id>.num_spatial_directions);
<if(motion_driver.has_cartesian_force)>
        state.<solver.id>.f_ext = KDL::Wrenches(state.<solver.id>.num_segments);
        // Weight one: the authored wrench is exerted, not a disturbance to compensate.
        state.<solver.id>.achd->setDriverWeights(
            Eigen::VectorXd::Ones(state.<solver.id>.num_spatial_directions),
            Eigen::VectorXd::Zero(state.<solver.id>.num_spatial_directions));
<endif>
>>

solver-init-algorithm-RNE(solver, chain_solver, motion_driver) ::= <<
        state.<solver.id>.f_ext = KDL::Wrenches(state.<solver.id>.num_segments);
        state.<solver.id>.num_spatial_directions = <if(motion_driver.cartesian_acceleration)><length(motion_driver.cartesian_acceleration)><else>0<endif>;
        state.<solver.id>.spatial_directions = KDL::Jacobian(state.<solver.id>.num_spatial_directions);
        state.<solver.id>.cartesian_acceleration = KDL::JntArray(state.<solver.id>.num_spatial_directions);
        state.<solver.id>.jac = KDL::Jacobian(state.<solver.id>.num_joints);
        state.<solver.id>.qdd_des = KDL::JntArray(state.<solver.id>.num_joints);
        state.<solver.id>.task_bias = Eigen::VectorXd::Zero(state.<solver.id>.num_spatial_directions);
        state.<solver.id>.accel_work.resize(state.<solver.id>.num_spatial_directions, state.<solver.id>.num_joints);
        state.<solver.id>.rnea = std::make_unique\<KDL::ChainIdSolver_RNE\>(*robot.<solver.id>.chain, KDL::Vector(<if(chain_solver.gravity)><chain_solver.gravity; separator=", "><else>0.0, 0.0, 0.0<endif>));
        state.<solver.id>.jac_solver = std::make_unique\<KDL::ChainJntToJacSolver\>(*robot.<solver.id>.chain);
        state.<solver.id>.jac_dot_solver = std::make_unique\<KDL::ChainJntToJacDotSolver\>(*robot.<solver.id>.chain);
>>

solver-init-extra-impl ::= [
    "ACHD-mj_kdl": "solver-init-extra-ACHD-mj_kdl",
    "ACHD-robif2b": "solver-init-extra-ACHD-robif2b",
    default: "solver-no-extra"
]

solver-init-extra(solver, chain_solver, motion_driver, backend) ::= <<
<if(solver.read_only)><else><({<solver-init-extra-impl.({<chain_solver.algorithm_name>-<backend>})>})(solver, chain_solver, motion_driver)><endif>
>>

// The one place a sign is not the author's: this pass gravity-compensates the ACHD command, so
// it is built with the field itself rather than with the root acceleration ACHD was given.
solver-init-extra-ACHD-mj_kdl(solver, chain_solver, motion_driver) ::= <<
        state.<solver.id>.rnea = std::make_unique\<KDL::ChainIdSolver_RNE\>(*robot.<solver.id>.chain, KDL::Vector(<if(chain_solver.gravity_compensation)><chain_solver.gravity_compensation; separator=", "><else>0.0, 0.0, 0.0<endif>));
>>

solver-init-extra-ACHD-robif2b(solver, chain_solver, motion_driver) ::= <<
<if(motion_driver.has_cartesian_force)>
        state.<solver.id>.jac = KDL::Jacobian(state.<solver.id>.num_joints);
        state.<solver.id>.tau_fext = KDL::JntArray(state.<solver.id>.num_joints);
        state.<solver.id>.jac_solver = std::make_unique\<KDL::ChainJntToJacSolver\>(*robot.<solver.id>.chain);
<endif>
>>

// The turn a measured joint angle is read onto. Applied to the measurement a model names and
// constraints read -- not to the solver's own joint array, which FK and the dynamics see only
// through sin/cos and which a joint resting on the interval's edge would make discontinuous.
normalized-joint-read(expression, joint_normalization) ::= <<
<if(joint_normalization)>motion_spec::runtime::normalize_joint_position(<expression>, <joint_normalization.lower>, <joint_normalization.upper>)<else><expression><endif>
>>

// The runtime was read once for this cycle before the FSM was dispatched; this mirrors the
// measured ports into the solver's own joint arrays.
solver-sync-input(solver, chain_solver) ::= <<
for (int i = 0; i \< state.<solver.id>.num_joints; ++i) {
    state.<solver.id>.q(i) = *robot.ports_<chain_solver.runtime.id>[i].position;
    state.<solver.id>.qd(i) = *robot.ports_<chain_solver.runtime.id>[i].velocity;
    state.<solver.id>.q_qd.q(i) = state.<solver.id>.q(i);
    state.<solver.id>.q_qd.qdot(i) = state.<solver.id>.qd(i);
}
>>

// The command that means "stay put": RNE at the measured configuration, at rest, unloaded. Uses
// the solver's own arrays -- the motion owning them is not running, and it refills them on entry.
solver-gravity-hold(solver, chain_solver, backend) ::= <<
    {
        static KDL::ChainIdSolver_RNE _gravity_<solver.id>(*robot.<solver.id>.chain, KDL::Vector(<if(chain_solver.gravity)><chain_solver.gravity; separator=", "><else>0.0, 0.0, 0.0<endif>));
        <solver-sync-input(solver, chain_solver)>
        KDL::SetToZero(state.<solver.id>.qd);
        KDL::SetToZero(state.<solver.id>.qdd);
        for (auto &_w : state.<solver.id>.f_ext) {
            _w = KDL::Wrench::Zero();
        \}
        _gravity_<solver.id>.CartToJnt(
            state.<solver.id>.q,
            state.<solver.id>.qd,
            state.<solver.id>.qdd,
            state.<solver.id>.f_ext,
            state.<solver.id>.tau_ctrl);
    for (int i = 0; i \< state.<solver.id>.num_joints; ++i) {
            *robot.ports_<chain_solver.runtime.id>[i].effort_cmd = <solver-torque-command(solver, chain_solver)>;
        \}
    \}
>>

// Every end reads off the one world model, so the same rule answers on every platform.
solver-output-Pose(solver, chain_solver, out, backend) ::= <<
<if(out.seen_by_root)>
{
    // Measured from a frame that moves with the arm, but stated in the chain root's axes: the
    // translation is the base-frame gap between the two, so what the pose carries as its
    // orientation is the subject's own.
    const KDL::Frame _of_<out.id> = <world-pose(solver, {robot.world_<chain_solver.runtime.owner_id>_<out.of.id>})>;
    const KDL::Frame _wrt_<out.id> = <world-pose(solver, {robot.world_<chain_solver.runtime.owner_id>_<out.relative_to_frame.id>})>;
    shared.<out.id> = KDL::Frame(_of_<out.id>.M, _of_<out.id>.p - _wrt_<out.id>.p);
}
<elseif(out.relative_to_frame)>
<relative-world-pose(solver, out)>
<else>
shared.<out.id> = <world-pose(solver, {<if(out.of.id)>robot.world_<chain_solver.runtime.owner_id>_<out.of.id><else>robot.<solver.id>.world_tip<endif>})>;
<endif>
>>

// One indexed read out of this cycle's world update, composed back onto the chain's own root --
// the same "target relative to this chain's base" the chain solver reported.
world-pose(solver, index) ::= <<
robot.<solver.id>.world_to_root * robot.world->pose(<index>, robot.control_cycle)
>>

// Both ends read off the world model; world_to_root cancels in a relative pose.
relative-world-pose(solver, out) ::= <<
shared.<out.id> = (robot.world->pose(robot.world_<chain_solver.runtime.owner_id>_<out.relative_to_frame.id>, robot.control_cycle)).Inverse() * robot.world->pose(robot.world_<chain_solver.runtime.owner_id>_<out.of.id>, robot.control_cycle);
>>

// The outward pass carries the twist beside the pose, so the chain is not walked a second time;
// what it holds is in the world's axes, and the chain root's rotation states it as the chain does.
solver-output-VelocityTwist(solver, chain_solver, out, backend) ::= <<
<if(out.seen_by_root)>
shared.<out.id> = robot.<solver.id>.world_to_root.M * robot.world->twist(robot.world_<chain_solver.runtime.owner_id>_<out.of.id>, robot.control_cycle);
<else>
// Seen by a frame that moves with the arm: the same twist about the same point, turned into
// that frame's axes, so a rotation the arm carries along reads as a constant.
shared.<out.id> = (<world-pose(solver, {robot.world_<chain_solver.runtime.owner_id>_<out.as_seen_by.id>})>).M.Inverse()
    * (robot.<solver.id>.world_to_root.M * robot.world->twist(robot.world_<chain_solver.runtime.owner_id>_<out.of.id>, robot.control_cycle));
<endif>
>>

// A chain joint reads its runtime's own port row; one the chain does not articulate -- a gripper
// mimic, an object hinge -- reads the world port whichever provider answers it wrote into.
solver-output-JointPosition(solver, chain_solver, out, backend) ::= <<
<if(out.on_chain)>shared.<out.id> = <normalized-joint-read({*robot.ports_<chain_solver.runtime.id>[<out.joint_index>].position}, out.normalization)>;  // <out.joint_name>
<else>shared.<out.id> = <normalized-joint-read({*robot.world_joint_<out.world_slot>}, out.normalization)>;  // <out.joint_name>
<endif>
>>

solver-output-JointVelocity(solver, chain_solver, out, backend) ::= <<
<if(out.on_chain)>shared.<out.id> = *robot.ports_<chain_solver.runtime.id>[<out.joint_index>].velocity;  // <out.joint_name>
<else>shared.<out.id> = *robot.world_joint_<out.world_slot>_velocity;  // <out.joint_name>
<endif>
>>

// A joint a bound device reports rather than the chain: the device wrote its port, so the read
// is the same one any other off-chain joint takes.
gripper-joint-output(solver, chain_solver, out, backend) ::= <<
<({<gripper-joint-output-impl.(out.type)>})(out)>
>>

gripper-joint-output-impl ::= [
    "JointVelocity": "gripper-velocity-output",
    "JointCurrent": "gripper-current-output",
    default: "gripper-position-output"
]

gripper-position-output(out) ::= <<
shared.<out.id> = <normalized-joint-read({*robot.world_joint_<out.world_slot>}, out.normalization)>;
>>

gripper-velocity-output(out) ::= <<
shared.<out.id> = *robot.world_joint_<out.world_slot>_velocity;
>>

gripper-current-output(out) ::= <<
shared.<out.id> = *robot.world_joint_<out.world_slot>_current;
>>

solver-output-Wrench(solver, chain_solver, out, backend) ::= <<
<if(out.estimator)><solver-output-Wrench-estimated(solver, chain_solver, out, backend)><else><solver-output-Wrench-measured(solver, chain_solver, out, backend)><endif>
>>

// Only the raw sample and the gravity vector are the platform's; the three frames the tare needs
// are read off the one world model, composed back onto this chain's root.
solver-output-Wrench-measured(solver, chain_solver, out, backend) ::= <<
{
<({wrench-raw-<backend>})(solver, out)>
    const KDL::Frame sensor_<out.id> = <world-pose(solver, {robot.world_<chain_solver.runtime.owner_id>_<out.sensor_frame.id>})>;
    const KDL::Frame reference_<out.id> = <world-pose(solver, {robot.world_<chain_solver.runtime.owner_id>_<out.reference_point.id>})>;
    const KDL::Frame observer_<out.id> = <world-pose(solver, {robot.world_<chain_solver.runtime.owner_id>_<out.as_seen_by.id>})>;
    const KDL::Vector gravity_<out.id> = <({wrench-gravity-<backend>})(solver, chain_solver)>;
<ft-tare(out, {raw_<out.id>}, {sensor_<out.id>}, {reference_<out.id>}, {observer_<out.id>}, {gravity_<out.id>})>
}
>>

// Three constants, three frames: the sensor's zero is fixed in the sensor frame, the load's weight
// in gravity's frame, the payload in the as-seen-by frame. A zero taken in any one frame leaves
// the other two rotating with the wrist. `raw` is what the load applies to the sensor.
ft-tare(out, raw, sensor, reference, observer, gravity) ::= <<
    const KDL::Vector gravity_sensor_<out.id> = (<sensor>).M.Inverse(<gravity>);
    {
        const KDL::Vector weight_<out.id> = robot.ft_<out.sensor_name>_load.getMass() * gravity_sensor_<out.id>;
        shared.<out.id>_ft_load = KDL::Wrench(
            weight_<out.id>,
            robot.ft_<out.sensor_name>_load.getMass() > 0.0
                ? robot.ft_<out.sensor_name>_load.getCOG() * weight_<out.id>
                : KDL::Vector::Zero());
    }
    shared.<out.id>_ft_raw = motion_spec::runtime::transform_wrench(<raw>, <sensor>, <reference>, <observer>);
    // Sensor frame, zero and load out: payload plus contact (plus the zero until the first tare).
    const KDL::Wrench net_<out.id> = <raw> - shared.<out.id>_ft_bias - shared.<out.id>_ft_load;
<retare-on(out)>    if (robot.ft_<out.sensor_name>_bias_samples > 0 && shared.<out.id>_ft_settle \< robot.ft_<out.sensor_name>_bias_samples) {
        if (shared.<out.id>_ft_settle > 0 && robot.ft_<out.sensor_name>_bias_max_drift > 0.0
            && (net_<out.id> - shared.<out.id>_ft_bias_new).force.Norm() > robot.ft_<out.sensor_name>_bias_max_drift) {
            shared.<out.id>_ft_settle = 0;
        \}
        ++shared.<out.id>_ft_settle;
        shared.<out.id>_ft_bias_new = shared.<out.id>_ft_bias_new
            + (net_<out.id> - shared.<out.id>_ft_bias_new) / static_cast\<double>(shared.<out.id>_ft_settle);
        if (shared.<out.id>_ft_settle >= robot.ft_<out.sensor_name>_bias_samples) {
            // Two agreeing windows commit; a press that ends between them never becomes the zero.
            if (shared.<out.id>_ft_confirming
                && (shared.<out.id>_ft_bias_new - shared.<out.id>_ft_bias_prev).force.Norm()
                     \<= robot.ft_<out.sensor_name>_bias_max_drift) {
                if (shared.<out.id>_ft_tares == 0) {
                    // First tare of a run: the sensor's zero.
                    shared.<out.id>_ft_bias = shared.<out.id>_ft_bias_new;
                \} else {
                    // A held weight lies along gravity; what a later tare finds across it is
                    // the zero having moved.
                    const double _g = gravity_sensor_<out.id>.Norm();
                    const KDL::Vector _g_hat = _g > 0.0 ? gravity_sensor_<out.id> / _g : KDL::Vector::Zero();
                    const KDL::Wrench _along(
                        KDL::dot(shared.<out.id>_ft_bias_new.force, _g_hat) * _g_hat,
                        KDL::dot(shared.<out.id>_ft_bias_new.torque, _g_hat) * _g_hat);
                    shared.<out.id>_ft_bias = shared.<out.id>_ft_bias + (shared.<out.id>_ft_bias_new - _along);
                    shared.<out.id>_ft_payload = motion_spec::runtime::transform_wrench(
                        _along, <sensor>, <reference>, <observer>);
                \}
                ++shared.<out.id>_ft_tares;
                shared.<out.id>_ft_confirming = false;
            \} else {
                if (shared.<out.id>_ft_confirming) {
                    ++shared.<out.id>_ft_rejects;
                \}
                shared.<out.id>_ft_bias_prev = shared.<out.id>_ft_bias_new;
                shared.<out.id>_ft_confirming = true;
                shared.<out.id>_ft_settle = 0;
            \}
        \}
    \}
    shared.<out.id> = (shared.<out.id>_ft_tares > 0 || robot.ft_<out.sensor_name>_bias_samples == 0)
        ? shared.<out.id>_ft_payload
            - motion_spec::runtime::transform_wrench(
                <raw> - shared.<out.id>_ft_bias - shared.<out.id>_ft_load, <sensor>, <reference>, <observer>)
        : KDL::Wrench::Zero();
>>

// Re-arm the settle: the bias is only what the sensor reads unloaded, and the load changes.
retare-on(out) ::= <<
<if(out.retare_events_present)>    if (robot.fsm_events && (<out.retare_events:{e | consume_event(robot.fsm_events, <e>)}; separator=" || ">)) {
        shared.<out.id>_ft_settle = 0;
        shared.<out.id>_ft_confirming = false;
    \}
<endif>
>>

// Momentum observer (Haddadin/De Luca/Albu-Schaeffer, T-RO 2017) as KDL ships it: fed the
// chain's q, qd and joint torque, it returns the environment's wrench on the tip, in the tip frame.
solver-output-Wrench-estimated(solver, chain_solver, out, backend) ::= <<
{
    static KDL::ChainExternalWrenchEstimator est_<out.id>(
        *robot.<solver.id>.chain,
        KDL::Vector(<chain_solver.gravity; separator=", ">),
        1.0 / motion_spec::runtime::kControlPeriodS,
        <out.estimator.estimation_gain_hz>,
        <out.estimator.filter_constant>);
    // The world block runs in main, where no motion's `state` is in scope: size off the chain.
    static const unsigned nj_<out.id> = robot.<solver.id>.chain->getNrOfJoints();
    static KDL::JntArray q_<out.id>(nj_<out.id>);
    static KDL::JntArray qd_<out.id>(nj_<out.id>);
    static KDL::JntArray tau_<out.id>(nj_<out.id>);
    // Five observer time constants for a reset to converge, five more averaged into the payload.
    static const int settle_<out.id> = static_cast\<int>(
        std::ceil(5.0 / (<out.estimator.estimation_gain_hz> * motion_spec::runtime::kControlPeriodS)));
    for (unsigned i = 0; i \< nj_<out.id>; ++i) {
        q_<out.id>(i) = <({estimator-q-<backend>})(solver)>;
        qd_<out.id>(i) = <({estimator-qd-<backend>})(solver)>;
        tau_<out.id>(i) = <({estimator-tau-<backend>})(solver)>;
    \}
<retare-on-estimator(out)>    KDL::Wrench tip_<out.id>;
    if (est_<out.id>.JntToExtWrench(q_<out.id>, qd_<out.id>, tau_<out.id>, tip_<out.id>) != KDL::SolverI::E_NOERROR) {
        throw std::runtime_error(std::string("wrench estimate '<out.id>': ") + est_<out.id>.strError(est_<out.id>.getError()));
    \}
    const KDL::Frame tip_frame_<out.id> = <world-pose(solver, {robot.<solver.id>.world_tip})>;
    const KDL::Frame reference_<out.id> = <world-pose(solver, {robot.world_<chain_solver.runtime.owner_id>_<out.reference_point.id>})>;
    const KDL::Frame observer_<out.id> = <world-pose(solver, {robot.world_<chain_solver.runtime.owner_id>_<out.as_seen_by.id>})>;
    if (shared.<out.id>_est_settle \< 2 * settle_<out.id>) {
        ++shared.<out.id>_est_settle;
        if (shared.<out.id>_est_settle > settle_<out.id>) {
            // As the FT tare: a held weight lies along gravity, so only that part is the payload.
            const KDL::Vector g_tip_<out.id> = tip_frame_<out.id>.M.Inverse(KDL::Vector(<chain_solver.gravity; separator=", ">));
            const double g_norm_<out.id> = g_tip_<out.id>.Norm();
            const KDL::Vector g_hat_<out.id> = g_norm_<out.id> > 0.0 ? g_tip_<out.id> / g_norm_<out.id> : KDL::Vector::Zero();
            const KDL::Wrench along_<out.id>(
                KDL::dot(tip_<out.id>.force, g_hat_<out.id>) * g_hat_<out.id>,
                KDL::dot(tip_<out.id>.torque, g_hat_<out.id>) * g_hat_<out.id>);
            const KDL::Wrench sample_<out.id> = motion_spec::runtime::transform_wrench(along_<out.id>, tip_frame_<out.id>, reference_<out.id>, observer_<out.id>);
            const double n_<out.id> = static_cast\<double>(shared.<out.id>_est_settle - settle_<out.id>);
            shared.<out.id>_est_payload_new = shared.<out.id>_est_payload_new + (sample_<out.id> - shared.<out.id>_est_payload_new) / n_<out.id>;
            if (shared.<out.id>_est_settle == 2 * settle_<out.id>) {
                shared.<out.id>_est_payload = shared.<out.id>_est_payload_new;
                ++shared.<out.id>_est_tares;
            \}
        \}
    \}
    // Same sign as the FT path: what the environment applies to the arm (a hanging load reads -z).
    shared.<out.id> = motion_spec::runtime::transform_wrench(tip_<out.id>, tip_frame_<out.id>, reference_<out.id>, observer_<out.id>)
        - shared.<out.id>_est_payload;
\}
>>
estimator-q-mj_kdl(solver)    ::= "*robot.ports_<solver.runtime.id>[i].position"
estimator-qd-mj_kdl(solver)   ::= "*robot.ports_<solver.runtime.id>[i].velocity"
// Simulated torque control zeroes qfrc_actuator, so the measured effort port reads nothing; the
// command applied last tick is what moved the arm.
estimator-tau-mj_kdl(solver)  ::= "*robot.ports_<solver.runtime.id>[i].effort_cmd"
estimator-q-robif2b(solver)   ::= "*robot.ports_<solver.runtime.id>[i].position"
estimator-qd-robif2b(solver)  ::= "*robot.ports_<solver.runtime.id>[i].velocity"
// Kortex actuator feedback torque carries the opposite sign to the command it answers.
estimator-tau-robif2b(solver) ::= "-*robot.ports_<solver.runtime.id>[i].effort"

// The observer's zero is the momentum now: the integral and the filtered torque restart from it,
// and the payload is taken again once it has re-converged.
retare-on-estimator(out) ::= <<
<if(out.retare_events_present)>    if (robot.fsm_events && (<out.retare_events:{e | consume_event(robot.fsm_events, <e>)}; separator=" || ">)) {
        est_<out.id>.setInitialMomentum(q_<out.id>, qd_<out.id>);
        shared.<out.id>_est_settle = 0;
        shared.<out.id>_est_payload_new = KDL::Wrench::Zero();
    \}
<endif>
>>

solver-output(solver, chain_solver, out, backend) ::= <<
<({solver-output-<out.type>})(solver, chain_solver, out, backend)>
>>

// A read-only solver serves state and FK only: no solve runs and the staged command is zero.
// The q/qd mirrors still publish so the frame log records the observed arm.
solver-run(solver, chain_solver, motion_driver, backend) ::= <<
<if(solver.read_only)>
<solver-log-joint-space(solver, chain_solver)>
<else>
<solver-run-full(solver, chain_solver, motion_driver, backend)>
<endif>
>>

solver-run-full(solver, chain_solver, motion_driver, backend) ::= <<
    KDL::SetToZero(state.<solver.id>.spatial_directions);
<solver-assign-acceleration-input(solver, chain_solver, motion_driver)>
    KDL::SetToZero(state.<solver.id>.tau_ff);
<motion_driver.joint_force:{jf |     state.<solver.id>.tau_ff(<jf.joint_index>) += shared.<jf.force_id>;  // <jf.joint_name>}; separator="\n">
<solver-clear-external-forces(solver, chain_solver, motion_driver)>
<if(motion_driver.has_cartesian_force)>
<motion_driver.cartesian_force:{f |     <solver-assign-f-ext-modular(solver, chain_solver, f)>}; separator="\n">
<solver-run-fext-pre(solver, chain_solver, motion_driver, backend)>
<endif>
<solver-execute-algorithm(solver, chain_solver, motion_driver, backend)>
<solver-log-joint-space(solver, chain_solver)>
>>

// Mirror the solver's joint-space signals into shared_data so the frame log can carry them:
// state.<solver> lives in the per-motion struct, which sample_model never sees.
solver-log-joint-space(solver, chain_solver) ::= <<
<solver.joint_space_samples:{s |     shared.<s.id> = <joint-space-expr(s, solver, chain_solver)>;}; separator="\n">
>>

joint-space-expr(s, solver, chain_solver) ::= <<
<({joint-space-expr-<s.channel>})(s, solver, chain_solver)>
>>

joint-space-expr-q(s, solver, chain_solver)        ::= "state.<solver.id>.q(<s.index>)"
joint-space-expr-qd(s, solver, chain_solver)       ::= "state.<solver.id>.qd(<s.index>)"
joint-space-expr-qdd(s, solver, chain_solver)      ::= "state.<solver.id>.qdd(<s.index>)"
joint-space-expr-tau_ctrl(s, solver, chain_solver) ::= "state.<solver.id>.tau_ctrl(<s.index>)"

// Only backends that actually measure joint torque get this channel (see _JOINT_SPACE_CHANNELS);
// under simulated torque control the measured effort mirrors qfrc_actuator, which is zero.
// Negated: only robif2b emits this, and Kortex feedback torque carries the opposite sign to its command.
joint-space-expr-tau_msr(s, solver, chain_solver) ::= "-*robot.ports_<chain_solver.runtime.id>[<s.index>].effort"

// Read back from the port, so what is logged is what was sent -- not a second evaluation of
// clamp_range, which could drift from what the store wrote.
solver-log-joint-space-cmd(solver, chain_solver) ::= <<
<solver.joint_space_cmd_samples:{s |     shared.<s.id> = *robot.ports_<chain_solver.runtime.id>[<s.index>].effort_cmd;}; separator="\n">
>>

solver-clear-external-forces(solver, chain_solver, motion_driver) ::= <<
<({solver-clear-external-forces-<chain_solver.algorithm_name>})(solver, motion_driver)>
>>

solver-clear-external-forces-ACHD(solver, motion_driver) ::= <<
<if(motion_driver.has_cartesian_force)>
    for (int i = 0; i \< state.<solver.id>.num_segments; ++i) {
        KDL::SetToZero(state.<solver.id>.f_ext[i]);
    }
<endif>
>>

solver-clear-external-forces-RNE(solver, motion_driver) ::= <<
    for (int i = 0; i \< state.<solver.id>.num_segments; ++i) {
        KDL::SetToZero(state.<solver.id>.f_ext[i]);
    }
>>

solver-assign-acceleration-input(solver, chain_solver, motion_driver) ::= <<
<({solver-assign-acceleration-input-<chain_solver.algorithm_name>})(solver, chain_solver, motion_driver)>
>>

solver-assign-acceleration-input-RNE(solver, chain_solver, motion_driver) ::= <<
<if(motion_driver.cartesian_acceleration)>
<motion_driver.cartesian_acceleration:{a | <assign-cartesian-acceleration(a, solver.id, i0, chain_solver.runtime.owner_id)>}; separator="\n">
<endif>
>>

solver-assign-acceleration-input-ACHD(solver, chain_solver, motion_driver) ::= <<
<if(motion_driver.acceleration_constraint)>
<motion_driver.acceleration_constraint:{c | <assign-acceleration-constraint(c, solver.id, i0, chain_solver.runtime.owner_id)>}; separator="\n">
<endif>
>>

solver-execute-algorithm(solver, chain_solver, motion_driver, backend) ::= <<
<({solver-execute-algorithm-<chain_solver.algorithm_name>})(solver, motion_driver, backend)>
>>

solver-execute-algorithm-RNE(solver, motion_driver, backend) ::= <<
<solver-run-RNE(solver, motion_driver, backend)>
>>

solver-execute-algorithm-ACHD(solver, motion_driver, backend) ::= <<
    state.<solver.id>.achd->CartToJnt(
        state.<solver.id>.q,
        state.<solver.id>.qd,
        state.<solver.id>.qdd,
        state.<solver.id>.spatial_directions,
        state.<solver.id>.acceleration_energy,
        <solver-achd-f_ext-arg(solver, motion_driver, backend)>,
        state.<solver.id>.tau_ff,
        state.<solver.id>.tau_ctrl_acc);
<solver-run-finalize(solver, motion_driver, backend)>
>>

solver-run-RNE(solver, motion_driver, backend) ::= <<
    state.<solver.id>.jac_solver->JntToJac(state.<solver.id>.q, state.<solver.id>.jac);
    // Task-space velocity-product term Jdot*qdot (base frame, ee ref point):
    // xdd = J*qdd + Jdot*qdot, so subtract it from the desired task accel before
    // resolving the joint acceleration consumed by RNEA. This Cartesian-to-joint
    // mapping is an upstream kinematic adapter, not part of RNEA itself.
    KDL::Twist jdot_qd_<solver.id>;
    state.<solver.id>.jac_dot_solver->JntToJacDot(state.<solver.id>.q_qd, jdot_qd_<solver.id>);
    Eigen::Matrix\<double, 6, 1\> jdot_qd_vec_<solver.id>;
    jdot_qd_vec_<solver.id> \<\< jdot_qd_<solver.id>.vel.x(), jdot_qd_<solver.id>.vel.y(), jdot_qd_<solver.id>.vel.z(),
                               jdot_qd_<solver.id>.rot.x(), jdot_qd_<solver.id>.rot.y(), jdot_qd_<solver.id>.rot.z();
    state.<solver.id>.task_bias.noalias() = state.<solver.id>.spatial_directions.data.transpose() * jdot_qd_vec_<solver.id>;
    motion_spec::runtime::resolve_cartesian_acceleration(
        state.<solver.id>.jac,
        state.<solver.id>.spatial_directions,
        state.<solver.id>.cartesian_acceleration,
        &state.<solver.id>.task_bias,
        state.<solver.id>.accel_work,
        state.<solver.id>.qdd_des);
    state.<solver.id>.rnea->CartToJnt(
        state.<solver.id>.q,
        state.<solver.id>.qd,
        state.<solver.id>.qdd_des,
        state.<solver.id>.f_ext,
        state.<solver.id>.tau_ctrl);
    // Publish the resolved acceleration RNE was given; ACHD writes state.qdd itself, this is the
    // RNE path's equivalent. Copied after CartToJnt, never passed in as the input in its place.
    state.<solver.id>.qdd = state.<solver.id>.qdd_des;
    for (int i = 0; i \< state.<solver.id>.num_joints; ++i) {
        state.<solver.id>.tau_ctrl(i) += state.<solver.id>.tau_ff(i);
    }
>>

// The wrench used to take its own ACHD pass; with the driver weights it rides the one solve.
solver-run-fext-pre(solver, chain_solver, motion_driver, backend) ::= <<>>

solver-achd-f_ext-arg(solver, motion_driver, backend) ::= <<
<if(motion_driver.has_cartesian_force)>state.<solver.id>.f_ext<else>state.<solver.id>.f_ext_zero<endif>
>>

solver-run-finalize(solver, motion_driver, backend) ::= <<
<({solver-run-finalize-<backend>})(solver, motion_driver)>
>>

// ACHD's constraint torque lives in the gravity-absorbed ABA frame (~ M*qdd - c); MuJoCo's
// qfrc_applied needs M*qdd + c, so RNEA re-prices the resolved qdd. Zero wrench here, always:
// qdd already carries the wrench, so the re-priced torque holds J^T f_ext without RNEA seeing it.
solver-run-finalize-mj_kdl(solver, motion_driver) ::= <<
    state.<solver.id>.rnea->CartToJnt(
        state.<solver.id>.q,
        state.<solver.id>.qd,
        state.<solver.id>.qdd,
        state.<solver.id>.f_ext_zero,
        state.<solver.id>.tau_ctrl);
>>

// The constraint torque is blind to a wrench it lets through, so J^T f_ext is added per segment.
solver-run-finalize-robif2b(solver, motion_driver) ::= <<
<if(motion_driver.has_cartesian_force)>
    KDL::SetToZero(state.<solver.id>.tau_fext);
    for (int i = 0; i \< state.<solver.id>.num_segments; ++i) {
        if (KDL::Equal(state.<solver.id>.f_ext[i], KDL::Wrench::Zero())) {
            continue;
        \}
        state.<solver.id>.jac_solver->JntToJac(state.<solver.id>.q, state.<solver.id>.jac, i + 1);
        Eigen::Matrix\<double, 6, 1\> wrench_<solver.id>;
        wrench_<solver.id> \<\< state.<solver.id>.f_ext[i](0), state.<solver.id>.f_ext[i](1), state.<solver.id>.f_ext[i](2),
                             state.<solver.id>.f_ext[i](3), state.<solver.id>.f_ext[i](4), state.<solver.id>.f_ext[i](5);
        state.<solver.id>.tau_fext.data.noalias() += state.<solver.id>.jac.data.transpose() * wrench_<solver.id>;
    \}
    KDL::Add(state.<solver.id>.tau_fext, state.<solver.id>.tau_ctrl_acc, state.<solver.id>.tau_ctrl);
<else>
    state.<solver.id>.tau_ctrl = state.<solver.id>.tau_ctrl_acc;
<endif>
>>

// The modelled wrench is one the arm generates on the segment it is attached to, stated in the
// chain root's orientation about that segment's origin. What each algorithm wants of it differs
// on both counts, so the two take separate rules. A sensed wrench is the same wrench read the
// other way round -- what the environment exerts on the arm -- so it enters with the sign flipped.
solver-assign-f-ext-modular(solver, chain_solver, force) ::= <<
<({solver-assign-f-ext-<chain_solver.algorithm_name>})(solver, chain_solver, force)>
>>

// Vereshchagin rotates f_ext onto the segment itself and enters it as a bias force of the sign
// the model states, so the wrench goes in as authored.
solver-assign-f-ext-ACHD(solver, chain_solver, force) ::= <<
state.<solver.id>.f_ext[<force.attached_to.segment> - 1] += shared.<force.force.id>;
>>

// RNEA does neither: it reads f_ext[i] in segment i's own frame, and enters it as `-J_i^T f_ext`
// -- the wrench the environment applies to the arm. Rotating onto the segment and negating is
// what turns that into the force the arm generates there.
solver-assign-f-ext-RNE(solver, chain_solver, force) ::= <<
{
    // Where that segment stands this cycle comes off the one world pass, composed back onto this
    // chain's root -- the frame the authored wrench is stated in.
    const KDL::Frame f_ext_frame_<force.force.id> =
        <world-pose(solver, {robot.world_<chain_solver.runtime.owner_id>_<force.attached_to.id>})>;
    state.<solver.id>.f_ext[<force.attached_to.segment> - 1] -=
        f_ext_frame_<force.force.id>.M.Inverse() * shared.<force.force.id>;
}
>>

// An undriven solver stages a zero torque command on its runtime; the command reaches the
// platform through the same port either way.
solver-stage-output(solver, chain_solver, backend) ::= <<
    for (int i = 0; i \< state.<solver.id>.num_joints; ++i) {
        *robot.ports_<chain_solver.runtime.id>[i].effort_cmd = <if(solver.read_only)>0.0<else><solver-torque-command(solver, chain_solver)><endif>;
    }
<solver-log-joint-space-cmd(solver, chain_solver)>
>>
// The authored torque limit binds on every backend: it protects the joint, so the simulator and
// the real arm must clamp the same command by the same bound.
solver-torque-command(solver, chain_solver) ::= <<
motion_spec::runtime::finite_or_stop(<if(chain_solver.torque_saturation)>motion_spec::runtime::clamp_range(state.<solver.id>.tau_ctrl(i), <saturation-lower(chain_solver.torque_saturation)>, <saturation-upper(chain_solver.torque_saturation)>)<else>state.<solver.id>.tau_ctrl(i)<endif>, i)
>>
