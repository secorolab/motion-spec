// SPDX-License-Identifier: MPL-2.0
// The robot config check a real-hardware generation ships beside its program: what the program
// reads from the config, baked in, so the runner checks the file before launch from the file alone.

config_check(configuration, resources) ::= <<
#!/usr/bin/env python3
# Generated by motion-spec for <configuration.name>.
"""Check the robot config <configuration.name> reads, before it connects to any hardware.

Each device it drives has its section with the keys that device's reader needs, each pose it
reads has three-number <configuration.config_check.pose_fields; separator=" and ">, and nothing in it is read
only by a simulation. Exits 1 with every problem on stderr; 0 when the config holds what the
program reads.
"""

import sys
import tomllib

CONFIG = "<configuration.platform.config>"
# The section each device is configured in, and the device's kind.
DEVICES = [
<resources.by_kind.serial_chain:{solver | <if(solver.runtime.owner)><solver.devices:{device |     ("<device.config_key>", "<device.kind>"),}; separator="\n"><endif>}; separator="\n">
]
# What each kind's reader in robot_config.hpp demands of its section; optional keys
# (timeout_ms, bias_samples, poll_interval_ms) have defaults there.
DEVICE_KEYS = {
    "KinovaGen3": ("ip", "user", "password", "port", "port_real_time", "session_timeout_ms", "connection_timeout_ms"),
    "KinovaGen3-2F85": ("ip", "user", "password", "port", "port_real_time", "session_timeout_ms", "connection_timeout_ms"),
    "Robotiq2F85": ("port", "baudrate", "slave_address"),
    "RobotiqFT300s": ("port", "baudrate", "slave_address"),
}
POSES = [<configuration.config_poses:{pose | "<pose.config_key>"}; separator=", ">]
POSE_FIELDS = (<configuration.config_check.pose_fields:{field | "<field>"}; separator=", ">)
HOME_KEY = "<configuration.config_check.home_key>"


def section_of(table, key):
    """The table a dotted config key names, or None when the file states no such path."""
    for part in key.split("."):
        table = table.get(part) if isinstance(table, dict) else None
    return table if isinstance(table, dict) else None


path = sys.argv[1] if len(sys.argv) == 2 else CONFIG
try:
    with open(path, "rb") as file:
        config = tomllib.load(file)
except FileNotFoundError:
    sys.exit(f"{path}: robot config not found")
except tomllib.TOMLDecodeError as error:
    sys.exit(f"{path}: {error}")

problems = []
devices = list(dict.fromkeys(DEVICES))
for key, kind in devices:
    section = section_of(config, key)
    if section is None:
        problems.append(f"no [{key}] section for the bound {kind}")
        continue
    missing = [field for field in DEVICE_KEYS.get(kind, ()) if field not in section]
    if missing:
        problems.append(f"[{key}] is missing {', '.join(missing)}")
    if HOME_KEY in section:
        problems.append(
            f"`{HOME_KEY}` in [{key}] is read only by a simulated run: these devices start "
            f"wherever they were left. Comment it out, or run the simulated platform"
        )
for key in POSES:
    section = section_of(config, key) or {}
    for field in POSE_FIELDS:
        values = section.get(field)
        if not isinstance(values, list) or len(values) != 3:
            problems.append(f"[{key}] states no three-number `{field}`")
if problems:
    sys.exit("\\n".join(f"{path}: {problem}" for problem in problems))
>>
