// L4 entry — the build: CMake projects and the robot config header.

import "backend_robif2b.stg"
cmake_mj_kdl(fsm, ros) ::= <<
cmake_minimum_required(VERSION 3.16)
project(motion_spec_mj_kdl_target LANGUAGES CXX)

set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)

find_package(Eigen3 REQUIRED)
find_package(orocos_kdl REQUIRED CONFIG)
<if(fsm)>
find_package(coord2b REQUIRED)
<endif>
find_package(mj_kdl_wrapper 0.2.2 REQUIRED CONFIG)
find_package(Threads REQUIRED)
<if(ros)>
find_package(rclcpp REQUIRED)
find_package(realtime_tools REQUIRED)
<ros.packages:{pkg | find_package(<pkg> REQUIRED)}; separator="\n">
<endif>

option(MOTION_SPEC_ENABLE_INTROSPECTION "Enable generated runtime introspection logging" OFF)

add_executable(main
    ref_main.cpp
)
target_include_directories(main PRIVATE
    ${EIGEN3_INCLUDE_DIRS}
    ${CMAKE_CURRENT_SOURCE_DIR}
    ${CMAKE_CURRENT_SOURCE_DIR}/headers
<if(fsm)>
    ${coord2b_INCLUDE_DIRS}
<endif>
)
target_link_libraries(main PRIVATE
    mj_kdl_wrapper::mj_kdl_wrapper
    orocos-kdl
<if(fsm)>
    ${coord2b_LIBRARIES}
<endif>
<if(ros)>
    rclcpp::rclcpp
    realtime_tools::realtime_tools
<ros.packages:{pkg |     ${<pkg>_TARGETS\}}; separator="\n">
<endif>
)
if(MOTION_SPEC_ENABLE_INTROSPECTION)
    find_package(Protobuf REQUIRED)
    target_sources(main PRIVATE frame_log.pb.cc)
    target_include_directories(main PRIVATE ${Protobuf_INCLUDE_DIRS})
    target_compile_definitions(main PRIVATE MOTION_SPEC_ENABLE_INTROSPECTION)
    target_link_libraries(main PRIVATE Threads::Threads protobuf::libprotobuf)
endif()
target_compile_options(main PRIVATE -Wall -Wextra -ftemplate-depth=2048)
>>

robot_config_header() ::= <<
// GENERATED by motion-spec codegen. Do not edit.
#pragma once

#include \<stdexcept\>
#include \<string\>

#include \<toml++/toml.hpp\>

namespace motion_spec::config {

struct Device {
    std::string ip;
    std::string user;
    std::string password;
    int port = 0;
    int port_real_time = 0;
    int session_timeout_ms = 0;
    int connection_timeout_ms = 0;
};

// The declared path only. Nothing may redirect it at launch: the CLI validates the file the
// model declares, and a redirected run would connect against a file nothing checked.
inline toml::table load(const std::string &path) {
    if (path.empty()) {
        throw std::runtime_error("no robot config declared; a real-world run needs one");
    }
    try {
        return toml::parse_file(path);
    \} catch (const toml::parse_error &error) {
        throw std::runtime_error(path + ": " + std::string(error.description()));
    \}
\}

inline const toml::table &section(const toml::table &config, const std::string &key) {
    const toml::node *node = config.at_path(key).node();
    if (!node || !node->is_table()) {
        throw std::runtime_error("robot config has no [" + key + "] section");
    \}
    return *node->as_table();
\}

template \<typename T\>
T required(const toml::table &table, const std::string &key, const std::string &where) {
    const auto value = table[key].value\<T\>();
    if (!value) throw std::runtime_error("robot config [" + where + "] is missing '" + key + "'");
    return *value;
\}

struct Serial {
    std::string port;
    int baudrate = 0;
    double timeout_ms = 0.0;
    int slave_address = 0;
};

inline Serial serial(const toml::table &config, const std::string &key) {
    const toml::table &entry = section(config, key);
    Serial out;
    out.port = required\<std::string\>(entry, "port", key);
    out.baudrate = required\<int\>(entry, "baudrate", key);
    out.timeout_ms = entry["timeout_ms"].value_or(1.0);
    out.slave_address = required\<int\>(entry, "slave_address", key);
    return out;
\}

// How many startup ticks are averaged away as the sensor's zero. Optional: a sensor that is
// already tared externally sets 0 and the reading passes through untouched.
inline int bias_samples(const toml::table &config, const std::string &key) {
    const int value = section(config, key)["bias_samples"].value_or(200);
    if (value \< 0) {
        throw std::runtime_error("robot config [" + key + "] has a negative 'bias_samples'");
    \}
    return value;
\}

inline Device device(const toml::table &config, const std::string &key) {
    const toml::table &entry = section(config, key);
    Device out;
    out.ip = required\<std::string\>(entry, "ip", key);
    out.user = required\<std::string\>(entry, "user", key);
    out.password = required\<std::string\>(entry, "password", key);
    out.port = required\<int\>(entry, "port", key);
    out.port_real_time = required\<int\>(entry, "port_real_time", key);
    out.session_timeout_ms = required\<int\>(entry, "session_timeout_ms", key);
    out.connection_timeout_ms = required\<int\>(entry, "connection_timeout_ms", key);
    return out;
\}

\} // namespace motion_spec::config
>>

cmake_robif2b(fsm, ros, serial_chain_solvers) ::= <<
cmake_minimum_required(VERSION 3.16)
project(motion_spec_robif2b_target LANGUAGES C CXX)

set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)

find_package(Eigen3 REQUIRED)
find_package(orocos_kdl REQUIRED CONFIG)
find_package(robif2b REQUIRED CONFIG)
find_package(tomlplusplus REQUIRED CONFIG)
<if(fsm)>
find_package(coord2b REQUIRED)
<endif>
find_package(Threads REQUIRED)
<if(ros)>
find_package(rclcpp REQUIRED)
find_package(realtime_tools REQUIRED)
<ros.packages:{pkg | find_package(<pkg> REQUIRED)}; separator="\n">
<endif>

option(MOTION_SPEC_ENABLE_INTROSPECTION "Enable generated runtime introspection logging" OFF)

add_executable(main
    ref_main.cpp
)
target_include_directories(main PRIVATE
    ${EIGEN3_INCLUDE_DIRS}
    ${CMAKE_CURRENT_SOURCE_DIR}
    ${CMAKE_CURRENT_SOURCE_DIR}/headers
<if(fsm)>
    ${coord2b_INCLUDE_DIRS}
<endif>
)
target_link_libraries(main PRIVATE
    orocos-kdl
    tomlplusplus::tomlplusplus
<serial_chain_solvers:{solver | <if(solver.runtime_owner)><solver.devices:{device | <({cmake-device-link-<device.kind>})()>}; separator="\n"><endif>}; separator="\n">
<if(fsm)>
    ${coord2b_LIBRARIES}
<endif>
<if(ros)>
    rclcpp::rclcpp
    realtime_tools::realtime_tools
<ros.packages:{pkg |     ${<pkg>_TARGETS\}}; separator="\n">
<endif>
)
if(MOTION_SPEC_ENABLE_INTROSPECTION)
    find_package(Protobuf REQUIRED)
    target_sources(main PRIVATE frame_log.pb.cc)
    target_include_directories(main PRIVATE ${Protobuf_INCLUDE_DIRS})
    target_compile_definitions(main PRIVATE MOTION_SPEC_ENABLE_INTROSPECTION)
    target_link_libraries(main PRIVATE Threads::Threads protobuf::libprotobuf)
endif()
target_compile_options(main PRIVATE -Wall -Wextra -ftemplate-depth=2048)
>>

// Only the drivers a binding actually needs: a deployment without a gripper must not have to
// build robif2b's Robotiq support.
