// Introspection artifacts: frame layout, runtime writer, model samples, frame_log.proto.

import "expr_values.stg"
import "domain_monitors.stg"
frame_layout_header(communication) ::= <<
// GENERATED by motion-spec codegen. Do not edit.
#pragma once

#include \<cstddef\>
#include \<cstdint\>

namespace motion_spec::introspection {

inline constexpr std::uint32_t kSchemaVersion = <communication.introspection_artifacts.frame_layout.schema_version>;
inline constexpr std::uint32_t kFrameLayoutVersion = <communication.introspection_artifacts.frame_layout.frame_layout_version>;
inline constexpr std::uint32_t kRuntimeRdfContractVersion = <communication.introspection_artifacts.frame_layout.runtime_rdf_contract_version>;
inline constexpr std::size_t kNumConstraints = <communication.introspection_artifacts.frame_layout.pools.constraints>;
inline constexpr std::size_t kNumMonitors = <communication.introspection_artifacts.frame_layout.pools.monitors>;
inline constexpr std::size_t kNumQuantities = <communication.introspection_artifacts.frame_layout.pools.quantities>;
inline constexpr std::size_t kNumDevices = <communication.introspection_artifacts.frame_layout.pools.devices>;
inline constexpr std::size_t kNumTriggers = <communication.introspection_artifacts.frame_layout.pools.triggers>;
inline constexpr std::size_t kNumPoses = <communication.introspection_artifacts.frame_layout.pools.poses>;
inline constexpr std::size_t kNumTwists = <communication.introspection_artifacts.frame_layout.pools.twists>;
inline constexpr std::size_t kNumWrenches = <communication.introspection_artifacts.frame_layout.pools.wrenches>;
inline constexpr std::size_t kFrameSizeBytes = <communication.introspection_artifacts.frame_layout.frame_size_bytes>;
inline constexpr const char *kSchemaHash = "<communication.introspection_artifacts.frame_layout.schema_hash>";
inline constexpr const char *kFrameLayoutHash = "<communication.introspection_artifacts.frame_layout.frame_layout_hash>";
inline constexpr const char *kRuntimeActivityId = "<communication.introspection_artifacts.frame_layout.runtime_activity_id>";
inline constexpr const char *kRuntimeProducerAgentId = "<communication.introspection_artifacts.frame_layout.runtime_producer_agent_id>";
inline constexpr const char *kRuntimeAgentId = "<communication.introspection_artifacts.frame_layout.runtime_agent_id>";
inline constexpr std::int64_t kEndState = <communication.introspection_artifacts.frame_layout.end_state>;
inline constexpr std::int64_t kNominalPeriodNs = <communication.introspection_artifacts.frame_layout.nominal_period_ns>;

// The frame log's first record, serialized at generation time: the message descriptor, every
// slot's id and IRI, the per-motion gate, the FSM tables and the init-cadence constants. Built
// here rather than assembled at startup because every field is known when the code is generated,
// and embedded rather than read from a file so a log never needs a companion to be decoded.
inline constexpr unsigned char kFrameLogHeaderRecord[] = {
<communication.introspection_artifacts.frame_layout.header_record_rows:{row|    <row; separator=", ">}; separator=",\n">
};
inline constexpr std::size_t kFrameLogHeaderRecordSize = sizeof(kFrameLogHeaderRecord);

} // namespace motion_spec::introspection
>>

introspection_runtime_header(communication, configuration) ::= <<
// GENERATED by motion-spec codegen. Do not edit.
#pragma once

#include "frame_layout.h"
#include "frame_log.pb.h"

#include \<atomic\>
#include \<chrono\>
#include \<cstddef\>
#include \<cstdint\>
#include \<cstdio\>
#include \<cstring\>
#include \<cstdlib\>
#include \<fcntl.h\>
#include \<string\>
#include \<thread\>
#include \<type_traits\>
#include \<unistd.h\>
#include \<sys/mman.h\>
#include \<vector\>

namespace motion_spec::introspection {

struct ConstraintSlot {
    std::int64_t active;
    double error;
    double output;
    std::int64_t satisfied;
    double sat_t;
    double measured;
    double setpoint;
};

struct MonitorSlot {
    std::int64_t active;
    double value;
    std::int64_t satisfied;
    double sat_t;
};

struct DeviceSlot {
    std::uint64_t seq;
    std::int64_t success;
};

struct Trigger {
    std::int64_t kind;
    std::int64_t idx;
    std::int64_t fsm_state;
    double t;
    std::int64_t wall_ns;
};

// Spatial slots ride the frame ring; the writer serializes them into the frame record's
// pose/twist/wrench fields. `active` says the motion that ran this tick drives the slot, exactly
// as it does for a constraint or a monitor: only a driven slot is sampled, and only a sampled
// slot is worth a sub-message.
struct PoseSlot {
    std::int64_t active;
    double px, py, pz, qx, qy, qz, qw;
};

struct TwistSlot {
    std::int64_t active;
    double lx, ly, lz, ax, ay, az;
};

struct WrenchSlot {
    std::int64_t active;
    double fx, fy, fz, tx, ty, tz;
};

struct Frame {
    std::uint64_t seq;
    double t;
    std::uint64_t step;
    std::int64_t fsm_state;
    std::int64_t active_motion;
    std::int64_t last_event;
    double state_since_t;
    std::int64_t state_since_wall_ns;
    double event_t;
    std::int64_t event_wall_ns;
    std::int64_t wall_ns;
    std::int64_t period_ns;
    std::int64_t compute_ns;
    ConstraintSlot constraints[kNumConstraints];
    MonitorSlot monitors[kNumMonitors];
    double quantities[kNumQuantities];
    DeviceSlot devices[kNumDevices];
    Trigger triggers[kNumTriggers];
    std::int64_t trigger_count;
    PoseSlot poses[kNumPoses];
    TwistSlot twists[kNumTwists];
    WrenchSlot wrenches[kNumWrenches];
};

static_assert(sizeof(ConstraintSlot) == 7 * 8, "ConstraintSlot must be padding-free");
static_assert(sizeof(MonitorSlot) == 4 * 8, "MonitorSlot must be padding-free");
static_assert(sizeof(DeviceSlot) == 2 * 8, "DeviceSlot must be padding-free");
static_assert(sizeof(Trigger) == 5 * 8, "Trigger must be padding-free");
static_assert(sizeof(PoseSlot) == 8 * 8, "PoseSlot must be padding-free");
static_assert(sizeof(TwistSlot) == 7 * 8, "TwistSlot must be padding-free");
static_assert(sizeof(WrenchSlot) == 7 * 8, "WrenchSlot must be padding-free");
static_assert(sizeof(Frame) == kFrameSizeBytes, "Frame layout must match frame_layout.json");
static_assert(std::is_trivially_copyable_v\<Frame\>, "Frame must stay trivially copyable");

inline std::int64_t wall_time_ns() {
    const auto now = std::chrono::system_clock::now().time_since_epoch();
    return std::chrono::duration_cast\<std::chrono::nanoseconds\>(now).count();
}

inline std::int64_t steady_time_ns() {
    const auto now = std::chrono::steady_clock::now().time_since_epoch();
    return std::chrono::duration_cast\<std::chrono::nanoseconds\>(now).count();
}

class LatestFramePublisher {
public:
    explicit LatestFramePublisher(const std::string &name) {
        int fd = ::shm_open(name.c_str(), O_CREAT | O_RDWR, 0666);
        if (fd \< 0) return;
        if (::ftruncate(fd, sizeof(Frame)) != 0) {
            ::close(fd);
            return;
        \}
        void *p = ::mmap(nullptr, sizeof(Frame), PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
        ::close(fd);
        if (p == MAP_FAILED) return;
        frame_ = static_cast\<Frame *\>(p);
        std::memset(frame_, 0, sizeof(Frame));
    \}

    ~LatestFramePublisher() {
        if (frame_) {
            ::munmap(frame_, sizeof(Frame));
            frame_ = nullptr;
        \}
    \}

    void publish(const Frame &scratch) {
        if (!frame_) return;
        const std::uint64_t odd = __atomic_load_n(&frame_->seq, __ATOMIC_RELAXED) | 1ull;
        __atomic_store_n(&frame_->seq, odd, __ATOMIC_RELAXED);
        std::atomic_thread_fence(std::memory_order_release);
        std::memcpy(
            reinterpret_cast\<char *\>(frame_) + sizeof(std::uint64_t),
            reinterpret_cast\<const char *\>(&scratch) + sizeof(std::uint64_t),
            sizeof(Frame) - sizeof(std::uint64_t));
        std::atomic_thread_fence(std::memory_order_release);
        __atomic_store_n(&frame_->seq, odd + 1, __ATOMIC_RELAXED);
    \}

private:
    Frame *frame_ = nullptr;
};

<if(configuration.platform.simulated)>
struct ControlState {
    bool pause;
    double speed;
    bool stop;
    bool step;   // advance exactly one tick, though the run is paused
};

// Pause / speed / stop, set from outside the run (the dashboard) and read once per tick.
// Every word is its own 8-byte-aligned atomic -- no seqlock, because a control word read one
// tick late is not an error, and the three are independent.
struct ControlBlock {
    std::uint64_t version;
    std::uint64_t seq;      // bumped by the writer after it sets the fields
    std::int64_t pause;
    std::uint64_t speed_bits;  // an f64 bit pattern; doubles are not valid __atomic operands
    std::int64_t stop;
    std::uint64_t ack_seq;  // last seq this run has applied
    std::int64_t steps;     // ticks the run still owes a paused stepper; it counts them down
};
static_assert(sizeof(ControlBlock) == 56, "ControlBlock must match the dashboard's layout");

inline constexpr double kMinControlSpeed = 0.1;
inline constexpr double kMaxControlSpeed = 10.0;

class ControlChannel {
public:
    explicit ControlChannel(const std::string &name) {
        int fd = ::shm_open(name.c_str(), O_CREAT | O_RDWR, 0666);
        if (fd \< 0) return;
        if (::ftruncate(fd, sizeof(ControlBlock)) != 0) {
            ::close(fd);
            return;
        \}
        void *p = ::mmap(nullptr, sizeof(ControlBlock), PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
        ::close(fd);
        if (p == MAP_FAILED) return;
        block_ = static_cast\<ControlBlock *\>(p);
        // A block left behind by a crashed run is re-zeroed rather than unlinked, same as the
        // frame shm: whoever attaches next sees a run at 1x that nobody is driving.
        std::memset(block_, 0, sizeof(ControlBlock));
        const double speed = 1.0;
        std::uint64_t bits = 0;
        std::memcpy(&bits, &speed, sizeof(bits));
        __atomic_store_n(&block_->speed_bits, bits, __ATOMIC_RELAXED);
        __atomic_store_n(&block_->version, 1ull, __ATOMIC_RELAXED);
    \}

    ~ControlChannel() {
        if (block_) {
            ::munmap(block_, sizeof(ControlBlock));
            block_ = nullptr;
        \}
    \}

    // Start the run paused, as if the block's writer had asked before the loop began.
    void seed_pause() {
        if (block_) __atomic_store_n(&block_->pause, 1, __ATOMIC_RELAXED);
    \}

    ControlState poll() {
        ControlState state{false, 1.0, false, false};
        if (!block_) return state;
        state.pause = __atomic_load_n(&block_->pause, __ATOMIC_RELAXED) != 0;
        /* Stepping is a pause that owes ticks: the writer adds them, the run takes one per
           poll, so a click advances exactly one tick however long the click lasted. */
        if (state.pause && __atomic_load_n(&block_->steps, __ATOMIC_RELAXED) \> 0) {
            __atomic_fetch_sub(&block_->steps, 1, __ATOMIC_RELAXED);
            state.step = true;
        \}
        state.stop = __atomic_load_n(&block_->stop, __ATOMIC_RELAXED) != 0;
        const std::uint64_t bits = __atomic_load_n(&block_->speed_bits, __ATOMIC_RELAXED);
        double speed = 0.0;
        std::memcpy(&speed, &bits, sizeof(speed));
        // Zero (an untouched block) and NaN both mean "nobody set a speed" -- run at 1x.
        if (!(speed > 0.0)) speed = 1.0;
        if (speed \< kMinControlSpeed) speed = kMinControlSpeed;
        if (speed > kMaxControlSpeed) speed = kMaxControlSpeed;
        state.speed = speed;
        __atomic_store_n(
            &block_->ack_seq, __atomic_load_n(&block_->seq, __ATOMIC_RELAXED), __ATOMIC_RELAXED);
        return state;
    \}

private:
    ControlBlock *block_ = nullptr;
};

<endif>
class FrameLogger {
public:
    FrameLogger(
        const std::string &path,
        std::size_t ring_capacity = 8192)
        : mask_(ring_capacity - 1) {
        // An empty path is the operator saying "no recording": no ring, no health file, no thread.
        if (path.empty()) return;
        if (ring_capacity == 0 || (ring_capacity & (ring_capacity - 1)) != 0) return;
        ring_.resize(ring_capacity);
        health_path_ = path + ".health.json";
        log_ = std::fopen(path.c_str(), "wb");
        if (!log_) return;
        write_header();
        running_.store(true, std::memory_order_relaxed);
        writer_ = std::thread(&FrameLogger::run, this);
    \}

    ~FrameLogger() { close(); \}

    void close() {
        bool expected = true;
        if (!running_.compare_exchange_strong(expected, false, std::memory_order_relaxed)) {
            return;
        \}
        if (writer_.joinable()) writer_.join();
        if (log_) {
            std::fclose(log_);
            log_ = nullptr;
        \}
        write_health();
    \}

    void push(const Frame &frame) {
        attempted_.fetch_add(1, std::memory_order_relaxed);
        if (!running_.load(std::memory_order_relaxed)) return;
        const std::uint64_t head = head_.load(std::memory_order_relaxed);
        const std::uint64_t tail = tail_.load(std::memory_order_acquire);
        if (head - tail \>= ring_.size()) {
            dropped_.fetch_add(1, std::memory_order_relaxed);
            return;
        \}
        ring_[head & mask_] = frame;
        head_.store(head + 1, std::memory_order_release);
        accepted_.fetch_add(1, std::memory_order_relaxed);
    \}

private:
    void run() {
        while (running_.load(std::memory_order_relaxed)) {
            if (!drain()) std::this_thread::sleep_for(std::chrono::milliseconds(2));
        \}
        drain();
    \}

    bool drain() {
        const std::uint64_t head = head_.load(std::memory_order_acquire);
        std::uint64_t tail = tail_.load(std::memory_order_relaxed);
        if (tail == head) return false;
        while (tail != head) {
            const Frame &frame = ring_[tail & mask_];
            write_frame(frame);
            ++tail;
        \}
        tail_.store(tail, std::memory_order_release);
        return true;
    \}

    static void append_varint(std::string &out, std::uint64_t value) {
        while (value \>= 128) {
            out.push_back(static_cast\<char\>((value % 128) + 128));
            value /= 128;
        \}
        out.push_back(static_cast\<char\>(value));
    \}

    // Length-delimited framing for the protobuf record stream (varint size + bytes).
    bool write_delimited(const std::string &message) {
        if (!log_) return false;
        prefix_.clear();
        append_varint(prefix_, message.size());
        return std::fwrite(prefix_.data(), 1, prefix_.size(), log_) == prefix_.size()
            && std::fwrite(message.data(), 1, message.size(), log_) == message.size();
    \}

    // Serialized at generation time (frame_layout.h) and written verbatim -- nothing here is
    // known only at runtime, so there is nothing to assemble.
    void write_header() {
        if (!write_delimited(std::string(
                reinterpret_cast\<const char *\>(kFrameLogHeaderRecord),
                kFrameLogHeaderRecordSize))) {
            ++write_errors_;
        \}
        // A run armed paused writes no frame for a while; readers need the contract on disk now.
        std::fflush(log_);
    \}

    void write_frame(const Frame &frame) {
        record_.Clear();
        log::RuntimeFrame *m = record_.mutable_frame();
        m->set_t(frame.t);
        m->set_step(frame.step);
        m->set_fsm_state(frame.fsm_state);
        m->set_active_motion(frame.active_motion);
        m->set_last_event(frame.last_event);
        m->set_state_since_t(frame.state_since_t);
        m->set_state_since_wall_ns(frame.state_since_wall_ns);
        m->set_event_t(frame.event_t);
        m->set_event_wall_ns(frame.event_wall_ns);
        m->set_wall_ns(frame.wall_ns);
        m->set_period_ns(frame.period_ns);
        m->set_compute_ns(frame.compute_ns);
        m->set_trigger_count(frame.trigger_count);
        // `active` is not written: which slots a motion drives is already in schema["by_motion"],
        // and the decoder resolves it from active_motion exactly as it does for quantity slots.
        <communication.introspection_artifacts.frame_layout.protobuf.fields.constraints:{f|if (frame.constraints[<f.index>].active) { auto &s = *m->mutable_<f.name>(); const auto &c = frame.constraints[<f.index>]; s.set_error(c.error); s.set_output(c.output); s.set_satisfied(c.satisfied); s.set_sat_t(c.sat_t); s.set_measured(c.measured); s.set_setpoint(c.setpoint); \}}; separator="\n        ">
        <communication.introspection_artifacts.frame_layout.protobuf.fields.monitors:{f|if (frame.monitors[<f.index>].active) { auto &s = *m->mutable_<f.name>(); const auto &x = frame.monitors[<f.index>]; s.set_value(x.value); s.set_satisfied(x.satisfied); s.set_sat_t(x.sat_t); \}}; separator="\n        ">
        <communication.introspection_artifacts.frame_layout.protobuf.fields.quantities:{f|<quantity-field-set(f)>}; separator="\n        ">
        <communication.introspection_artifacts.frame_layout.protobuf.fields.devices:{f|{ auto &s = *m->mutable_<f.name>(); const auto &x = frame.devices[<f.index>]; s.set_seq(x.seq); s.set_success(x.success); \}}; separator="\n        ">
        // Only the slots this tick actually filled: mutable_ materializes a sub-message even when
        // empty, so writing the whole pool would ship 31 empty wrappers on every eventless tick.
        <communication.introspection_artifacts.frame_layout.protobuf.fields.triggers:{f|if (frame.trigger_count > <f.index>) { auto &s = *m->mutable_<f.name>(); const auto &x = frame.triggers[<f.index>]; s.set_kind(x.kind); s.set_idx(x.idx); s.set_fsm_state(x.fsm_state); s.set_t(x.t); s.set_wall_ns(x.wall_ns); \}}; separator="\n        ">
        <communication.introspection_artifacts.frame_layout.protobuf.fields.poses:{f|if (frame.poses[<f.index>].active) { auto &s = *m->mutable_<f.name>(); const auto &x = frame.poses[<f.index>]; s.set_px(x.px); s.set_py(x.py); s.set_pz(x.pz); s.set_qx(x.qx); s.set_qy(x.qy); s.set_qz(x.qz); s.set_qw(x.qw); \}}; separator="\n        ">
        <communication.introspection_artifacts.frame_layout.protobuf.fields.twists:{f|if (frame.twists[<f.index>].active) { auto &s = *m->mutable_<f.name>(); const auto &x = frame.twists[<f.index>]; s.set_lx(x.lx); s.set_ly(x.ly); s.set_lz(x.lz); s.set_ax(x.ax); s.set_ay(x.ay); s.set_az(x.az); \}}; separator="\n        ">
        <communication.introspection_artifacts.frame_layout.protobuf.fields.wrenches:{f|if (frame.wrenches[<f.index>].active) { auto &s = *m->mutable_<f.name>(); const auto &x = frame.wrenches[<f.index>]; s.set_fx(x.fx); s.set_fy(x.fy); s.set_fz(x.fz); s.set_tx(x.tx); s.set_ty(x.ty); s.set_tz(x.tz); \}}; separator="\n        ">
        payload_.clear();
        record_.SerializeToString(&payload_);
        if (write_delimited(payload_)) {
            ++written_;
        \} else {
            ++write_errors_;
        \}
    \}

    void write_health() {
        std::FILE *health = std::fopen(health_path_.c_str(), "wb");
        if (!health) return;
        const std::uint64_t attempted = attempted_.load(std::memory_order_relaxed);
        const std::uint64_t accepted = accepted_.load(std::memory_order_relaxed);
        const std::uint64_t dropped = dropped_.load(std::memory_order_relaxed);
        std::fprintf(
            health,
            "{\n"
            "  \"attempted_frames\": %llu,\n"
            "  \"accepted_frames\": %llu,\n"
            "  \"written_frames\": %llu,\n"
            "  \"write_errors\": %llu,\n"
            "  \"dropped_frames\": %llu,\n"
            "  \"complete\": %s\n"
            "}\n",
            static_cast\<unsigned long long\>(attempted),
            static_cast\<unsigned long long\>(accepted),
            static_cast\<unsigned long long\>(written_),
            static_cast\<unsigned long long\>(write_errors_),
            static_cast\<unsigned long long\>(dropped),
            (dropped == 0 && accepted == written_ && write_errors_ == 0) ? "true" : "false");
        std::fclose(health);
    \}

    std::vector\<Frame\> ring_;
    std::uint64_t mask_ = 0;
    std::string health_path_;
    std::FILE *log_ = nullptr;
    log::FrameLogRecord record_;
    std::string payload_;
    std::string prefix_;
    std::thread writer_;
    std::atomic\<bool\> running_{false};
    std::atomic\<std::uint64_t\> head_{0};
    std::atomic\<std::uint64_t\> tail_{0};
    std::atomic\<std::uint64_t\> attempted_{0};
    std::atomic\<std::uint64_t\> accepted_{0};
    std::atomic\<std::uint64_t\> dropped_{0};
    std::uint64_t written_ = 0;
    std::uint64_t write_errors_ = 0;
};

class RunPublisher {
public:
    RunPublisher()
        : shm_(shm_name()),
<if(configuration.platform.simulated)>
          control_(ctrl_shm_name()),
<endif>
          logger_(log_path()) {}
<if(configuration.platform.simulated)>

    ControlState poll_control() { return control_.poll(); \}

    void start_paused() { control_.seed_pause(); \}
<endif>

    // Close the log before a backend tears down its GUI, its hardware or its worker threads.
    // The destructor would otherwise run last, and a teardown that hangs or aborts takes the
    // health record -- and the run's recoverable tail -- with it. Closing twice is a no-op.
    void close() { logger_.close(); \}

    void begin_tick(double t, std::uint64_t step, std::int64_t active_motion) {
        begin_tick(t, step, active_motion, active_motion);
    \}

    void begin_tick(double t, std::uint64_t step, std::int64_t active_motion, std::int64_t fsm_state) {
        tick_start_ns_ = steady_time_ns();
        const std::int64_t now = wall_time_ns();
        scratch_ = Frame{};
        scratch_.t = t;
        scratch_.step = step;
        scratch_.fsm_state = fsm_state;
        scratch_.active_motion = active_motion;
        scratch_.last_event = -1;
        scratch_.wall_ns = now;
        scratch_.period_ns = last_tick_ns_ == 0 ? 0 : tick_start_ns_ - last_tick_ns_;
        last_tick_ns_ = tick_start_ns_;
        // A slot index is motion-local -- slot 3 is a different constraint under a different
        // motion -- so the satisfaction latches only mean anything within one motion.
        if (active_motion != latched_motion_) {
            latched_motion_ = active_motion;
            for (std::size_t i = 0; i \< kNumConstraints; ++i) { csat_since_[i] = 0.0; csat_prev_[i] = false; \}
            for (std::size_t i = 0; i \< kNumMonitors; ++i) { msat_since_[i] = 0.0; msat_prev_[i] = false; \}
        \}
    \}

    // The slot index is declared by the generator, not counted as calls arrive: a constraint's
    // identity is schema["by_motion"][m]["controllers"][index], which must not depend on how many
    // samples happened to be emitted before it.
    void constraint_sample(std::size_t index, double error, double output, double measured, double setpoint, bool satisfied) {
        if (index \>= kNumConstraints) return;
        ConstraintSlot &slot = scratch_.constraints[index];
        slot.active = 1;
        slot.error = error;
        slot.output = output;
        slot.measured = measured;
        slot.setpoint = setpoint;
        slot.satisfied = satisfied ? 1 : 0;
        // Since *when* it has been satisfied, latched on the rising edge. Writing the current
        // tick's t here would only restate the frame's own timestamp.
        if (satisfied && !csat_prev_[index]) csat_since_[index] = scratch_.t;
        csat_prev_[index] = satisfied;
        slot.sat_t = satisfied ? csat_since_[index] : 0.0;
    \}

    void monitor_sample(std::size_t index, double value, bool satisfied) {
        if (index \>= kNumMonitors) return;
        MonitorSlot &slot = scratch_.monitors[index];
        slot.active = 1;
        slot.value = value;
        slot.satisfied = satisfied ? 1 : 0;
        if (satisfied && !msat_prev_[index]) msat_since_[index] = scratch_.t;
        msat_prev_[index] = satisfied;
        slot.sat_t = satisfied ? msat_since_[index] : 0.0;
    \}

    void quantity_sample(std::size_t index, double value) {
        if (index \>= kNumQuantities) return;
        scratch_.quantities[index] = value;
    \}

    void device_sample(std::size_t index, std::uint64_t seq, bool success) {
        if (index \>= kNumDevices) return;
        scratch_.devices[index] = DeviceSlot{seq, success ? 1 : 0};
    \}

    void pose_sample(std::size_t index, double px, double py, double pz, double qx, double qy, double qz, double qw) {
        if (index \>= kNumPoses) return;
        PoseSlot &s = scratch_.poses[index];
        s.active = 1;
        s.px = px; s.py = py; s.pz = pz; s.qx = qx; s.qy = qy; s.qz = qz; s.qw = qw;
    \}

    void twist_sample(std::size_t index, double lx, double ly, double lz, double ax, double ay, double az) {
        if (index \>= kNumTwists) return;
        TwistSlot &s = scratch_.twists[index];
        s.active = 1;
        s.lx = lx; s.ly = ly; s.lz = lz; s.ax = ax; s.ay = ay; s.az = az;
    \}

    void wrench_sample(std::size_t index, double fx, double fy, double fz, double tx, double ty, double tz) {
        if (index \>= kNumWrenches) return;
        WrenchSlot &s = scratch_.wrenches[index];
        s.active = 1;
        s.fx = fx; s.fy = fy; s.fz = fz; s.tx = tx; s.ty = ty; s.tz = tz;
    \}

    void event_occurrences(std::int64_t event_count, const int *events, std::size_t capacity) {
        if (capacity == 0 || event_count \<= last_event_count_) return;
        std::int64_t start = last_event_count_;
        const std::int64_t oldest = event_count - static_cast\<std::int64_t\>(capacity);
        if (start \< oldest) start = oldest;
        for (std::int64_t count = start; count \< event_count; ++count) {
            append_event(events[count % static_cast\<std::int64_t\>(capacity)]);
        \}
        last_event_count_ = event_count;
    \}

    void append_event(std::int64_t event_idx) {
        if (event_idx \< 0 || kNumTriggers == 0) return;
        const std::int64_t idx = scratch_.trigger_count % static_cast\<std::int64_t\>(kNumTriggers);
        scratch_.last_event = event_idx;
        scratch_.event_t = scratch_.t;
        scratch_.event_wall_ns = wall_time_ns();
        Trigger &trigger = scratch_.triggers[idx];
        trigger.kind = 1;
        trigger.idx = event_idx;
        trigger.fsm_state = scratch_.fsm_state;
        trigger.t = scratch_.t;
        trigger.wall_ns = scratch_.event_wall_ns;
        ++scratch_.trigger_count;
    \}

    void end_tick() {
        scratch_.compute_ns = steady_time_ns() - tick_start_ns_;
        shm_.publish(scratch_);
        logger_.push(scratch_);
    \}

private:
    // An empty MOTION_SPEC_FRAME_LOG disables the logger (motion-spec run --no-log).
    static std::string log_path() {
        if (const char *env = std::getenv("MOTION_SPEC_FRAME_LOG")) return env;
        return "frame_log.pb";
    \}

    static std::string shm_name() {
        if (const char *env = std::getenv("MOTION_SPEC_SHM_NAME")) return env;
        std::string suffix = kSchemaHash;
        if (suffix.size() > 16) suffix.resize(16);
        return "/motion_spec_" + suffix;
    \}
<if(configuration.platform.simulated)>

    static std::string ctrl_shm_name() {
        if (const char *env = std::getenv("MOTION_SPEC_CTRL_SHM_NAME")) return env;
        std::string suffix = kSchemaHash;
        if (suffix.size() > 16) suffix.resize(16);
        return "/motion_spec_ctrl_" + suffix;
    \}
<endif>

    Frame scratch_{};
    // Satisfaction onset per slot, reset when the active motion changes (slots are motion-local).
    double csat_since_[kNumConstraints ? kNumConstraints : 1]{};
    bool csat_prev_[kNumConstraints ? kNumConstraints : 1]{};
    double msat_since_[kNumMonitors ? kNumMonitors : 1]{};
    bool msat_prev_[kNumMonitors ? kNumMonitors : 1]{};
    std::int64_t latched_motion_ = -1;
    LatestFramePublisher shm_;
<if(configuration.platform.simulated)>
    ControlChannel control_;
<endif>
    FrameLogger logger_;
    std::int64_t tick_start_ns_ = 0;
    std::int64_t last_tick_ns_ = 0;
    std::int64_t last_event_count_ = 0;
};

} // namespace motion_spec::introspection
>>

ctrl-sig(id, views) ::= <<
<if(id)><access-expr(id, views)><else>0.0<endif>
>>

// A signal the model resolved to a shared field; anything else samples as a constant.
shared-sig(id) ::= <<
<if(id)>shared.<id><else>0.0<endif>
>>

// The URI rides as a comment, not as an argument: the wire carries the slot index and the schema
// carries the identity, so a dead runtime parameter would only invite it being trusted.
introspection-controller-sample(slot, views) ::= <<
        pub.constraint_sample(<slot.index>, <ctrl-sig(slot.error_signal, views)>, <shared-sig(slot.output_signal)>, <ctrl-sig(slot.measured_signal, views)>, <ctrl-sig(slot.setpoint_signal, views)>, motion_spec::runtime::constraint_satisfied(<ctrl-sig(slot.error_signal, views)>, <shared-sig(slot.tolerance_signal)>));  // <slot.uri_comment>
>>

introspection-monitor-sample(slot) ::= <<
<if(slot.has_active)>        pub.monitor_sample(<slot.index>, <if(slot.active_terms_present)><bool-condition(slot.active_terms, slot.active_any)><else>false<endif>, <if(slot.active_terms_present)><bool-condition(slot.active_terms, slot.active_any)><else>false<endif>);  // <slot.uri_comment><else>        pub.monitor_sample(<slot.index>, <if(slot.composite_error)>motion_spec::runtime::constraint_error_value(<shared-sig(slot.value_signal)>)<else><shared-sig(slot.value_signal)><endif>, motion_spec::runtime::constraint_satisfied(<shared-sig(slot.value_signal)>, <shared-sig(slot.tolerance_signal)>));  // <slot.uri_comment><endif>
>>

// A flag-typed quantity is stored as a double in the frame ring but written as a proto bool.
quantity-field-set(f) ::= <<
<({quantity-field-set-<f.proto_type>})(f)>
>>
quantity-field-set-double(f) ::= "m->set_<f.name>(frame.quantities[<f.index>]);"
quantity-field-set-bool(f)   ::= "m->set_<f.name>(frame.quantities[<f.index>] != 0.0);"

introspection-quantity-sample(slot, views) ::= <<
    pub.quantity_sample(<slot.index>, <sample-expr(slot.desc, views)>);
>>

introspection-pose-sample(slot) ::= <<
    { double _qx, _qy, _qz, _qw; shared.<slot.id>.M.GetQuaternion(_qx, _qy, _qz, _qw); pub.pose_sample(<slot.index>, shared.<slot.id>.p.x(), shared.<slot.id>.p.y(), shared.<slot.id>.p.z(), _qx, _qy, _qz, _qw); \}
>>

introspection-twist-sample(slot) ::= <<
    pub.twist_sample(<slot.index>, shared.<slot.id>.vel.x(), shared.<slot.id>.vel.y(), shared.<slot.id>.vel.z(), shared.<slot.id>.rot.x(), shared.<slot.id>.rot.y(), shared.<slot.id>.rot.z());
>>

introspection-wrench-sample(slot) ::= <<
    pub.wrench_sample(<slot.index>, shared.<slot.id>.force.x(), shared.<slot.id>.force.y(), shared.<slot.id>.force.z(), shared.<slot.id>.torque.x(), shared.<slot.id>.torque.y(), shared.<slot.id>.torque.z());
>>

// Gated on the motion that computes these values, not on the coordinator state that selected it:
// an FSM state, a behaviour-tree node and a plain sequencer all reduce to "which motion ran".
introspection-motion-case(motion, views) ::= <<
    case <motion.index>:
<motion.quantities:{slot | <introspection-quantity-sample(slot, views)>}; separator="\n">
<motion.poses:{slot | <introspection-pose-sample(slot)>}; separator="\n">
<motion.twists:{slot | <introspection-twist-sample(slot)>}; separator="\n">
<motion.wrenches:{slot | <introspection-wrench-sample(slot)>}; separator="\n">
<motion.controllers:{slot | <introspection-controller-sample(slot, views)>}; separator="\n">
<motion.monitors:{slot | <introspection-monitor-sample(slot)>}; separator="\n">
        break;
>>

introspect_model_header(communication, computation) ::= <<
// GENERATED by motion-spec codegen. Do not edit.
#pragma once

#include "introspection_runtime.hpp"
#include "runtime.hpp"
#include "shared_state.hpp"

#include \<cstdint\>

namespace motion_spec::introspection {

// `state_index` is coordinator context recorded in the frame; `active_motion` is what selects the
// slots, because a motion is what computes them.
inline void sample_model(RunPublisher &pub, int active_motion, shared_data &shared) {
    static_cast\<void\>(shared);
<communication.introspection_artifacts.model.quantities:{slot | <introspection-quantity-sample(slot, computation.views)>}; separator="\n">
<communication.introspection_artifacts.model.poses:{slot | <introspection-pose-sample(slot)>}; separator="\n">
<communication.introspection_artifacts.model.twists:{slot | <introspection-twist-sample(slot)>}; separator="\n">
<communication.introspection_artifacts.model.wrenches:{slot | <introspection-wrench-sample(slot)>}; separator="\n">
    switch (active_motion) {
<communication.introspection_artifacts.model.motions:{motion | <introspection-motion-case(motion, computation.views)>}; separator="\n">
    default:
        break;
    \}
}

} // namespace motion_spec::introspection
>>

// Per-model semantic frame-log wire contract. Field numbers come from the run's schema
// (motion_spec.introspection.artifacts.build_frame_log_proto_fields); the C++ writer in
// module.stg (write_frame) emits the matching numbers, so this .proto decodes logs/frame_log.pb.
frame_log_proto(communication) ::= <<
// SPDX-License-Identifier: MPL-2.0
// GENERATED by motion-spec codegen from this model's schema. Do not edit.

syntax = "proto3";

package motion_spec.introspection.log;

// A slot's identity: the RuntimeFrame field number that carries it, the generated id, and the
// model IRI it names. An id is a lossy projection of its IRI, so both travel.
message SlotIri {
  uint32 number = 1;
  string id = 2;
  string iri = 3;
  // A controller slot names the constraint it serves; a monitor slot names the event it fires.
  string constraint_iri = 4;
  string event_iri = 5;
  string constraint_id = 6;
  // "while" | "until" | "when" on a monitor slot, empty elsewhere.
  string phase = 7;
  // The quantity slots this slot joins to, by id: what a plot of it is drawn from.
  string error_id = 8;
  string output_id = 9;
  string measured_id = 10;
  string setpoint_id = 11;
  string tolerance_id = 12;
  // Every watched constraint: an aggregate monitor watches more than the scalar can say.
  repeated string constraint_iris = 13;
  // Each one with the error it is judged by, so a conjunction can be read member by member.
  repeated WatchedConstraint watched = 18;
  repeated SlotGain gains = 14;
  // The two quantities the evaluator compares, the difference it writes, and the closure itself.
  repeated string operand_ids = 15;
  string difference_id = 16;
  string evaluator_id = 17;
}

// One constraint an aggregate monitor watches, and the error its evaluator writes.
message WatchedConstraint {
  string id = 1;
  string iri = 2;
  string error_id = 3;
  string tolerance_id = 4;
}

// A controller's gains: literals folded into the controller, so no quantity slot carries them.
message SlotGain {
  string role = 1;
  double value = 2;
}

message Transition {
  uint32 index = 1;
  string id = 2;
  string iri = 3;
  int32 from_state = 4;
  int32 to_state = 5;
  int32 event_index = 6;
  repeated uint32 event_indices = 7;
}

// Which slots a motion drives. proto3 elides a genuine 0.0 exactly as it elides "never written",
// so absence on the wire cannot tell an inactive slot from a zero one -- the frame carries
// active_motion and this says what that motion writes.
message MotionGate {
  uint32 index = 1;
  string id = 2;
  string iri = 3;
  int32 fsm_state = 4;
  repeated uint32 quantities = 5;
  repeated uint32 poses = 6;
  repeated uint32 twists = 7;
  repeated uint32 wrenches = 8;
  repeated SlotIri controllers = 9;
  repeated SlotIri monitors = 10;
}

message Constant {
  string id = 1;
  string source_id = 2;
  double value = 3;
  // The model term this number projects, and who reads it.
  string uri = 4;
  repeated ConstantConsumer consumers = 5;
}

message ConstantConsumer {
  string id = 1;
  string kind = 2;
  string role = 3;
}

message FrameLogHeader {
  string schema_hash = 1;
  string producer_agent_id = 2;
  string activity_id = 3;
  // This file's own FileDescriptorSet: the log carries the schema it was written against.
  bytes descriptor_set = 4;
  repeated SlotIri slots = 5;
  repeated MotionGate motions = 6;
  uint32 trigger_pool = 7;
  repeated SlotIri fsm_states = 8;
  repeated SlotIri fsm_events = 9;
  repeated Transition fsm_transitions = 10;
  // Written once at init; repeating them per tick would say nothing new.
  repeated Constant constants = 11;
  string runtime_agent_id = 12;
  string platform_name = 13;
  bool simulated = 14;
  int32 end_state = 15;
  int64 nominal_period_ns = 16;
  string fsm_namespace = 17;
}

message ConstraintSlot {
  sfixed64 active = 1;
  double error = 2;
  double output = 3;
  sfixed64 satisfied = 4;
  double sat_t = 5;
  double measured = 6;
  double setpoint = 7;
}

message MonitorSlot {
  sfixed64 active = 1;
  double value = 2;
  sfixed64 satisfied = 3;
  double sat_t = 4;
}

message DeviceSlot {
  uint64 seq = 1;
  bool success = 2;
}

message Trigger {
  sfixed64 kind = 1;
  sfixed64 idx = 2;
  sfixed64 fsm_state = 3;
  double t = 4;
  sfixed64 wall_ns = 5;
}

message PoseSlot {
  double px = 1;
  double py = 2;
  double pz = 3;
  double qx = 4;
  double qy = 5;
  double qz = 6;
  double qw = 7;
}

message TwistSlot {
  double lx = 1;
  double ly = 2;
  double lz = 3;
  double ax = 4;
  double ay = 5;
  double az = 6;
}

message WrenchSlot {
  double fx = 1;
  double fy = 2;
  double fz = 3;
  double tx = 4;
  double ty = 5;
  double tz = 6;
}

message RuntimeFrame {
  double t = 1;
  uint64 step = 2;
  sfixed64 fsm_state = 3;
  sfixed64 active_motion = 4;
  sfixed64 last_event = 5;
  double state_since_t = 6;
  sfixed64 state_since_wall_ns = 7;
  double event_t = 8;
  sfixed64 event_wall_ns = 9;
  sfixed64 wall_ns = 10;
  sfixed64 period_ns = 11;
  sfixed64 compute_ns = 12;
  <communication.introspection_artifacts.frame_layout.protobuf.fields.constraints:{f|ConstraintSlot <f.name> = <f.number>;}; separator="\n">
  <communication.introspection_artifacts.frame_layout.protobuf.fields.monitors:{f|MonitorSlot <f.name> = <f.number>;}; separator="\n">
  <communication.introspection_artifacts.frame_layout.protobuf.fields.quantities:{f|<f.proto_type> <f.name> = <f.number>;}; separator="\n">
  <communication.introspection_artifacts.frame_layout.protobuf.fields.devices:{f|DeviceSlot <f.name> = <f.number>;}; separator="\n">
  <communication.introspection_artifacts.frame_layout.protobuf.fields.triggers:{f|Trigger <f.name> = <f.number>;}; separator="\n">
  sfixed64 trigger_count = 17;
  <communication.introspection_artifacts.frame_layout.protobuf.fields.poses:{f|PoseSlot <f.name> = <f.number>;}; separator="\n">
  <communication.introspection_artifacts.frame_layout.protobuf.fields.twists:{f|TwistSlot <f.name> = <f.number>;}; separator="\n">
  <communication.introspection_artifacts.frame_layout.protobuf.fields.wrenches:{f|WrenchSlot <f.name> = <f.number>;}; separator="\n">
}

message FrameLogRecord {
  oneof record {
    FrameLogHeader header = 1;
    RuntimeFrame frame = 2;
  }
}
>>
