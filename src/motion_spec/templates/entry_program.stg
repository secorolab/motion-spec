// SPDX-License-Identifier: MPL-2.0
// L4 entry — the program: main.cpp and the shared_state header.

import "assembly_loop.stg"
import "ros.stg"
import "assembly_coordination.stg"
import "assembly_motion.stg"
import "expr_values.stg"
import "runtime.stg"

main_source(configuration, resources, composition, computation, coordination, communication) ::= <<
#include "runtime.hpp"
#include "shared_state.hpp"
#ifdef MOTION_SPEC_ENABLE_INTROSPECTION
#include "introspect_model.hpp"
#endif
<if(resources.by_kind.mobile_base)>
<({<mobile-base-cycle-include-impl.(configuration.backend)>})()>
<endif>
<coordination.motions:{motion | <motion-include(motion)>}; separator="\n">

<app-chain-includes(configuration.backend, resources.by_kind.serial_chain, resources)>
#include \<unistd.h\>
<if(coordination.fsm)>

<coordination.motions:{motion | <fsm-step-function(motion)>}; separator="\n\n">
<endif>

int main(int argc, char **argv) {
    motion_spec::runtime::install_stop_handlers();
    robot_io robot{};
    shared_data shared{};
    motion_spec_event_buffer events{};
<if(communication.ros)>

<ros-setup(communication.ros)>
<endif>
<if(resources.by_kind.mobile_base)>

<({<app-main-base-setup-impl.(configuration.backend)>})()>
<endif>
<if(resources.by_kind.serial_chain)>

<app-chain-setup(configuration.backend, resources.by_kind.serial_chain, composition.scene, configuration.platform.config)>
<endif>
<computation.values.externally_measured:{wrench | <wrench-measurement(wrench)>}; separator="\n">
<computation.values.externally_measured:{wrench |     robot.<wrench.id> = &<wrench.id>_measurement;}; separator="\n">
<coordination.motions:{motion | <motion-state-member(motion)>}; separator="\n">
<if(resources.by_kind.mobile_base)>
    mobile_base_state mobile_base_state_instance;
<endif>
<if(resources.by_kind.mobile_base)>

    robif2b_ethercat_configure(robot.mobile_base.ethercat);
    robif2b_ethercat_start(robot.mobile_base.ethercat);
<endif>
<if(resources.by_kind.serial_chain)>
<resources.by_kind.serial_chain:{solver |
<robot-configure(solver, configuration.backend)>
}; separator="\n">
<endif>

<if(resources.by_kind.serial_chain)>
<app-chain-post-setup(configuration.backend, resources.by_kind.serial_chain, coordination.motions, configuration.agent_homes)>
<endif>
<if(communication.ros)>
<ros-joint-states-setup(communication.ros)>
<ros-spin-start(communication.ros)>
<ros-publish-tick-locals(communication.ros)>
<ros-subscriptions-wait(communication.ros)>
<endif>

<if(coordination.fsm)>
    struct fsm_nbx *fsm = <coordination.fsm.cpp_namespace>::create_fsm();
    if (!fsm) {
<if(communication.ros)>
        <ros-stop-before-loop(communication.ros)>
<endif>
        return 1;
    \}
    robot.fsm_events = fsm->eventData;

<fsm-active-motion(coordination.motions, coordination.fsm)>
<fsm-dispatch(coordination.motions, coordination.fsm)>

<endif>
    int _step = 0;
<if(coordination.fsm)>
    int _fsm_prev_state = -1;
<endif>
#ifdef MOTION_SPEC_ENABLE_INTROSPECTION
    motion_spec::introspection::RunPublisher _introspection_pub;
#endif
    timespec _next_tick{};
    clock_gettime(CLOCK_MONOTONIC, &_next_tick);
    double _prev_clock_s = 0.0;
    while (!motion_spec::runtime::stop_requested() && (<app-loop-condition(configuration.backend, resources.by_kind.serial_chain)>)<if(communication.ros)> && rclcpp::ok()<endif>) {
        shared.clock_time_s = <clock-time-source(configuration.backend, resources.by_kind.serial_chain, resources.by_kind.serial_chain)>;
        // Integrators step with the time that actually elapsed, not the period we asked for: the
        // loop sleeps to deadlines it can overrun. In sim the clock advances exactly one timestep
        // per tick, so this equals the nominal period.
        const double _dt_raw = (_step == 0)
            ? motion_spec::runtime::kControlPeriodS
            : shared.clock_time_s - _prev_clock_s;
        _prev_clock_s = shared.clock_time_s;
        shared.dt_measured_s = std::clamp(_dt_raw, motion_spec::runtime::kDtClampMin,
                                          motion_spec::runtime::kDtClampMax);
<if(resources.by_kind.serial_chain)>
<app-chain-loop-reset(configuration.backend, resources.by_kind.serial_chain, coordination.fsm)>
<endif>
<if(coordination.fsm)>
        if (static_cast\<int\>(fsm->currentStateIndex) != _fsm_prev_state) {
            _fsm_prev_state = static_cast\<int\>(fsm->currentStateIndex);
            std::cerr \<\< "[fsm] state   " \<\< <coordination.fsm.cpp_namespace>::STATE_URIS[fsm->currentStateIndex] \<\< std::endl;
            // Leaving a state ends its motion's activation, so re-entering one is a fresh
            // start: active_steps returns to 0 and any trajectory replans from the current
            // pose instead of resuming the alpha it had when it was interrupted.
<if(communication.ros)>
<coordination.motions:{motion | <ros-action-cancel-on-exit(motion)>}>
<endif>
<coordination.motions:{motion |             <motion.id>_state_instance.active = false;}; separator="\n">
        \}
        if (fsm->currentStateIndex == fsm->endStateIndex) {
<if(communication.ros.action_server)>
<ros-goal-end-state(communication.ros.action_server)>
<endif>
            break;
        \}
<coordination.motions:{m | <fsm-motion-reentry(m, coordination.fsm)>}><if(communication.ros.action_server)>
<ros-goal-arm-tick(coordination, communication.ros.action_server)>
<endif>
<if(coordination.fsm.step_event)>
        // The heartbeat drives the FSM but is not recorded: the frame log is a time series, so
        // every frame already *is* the tick (t, step, wall_ns, period_ns). Logging a per-tick
        // event would restate that 24k times and leave last_event permanently pinned to it.
        produce_event(fsm->eventData, <coordination.fsm.cpp_namespace>::<coordination.fsm.step_event>);
<endif>
        fsm_dispatch(fsm);
<endif>
<if(communication.ros)>
<ros-publish-tick(coordination, communication)>
<endif>
<if(resources.by_kind.serial_chain)>
<app-chain-trace-update(configuration.backend, resources.by_kind.serial_chain, configuration.trace)>
<app-chain-runtime-step(configuration.backend, resources.by_kind.serial_chain)>
<endif>
<if(coordination.fsm)>
        const unsigned int _fsm_state_before = fsm->currentStateIndex;
        fsm_step_nbx(fsm);
        reconfig_event_buffers(fsm->eventData);
<coordination.fsm.step_transitions:{t |         // The clock is this transition's guard, so this one heartbeat is the cause of the
        // state change -- record it, unlike the 24k that drive nothing.
        if (_fsm_state_before == <coordination.fsm.cpp_namespace>::<t.from> && fsm->currentStateIndex == <coordination.fsm.cpp_namespace>::<t.to>) {
            events.record(<coordination.fsm.step_event_idx>);
        \}}; separator="\n">
        static_cast\<void\>(_fsm_state_before);
<endif>
#ifdef MOTION_SPEC_ENABLE_INTROSPECTION
<if(resources.by_kind.serial_chain)>
<app-chain-camera-publish(configuration.backend, composition.scene.cameras)>
<endif>
        motion_spec::introspection::sample_model(
            _introspection_pub,
<if(coordination.fsm)>            static_cast\<int\>(fsm->currentStateIndex),
            fsm_active_motion(fsm),
<endif>            motion_spec::runtime::monotonic_time_s(),
            static_cast\<std::uint64_t\>(_step),
            shared,
            events);
#endif
        ++_step;
        motion_spec::runtime::sleep_until_next(_next_tick, <configuration.control_period_ns>);
    }
#ifdef MOTION_SPEC_ENABLE_INTROSPECTION
    _introspection_pub.close();
<if(resources.by_kind.serial_chain)>
<app-chain-camera-cleanup(configuration.backend, composition.scene.cameras)>
<endif>
#endif
<if(resources.by_kind.serial_chain)>

<app-chain-cleanup(configuration.backend, resources.by_kind.serial_chain)>
<resources.by_kind.serial_chain:{solver |
<robot-shutdown(solver, configuration.backend)>
}; separator="\n">
<endif>
<if(resources.by_kind.mobile_base)>
    robif2b_kelo_drive_actuator_stop(robot.mobile_base.wheel_actuator);
    robif2b_ethercat_stop(robot.mobile_base.ethercat);
    robif2b_ethercat_shutdown(robot.mobile_base.ethercat);
<endif>
<if(coordination.fsm)>
    <coordination.fsm.cpp_namespace>::destroy_fsm(fsm);
<endif>
<if(communication.ros)>

<ros-shutdown(communication.ros)>
<endif>

    if (motion_spec::runtime::stop_requested()) {
        std::cerr \<\< "[run] interrupted; frame log closed at step " \<\< _step \<\< std::endl;
        return 130;
    \}
    return 0;
}
>>

shared_state_header(configuration, resources, computation, coordination, communication) ::= <<
#pragma once

#include "frame_layout.h"
#include "runtime.hpp"
<if(coordination.fsm)>
#include "coord2b/functions/event_loop.h"
#include "coord2b/functions/fsm.h"
#include "<coordination.fsm.header>"
<endif>

#include \<memory\>
<if(communication.ros)>
<ros-includes(communication.ros)>
<endif>
#include \<kdl/frames.hpp\>
#include \<kdl/chain.hpp\>
#include \<kdl/jacobian.hpp\>
#include \<kdl/jntarray.hpp\>
#include \<kdl/chainfksolverpos_recursive.hpp\>
#include \<kdl/chainfksolvervel_recursive.hpp\>
#include \<kdl/chainhdsolver_vereshchagin_fixed_joint.hpp\>
<if(resources.by_kind.serial_chain)><solver-rnea-include(configuration.backend)><endif>
<if(resources.by_kind.serial_chain)><robot-driver-include(first(resources.by_kind.serial_chain), configuration.backend, configuration.model_name, resources)><endif>
<if(resources.by_kind.mobile_base)>
#include \<robif2b/functions/ethercat.h\>
#include \<robif2b/functions/kelo_drive.h\>
<endif>

#include \<kdl/chainhdsolver_vereshchagin_fext_fixed_joint.hpp\>

<if(resources.by_kind.serial_chain)><robot-num-joints-def(first(resources.by_kind.serial_chain))><endif>

<if(resources.by_kind.mobile_base)>
struct ecat_state {
    const char *ethernet_if = nullptr;
    int error_code = 0;
    int num_exposed_slaves = 0;
    int num_found_slaves = 0;
    int num_active_slaves = 0;
    int slave_idx[NUM_SLAVES] = {0};
    const char *name[NUM_SLAVES] = {nullptr};
    unsigned int prod_code[NUM_SLAVES] = {0U};
    size_t input_size[NUM_SLAVES] = {0U};
    size_t output_size[NUM_SLAVES] = {0U};
    bool is_connected[NUM_SLAVES] = {false};
};

struct ecat_comm {
    robif2b_kelo_drive_api_msr_pdo drv_msr_pdo[NUM_DRIVES];
    robif2b_kelo_drive_api_cmd_pdo drv_cmd_pdo[NUM_DRIVES];
};

struct kelo_msr {
    double pvt_off[NUM_DRIVES] = {0.0};
    double pvt_pos[NUM_DRIVES] = {0.0};
    double pvt_vel[NUM_DRIVES] = {0.0};
    double whl_pos[NUM_DRIVES * 2] = {0.0};
    double whl_vel[NUM_DRIVES * 2] = {0.0};
    double imu_ang_vel[NUM_DRIVES * 3] = {0.0};
    double imu_lin_acc[NUM_DRIVES * 3] = {0.0};
    double bat_volt = 0.0;
    double bat_cur = 0.0;
    double bat_pwr = 0.0;
    int bat_lvl = 0;
};

struct kelo_cmd {
    enum robif2b_ctrl_mode ctrl_mode[NUM_DRIVES] = {ROBIF2B_CTRL_MODE_FORCE};
    double vel[NUM_DRIVES * 2] = {0.0};
    double trq[NUM_DRIVES * 2] = {0.0};
    double cur[NUM_DRIVES * 2] = {0.0};
    double max_current[NUM_DRIVES * 2] = {0.0};
    double trq_const[NUM_DRIVES * 2] = {0.0};
};

struct mobile_base_robot {
    int *num_drives = nullptr;
    ecat_state *ethercat_state = nullptr;
    ecat_comm *ethercat_comm = nullptr;
    robif2b_ethercat *ethercat = nullptr;
    kelo_msr *measurement = nullptr;
    kelo_cmd *command = nullptr;
    robif2b_kelo_drive_encoder *drive_encoder = nullptr;
    robif2b_kelo_drive_actuator *wheel_actuator = nullptr;
};
<endif>

<if(resources.by_kind.serial_chain)>
<robot-state-struct(first(resources.by_kind.serial_chain), configuration.backend)>

<robot-manipulator-struct(first(resources.by_kind.serial_chain), configuration.backend)>

<chain-solver-members(resources.by_kind.serial_chain, configuration.backend)>
<endif>

struct robot_io {
<if(resources.by_kind.mobile_base)>
    mobile_base_robot mobile_base;
<endif>
<if(coordination.fsm)>
    struct events *fsm_events = nullptr;
<endif>
<if(communication.ros)>
<ros-io-members(communication.ros)>
<endif>
<resources.by_kind.serial_chain:{solver | <chain-robot-member(solver)>}; separator="\n">
<resources.by_kind.serial_chain:{solver | <chain-device-members(solver, configuration.backend)>}; separator="">
<computation.values.externally_measured:{wrench | <wrench-pointer-member(wrench)>}; separator="\n">
};

<event-buffer-struct()>

struct shared_data {
<computation.shared_data:{var | <indented-shared-member(var)>}; separator="\n">
};
>>

// A self-transition's fired event re-enters the state's motion: entry runs again, so a model
// retries perception by authoring `fires` on the retry reaction.

fsm-motion-reentry(m, fsm) ::= <<
<if(m.has_reentry_events)>
        if (fsm->currentStateIndex == <fsm.cpp_namespace>::<m.fsm_state>
                && (<m.reentry_events:{e | consume_event(robot.fsm_events, <fsm.cpp_namespace>::<e>)}; separator=" || ">)) {
<m.action_clients:{c | <ros-action-cancel(c)>}; separator="\n">
            <m.id>_state_instance.active = false;
        \}
<endif>
>>
