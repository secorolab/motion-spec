// SPDX-License-Identifier: MPL-2.0
// L4 entry — the program: ref_main and the shared_state header.

import "assembly_loop.stg"
import "assembly_coordination.stg"
import "assembly_motion.stg"
import "expr_values.stg"
import "runtime.stg"

ref_main(platform, motions, values, has_serial_chain, resources, shared_data, backend, scene, trace, fsm, needs_clock_time, control_period_ns, ros, agent_homes) ::= <<
#include "runtime.hpp"
#include "shared_state.hpp"
#ifdef MOTION_SPEC_ENABLE_INTROSPECTION
#include "introspect_model.hpp"
#endif
<if(resources.by_kind.mobile_base)>
<({<mobile-base-cycle-include-impl.(backend)>})()>
<endif>
<motions:{motion | <motion-include(motion)>}; separator="\n">

<app-chain-includes(backend, has_serial_chain)>
#include \<unistd.h\>
<if(fsm)>

<motions:{motion | <fsm-step-function(motion)>}; separator="\n\n">
<endif>

int main(int argc, char **argv) {
    motion_spec::runtime::install_stop_handlers();
    robot_io robot{};
    shared_data shared{};
    motion_spec_event_buffer events{};
<if(ros)>

<ros-setup(ros)>
<endif>
<if(resources.by_kind.mobile_base)>

<({<app-main-base-setup-impl.(backend)>})()>
<endif>
<if(has_serial_chain)>

<app-chain-setup(backend, resources.by_kind.serial_chain, scene, platform.config)>
<endif>
<values.externally_measured:{wrench | <wrench-measurement(wrench)>}; separator="\n">
<values.externally_measured:{wrench |     robot.<wrench.id> = &<wrench.id>_measurement;}; separator="\n">
<motions:{motion | <motion-state-member(motion)>}; separator="\n">
<if(resources.by_kind.mobile_base)>
    mobile_base_state mobile_base_state_instance;
<endif>
<if(resources.by_kind.mobile_base)>

    robif2b_ethercat_configure(robot.mobile_base.ethercat);
    robif2b_ethercat_start(robot.mobile_base.ethercat);
<endif>
<if(has_serial_chain)>
<resources.by_kind.serial_chain:{solver |
<robot-configure(solver, backend)>
}; separator="\n">
<endif>

<if(has_serial_chain)>
<app-chain-post-setup(backend, resources.by_kind.serial_chain, motions, agent_homes)>
<endif>

<if(fsm)>
    struct fsm_nbx *fsm = <fsm.cpp_namespace>::create_fsm();
    if (!fsm) return 1;
    robot.fsm_events = fsm->eventData;

<fsm-active-motion(motions, fsm)>
<fsm-dispatch(motions, fsm)>

<endif>
    int _step = 0;
<if(fsm)>
    int _fsm_prev_state = -1;
<else>
    int current_motion = 0;
<endif>
#ifdef MOTION_SPEC_ENABLE_INTROSPECTION
    motion_spec::introspection::RunPublisher _introspection_pub;
#endif
    timespec _next_tick{};
    clock_gettime(CLOCK_MONOTONIC, &_next_tick);
    double _prev_clock_s = 0.0;
    while (!motion_spec::runtime::stop_requested() && (<app-loop-condition(backend, has_serial_chain)>)) {
        shared.clock_time_s = <clock-time-source(backend, resources.by_kind.serial_chain, has_serial_chain)>;
        // Integrators step with the time that actually elapsed, not the period we asked for: the
        // loop sleeps to deadlines it can overrun. In sim the clock advances exactly one timestep
        // per tick, so this equals the nominal period.
        const double _dt_raw = (_step == 0)
            ? motion_spec::runtime::kControlPeriodS
            : shared.clock_time_s - _prev_clock_s;
        _prev_clock_s = shared.clock_time_s;
        shared.dt_measured_s = std::clamp(_dt_raw, motion_spec::runtime::kDtClampMin,
                                          motion_spec::runtime::kDtClampMax);
<if(has_serial_chain)>
<app-chain-loop-reset(backend, resources.by_kind.serial_chain, fsm)>
<endif>
<if(fsm)>
        if (static_cast\<int\>(fsm->currentStateIndex) != _fsm_prev_state) {
            _fsm_prev_state = static_cast\<int\>(fsm->currentStateIndex);
            std::cerr \<\< "[fsm] state   " \<\< <fsm.cpp_namespace>::STATE_URIS[fsm->currentStateIndex] \<\< std::endl;
            // Leaving a state ends its motion's activation, so re-entering one is a fresh
            // start: active_steps returns to 0 and any trajectory replans from the current
            // pose instead of resuming the alpha it had when it was interrupted.
<motions:{motion |             <motion.id>_state_instance.active = false;}; separator="\n">
        \}
        if (fsm->currentStateIndex == fsm->endStateIndex) break;
<if(fsm.step_event)>
        // The heartbeat drives the FSM but is not recorded: the frame log is a time series, so
        // every frame already *is* the tick (t, step, wall_ns, period_ns). Logging a per-tick
        // event would restate that 24k times and leave last_event permanently pinned to it.
        produce_event(fsm->eventData, <fsm.cpp_namespace>::<fsm.step_event>);
<endif>
        fsm_dispatch(fsm);
<else>
        switch (current_motion) {
<motions:{motion |
        case <i0>: {
            update_<motion.id>(<motion.id>_state_instance, shared, robot);
            monitor_<motion.id>(<sig-args(motion.id, motion.monitor_needs_state, motion.monitor_needs_shared, motion.monitor_needs_robot, motion.monitor_needs_events)>);
            if (!<motion.id>_state_instance.active && can_start_<motion.id>(<sig-args(motion.id, motion.can_start_needs_state, motion.can_start_needs_shared, motion.can_start_needs_robot)>)) {
                <motion.id>_state_instance.active = true;
                <motion.id>_state_instance.active_steps = 0;
<if(motion.has_active_elapsed)>                <motion.id>_state_instance.motion_start_time = shared.clock_time_s;
<endif>
<motion.until_monitors:{m |                 <motion.id>_state_instance.<m.id>_previous = false;
                <motion.id>_state_instance.<m.id>_event_triggered = false;}; separator="
">
            \}
            if (<motion.id>_state_instance.active) {
                control_<motion.id>(<motion.id>_state_instance, shared, robot<if(motion.control_needs_events)>, events<endif>);
                apply_<motion.id>(<sig-args(motion.id, motion.apply_needs_state, motion.apply_needs_shared, motion.apply_needs_robot)>);
                // TODO: replace this temporary event latch bridge with real event-driven FSM transitions.
                if (<motion.id>_state_instance.active_steps > 0 && (<motion-done-condition(motion)>)) {
                    <motion.id>_state_instance.active = false;
                    current_motion = <i>;
                \}
                ++<motion.id>_state_instance.active_steps;
            \}
            break;
        \}
}; separator="\n">
        default:
            current_motion = <length(motions)> - 1;
            break;
        }
<endif>
<if(has_serial_chain)>
<app-chain-trace-update(backend, resources.by_kind.serial_chain, trace)>
<app-chain-runtime-step(backend, resources.by_kind.serial_chain)>
<endif>
<if(fsm)>
        const unsigned int _fsm_state_before = fsm->currentStateIndex;
        fsm_step_nbx(fsm);
        reconfig_event_buffers(fsm->eventData);
<fsm.step_transitions:{t |         // The clock is this transition's guard, so this one heartbeat is the cause of the
        // state change -- record it, unlike the 24k that drive nothing.
        if (_fsm_state_before == <fsm.cpp_namespace>::<t.from> && fsm->currentStateIndex == <fsm.cpp_namespace>::<t.to>) {
            events.record(<fsm.step_event_idx>);
        \}}; separator="\n">
        static_cast\<void\>(_fsm_state_before);
<endif>
#ifdef MOTION_SPEC_ENABLE_INTROSPECTION
        motion_spec::introspection::sample_model(
            _introspection_pub,
<if(fsm)>            static_cast\<int\>(fsm->currentStateIndex),
            fsm_active_motion(fsm),
<else>            current_motion,
            current_motion,
<endif>            motion_spec::runtime::monotonic_time_s(),
            static_cast\<std::uint64_t\>(_step),
            shared,
            events);
#endif
        ++_step;
        motion_spec::runtime::sleep_until_next(_next_tick, <control_period_ns>);
    }
#ifdef MOTION_SPEC_ENABLE_INTROSPECTION
    _introspection_pub.close();
#endif
<if(has_serial_chain)>

<app-chain-cleanup(backend, has_serial_chain)>
<resources.by_kind.serial_chain:{solver |
<robot-shutdown(solver, backend)>
}; separator="\n">
<endif>
<if(resources.by_kind.mobile_base)>
    robif2b_kelo_drive_actuator_stop(robot.mobile_base.wheel_actuator);
    robif2b_ethercat_stop(robot.mobile_base.ethercat);
    robif2b_ethercat_shutdown(robot.mobile_base.ethercat);
<endif>
<if(fsm)>
    <fsm.cpp_namespace>::destroy_fsm(fsm);
<endif>
<if(ros)>

<ros-shutdown(ros)>
<endif>

    if (motion_spec::runtime::stop_requested()) {
        std::cerr \<\< "[run] interrupted; frame log closed at step " \<\< _step \<\< std::endl;
        return 130;
    \}
    return 0;
}
>>

shared_state_header(shared_data, values, has_serial_chain, resources, backend, fsm, ros) ::= <<
#pragma once

#include "frame_layout.h"
#include "runtime.hpp"
<if(fsm)>
#include "coord2b/functions/event_loop.h"
#include "coord2b/functions/fsm.h"
#include "<fsm.header>"
<endif>

#include \<memory\>
<if(ros)>
<ros-includes(ros)>
<endif>
#include \<kdl/frames.hpp\>
#include \<kdl/chain.hpp\>
#include \<kdl/jacobian.hpp\>
#include \<kdl/jntarray.hpp\>
#include \<kdl/chainfksolverpos_recursive.hpp\>
#include \<kdl/chainfksolvervel_recursive.hpp\>
#include \<kdl/chainhdsolver_vereshchagin_fixed_joint.hpp\>
<if(has_serial_chain)><solver-rnea-include(backend)><endif>
<if(has_serial_chain)><robot-driver-include(first(resources.by_kind.serial_chain), backend)><endif>
<if(resources.by_kind.mobile_base)>
#include \<robif2b/functions/ethercat.h\>
#include \<robif2b/functions/kelo_drive.h\>
<endif>

#include \<kdl/chainhdsolver_vereshchagin_fext_fixed_joint.hpp\>

<if(has_serial_chain)><robot-num-joints-def(first(resources.by_kind.serial_chain))><endif>

<if(resources.by_kind.mobile_base)>
struct ecat_state {
    const char *ethernet_if = nullptr;
    int error_code = 0;
    int num_exposed_slaves = 0;
    int num_found_slaves = 0;
    int num_active_slaves = 0;
    int slave_idx[NUM_SLAVES] = {0};
    const char *name[NUM_SLAVES] = {nullptr};
    unsigned int prod_code[NUM_SLAVES] = {0U};
    size_t input_size[NUM_SLAVES] = {0U};
    size_t output_size[NUM_SLAVES] = {0U};
    bool is_connected[NUM_SLAVES] = {false};
};

struct ecat_comm {
    robif2b_kelo_drive_api_msr_pdo drv_msr_pdo[NUM_DRIVES];
    robif2b_kelo_drive_api_cmd_pdo drv_cmd_pdo[NUM_DRIVES];
};

struct kelo_msr {
    double pvt_off[NUM_DRIVES] = {0.0};
    double pvt_pos[NUM_DRIVES] = {0.0};
    double pvt_vel[NUM_DRIVES] = {0.0};
    double whl_pos[NUM_DRIVES * 2] = {0.0};
    double whl_vel[NUM_DRIVES * 2] = {0.0};
    double imu_ang_vel[NUM_DRIVES * 3] = {0.0};
    double imu_lin_acc[NUM_DRIVES * 3] = {0.0};
    double bat_volt = 0.0;
    double bat_cur = 0.0;
    double bat_pwr = 0.0;
    int bat_lvl = 0;
};

struct kelo_cmd {
    enum robif2b_ctrl_mode ctrl_mode[NUM_DRIVES] = {ROBIF2B_CTRL_MODE_FORCE};
    double vel[NUM_DRIVES * 2] = {0.0};
    double trq[NUM_DRIVES * 2] = {0.0};
    double cur[NUM_DRIVES * 2] = {0.0};
    double max_current[NUM_DRIVES * 2] = {0.0};
    double trq_const[NUM_DRIVES * 2] = {0.0};
};

struct mobile_base_robot {
    int *num_drives = nullptr;
    ecat_state *ethercat_state = nullptr;
    ecat_comm *ethercat_comm = nullptr;
    robif2b_ethercat *ethercat = nullptr;
    kelo_msr *measurement = nullptr;
    kelo_cmd *command = nullptr;
    robif2b_kelo_drive_encoder *drive_encoder = nullptr;
    robif2b_kelo_drive_actuator *wheel_actuator = nullptr;
};
<endif>

<if(has_serial_chain)>
<robot-state-struct(first(resources.by_kind.serial_chain), backend)>

<robot-manipulator-struct(first(resources.by_kind.serial_chain), backend)>

<chain-solver-members(resources.by_kind.serial_chain, backend)>
<endif>

struct robot_io {
<if(resources.by_kind.mobile_base)>
    mobile_base_robot mobile_base;
<endif>
<if(fsm)>
    struct events *fsm_events = nullptr;
<endif>
<if(ros)>
<ros-io-members(ros)>
<endif>
<resources.by_kind.serial_chain:{solver | <chain-robot-member(solver)>}; separator="\n">
<resources.by_kind.serial_chain:{solver | <chain-device-members(solver, backend)>}; separator="">
<values.externally_measured:{wrench | <wrench-pointer-member(wrench)>}; separator="\n">
};

<event-buffer-struct()>

struct shared_data {
<shared_data:{var | <indented-shared-member(var)>}; separator="\n">
};
>>
