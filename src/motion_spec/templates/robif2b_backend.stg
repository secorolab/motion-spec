        gripper_<solver.runtime_id>_state.pos_cmd = static_cast\<float\>(
            100.0 * motion_spec::runtime::gripper_closed_fraction(
                gripper_<solver.runtime_id>_cmd, <gripper-travel-Robotiq2F85()>));
        robif2b_kg3_robotiq_gripper_update(&gripper_<solver.runtime_id>);
>>

device-update-robif2b-Robotiq2F85(solver, device) ::= <<
        gripper_<solver.runtime_id>_state.position_cmd = static_cast\<uint8_t\>(std::lround(
            255.0 * motion_spec::runtime::gripper_closed_fraction(
                gripper_<solver.runtime_id>_cmd, <gripper-travel-Robotiq2F85()>)));
        robif2b_robotiq_gripper_update(&gripper_<solver.runtime_id>);
>>

device-update-robif2b-RobotiqFT300s(solver, device) ::= <<
        robif2b_robotiq_ft_update(&ft_<device.drives>);
>>

