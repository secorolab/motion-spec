// SPDX-License-Identifier: MPL-2.0
// robif2b backend: EtherCAT/KELO driver bindings and the robif2b KinovaGen3 robot impl.

robot-driver-include-robif2b-KinovaGen3(solver) ::= <<
#include "headers/<solver.kdl_header>"
#include \<robif2b/functions/kinova_gen3.h\>
#include \<robif2b/functions/robotiq_gripper.h\>
#include \<robif2b/functions/robotiq_ft_sensor.h\>
>>

robot-state-struct-robif2b-KinovaGen3(solver) ::= <<
// The gripper closes under its own speed and force loop; the model commands position only.
// Mid-range on both: fast enough to keep up with a motion, soft enough not to crush.
static constexpr float kGripperSpeedPct = 50.0f;
static constexpr float kGripperForcePct = 50.0f;
static constexpr uint8_t kGripperSpeedByte = 128;
static constexpr uint8_t kGripperForceByte = 128;

struct kinova_state {
    bool success = false;
    enum robif2b_ctrl_mode ctrl_mode = ROBIF2B_CTRL_MODE_FORCE;
    double pos_msr[KINOVA_NUM_JOINTS] = {0.0};
    double vel_msr[KINOVA_NUM_JOINTS] = {0.0};
    double eff_msr[KINOVA_NUM_JOINTS] = {0.0};
    double cur_msr[KINOVA_NUM_JOINTS] = {0.0};
    double pos_cmd[KINOVA_NUM_JOINTS] = {0.0};
    double vel_cmd[KINOVA_NUM_JOINTS] = {0.0};
    double eff_cmd[KINOVA_NUM_JOINTS] = {0.0};
    double cur_cmd[KINOVA_NUM_JOINTS] = {0.0};
};

// Gripper over the arm's interconnect: every port is a percentage of travel.
struct kg3_gripper_state {
    bool success = false;
    float pos_msr = 0.0f;
    float vel_msr = 0.0f;
    float cur_msr = 0.0f;
    float pos_cmd = 0.0f;
    float vel_cmd = kGripperSpeedPct;
    float frc_cmd = kGripperForcePct;
};

// Gripper on its own serial line: the same ports, counted 0-255.
struct serial_gripper_state {
    bool success = false;
    uint8_t position_msr = 0;
    bool is_moving = false;
    robif2b_robotiq_gripper_obj_status obj_status = ROBIF2B_ROBOTIQ_OBJ_UNKNOWN;
    robif2b_robotiq_gripper_status status = ROBIF2B_ROBOTIQ_UNKNOWN;
    uint8_t position_cmd = 0;
    uint8_t speed_cmd = kGripperSpeedByte;
    uint8_t force_cmd = kGripperForceByte;
    robif2b_robotiq_gripper_error error = ROBIF2B_ROBOTIQ_NO_ERROR;
};

struct ft_sensor_state {
    bool success = false;
    float force[3] = {0.0f};
    float force_offset[3] = {0.0f};
    float moment[3] = {0.0f};
    float moment_offset[3] = {0.0f};
};
>>

robot-manipulator-struct-robif2b-KinovaGen3(solver) ::= <<
struct manipulator_robot {
    kinova_state *state = nullptr;
    robif2b_kinova_gen3_nbx *robot = nullptr;
    KDL::Chain *chain = nullptr;
    // The commanded gripper joint position [rad], as the model authored it. Which device that
    // reaches, and in whose units, is settled at generation by the bound device's rule set.
    double *gripper_cmd = nullptr;
};
>>

robot-state-init-robif2b-KinovaGen3(solver) ::= <<
<if(solver.runtime_owner)>    kinova_state kinova_<solver.runtime_id>_state{};
    kinova_<solver.runtime_id>_state.ctrl_mode = ROBIF2B_CTRL_MODE_FORCE;
<solver.devices:{device | <({device-state-init-robif2b-<device.kind>})(solver, device)>}; separator="\n">
<endif>
>>

chain-device-members-robif2b(solver) ::= <<
<solver.devices:{device | <({device-io-member-robif2b-<device.kind>})(solver, device)>}; separator="">
>>

device-io-member-robif2b-KinovaGen3(solver, device) ::= <<>>

device-io-member-robif2b-KinovaGen3-2F85(solver, device) ::= <<>>

device-io-member-robif2b-Robotiq2F85(solver, device) ::= <<>>

// The motion functions read the sensor through here; main owns the driver's state.
device-io-member-robif2b-RobotiqFT300s(solver, device) ::= <<
    const ft_sensor_state *ft_<device.drives> = nullptr;
    int ft_<device.drives>_bias_samples = 0;
>>

device-io-assign-robif2b-KinovaGen3(solver, device) ::= <<>>

device-io-assign-robif2b-KinovaGen3-2F85(solver, device) ::= <<>>

device-io-assign-robif2b-Robotiq2F85(solver, device) ::= <<>>

device-io-assign-robif2b-RobotiqFT300s(solver, device) ::= <<
    robot.ft_<device.drives> = &ft_<device.drives>_state;
    robot.ft_<device.drives>_bias_samples = motion_spec::config::bias_samples(robot_config, "<device.config_key>");
>>

device-state-init-robif2b-KinovaGen3(solver, device) ::= <<>>

device-state-init-robif2b-KinovaGen3-2F85(solver, device) ::= <<
    kg3_gripper_state gripper_<solver.runtime_id>_state{};
    double gripper_<solver.runtime_id>_cmd = 0.0;
>>

device-state-init-robif2b-Robotiq2F85(solver, device) ::= <<
    serial_gripper_state gripper_<solver.runtime_id>_state{};
    double gripper_<solver.runtime_id>_cmd = 0.0;
>>

device-state-init-robif2b-RobotiqFT300s(solver, device) ::= <<
    ft_sensor_state ft_<device.drives>_state{};
>>

// Each bound device opens its own connection, except a gripper on the arm's interconnect --
// there the arm was the device named, so the arm's rule set wires both.
device-init-robif2b(solver, device) ::= <<
<({device-init-robif2b-<device.kind>})(solver, device)>
>>

device-configure-robif2b(solver, device) ::= <<
<({device-configure-robif2b-<device.kind>})(solver, device)>
>>

device-update-robif2b(solver, device) ::= <<
<({device-update-robif2b-<device.kind>})(solver, device)>
>>

device-shutdown-robif2b(solver, device) ::= <<
<({device-shutdown-robif2b-<device.kind>})(solver, device)>
>>

// The 2F-85's driver joint travels 0.8 rad from fully open to fully closed. A device fact:
// every 2F-85 is the same gripper, whichever route reaches it.
gripper-travel-Robotiq2F85() ::= "0.8"

device-init-robif2b-KinovaGen3(solver, device) ::= <<
<if(solver.runtime_owner)>    const auto cfg_<solver.runtime_id> = motion_spec::config::device(robot_config, "<device.config_key>");
    robif2b_kinova_gen3_nbx kinova_<solver.runtime_id>{};
    kinova_<solver.runtime_id>.conf.ip_address = cfg_<solver.runtime_id>.ip.c_str();
    kinova_<solver.runtime_id>.conf.port = cfg_<solver.runtime_id>.port;
    kinova_<solver.runtime_id>.conf.port_real_time = cfg_<solver.runtime_id>.port_real_time;
    kinova_<solver.runtime_id>.conf.user = cfg_<solver.runtime_id>.user.c_str();
    kinova_<solver.runtime_id>.conf.password = cfg_<solver.runtime_id>.password.c_str();
    kinova_<solver.runtime_id>.conf.session_timeout = cfg_<solver.runtime_id>.session_timeout_ms;
    kinova_<solver.runtime_id>.conf.connection_timeout = cfg_<solver.runtime_id>.connection_timeout_ms;
    kinova_<solver.runtime_id>.ctrl_mode = &kinova_<solver.runtime_id>_state.ctrl_mode;
    kinova_<solver.runtime_id>.jnt_pos_msr = &kinova_<solver.runtime_id>_state.pos_msr[0];
    kinova_<solver.runtime_id>.jnt_vel_msr = &kinova_<solver.runtime_id>_state.vel_msr[0];
    kinova_<solver.runtime_id>.jnt_trq_msr = &kinova_<solver.runtime_id>_state.eff_msr[0];
    kinova_<solver.runtime_id>.act_cur_msr = &kinova_<solver.runtime_id>_state.cur_msr[0];
    kinova_<solver.runtime_id>.jnt_pos_cmd = &kinova_<solver.runtime_id>_state.pos_cmd[0];
    kinova_<solver.runtime_id>.jnt_vel_cmd = &kinova_<solver.runtime_id>_state.vel_cmd[0];
    kinova_<solver.runtime_id>.jnt_trq_cmd = &kinova_<solver.runtime_id>_state.eff_cmd[0];
    kinova_<solver.runtime_id>.act_cur_cmd = &kinova_<solver.runtime_id>_state.cur_cmd[0];
    kinova_<solver.runtime_id>.success = &kinova_<solver.runtime_id>_state.success;
<endif>
>>

// One device, one connection: the gripper rides the arm's interconnect and needs no section
// of its own, so this is the arm's rule set plus the gripper hanging off its comm.
device-init-robif2b-KinovaGen3-2F85(solver, device) ::= <<
<device-init-robif2b-KinovaGen3(solver, device)>
<if(solver.runtime_owner)>    robif2b_kg3_robotiq_gripper_nbx gripper_<solver.runtime_id>{};
    gripper_<solver.runtime_id>.gripper_pos_msr = &gripper_<solver.runtime_id>_state.pos_msr;
    gripper_<solver.runtime_id>.gripper_vel_msr = &gripper_<solver.runtime_id>_state.vel_msr;
    gripper_<solver.runtime_id>.gripper_cur_msr = &gripper_<solver.runtime_id>_state.cur_msr;
    gripper_<solver.runtime_id>.gripper_pos_cmd = &gripper_<solver.runtime_id>_state.pos_cmd;
    gripper_<solver.runtime_id>.gripper_vel_cmd = &gripper_<solver.runtime_id>_state.vel_cmd;
    gripper_<solver.runtime_id>.gripper_frc_cmd = &gripper_<solver.runtime_id>_state.frc_cmd;
    gripper_<solver.runtime_id>.success = &gripper_<solver.runtime_id>_state.success;
<endif>
>>

device-init-robif2b-Robotiq2F85(solver, device) ::= <<
<if(solver.runtime_owner)>    const auto cfg_gripper_<solver.runtime_id> = motion_spec::config::serial(robot_config, "<device.config_key>");
    robif2b_robotiq_gripper_nbx gripper_<solver.runtime_id>{};
    gripper_<solver.runtime_id>.serial.port = cfg_gripper_<solver.runtime_id>.port.c_str();
    gripper_<solver.runtime_id>.serial.baudrate = cfg_gripper_<solver.runtime_id>.baudrate;
    gripper_<solver.runtime_id>.serial.timeout_ms = cfg_gripper_<solver.runtime_id>.timeout_ms;
    gripper_<solver.runtime_id>.serial.slave_address = cfg_gripper_<solver.runtime_id>.slave_address;
    gripper_<solver.runtime_id>.position_msr = &gripper_<solver.runtime_id>_state.position_msr;
    gripper_<solver.runtime_id>.is_gripper_moving = &gripper_<solver.runtime_id>_state.is_moving;
    gripper_<solver.runtime_id>.obj_detection_status = &gripper_<solver.runtime_id>_state.obj_status;
    gripper_<solver.runtime_id>.gripper_status = &gripper_<solver.runtime_id>_state.status;
    gripper_<solver.runtime_id>.position_cmd = &gripper_<solver.runtime_id>_state.position_cmd;
    gripper_<solver.runtime_id>.speed_cmd = &gripper_<solver.runtime_id>_state.speed_cmd;
    gripper_<solver.runtime_id>.force_cmd = &gripper_<solver.runtime_id>_state.force_cmd;
    gripper_<solver.runtime_id>.error = &gripper_<solver.runtime_id>_state.error;
    gripper_<solver.runtime_id>.success = &gripper_<solver.runtime_id>_state.success;
<endif>
>>

device-init-robif2b-RobotiqFT300s(solver, device) ::= <<
<if(solver.runtime_owner)>    const auto cfg_ft_<device.drives> = motion_spec::config::serial(robot_config, "<device.config_key>");
    robif2b_robotiq_ft_sensor_nbx ft_<device.drives>{};
    ft_<device.drives>.serial.port = cfg_ft_<device.drives>.port.c_str();
    ft_<device.drives>.serial.baudrate = cfg_ft_<device.drives>.baudrate;
    ft_<device.drives>.serial.timeout_ms = cfg_ft_<device.drives>.timeout_ms;
    ft_<device.drives>.serial.slave_address = cfg_ft_<device.drives>.slave_address;
    ft_<device.drives>.force_msr = &ft_<device.drives>_state.force[0];
    ft_<device.drives>.force_offset = &ft_<device.drives>_state.force_offset[0];
    ft_<device.drives>.moment_msr = &ft_<device.drives>_state.moment[0];
    ft_<device.drives>.moment_offset = &ft_<device.drives>_state.moment_offset[0];
    ft_<device.drives>.success = &ft_<device.drives>_state.success;
<endif>
>>

