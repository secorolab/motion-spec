robot-chain-robif2b-KinovaGen3(solver) ::= <<
<if(solver.runtime_owner)>    KDL::Tree built_tree_<solver.runtime_id>{};
    if (!scene_kdl::make_tree_<solver.kdl_tree>(&built_tree_<solver.runtime_id>)) {
        std::cerr \<\< "make_tree_<solver.kdl_tree>() failed for runtime <solver.runtime_id>\n";
        return 1;
    \}
    KDL::Chain chain_<solver.runtime_id>{};
    if (!scene_kdl::make_chain_<solver.kdl_chain>(built_tree_<solver.runtime_id>, &chain_<solver.runtime_id>)) {
        std::cerr \<\< "make_chain_<solver.kdl_chain>() failed for runtime <solver.runtime_id>\n";
        return 1;
    \}
<endif>
>>

robot-assign-robif2b-KinovaGen3(solver) ::= <<
    robot.<solver.id> = manipulator_robot{
        .state = &kinova_<solver.runtime_id>_state,
        .robot = &kinova_<solver.runtime_id>,
        .chain = &chain_<solver.runtime_id>,
<solver.devices:{device | <({device-assign-robif2b-<device.kind>})(solver, device)>}; separator="">
    };
>>

robot-configure-robif2b-KinovaGen3(solver) ::= <<
<if(solver.runtime_owner)><solver.devices:{device | <device-configure-robif2b(solver, device)>}; separator="\n">
<endif>
>>

robot-shutdown-robif2b-KinovaGen3(solver) ::= <<
<if(solver.runtime_owner)><solver.devices:{device | <device-shutdown-robif2b(solver, device)>}; separator="\n">
<endif>
>>

app-chain-includes-robif2b(has_serial_chain) ::= <<
<if(has_serial_chain)>
#include \<iostream\>
#include "robot_config.hpp"
<endif>
>>

robot_config_header(platform) ::= <<
// GENERATED by motion-spec codegen. Do not edit.
#pragma once

#include \<stdexcept\>
#include \<string\>

#include \<toml++/toml.hpp\>

namespace motion_spec::config {

struct Device {
    std::string ip;
    std::string user;
    std::string password;
    int port = 0;
    int port_real_time = 0;
    int session_timeout_ms = 0;
    int connection_timeout_ms = 0;
};

// The declared path only. Nothing may redirect it at launch: the CLI validates the file the
// model declares, and a redirected run would connect against a file nothing checked.
inline toml::table load(const std::string &path) {
    if (path.empty()) {
        throw std::runtime_error("no robot config declared; a real-world run needs one");
    }
    try {
        return toml::parse_file(path);
    \} catch (const toml::parse_error &error) {
        throw std::runtime_error(path + ": " + std::string(error.description()));
    \}
\}

inline const toml::table &section(const toml::table &config, const std::string &key) {
    const toml::node *node = config.at_path(key).node();
    if (!node || !node->is_table()) {
        throw std::runtime_error("robot config has no [" + key + "] section");
    \}
    return *node->as_table();
\}

template \<typename T\>
T required(const toml::table &table, const std::string &key, const std::string &where) {
    const auto value = table[key].value\<T\>();
    if (!value) throw std::runtime_error("robot config [" + where + "] is missing '" + key + "'");
    return *value;
\}

struct Serial {
    std::string port;
    int baudrate = 0;
    double timeout_ms = 0.0;
    int slave_address = 0;
};

inline Serial serial(const toml::table &config, const std::string &key) {
    const toml::table &entry = section(config, key);
    Serial out;
    out.port = required\<std::string\>(entry, "port", key);
    out.baudrate = required\<int\>(entry, "baudrate", key);
    out.timeout_ms = entry["timeout_ms"].value_or(1.0);
    out.slave_address = required\<int\>(entry, "slave_address", key);
    return out;
\}

// How many startup ticks are averaged away as the sensor's zero. Optional: a sensor that is
// already tared externally sets 0 and the reading passes through untouched.
inline int bias_samples(const toml::table &config, const std::string &key) {
    const int value = section(config, key)["bias_samples"].value_or(200);
    if (value \< 0) {
        throw std::runtime_error("robot config [" + key + "] has a negative 'bias_samples'");
    \}
    return value;
\}

inline Device device(const toml::table &config, const std::string &key) {
    const toml::table &entry = section(config, key);
    Device out;
    out.ip = required\<std::string\>(entry, "ip", key);
    out.user = required\<std::string\>(entry, "user", key);
    out.password = required\<std::string\>(entry, "password", key);
    out.port = required\<int\>(entry, "port", key);
    out.port_real_time = required\<int\>(entry, "port_real_time", key);
    out.session_timeout_ms = required\<int\>(entry, "session_timeout_ms", key);
    out.connection_timeout_ms = required\<int\>(entry, "connection_timeout_ms", key);
    return out;
\}

\} // namespace motion_spec::config
>>

app-chain-setup-robif2b(serial_chain_solvers, scene, config_path) ::= <<
    const auto robot_config = motion_spec::config::load("<config_path>");
<serial_chain_solvers:{solver |

<robot-state-init(solver, "robif2b")>

<if(solver.runtime_owner)><solver.devices:{device | <device-init-robif2b(solver, device)>}; separator="\n"><endif>

<robot-chain(solver, "robif2b")>

<robot-assign(solver, "robif2b")>
<if(solver.runtime_owner)><solver.devices:{device | <({device-io-assign-robif2b-<device.kind>})(solver, device)>}; separator=""><endif>
}; separator="\n">
>>

app-loop-condition-robif2b(has_serial_chain) ::= <<
true
>>

app-chain-runtime-step-robif2b(serial_chain_solvers) ::= <<
<serial_chain_solvers:{solver | <if(solver.runtime_owner)><solver.devices:{device | <device-update-robif2b(solver, device)>
}; separator=""><endif>}; separator="">
>>

app-chain-trace-update-robif2b(serial_chain_solvers, trace) ::= <<
>>

app-chain-cleanup-robif2b(has_serial_chain) ::= <<
>>


cmake_robif2b(motions, fsm_namespace, has_ros, ros_packages, serial_chain_solvers) ::= <<
cmake_minimum_required(VERSION 3.16)
project(motion_spec_robif2b_target LANGUAGES C CXX)

set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)

find_package(Eigen3 REQUIRED)
find_package(orocos_kdl REQUIRED CONFIG)
find_package(robif2b REQUIRED CONFIG)
find_package(tomlplusplus REQUIRED CONFIG)
<if(fsm_namespace)>
find_package(coord2b REQUIRED)
<endif>
find_package(Threads REQUIRED)
<if(has_ros)>
find_package(rclcpp REQUIRED)
find_package(realtime_tools REQUIRED)
<ros_packages:{pkg | find_package(<pkg> REQUIRED)}; separator="\n">
<endif>

option(MOTION_SPEC_ENABLE_INTROSPECTION "Enable generated runtime introspection logging" OFF)

add_executable(main
    ref_main.cpp
)
target_include_directories(main PRIVATE
    ${EIGEN3_INCLUDE_DIRS}
    ${CMAKE_CURRENT_SOURCE_DIR}
    ${CMAKE_CURRENT_SOURCE_DIR}/headers
<if(fsm_namespace)>
    ${coord2b_INCLUDE_DIRS}
<endif>
)
target_link_libraries(main PRIVATE
    orocos-kdl
    tomlplusplus::tomlplusplus
<serial_chain_solvers:{solver | <if(solver.runtime_owner)><solver.devices:{device | <({cmake-device-link-<device.kind>})()>}; separator="\n"><endif>}; separator="\n">
<if(fsm_namespace)>
    ${coord2b_LIBRARIES}
<endif>
<if(has_ros)>
    rclcpp::rclcpp
    realtime_tools::realtime_tools
<ros_packages:{pkg |     ${<pkg>_TARGETS\}}; separator="\n">
<endif>
)
if(MOTION_SPEC_ENABLE_INTROSPECTION)
    find_package(Protobuf REQUIRED)
    target_sources(main PRIVATE frame_log.pb.cc)
    target_include_directories(main PRIVATE ${Protobuf_INCLUDE_DIRS})
    target_compile_definitions(main PRIVATE MOTION_SPEC_ENABLE_INTROSPECTION)
    target_link_libraries(main PRIVATE Threads::Threads protobuf::libprotobuf)
endif()
target_compile_options(main PRIVATE -Wall -Wextra -ftemplate-depth=2048)
>>

// Only the drivers a binding actually needs: a deployment without a gripper must not have to
// build robif2b's Robotiq support.
cmake-device-link-KinovaGen3() ::= <<
    robif2b::kinova_gen3
>>

cmake-device-link-KinovaGen3-2F85() ::= <<
    robif2b::kinova_gen3
>>

cmake-device-link-Robotiq2F85() ::= <<
    robif2b::robotiq_gripper
>>

cmake-device-link-RobotiqFT300s() ::= <<
    robif2b::robotiq_ft_sensor
>>

robif2b-include-ethercat() ::= <<
#include \<robif2b/functions/ethercat.h\>
>>

robif2b-define-struct-ethercat() ::= <<
struct ecat_state {
    const char   *ethernet_if;
    int          error_code;
    int          num_exposed_slaves;
    int          num_found_slaves;
    int          num_active_slaves;
    int          slave_idx[NUM_SLAVES];
    const char   *name[NUM_SLAVES];
    unsigned int prod_code[NUM_SLAVES];
    size_t       input_size[NUM_SLAVES];
    size_t       output_size[NUM_SLAVES];
    bool         is_connected[NUM_SLAVES];
};
>>

robif2b-define-ethercat-state() ::= <<
ecat_state ecat_state;
ecat_state.ethernet_if        = "net0";
ecat_state.num_exposed_slaves = NUM_SLAVES;
ecat_state.slave_idx[0]       = 3;
ecat_state.slave_idx[1]       = 4;
ecat_state.slave_idx[3]       = 6;
ecat_state.slave_idx[4]       = 7;

for (int i = 0; i \< NUM_DRIVES; i++) {
    ecat_state.name[i]        = "KELOD105";
    ecat_state.prod_code[i]   = 0x02001001;
    ecat_state.input_size[i]  = sizeof(ecat_comm.drv_msr_pdo[i]);
    ecat_state.output_size[i] = sizeof(ecat_comm.drv_cmd_pdo[i]);
}
>>

robif2b-define-ethercat() ::= <<
void *input_array[NUM_SLAVES] = {
    &ecat_comm.drv_msr_pdo[0],
    &ecat_comm.drv_msr_pdo[1],
    &ecat_comm.drv_msr_pdo[2],
    &ecat_comm.drv_msr_pdo[3]
};
const void *output_array[NUM_SLAVES] = {
    &ecat_comm.drv_cmd_pdo[0],
    &ecat_comm.drv_cmd_pdo[1],
    &ecat_comm.drv_cmd_pdo[2],
    &ecat_comm.drv_cmd_pdo[3]
};

robif2b_ethercat ecat;
ecat.ethernet_if        = &ecat_state.ethernet_if[0];
ecat.num_exposed_slaves = &ecat_state.num_exposed_slaves;
ecat.slave_idx          = &ecat_state.slave_idx[0];
ecat.name               = &ecat_state.name[0];
ecat.product_code       = &ecat_state.prod_code[0];
ecat.input_size         = &ecat_state.input_size[0];
ecat.output_size        = &ecat_state.output_size[0];
ecat.error_code         = &ecat_state.error_code;
ecat.num_initial_slaves = &ecat_state.num_found_slaves;
ecat.num_current_slaves = &ecat_state.num_active_slaves;
ecat.is_connected       = &ecat_state.is_connected[0];
ecat.input              = input_array;
ecat.output             = output_array;
>>

robif2b-configure-ethercat() ::= <<
robif2b_ethercat_configure(&ecat);
>>

robif2b-start-ethercat() ::= <<
robif2b_ethercat_start(&ecat);
>>

robif2b-update-ethercat() ::= <<
robif2b_ethercat_update(&ecat);
>>

robif2b-stop-ethercat() ::= <<
robif2b_ethercat_stop(&ecat);
>>

robif2b-shutdown-ethercat() ::= <<
robif2b_ethercat_shutdown(&ecat);
>>



robif2b-include-kelo() ::= <<
#include \<robif2b/functions/kelo_drive.h\>
>>

robif2b-define-struct-kelo() ::= <<
struct ecat_comm {
    robif2b_kelo_drive_api_msr_pdo drv_msr_pdo[NUM_DRIVES];
    robif2b_kelo_drive_api_cmd_pdo drv_cmd_pdo[NUM_DRIVES];
};

struct kelo_msr {
    double pvt_off[NUM_DRIVES];
    double pvt_pos[NUM_DRIVES];
    double pvt_vel[NUM_DRIVES];
    double whl_pos[NUM_DRIVES * 2];
    double whl_vel[NUM_DRIVES * 2];
    double imu_ang_vel[NUM_DRIVES * 3];
    double imu_lin_acc[NUM_DRIVES * 3];
    double bat_volt;
    double bat_cur;
    double bat_pwr;
    int    bat_lvl;
};

struct kelo_cmd {
    enum robif2b_ctrl_mode ctrl_mode[NUM_DRIVES];
    double vel[NUM_DRIVES * 2];
    double trq[NUM_DRIVES * 2];
    double cur[NUM_DRIVES * 2];
    double max_current[NUM_DRIVES * 2];
    double trq_const[NUM_DRIVES * 2];
};
>>

robif2b-define-kelo() ::= <<
kelo_msr kelo_msr;
kelo_msr.pvt_off[0] = 0.0;
kelo_msr.pvt_off[1] = 0.0;
kelo_msr.pvt_off[2] = 0.0;
kelo_msr.pvt_off[3] = 0.0;

robif2b_kelo_drive_encoder drive_enc;
drive_enc.num_drives    = &num_drives;
drive_enc.msr_pdo       = &ecat_comm.drv_msr_pdo[0];
drive_enc.wheel_pos_msr = &kelo_msr.whl_pos[0];
drive_enc.wheel_vel_msr = &kelo_msr.whl_vel[0];
drive_enc.pivot_pos_msr = &kelo_msr.pvt_pos[0];
drive_enc.pivot_vel_msr = &kelo_msr.pvt_vel[0];
drive_enc.pivot_pos_off = &kelo_msr.pvt_off[0];

kelo_cmd kelo_cmd;
for (int i = 0; i \< NUM_DRIVES; i++) {
    kelo_cmd.ctrl_mode[i]           = ROBIF2B_CTRL_MODE_FORCE,
    kelo_cmd.max_current[i * 2 + 0] = 10;     // [A]
    kelo_cmd.max_current[i * 2 + 1] = 10;     // [A]
    kelo_cmd.trq_const[i * 2 + 0]   = 0.29;   // [Nm/A]
    kelo_cmd.trq_const[i * 2 + 1]   = 0.29;   // [Nm/A]
}

robif2b_kelo_drive_actuator wheel_act = {
    .num_drives  = &num_drives,
    .cmd_pdo     = &ecat_comm.drv_cmd_pdo[0],
    .ctrl_mode   = &kelo_cmd.ctrl_mode[0],
    .act_vel_cmd = &kelo_cmd.vel[0],
    .act_trq_cmd = &kelo_cmd.trq[0],
    .act_cur_cmd = &kelo_cmd.cur[0],
    .max_current = &kelo_cmd.max_current[0],
    .trq_const   = &kelo_cmd.trq_const[0]
};
>>

robif2b-update-kelo-encoder() ::= <<
robif2b_kelo_drive_encoder_update(&drive_enc);
>>

robif2b-update-kelo-driver() ::= <<
robif2b_kelo_drive_actuator_update(&wheel_act);
>>

robif2b-stop-kelo-drive() ::= <<
robif2b_kelo_drive_actuator_stop(&wheel_act);
>>



robif2b-include-kinova() ::= <<
#include \<robif2b/functions/kinova_gen3.h\>
>>

robif2b-define-struct-kinova() ::= <<
struct kinova_state {
    bool success;
    enum robif2b_ctrl_mode ctrl_mode;
    double pos_msr[NUM_JOINTS];
    double vel_msr[NUM_JOINTS];
    double eff_msr[NUM_JOINTS];
    double cur_msr[NUM_JOINTS];
    double pos_cmd[NUM_JOINTS];
    double vel_cmd[NUM_JOINTS];
    double eff_cmd[NUM_JOINTS];
    double cur_cmd[NUM_JOINTS];
};
>>

robif2b-define-kinova-state(side) ::= <<
kinova_state kinova_<side>_state;
kinova_<side>_state.ctrl_mode = ROBIF2B_CTRL_MODE_FORCE;
kinova_<side>_state.success = false;
for (int i = 0; i \< NUM_JOINTS; i++) {
    kinova_<side>_state.pos_msr[i] = 0.0;
    kinova_<side>_state.vel_msr[i] = 0.0;
    kinova_<side>_state.eff_msr[i] = 0.0;
    kinova_<side>_state.cur_msr[i] = 0.0;
    kinova_<side>_state.pos_cmd[i] = 0.0;
    kinova_<side>_state.vel_cmd[i] = 0.0;
    kinova_<side>_state.eff_cmd[i] = 0.0;
    kinova_<side>_state.cur_cmd[i] = 0.0;
}
>>


robif2b-configure-kinova(side) ::= <<
robif2b_kinova_gen3_configure(&kinova_<side>);
>>

robif2b-recover-kinova(side) ::= <<
robif2b_kinova_gen3_recover(&kinova_<side>);
>>

robif2b-start-kinova(side) ::= <<
robif2b_kinova_gen3_start(&kinova_<side>);
>>

robif2b-update-kinova(side) ::= <<
robif2b_kinova_gen3_update(&kinova_<side>);
>>

robif2b-stop-kinova(side) ::= <<
robif2b_kinova_gen3_stop(&kinova_<side>);
>>

robif2b-shutdown-kinova(side) ::= <<
robif2b_kinova_gen3_shutdown(&kinova_<side>);
>>
