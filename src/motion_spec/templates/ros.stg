// SPDX-License-Identifier: MPL-2.0
// L3 assembly — ROS: the node, its executor thread, the publishers, and the per-cycle tick.
// Every line of ROS text the program carries is written here.

import "domain_monitors.stg"
import "expr_values.stg"

// The DDS write happens on each RealtimePublisher's own thread; the control loop only hands
// over a filled message. Parameter services are answered by one executor thread, so a
// `ros2 param set` returns while the loop keeps its deadline.

ros-includes(ros) ::= <<
#include \<rclcpp/rclcpp.hpp\>
#include \<realtime_tools/realtime_publisher.hpp\>
#include \<array\>
#include \<cstdint\>
#include \<mutex\>
#include \<thread\>
<ros.publishers:{p | #include "<p.include>"}; separator="\n">
<if(ros.action_clients)>
#include \<rclcpp_action/rclcpp_action.hpp\>
#include \<action_msgs/msg/goal_status.hpp\>
<ros.action_clients:{c | #include "<c.include>"}; separator="\n">
<endif>
<if(ros.subscriptions)>
#include \<chrono\>
#include \<string\>
#include \<vector\>
<ros.subscriptions:{s | #include "<s.include>"}; separator="\n">
<endif>
<if(ros.joint_states)>
#include \<sensor_msgs/msg/joint_state.hpp\>
#include \<limits\>
<endif>
<if(ros.action_server)>
#include \<atomic\>
#include \<rclcpp_action/rclcpp_action.hpp\>
#include "<ros.action_server.include>"
<endif>

namespace motion_spec::ros {

<if(ros.action_server)>
using ServedAction = <ros.action_server.cpp_type>;
using ServedGoalHandle = rclcpp_action::ServerGoalHandle\<ServedAction\>;

<endif>
<if(ros.scenario_context_id)>
<if(!ros.action_server)>
// A hex UUID, with or without its dashes. An empty string is the zero UUID: a run that
// belongs to no scenario says so, rather than failing to start.
inline bool parse_uuid(const std::string &text, std::array\<std::uint8_t, 16\> &out) {
    std::string digits;
    for (const char c : text) {
        if (c != '-') digits.push_back(c);
    \}
    if (digits.empty()) {
        out.fill(0);
        return true;
    \}
    if (digits.size() != 32) return false;
    for (std::size_t i = 0; i \< 16; ++i) {
        const std::string byte = digits.substr(i * 2, 2);
        if (byte.find_first_not_of("0123456789abcdefABCDEF") != std::string::npos) return false;
        out[i] = static_cast\<std::uint8_t\>(std::stoul(byte, nullptr, 16));
    \}
    return true;
\}

<endif>
<endif>
<if(ros.joint_states)>
// Publish every Nth control cycle. A rate at or above the loop rate, or none at all, means
// every cycle -- the loop is the fastest this can go.
inline int publish_divider(double rate_hz) {
    if (rate_hz \<= 0.0) return 1;
    const double every = 1.0 / (rate_hz * motion_spec::runtime::kControlPeriodS);
    return every \<= 1.0 ? 1 : static_cast\<int\>(every + 0.5);
\}

<endif>
}  // namespace motion_spec::ros
>>

ros-io-members(ros) ::= <<
    rclcpp::Node::SharedPtr ros_node = nullptr;
    std::shared_ptr\<rclcpp::executors::SingleThreadedExecutor\> ros_executor = nullptr;
    std::thread ros_spin_thread;
<if(ros.scenario_context_id)>
<if(!ros.action_server)>
    rclcpp::node_interfaces::OnSetParametersCallbackHandle::SharedPtr ros_param_handle = nullptr;
    std::mutex ros_context_id_mutex;
    std::array\<std::uint8_t, 16\> ros_context_id{};
<endif>
<endif>
<if(ros.action_server)>
    rclcpp_action::Server\<motion_spec::ros::ServedAction\>::SharedPtr goal_server = nullptr;
    std::mutex goal_mutex;
    std::shared_ptr\<motion_spec::ros::ServedGoalHandle\> staged_goal = nullptr;
    std::atomic\<bool\> goal_taken{false\};
<endif>
<ros.publishers:{p |     std::shared_ptr\<realtime_tools::RealtimePublisher\<<p.cpp_type>\>\> <p.pub_id> = nullptr;
    <p.cpp_type> <p.pub_id>_msg{\};}; separator="\n">
<ros.action_clients:{c | <ros-action-members(c)>}; separator="\n">
<ros.subscriptions:{s | <ros-subscription-members(s)>}; separator="\n">
<if(ros.joint_states)>
    std::shared_ptr\<realtime_tools::RealtimePublisher\<sensor_msgs::msg::JointState\>\> joint_states_pub = nullptr;
    sensor_msgs::msg::JointState joint_states_msg{};
    int joint_states_divider = 1;
<endif>
>>

ros-setup(ros) ::= <<
    rclcpp::init(argc, argv);
    robot.ros_node = std::make_shared\<rclcpp::Node\>("<ros.node_name>");
<if(ros.scenario_context_id)>
<if(!ros.action_server)>
<ros-context-id-setup()>
<endif>
<endif>
<ros.publishers:{p |     robot.<p.pub_id> = std::make_shared\<realtime_tools::RealtimePublisher\<<p.cpp_type>\>\>(
        robot.ros_node->create_publisher\<<p.cpp_type>\>("<p.channel>", rclcpp::QoS(10)));}; separator="\n">
<ros.action_clients:{c |     robot.<c.client_id> = rclcpp_action::create_client\<<c.cpp_type>\>(robot.ros_node, "<c.channel>");}; separator="\n">
<ros.subscriptions:{s | <ros-subscription-setup(s)>}; separator="\n">
<ros.standing:{s | <ros-standing-setup(s)>}>
<if(ros.action_server)>

<ros-goal-server-setup(ros.action_server)>
<endif>
>>

// An act's client, the goal it currently has in flight, and the one result it stages for the
// loop. The executor thread writes the staged fields; the loop copies them out under try_lock,
// so a cycle never waits on the network.

ros-action-members(c) ::= <<
    rclcpp_action::Client\<<c.cpp_type>\>::SharedPtr <c.client_id> = nullptr;
    rclcpp_action::ClientGoalHandle\<<c.cpp_type>\>::SharedPtr <c.client_id>_goal = nullptr;
    std::mutex <c.client_id>_mutex;
    bool <c.client_id>_staged = false;
    int <c.client_id>_staged_status = action_msgs::msg::GoalStatus::STATUS_UNKNOWN;
<c.written_poses:{w |     KDL::Frame <c.client_id>_staged_<w.pose_id>;}; separator="\n">
>>

// A standing channel's subscription, the poses it stages for the loop, and whether each has ever
// arrived. The executor thread writes the staged fields; the loop copies them out under try_lock,
// so a cycle never waits on the network.

ros-subscription-members(s) ::= <<
    rclcpp::Subscription\<<s.cpp_type>\>::SharedPtr <s.sub_id>_sub = nullptr;
    std::mutex <s.sub_id>_mutex;
    bool <s.sub_id>_staged = false;
<s.written_poses:{w |     KDL::Frame <s.sub_id>_staged_<w.pose_id>;
    bool <s.sub_id>_seen_<w.pose_id> = false;
    // The two segments a staged reading is composed between: the frame the sender stated it in,
    // which is whatever its header named, and the one this pose is stated against.
    int <s.sub_id>_staged_from_<w.pose_id> = -1;
    int <s.sub_id>_segment_<w.pose_id> = -1;}; separator="\n">
>>

// The pose's own frame is the model's statement, so it is resolved once here and read by index
// on the hot path. A name the world model does not hold is a broken model and stops the run.

ros-subscription-wiring(s) ::= <<
<s.written_poses:{w |     robot.<s.sub_id>_segment_<w.pose_id> = world.index_of("<w.frame_segment>");
    if (robot.<s.sub_id>_segment_<w.pose_id> \< 0) {
        std::cerr \<\< "[world] no segment is named '<w.frame_segment>'" \<\< std::endl;
        return 1;
    \}}; separator="\n">
>>

// Staging is per message, not all-or-nothing: a goal asked one question and either answered it or
// failed, but a stream reports whatever it currently sees, and a message carrying two of three
// objects is not a failure.
//
ros-subscription-setup(s) ::= <<
    robot.<s.sub_id>_sub = robot.ros_node->create_subscription\<<s.cpp_type>\>(
        "<s.channel>", rclcpp::QoS(10),
        [&robot](const <s.cpp_type>::SharedPtr msg) {
            const std::lock_guard\<std::mutex\> lock(robot.<s.sub_id>_mutex);
            for (const auto &detection : msg-><s.detections_path>) {
                if (detection.<s.pose_container>.empty()) continue;
                const auto &pose = detection.<s.pose_path>;
<s.written_poses:{w |                 if (detection.<s.id_path> == "<w.target_iri>") {
                    robot.<s.sub_id>_staged_<w.pose_id> = KDL::Frame(
                        KDL::Rotation::Quaternion(pose.orientation.x, pose.orientation.y,
                                                  pose.orientation.z, pose.orientation.w),
                        KDL::Vector(pose.position.x, pose.position.y, pose.position.z));
                    robot.<s.sub_id>_staged_from_<w.pose_id> = robot.<s.sub_id>_segment_<w.pose_id>;
                    robot.<s.sub_id>_seen_<w.pose_id> = true;
                    robot.<s.sub_id>_staged = true;
                \}}; separator="\n">
            \}
        \});
>>

// Nothing has stated where the objects are until perception has published each of them once.
// Entering the loop before that snapshots an identity pose, and the arm drives at the origin of
// its own base frame. The wait is deployment data, so its bound comes from the config file.

// Every early exit taken after the executor is spinning shares this. The node is reachable from
// the moment the executor starts, so a goal may already be parked: rclcpp_action throws when an
// accepted goal is finalized unanswered, and a joinable spin thread destructing is its own
// std::terminate. A run that stops here established none of what the model authored, so the goal
// is aborted rather than answered -- `_active_goal` is a loop local that does not exist yet.

ros-stop-before-loop(ros) ::= <<
<if(ros.action_server)>
{
    const std::lock_guard\<std::mutex\> lock(robot.goal_mutex);
    if (robot.staged_goal) {
        <ros-goal-result-unset(ros.action_server)>
        robot.staged_goal->abort(_result);
        robot.staged_goal.reset();
    \}
\}
<endif>
robot.ros_executor->cancel();
if (robot.ros_spin_thread.joinable()) robot.ros_spin_thread.join();
rclcpp::shutdown();
>>

// Sent on the entry edge of the motion that owns the act, never per tick: `async_send_goal` only
// enqueues, and the executor thread carries it from there.
//
// A rejected goal has no GoalStatus of its own; the model asked whether the server will deliver,
// and it will not, so it stages the same answer an abort does.
//
// A detection is the pose the model asked for only when it names the target and arrives in the
// frame that pose is stated against; anything else is dropped, and a result that does not carry
// every pose the goal asked for is an abort.

ros-action-send(c) ::= <<
        shared.<c.status_id> = action_msgs::msg::GoalStatus::STATUS_UNKNOWN;
        {
            <c.cpp_type>::Goal _goal;
            _goal.<c.targets_path> = {
<c.target_iris:{iri |                 "<iri>"}; separator=",\n">
            \};
            rclcpp_action::Client\<<c.cpp_type>\>::SendGoalOptions _options;
            _options.goal_response_callback =
                [&robot](rclcpp_action::ClientGoalHandle\<<c.cpp_type>\>::SharedPtr handle) {
                    const std::lock_guard\<std::mutex\> lock(robot.<c.client_id>_mutex);
                    robot.<c.client_id>_goal = handle;
                    if (!handle) {
                        robot.<c.client_id>_staged_status =
                            action_msgs::msg::GoalStatus::STATUS_ABORTED;
                        robot.<c.client_id>_staged = true;
                    \}
                \};
            _options.result_callback =
                [&robot](const rclcpp_action::ClientGoalHandle\<<c.cpp_type>\>::WrappedResult &result) {
                    const std::lock_guard\<std::mutex\> lock(robot.<c.client_id>_mutex);
                    robot.<c.client_id>_goal.reset();
                    robot.<c.client_id>_staged = true;
                    if (result.code == rclcpp_action::ResultCode::CANCELED) {
                        robot.<c.client_id>_staged_status =
                            action_msgs::msg::GoalStatus::STATUS_CANCELED;
                        return;
                    \}
                    if (result.code != rclcpp_action::ResultCode::SUCCEEDED) {
                        robot.<c.client_id>_staged_status =
                            action_msgs::msg::GoalStatus::STATUS_ABORTED;
                        return;
                    \}
<c.written_poses:{w |                     bool _got_<w.pose_id> = false;}; separator="\n">
                    for (const auto &detection : result.result-><c.detections_path>) {
                        if (detection.<c.pose_container>.empty()) continue;
                        const auto &pose = detection.<c.pose_path>;
<c.written_poses:{w |                         if (detection.<c.id_path> == "<w.target_iri>" && detection.<c.frame_path> == "<w.frame_id>") {
                            robot.<c.client_id>_staged_<w.pose_id> = KDL::Frame(
                                KDL::Rotation::Quaternion(pose.orientation.x, pose.orientation.y,
                                                          pose.orientation.z, pose.orientation.w),
                                KDL::Vector(pose.position.x, pose.position.y, pose.position.z));
                            _got_<w.pose_id> = true;
                        \}}; separator="\n">
                    \}
                    // Every object the goal asked about, not merely as many detections as it
                    // asked for: one object seen twice must not stand in for another unseen.
                    robot.<c.client_id>_staged_status =
                        <c.written_poses:{w | _got_<w.pose_id>}; separator=" && ">
                            ? action_msgs::msg::GoalStatus::STATUS_SUCCEEDED
                            : action_msgs::msg::GoalStatus::STATUS_ABORTED;
                \};
            robot.<c.client_id>->async_send_goal(_goal, _options);
        \}
>>

// Cancelling on the exit edge: a goal still in flight is answering a question the model has
// stopped asking.

ros-action-cancel(c) ::= <<
            {
                const std::lock_guard\<std::mutex\> lock(robot.<c.client_id>_mutex);
                if (robot.<c.client_id>_goal) {
                    robot.<c.client_id>->async_cancel_goal(robot.<c.client_id>_goal);
                    robot.<c.client_id>_goal.reset();
                \}
            \}
>>

// Cancelled on the exit edge, from the loop thread: `async_cancel_goal` only enqueues too.

ros-action-cancel-on-exit(motion) ::= <<
<if(motion.has_action_clients)>
            if (<motion.id>_state_instance.active) {
<motion.action_clients:{c | <ros-action-cancel(c)>}; separator="\n">
            \}
<endif>
>>

// One try_lock per cycle: a staged result moves onto the blackboard, and a cycle that cannot
// take the lock reads the previous answer and tries again next tick.

ros-actions-tick(ros) ::= <<
<ros.action_clients:{c |         if (robot.<c.client_id>_mutex.try_lock()) {
            if (robot.<c.client_id>_staged) {
                shared.<c.status_id> = robot.<c.client_id>_staged_status;
<c.written_poses:{w |                 shared.<w.pose_id> = robot.<c.client_id>_staged_<w.pose_id>;}; separator="\n">
                robot.<c.client_id>_staged = false;
            \}
            robot.<c.client_id>_mutex.unlock();
        \}}; separator="\n">
>>

// The same try_lock, for a channel that keeps reporting: whatever the last message staged moves
// onto the blackboard, and a cycle that cannot take the lock reads the previous pose.
//
// The staged reading is stated in the sender's frame, so it is composed here, where kinematics
// exist: X(pose frame -> sender frame) * X(sender frame -> target). Composing on arrival and not
// every cycle is the point -- the result is where the object is, which does not move when the
// camera does, and re-composing an old reading against a newer camera pose would drag the object
// along with the arm. The camera pose used is the arriving cycle's rather than the image's, so a
// reading taken while the arm was elsewhere lands where the arm is now: true while the arm is
// still when it looks, and an arm that detects while moving needs the camera pose at the image
// stamp, which nothing here keeps.
//
// A pose no message has ever carried is left alone rather than written as the identity, which
// would put the object at the origin of its own reference frame and say nothing about it.

ros-subscriptions-tick(ros) ::= <<
<ros.subscriptions:{s |         if (robot.<s.sub_id>_mutex.try_lock()) {
            if (robot.<s.sub_id>_staged) {
<s.written_poses:{w |                 if (robot.<s.sub_id>_seen_<w.pose_id>) {
                    shared.<w.pose_id> =
                        robot.world->pose(robot.<s.sub_id>_segment_<w.pose_id>, robot.control_cycle).Inverse()
                        * robot.world->pose(robot.<s.sub_id>_staged_from_<w.pose_id>, robot.control_cycle)
                        * robot.<s.sub_id>_staged_<w.pose_id>;
                \}}; separator="\n">
                robot.<s.sub_id>_staged = false;
            \}
            robot.<s.sub_id>_mutex.unlock();
        \}}; separator="\n">
>>

// One goal per process run. The FSM parks where the model holds it and the goal event is what
// arms it; nothing routes it back to the parked state, so a second goal would start nothing.
// A goal may carry more than this run reads; what it carries and ignores is reported, never
// mapped, because the run answers the specification it was generated from.

ros-goal-server-setup(server) ::= <<
    robot.goal_server = rclcpp_action::create_server\<motion_spec::ros::ServedAction\>(
        robot.ros_node,
        "<server.action_name>",
        [&robot](const rclcpp_action::GoalUUID &,
                 std::shared_ptr\<const motion_spec::ros::ServedAction::Goal\> goal) {
            if (robot.goal_taken.exchange(true)) {
                RCLCPP_WARN(robot.ros_node->get_logger(),
                            "a goal was already served this run; rejecting");
                return rclcpp_action::GoalResponse::REJECT;
            \}
<server.ignored_goal_fields:{f |             if (!goal-><f>.empty()) {
                RCLCPP_WARN(robot.ros_node->get_logger(),
                            "ignoring %zu entries in goal field '<f>'", goal-><f>.size());
            \}}; separator="\n">
            return rclcpp_action::GoalResponse::ACCEPT_AND_EXECUTE;
        \},
        [](const std::shared_ptr\<motion_spec::ros::ServedGoalHandle\>) {
            // Accepted so the goal ends up CANCELED, but nothing is routed into the FSM: the run
            // plays out to its end state either way.
            return rclcpp_action::CancelResponse::ACCEPT;
        \},
        [&robot](const std::shared_ptr\<motion_spec::ros::ServedGoalHandle\> handle) {
            const std::lock_guard\<std::mutex\> lock(robot.goal_mutex);
            robot.staged_goal = handle;
        \});
>>

// Parsed on the executor thread and handed to the loop under a lock the loop never waits on.

ros-context-id-setup() ::= <<
    robot.ros_node->declare_parameter\<std::string\>("scenario_context_id", "");
    robot.ros_param_handle = robot.ros_node->add_on_set_parameters_callback(
        [&robot](const std::vector\<rclcpp::Parameter\> &params) {
            rcl_interfaces::msg::SetParametersResult result;
            result.successful = true;
            for (const auto &param : params) {
                if (param.get_name() != "scenario_context_id") continue;
                std::array\<std::uint8_t, 16\> parsed{};
                if (!motion_spec::ros::parse_uuid(param.as_string(), parsed)) {
                    result.successful = false;
                    result.reason = "scenario_context_id must be a hex UUID";
                    continue;
                \}
                const std::lock_guard\<std::mutex\> lock(robot.ros_context_id_mutex);
                robot.ros_context_id = parsed;
            \}
            return result;
        \});
>>

// The executor answers parameter services; it starts once every publisher exists so a client
// that sees the node also sees the topics.

ros-spin-start(ros) ::= <<
    robot.ros_executor = std::make_shared\<rclcpp::executors::SingleThreadedExecutor\>();
    robot.ros_executor->add_node(robot.ros_node);
    robot.ros_spin_thread = std::thread([&robot]() { robot.ros_executor->spin(); \});
>>

// Sized once, from the joints the model drives; the topic and the rate are deployment data,
// so they are read from the config file at launch rather than baked in.

ros-joint-states-setup(ros) ::= <<
<if(ros.joint_states)>
    {
        // Named, not a literal: `section` returns a reference into robot_config, and gcc reads a
        // temporary argument as the thing the reference could dangle to.
        const std::string _js_key = "<ros.joint_states.config_key>";
        const toml::table &_js_cfg = motion_spec::config::section(robot_config, _js_key);
        robot.joint_states_divider =
            motion_spec::ros::publish_divider(_js_cfg["rate"].value_or(0.0));
        robot.joint_states_msg.name = {
<ros.joint_states.joints:{j |             "<j.name>"}; separator=",\n">
        \};
        const std::size_t _js_n = robot.joint_states_msg.name.size();
        robot.joint_states_msg.position.assign(_js_n, 0.0);
        // sensor_msgs/JointState has no per-joint "not reported" -- its arrays are equal-length
        // or empty -- so a joint nothing measures a velocity or an effort for keeps the NaN it
        // was filled with, rather than a zero claiming it is standing still and unloaded.
        robot.joint_states_msg.velocity.assign(_js_n, std::numeric_limits\<double\>::quiet_NaN());
        robot.joint_states_msg.effort.assign(_js_n, std::numeric_limits\<double\>::quiet_NaN());
        robot.joint_states_pub =
            std::make_shared\<realtime_tools::RealtimePublisher\<sensor_msgs::msg::JointState\>\>(
                robot.ros_node->create_publisher\<sensor_msgs::msg::JointState\>(
                    _js_cfg["topic"].value_or(std::string("/joint_states")), rclcpp::QoS(10)));
    \}
<endif>
>>

// One tick per control cycle, for every publishing monitor whose motion is scheduled. Each
// state block writes the fields the model authored for it; a cycle whose polarity authored
// nothing publishes nothing, and an unscheduled monitor says nothing at all -- silence is what
// a reader takes for "not evaluated".

ros-publish-tick(coordination, communication, views) ::= <<
<if(communication.ros.scenario_context_id)>
<if(!communication.ros.action_server)>
        if (robot.ros_context_id_mutex.try_lock()) {
            _scenario_context_id = robot.ros_context_id;
            robot.ros_context_id_mutex.unlock();
        \}
<endif>
<endif>
<coordination.motions:{m | <m.when_monitors:{mon | <ros-monitor-publish(m, mon)>}><m.while_monitors:{mon | <ros-monitor-publish(m, mon)>}><m.until_monitors:{mon | <ros-monitor-publish(m, mon)>}>}>
<ros-joint-states-tick(communication.ros)>
<ros-actions-tick(communication.ros)>
<ros-subscriptions-tick(communication.ros)>
<ros-standing-tick(communication.ros, views)>
>>

// A topic the run publishes rather than a motion: it keeps reporting whichever motion is
// active, so its rate is its own. The authored rate is already the number of cycles between two
// messages, and the quantity is written whole -- a field the model mapped itself overrides the
// component that field would otherwise carry.

ros-standing-tick(ros, views) ::= <<
<ros.standing:{s |         if ((_step % <s.divider>) == 0) {
<s.entries:{e |<standing-payload(e)>
<e.auto_time:{p |             robot.<e.pub_id>_msg.<p> = robot.ros_node->now();
}>}>
<s.fields:{f |             robot.<s.pub_id>_msg.<f.path> = <access-expr(f.ref, views)>;}; separator="\n">
<s.auto_time:{p |             robot.<s.pub_id>_msg.<p> = robot.ros_node->now();}; separator="\n">
<s.auto_context_id:{p |             robot.<s.pub_id>_msg.<p>.uuid = _scenario_context_id;}; separator="\n">
            robot.<s.pub_id>->try_publish(robot.<s.pub_id>_msg);
        \}}; separator="\n">
>>

// What the model already settles stays out of the loop: how many entries there are, which
// entity each is about, and the frame each states it in are the model's own statements, so they
// are written once and only the quantity itself is written per cycle.

ros-standing-setup(s) ::= <<
<s.resize:{r |     robot.<s.pub_id>_msg.<r.path>.resize(<r.size>);}; separator="\n">
<if(s.frame_id)>    robot.<s.pub_id>_msg.<s.frame_path> = "<s.frame_id>";<endif>
<s.entries:{e | <if(e.id_path)>    robot.<e.pub_id>_msg.<e.id_path> = "<e.id_value>";
<endif><if(e.frame_id)>    robot.<e.pub_id>_msg.<e.frame_path> = "<e.frame_id>";
<endif>}>
>>

standing-payload(s) ::= <<
<({standing-payload-<s.value_type>})(s)>
>>

standing-payload-Wrench(s) ::= <<
            robot.<s.pub_id>_msg.<s.payload_path>force.x = shared.<s.value_id>.force.x();
            robot.<s.pub_id>_msg.<s.payload_path>force.y = shared.<s.value_id>.force.y();
            robot.<s.pub_id>_msg.<s.payload_path>force.z = shared.<s.value_id>.force.z();
            robot.<s.pub_id>_msg.<s.payload_path>torque.x = shared.<s.value_id>.torque.x();
            robot.<s.pub_id>_msg.<s.payload_path>torque.y = shared.<s.value_id>.torque.y();
            robot.<s.pub_id>_msg.<s.payload_path>torque.z = shared.<s.value_id>.torque.z();
>>

standing-payload-VelocityTwist(s) ::= <<
            robot.<s.pub_id>_msg.<s.payload_path>linear.x = shared.<s.value_id>.vel.x();
            robot.<s.pub_id>_msg.<s.payload_path>linear.y = shared.<s.value_id>.vel.y();
            robot.<s.pub_id>_msg.<s.payload_path>linear.z = shared.<s.value_id>.vel.z();
            robot.<s.pub_id>_msg.<s.payload_path>angular.x = shared.<s.value_id>.rot.x();
            robot.<s.pub_id>_msg.<s.payload_path>angular.y = shared.<s.value_id>.rot.y();
            robot.<s.pub_id>_msg.<s.payload_path>angular.z = shared.<s.value_id>.rot.z();
>>

standing-payload-Pose(s) ::= <<
            {
                double _qx, _qy, _qz, _qw;
                shared.<s.value_id>.M.GetQuaternion(_qx, _qy, _qz, _qw);
                robot.<s.pub_id>_msg.<s.payload_path>position.x = shared.<s.value_id>.p.x();
                robot.<s.pub_id>_msg.<s.payload_path>position.y = shared.<s.value_id>.p.y();
                robot.<s.pub_id>_msg.<s.payload_path>position.z = shared.<s.value_id>.p.z();
                robot.<s.pub_id>_msg.<s.payload_path>orientation.x = _qx;
                robot.<s.pub_id>_msg.<s.payload_path>orientation.y = _qy;
                robot.<s.pub_id>_msg.<s.payload_path>orientation.z = _qz;
                robot.<s.pub_id>_msg.<s.payload_path>orientation.w = _qw;
            \}
>>

// Taking the goal arms the FSM: the loop produces the goal event once -- only while the FSM
// sits in a state that reacts to it, since an event lives one tick -- and from then on stamps
// every message with the scenario the goal names.

ros-goal-arm-tick(coordination, server) ::= <<
        if (robot.goal_mutex.try_lock()) {
            if (robot.staged_goal) {
                _active_goal = robot.staged_goal;
                robot.staged_goal.reset();
            \}
            robot.goal_mutex.unlock();
        \}
        if (_active_goal && !_goal_armed
                && (<server.goal_states:{s | fsm->currentStateIndex == <coordination.fsm.cpp_namespace>::<s>}; separator=" || ">)) {
            _goal_armed = true;
<server.goal_context_id:{p |             _scenario_context_id = _active_goal->get_goal()-><p>.uuid;}; separator="\n">
            produce_event(robot.fsm_events, <coordination.fsm.cpp_namespace>::<server.goal_event>);
        \}
>>

// The fields the node owns rather than the model: when the run ended, and the scenario it
// belonged to. Both are answered whether or not the run reached its end.

ros-goal-result-own(server) ::= <<
<server.result_auto_time:{p | _result-><p> = robot.ros_node->now();}; separator="\n">
<server.result_auto_context_id:{p | _result-><p>.uuid = _scenario_context_id;}; separator="\n">
>>

// Stopping early establishes none of what the model authored, so none of it is stated: every
// field keeps the default its own message type gives it.

ros-goal-result-unset(server) ::= <<
auto _result = std::make_shared\<<server.result_cpp_type>\>();
<ros-goal-result-own(server)>
>>

ros-publish-tick-locals(ros) ::= <<
<if(ros.scenario_context_id)>
    std::array\<std::uint8_t, 16\> _scenario_context_id{};
<endif>
<if(ros.action_server)>
    std::shared_ptr\<motion_spec::ros::ServedGoalHandle\> _active_goal = nullptr;
    bool _goal_armed = false;
<endif>
>>

// An announced event is the event firing, so it rides the event itself rather than the
// constraint: one message per event on the cycle the FSM sees it, whatever state the motion is
// in. The URI comes from the FSM's own table, so what a scenario observes is the IRI the model
// declared.

ros-monitor-announce(monitor, event) ::= <<
        if (robot.fsm_events && consume_event(robot.fsm_events, <monitor.ros.occurrence_namespace>::<event>)) {
            robot.<monitor.ros.pub_id>_msg.<monitor.ros.occurrence_path> =
                <monitor.ros.occurrence_namespace>::EVENT_URIS[<monitor.ros.occurrence_namespace>::<event>];
<monitor.ros.auto_time:{p |             robot.<monitor.ros.pub_id>_msg.<p> = robot.ros_node->now();}; separator="\n">
<monitor.ros.auto_context_id:{p |             robot.<monitor.ros.pub_id>_msg.<p>.uuid = _scenario_context_id;}; separator="\n">
            robot.<monitor.ros.pub_id>->try_publish(robot.<monitor.ros.pub_id>_msg);
        \}
>>

// Reaching this monitor's state is what the model calls the goal finished, so the goal is
// answered there and once: the handle is dropped, and nothing else in the run still holds it.
// A goal whose cancel was accepted is reported CANCELED whatever the model states, because that
// is what the client was told to expect.

ros-monitor-answer(motion, monitor) ::= <<
        if (_active_goal && <motion.id>_state_instance.active
                && <if(!monitor.answer.satisfied)>!<endif>(<monitor-satisfied-expr(monitor)>)) {
            auto _result = std::make_shared\<<monitor.answer.result_cpp_type>\>();
<monitor.answer.fields:{f |             _result-><f.path> = <f.cpp_value>;}; separator="\n">
<monitor.answer.auto_time:{p |             _result-><p> = robot.ros_node->now();}; separator="\n">
<monitor.answer.auto_context_id:{p |             _result-><p>.uuid = _scenario_context_id;}; separator="\n">
            if (_active_goal->is_canceling()) {
                _active_goal->canceled(_result);
            \} else {
                _active_goal-><monitor.answer.method>(_result);
            \}
            _active_goal.reset();
        \}
>>

// What the monitor says while its motion runs, and then the goal it answers: a scenario sees
// every occurrence the run states before it is told the run is over.

ros-monitor-publish(motion, monitor) ::= <<
<if(monitor.ros.occurrence_path)>
<monitor.ros.occurrence_events:{e | <ros-monitor-announce(monitor, e)>}; separator="\n">
<elseif(monitor.ros)>
        if (<motion.id>_state_instance.active<if(monitor.ros.divider)> && (_step % <monitor.ros.divider>) == 0<endif>) {
            const bool _satisfied = <monitor-satisfied-expr(monitor)>;
            bool _authored = false;
<if(monitor.ros.has_satisfied)>
            if (_satisfied) {
<monitor.ros.on_satisfied:{f |                 robot.<monitor.ros.pub_id>_msg.<f.path> = <f.cpp_value>;}; separator="\n">
                _authored = true;
            \}
<endif>
<if(monitor.ros.has_violated)>
            if (!_satisfied) {
<monitor.ros.on_violated:{f |                 robot.<monitor.ros.pub_id>_msg.<f.path> = <f.cpp_value>;}; separator="\n">
                _authored = true;
            \}
<endif>
            if (_authored) {
<monitor.ros.auto_time:{p |                 robot.<monitor.ros.pub_id>_msg.<p> = robot.ros_node->now();}; separator="\n">
<monitor.ros.auto_context_id:{p |                 robot.<monitor.ros.pub_id>_msg.<p>.uuid = _scenario_context_id;}; separator="\n">
                robot.<monitor.ros.pub_id>->try_publish(robot.<monitor.ros.pub_id>_msg);
            \}
        \}
<endif>
<if(monitor.answer)>
<ros-monitor-answer(motion, monitor)>
<endif>
>>

ros-joint-states-tick(ros) ::= <<
<if(ros.joint_states)>
        if (robot.joint_states_pub && (_step % robot.joint_states_divider) == 0) {
            robot.joint_states_msg.header.stamp = robot.ros_node->now();
<ros.joint_states.joints:{j |             robot.joint_states_msg.position[<i0>] = shared.<j.position>;<if(j.velocity)>
            robot.joint_states_msg.velocity[<i0>] = shared.<j.velocity>;<endif><if(j.effort)>
            robot.joint_states_msg.effort[<i0>] = shared.<j.effort>;<endif>}; separator="\n">
            robot.joint_states_pub->try_publish(robot.joint_states_msg);
        \}
<endif>
>>

ros-shutdown(ros) ::= <<
<if(ros.action_server)>
    if (_active_goal && _active_goal->is_active()) {
        // Stopping before the end state: the run never reached what the model calls done.
        <ros-goal-result-unset(ros.action_server)>
        if (_active_goal->is_canceling()) {
            _active_goal->canceled(_result);
        \} else {
            _active_goal->abort(_result);
        \}
    \}
    _active_goal.reset();
<endif>
    if (robot.ros_executor) {
        robot.ros_executor->cancel();
    \}
    if (robot.ros_spin_thread.joinable()) {
        robot.ros_spin_thread.join();
    \}
<ros.publishers:{p |     robot.<p.pub_id>.reset();}; separator="\n">
<ros.action_clients:{c |     robot.<c.client_id>_goal.reset();
    robot.<c.client_id>.reset();}; separator="\n">
<ros.subscriptions:{s |     robot.<s.sub_id>_sub.reset();}; separator="\n">
<if(ros.joint_states)>
    robot.joint_states_pub.reset();
<endif>
<if(ros.action_server)>
    robot.goal_server.reset();
<endif>
    robot.ros_executor.reset();
    robot.ros_node.reset();
    rclcpp::shutdown();
>>
